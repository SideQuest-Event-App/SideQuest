ANTHROPIC_API_KEY=paste-your-key-here
# Optional: change the model
# MODEL=claude-haiku-4-5-20251001

# Optional: store the database in Supabase instead of data/db.json (Project Settings → API).
# Use the secret key (service_role on older projects): only server.js talks to Supabase.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...

# ---------- Sidekick: Google Places (suggests places that don't need tickets) ----------
# A key restricted to "Places API (New)". Without it, Sidekick suggests events only.
# GOOGLE_MAPS_API_KEY=
# Spending stop: the app stops searching at FREE_PER_MONTH × STOP_AT (default 1000 × 0.8 = 800 a month)
# and at DAILY_MAX a day, then carries on with events only until the month/day resets.
# GOOGLE_PLACES_FREE_PER_MONTH=1000
# GOOGLE_PLACES_STOP_AT=0.8
# GOOGLE_PLACES_DAILY_MAX=40
# SIDEKICK_PLACES_PER_CALL=2
# SIDEKICK_CITY=Toronto, ON
# SIDEKICK_PLACES_OFF=1        # kill switch

# ---------- Sidekick: ElevenLabs voice agent (the planner's phone) ----------
# ELEVENLABS_API_KEY=
# Agent IDs, from `node tools/elevenlabs-agents.js --create` (or the ElevenLabs dashboard)
# ELEVENLABS_AGENT_FRIEND=
# ELEVENLABS_AGENT_CONCIERGE=
# Optional voices (e.g. your own cloned voice) used when creating the agents
# ELEVENLABS_VOICE_FRIEND=
# ELEVENLABS_VOICE_CONCIERGE=
# Spending stop: each call reserves MAX_CALL_MINUTES up front and gives back what it didn't use.
# Sessions stop at MINUTES_PER_MONTH × STOP_AT, and at DAILY_MINUTES a day.
# ELEVENLABS_MINUTES_PER_MONTH=15
# ELEVENLABS_STOP_AT=0.8
# ELEVENLABS_DAILY_MINUTES=10
# ELEVENLABS_MAX_CALL_MINUTES=10
# SIDEKICK_ELEVENLABS_OFF=1    # kill switch
# The planner's "Start the call" tap starts the agent too, and the agent leads the call. Its tools run in the
# planner's browser (client tools), so no public URL or secret is needed. Update the agents' settings from code:
#   node tools/elevenlabs-agents.js --update     (then --check to read them back)
# Optional: the agent's conversation model (names from GET https://api.elevenlabs.io/v1/convai/llm/list)
# ELEVENLABS_LLM=
# ELEVENLABS_LLM_REASONING=minimal
# How the planner's phone connects: webrtc (default, falls back to websocket) or websocket
# ELEVENLABS_CONNECTION=webrtc
# Only for the optional server-side tool routes (/api/sk/agent/...), which the agents no longer use; any long random string
# SIDEKICK_TOOL_SECRET=

# ---------- Sidekick: in-app audio (WebRTC between phones) ----------
# Phones connect directly using public STUN. Some mobile networks need a TURN relay; without one,
# audio can stay on "connecting". Free option: Metered's free tier (metered.ca). Comma-separate URLs.
# These are sent only to phones that join in-app audio.
# SIDEKICK_TURN_URL=turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443?transport=tcp
# SIDEKICK_TURN_USER=
# SIDEKICK_TURN_PASS=
# SIDEKICK_STUN_URL=stun:stun.l.google.com:19302   # default; "off" for local tests with no network

# ---------- Sidekick: the voice A/B study (/study) ----------
# Password for the results page (/study/results) and the CSV export (/api/sk/study/export). Without it, results stay locked.
# SIDEKICK_STUDY_KEY=
# Where the study data is kept (default data/sidekick-study.json; also copied to Supabase Storage when it is set up)
# SIDEKICK_STUDY_FILE=
