0000,1795014000000,1795100400000,1795186800000,1795273200000,1795446000000,1795532400000,1795618800000,1795705200000,1795791600000,1795878000000,1796050800000,1796137200000,1796223600000,1796310000000,1796396400000,1796482800000,1796655600000,1796742000000,1796828400000,1796914800000,1797001200000,1797087600000,1797260400000,1797346800000,1797433200000,1797519600000,1797606000000,1797692400000,1797865200000,1797951600000,1798038000000,1798124400000,1798210800000,1798297200000,1798470000000,1798556400000,1798642800000,1798729200000],"start":"2026-09-07T10:00:00-04:00","end":"2026-12-31T10:00:00-05:00","allDay":"Day Event","venue":{"name":"Urbanspace Gallery","address":"401 Richmond St W, Toronto, ON, M5V 3A8","lat":43.647755,"lng":-79.394748},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"What do cities remember? How do our stories, relationships and experiences shape the places we call home?\n\nDrawing on community conversations, storytelling, a Sharing Circle and arts-based research, this evolving exhibition, featuring illuminated textile maps, documentary film and opportunities for public participation, explores how people connect to place and imagine urban futures. \n\nVisitors are invited to return throughout the exhibition, contribute to a growing textile installation and experience how the work changes over time.\n","categories":["Arts/Exhibits","Cultural","Film"],"presenter":null,"image":"NgegXWP7YyX5G3PIBLwp2g","website":"https://www.urbanspacegallery.ca/event/a-translucent-city-collective-memories-of-the-future/","tickets":null},{"id":"49d14064-6bef-4538-a105-ec59ef56b142","name":"A Translucent City: Collective Memories of the Future","dates":[1788789600000,1788876000000,1788962400000,1789048800000,1789135200000,1789221600000,1789394400000,1789480800000,1789567200000,1789653600000,1789740000000,1789826400000,1789999200000,1790085600000,1790172000000,1790258400000,1790344800000,1790431200000,1790604000000,1790690400000,1790776