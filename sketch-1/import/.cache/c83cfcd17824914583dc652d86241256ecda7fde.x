000,1789221600000,1789394400000,1789480800000,1789567200000,1789653600000,1789740000000,1789826400000,1789999200000,1790085600000,1790172000000,1790258400000,1790344800000,1790431200000,1790604000000,1790690400000,1790776800000,1790863200000,1790949600000,1791036000000,1791208800000,1791295200000,1791381600000,1791468000000,1791554400000,1791640800000,1791813600000,1791900000000,1791986400000,1792072800000,1792159200000,1792245600000,1792418400000,1792504800000,1792591200000,1792677600000,1792764000000,1792850400000,1793023200000,1793109600000,1793196000000,1793282400000,1793368800000,1793455200000,1793631600000,1793718000000,1793804400000,1793890800000,1793977200000,1794063600000,1794236400000,1794322800000,1794409200000,1794495600000,1794582000000,1794668400000,1794841200000,1794927600000,1795014000000,1795100400000,1795186800000,1795273200000,1795446000000,1795532400000,1795618800000,1795705200000,1795791600000,1795878000000,1796050800000,1796137200000,1796223600000,1796310000000,1796396400000,1796482800000,1796655600000,1796742000000,1796828400000,1796914800000,1797001200000,1797087600000,1797260400000,1797346800000,1797433200000,1797519600000,1797606000000,1797692400000,1797865200000,1797951600000,1798038000000,1798124400000,1798210800000,1798297200000,1798470000000,1798556400000,1798642800000,1798729200000],"start":"2026-09-07T10:00:00-04:00","end":"2026-12-31T10:00:00-05:00","allDay":"Day Event","venue":{"name":"Urbanspace Gallery","address":"401 Richmond St W, Toronto, ON, M5V 3A8","lat":43.647755,"lng":-79.394748},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"What do cities remember? How do our stories, relationships and experiences shape the places we call home?\n\nDrawing on community conversations, storytelling, a Sharing Circle and arts-based research, this evolving exhibition, featuring illuminated textile maps, documentary film and opportunities for public participation, explores how people connect to place and imagine urban futures. \n\nVisitors are invited to return throughout the exhibition, contribute to a growing textile installation and experience how the work changes over time.\n","categories":["Arts/Exhibits","Cultural","Film"],"presenter":null,"image":"NgegXWP7YyX5G3PIBLwp2g","website":"https://www.urbanspacegallery.ca/event/a-translucent-city-collective-memories-of-the-future/","tickets":null},{"id":"e813eb84-3a7f-4f89-b791-d3a603d333d0","name":"Ladysmith Black Mambazo","dates":[1806883200000],"start":"2027-04-04T20:00:00-04:00","end":"2027-04-04T20:00:00-04:00","allDay":"Night Event","venue":{"name":"Koerner Hall","address":"273 Bloor St W, Toronto, ON, M5S 1W2","lat":43.667856304,"lng":-79.396058814},"free":false,"low":65,"high":125,"pwyc":null,"costNotes":null,"description":"The Grammy Award-winning South African acapella ensemble, which blasted to stardom on Paul Simon’s album Graceland, returns to Toronto. They have also recorded with Stevie Wonder, Dolly Parton, Sarah McLachlan, Josh Groban, Emmylou Harris, Melissa Etheridge, amongst others.\n\nDo not miss this sure to sell out appearance, they’ve “got diamonds on the souls of their feet!”.\n\nAfter the concert, enjoy a beverage and more music at the Postlude Performance featuring a local emerging artist in the Leslie and Anna Dan Galleria. \n","categories":["Live Performances","Music"],"presenter":null,"image":"nwntZi03beI5O8mjMSo6yA","website":"https://www.rcmusic.com/concert/ladysmith-black-mambazo-446001","tickets":"https://www.rcmusic.com/tickets/seats/446001"},{"id":"0fdb011f-236f-4264-aae9-545029272e42","name":"Exhibition: \"Returning to Ourselves and Michael Massie: now and then\"","dates":[1788987600000,1789056000000,1789142400000,1789228800000,1789574400000,1789660800000,1789747200000,1789833600000,1790179200000,1790265600000,1790352000000,1790438400000,1790784000000,1790870400000,1790956800000,1791043200000,1791388800000,1791475200000,1791561600000,1791648000000,1791993600000,1792080000000,1792166400000