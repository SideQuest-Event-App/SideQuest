813600000,1791900000000,1791986400000,1792072800000,1792159200000,1792245600000,1792418400000,1792504800000,1792591200000,1792677600000,1792764000000,1792850400000,1793023200000,1793109600000,1793196000000,1793282400000,1793368800000,1793455200000,1793631600000,1793718000000,1793804400000,1793890800000,1793977200000,1794063600000,1794236400000,1794322800000,1794409200000,1794495600000,1794582000000,1794668400000,1794841200000,1794927600000,1795014000000,1795100400000,1795186800000,1795273200000,1795446000000,1795532400000,1795618800000,1795705200000,1795791600000,1795878000000,1796050800000,1796137200000,1796223600000,1796310000000,1796396400000,1796482800000,1796655600000,1796742000000,1796828400000,1796914800000,1797001200000,1797087600000,1797260400000,1797346800000,1797433200000,1797519600000,1797606000000,1797692400000,1797865200000,1797951600000,1798038000000,1798124400000,1798210800000,1798297200000,1798470000000,1798556400000,1798642800000,1798729200000],"start":"2026-09-07T10:00:00-04:00","end":"2026-12-31T10:00:00-05:00","allDay":"Day Event","venue":{"name":"Urbanspace Gallery","address":"401 Richmond St W, Toronto, ON, M5V 3A8","lat":43.647755,"lng":-79.394748},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"What do cities remember? How do our stories, relationships and experiences shape the places we call home?\n\nDrawing on community conversations, storytelling, a Sharing Circle and arts-based research, this evolving exhibition, featuring illuminated textile maps, documentary film and opportunities for public participation, explores how people connect to place and imagine urban futures. \n\nVisitors are invited to return throughout the exhibition, contribute to a growing textile installation and experience how the work changes over time.\n","categories":["Arts/Exhibits","Cultural","Film"],"presenter":null,"image":"NgegXWP7YyX5G3PIBLwp2g","website":"https://www.urbanspacegallery.ca/event/a-translucent-city-collective-memories-of-the-future/","tickets":null},{"id":"4f0ebf9f-721c-4a69-a290-cce2fa5cdcf2","name":"A Translucent City: Collective Memories of the Future","dates":[1788789600000,1788876000000,1788962400000,1789048800000,1789135200000,1789221600000,1789394400000,1789480800000,1789567200000,1789653600000,1789740000000,1789826400000,1789999200000,1790085600000,1790172000000,1790258400000,1790344800000,1790431200000,1790604000000,1790690400000,1790776800000,1790863200000,1790949600000,1791036000000,1791208800000,1791295200000,1791381600000,1791468000000,1791554400000,1791640800000,1791813600000,1791900000000,1791986400000,1792072800000,1792159200000,1792245600000,1792418400000,1792504800000,1792591200000,1792677600000,1792764000000,1792850400000,1793023200000,1793109600000,1793196000000,1793282400000,1793368800000,1793455200000,1793631600000,1793718000000,1793804400000,1793890800000,1793977200000,1794063600000,1794236400000,1794322800000,1794409200000,1794495600000,1794582000000,1794668400000,1794841200000,1794927600000,1795014000000,1795100400000,1795186800000,1795273200000,1795446000000,1795532400000,1795618800000,1795705200000,1795791600000,1795878000000,1796050800000,1796137200000,1796223600000,1796310000000,1796396400000,1796482800000,1796655600000,1796742000000,1796828400000,1796914800000,1797001200000,1797087600000,1797260400000,1797346800000,1797433200000,1797519600000,1797606000000,1797692400000,1797865200000,1797951600000,1798038000000,1798124400000,1798210800000,1798297200000,1798470000000,1798556400000,1798642800000,1798729200000],"start":"2026-09-07T10:00:00-04:00","end":"2026-12-31T10:00:00-05:00","allDay":"Day Event","venue":{"name":"Urbanspace Gallery","address":"401 Richmond St W, Toronto, ON, M5V 3A8","lat":43.647755,"lng":-79.394748},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"What do cities remember? How do our stories, relationships and experiences shape the places we call home?\n\nDrawing on community conversations, storytelling, a Sharing Circle and arts-based research, this evolving exhibition, featuring illuminated textile maps, documentary film and opportunities for public participation, explores how people connect to place and imagine urban futures. \n\nVisitors are invited to return throughout the exhibition, contribute to a growing textile installation and experience how the work changes over time.\n","categories":["Arts/Exhibits","Cultural","Film"],"presenter":null,"image":"NgegXWP7YyX5G3PIBLwp2g","website":"https://www.urbanspacegallery.ca/event/a-translucent-city-collective-memories-of-the-future/","tickets":null},{"id":"1b4d6eb9-bc8e-42a0-8611-348264fc8e51","name":"The Porch :itâ kâ-wasêtêki tâpwêwin","dates":[1792625400000,1792711800000,1792798200000,1792884600000,1792971000000],"start":"2026-10-21T19:30:00-04:00","end":"2026-10-25T19:30:00-04:00","allDay":"Night Event","venue":{"name":"Assembly Theatre","address":"1479 Queen St W, Toronto","lat":43.639881,"lng":-79.439392},"free":false,"low":33,"high":null,"pwyc":null,"costNotes":null,"description":"Where Truth is Brought Into the Light, written by Danik McAfee.\n\nOne Muskoka cottage. A yearly tradition of Friendsgiving and a whole lot left unsaid.\n\nBetween the cocktails, questionable decisions, old flames, new lovers, and one increasingly chaotic evening, The Porch is a dark comedy mystery about chosen family and the ridiculous lengths we go to keep the peace.\n\nSet against a celebration built around gratitude, the play asks what happens when the stories holding us together begin to crack.\n\nThrough an Indigenous lens, The Porch draws a parallel between the sanitized history of Thanksgiving and the histories we rewrite within our own families.\n\nBecause eventually, the drinks run out, the party ends and everything buried finds its way into the light.\n\n","categories":["Indigenous","2SLGBTQ+","Theatre","Thanksgiving"],"presenter":"Small but Mighty Productions","image":"eoTSipAJiJbLYcjdSp8Aag","website":"https://SBM-THE-PORCH.eventbrite.ca","tickets":"https://SBM-THE-PORCH.eventbrite.ca"},{"id":"e75f5224-7303-4fd5-95f5-199c314f9ade","name":"The Porch :itâ kâ-wasêtêki tâpwêwin","dates":[1792625400000,1792711800000,1792798200000,1792884600000,1792971000000],"start":"2026-10-21T19:30:00-04:00","end":"2026-10-25T19:30:00-04:00","allDay":"Night Event","venue":{"name":"Assembly Theatre","address":"1479 Queen St W, Toronto","lat":43.639881,"lng":-79.439392},"free":false,"low":33,"high":null,"pwyc":null,"costNotes":null,"description":"Where Truth is Brought Into the Light, written by Danik McAfee.\n\nOne Muskoka cottage. A yearly tradition of Friendsgiving and a whole lot left unsaid.\n\nBetween the cocktails, questionable decisions, old flames, new lovers, and one increasingly chaotic evening, The Porch is a dark comedy mystery about chosen family and the ridiculous lengths we go to keep the peace.\n\nSet against a celebration built around gratitude, the play asks what happens when the stories holding us together begin to crack.\n\nThrough an Indigenous lens, The Porch draws a parallel between the sanitized history of Thanksgiving and the histories we rewrite within our own families.\n\nBecause eventually, the drinks run out, the party ends and everything buried finds its way into the light.\n\n","categories":["Indigenous","2SLGBTQ+","Theatre","Thanksgiving"],"presenter":"Small but Mighty Productions","image":"eoTSipAJiJbLYcjdSp8Aag","website":"https://SBM-THE-PORCH.eventbrite.ca","tickets":"https://SBM-THE-PORCH.eventbrite.ca"},{"id":"daab44ad-186b-4c03-8ea5-187e8b9fabad","name":"The Porch :itâ kâ-wasêtêki tâpwêwin","dates":[1792625400000,1792711800000,1792798200000,1792884600000,1792971000000],"start":"2026-10-21T19:30:00-04:00","end":"2026-10-25T19:30:00-04:00","allDay":"Night Event","venue":{"name":"Assembly Theatre","address":"1479 Queen St W, Toronto","lat":43.639881,"lng":-79.439392},"free":false,"low":33,"high":null,"pwyc":null,"costNotes":null,"description":"Where Truth is Brought Into the Light, written by Danik McAfee.\n\nOne Muskoka cottage. A yearly tradition of Friendsgiving and a whole lot left unsaid.\n\nBetween the cocktails, questionable decisions, old flames, new lovers, and one increasingly chaotic evening, The Porch is a dark comedy mystery about chosen family and the ridiculous lengths we go to keep the peace.\n\nSet against a celebration built around gratitude, the play asks what happens when the stories holding us together begin to crack.\n\nThrough an Indigenous lens, The Porch draws a parallel between the sanitized history of Thanksgiving and the histories we rewrite within our own families.\n\nBecause eventually, the drinks run out, the party ends and everything buried finds its way into the light.\n\n","categories":["Indigenous","2SLGBTQ+","Theatre","Thanksgiving"],"presenter":"Small but Mighty Productions","image":"eoTSipAJiJbLYcjdSp8Aag","website":"https://SBM-THE-PORCH.eventbrite.ca","tickets":"https://SBM-THE-PORCH.eventbrite.ca"},{"id":"70729b5b-b0f9-44aa-ad4e-6cb4b8aadc5b","name":"The Porch :itâ kâ-wasêtêki tâpwêwin","dates":[1792625400000,1792711800000,1792798200000,1792884600000,1792971000000],"start":"2026-10-21T19:30:00-04:00","end":"2026-10-25T19:30:00-04:00","allDay":"Night Event","venue":{"name":"Assembly Theatre","address":"1479 Queen St W, Toronto","lat":43.639881,"lng":-79.439392},"free":false,"low":33,"high":null,"pwyc":null,"costNotes":null,"description":"Where Truth is Brought Into the Light, written by Danik McAfee.\n\nOne Muskoka cottage. A yearly tradition of Friendsgiving and a whole lot left unsaid.\n\nBetween the cocktails, questionable decisions, old flames, new lovers, and one increasingly chaotic evening, The Porch is a dark comedy mystery about chosen family and the ridiculous lengths we go to keep the peace.\n\nSet against a celebration built around gratitude, the play asks what happens when the stories holding us together begin to crack.\n\nThrough an Indigenous lens, The Porch draws a parallel between the sanitized history of Thanksgiving and the histories we rewrite within our own families.\n\nBecause eventually, the drinks run out, the party ends and everything buried finds its way into the light.\n\n","categories":["Indigenous","2SLGBTQ+","Theatre","Thanksgiving"],"presenter":"Small but Mighty Productions","image":"eoTSipAJiJbLYcjdSp8Aag","website":"https://SBM-THE-PORCH.eventbrite.ca","tickets":"https://SBM-THE-PORCH.eventbrite.ca"},{"id":"3f1799fc-4e16-4b85-9e06-7647a476ac29","name":"The Porch :itâ kâ-wasêtêki tâpwêwin","dates":[1792625400000,1792711800000,1792798200000,1792884600000,1792971000000],"start":"2026-10-21T19:30:00-04:00","end":"2026-10-25T19:30:00-04:00","allDay":"Night Event","venue":{"name":"Assembly Theatre","address":"1479 Queen St W, Toronto","lat":43.639881,"lng":-79.439392},"free":false,"low":33,"high":null,"pwyc":null,"costNotes":null,"description":"Where Truth is Brought Into the Light, written by Danik McAfee.\n\nOne Muskoka cottage. A yearly tradition of Friendsgiving and a whole lot left unsaid.\n\nBetween the cocktails, questionable decisions, old flames, new lovers, and one increasingly chaotic evening, The Porch is a dark comedy mystery about chosen family and the ridiculous lengths we go to keep the peace.\n\nSet against a celebration built around gratitude, the play asks what happens when the stories holding us together begin to crack.\n\nThrough an Indigenous lens, The Porch draws a parallel between the sanitized history of Thanksgiving and the histories we rewrite within our own families.\n\nBecause eventually, the drinks run out, the party ends and everything buried finds its way into the light.\n\n","categories":["Indigenous","2SLGBTQ+","Theatre","Thanksgiving"],"presenter":"Small but Mighty Productions","image":"eoTSipAJiJbLYcjdSp8Aag","website":"https://SBM-THE-PORCH.eventbrite.ca","tickets":"https://SBM-THE-PORCH.eventbrite.ca"},{"id":"efc14a1e-f849-4697-a5a4-aedf01fa016a","name":"Dinuk Wijeratne and the Canadian Chamber Orchestra","dates":[1793752200000],"start":"2026-11-03T19:30:00-05:00","end":"2026-11-03T19:30:00-05:00","allDay":"Night Event","venue":{"name":"Jane Mallett Theatre, St. Lawrence Centre for the Arts","address":"27 Front St E, Toronto, ON, M5E 1B4","lat":43.647405296,"lng":-79.375214232},"free":false,"low":40,"high":70,"pwyc":null,"costNotes":"\nSubscribe and save up to 40%","description":"Pianist and composer Dinuk Wijeratne joins the Canadian Chamber Orchestra for his electrifying solo piano and string orchestra piece Gajaga Vannama. Inspired by Sri Lankan ritual and the majesty of the elephant, this vibrant East-meets-West score pulses with dance rhythms, jazz inflections, tonal clusters and dazzling colour. \n\nIn works for chamber orchestra by George Walker, Caroline Shaw, and Philip Glass, the CCO traces a compelling musical arc from luminous lyricism to shimmering textures and hypnotic rhythmic drive. \n\n\n“An exhilarating journey into a strange new world of joyous energy.”, says the Winnipeg Free Press.","categories":["Cultural","Live Performances","Music"],"presenter":"Music Toronto","image":"Iz9uALRSI20Uw9dsF5NmTA","website":"https://musictorontoconcerts.com/2026-27-concerts/dinuk-wijeratne-cco","tickets":"https://musictorontoconcerts.com/2026-27-concerts/dinuk-wijeratne-cco"},{"id":"664d9d29-3d2f-45dc-a1c7-d0d44818cc71","name":"Youth Entrepreneurship Program","dates":[1789066800000,1789671600000,1790276400000,1790881200000,1791486000000,1792090800000,1792695600000,1793300400000,1793908800000,1794513600000],"start":"2026-09-10T15:00:00-04:00","end":"2026-11-12T15:00:00-05:00","allDay":"Day Event","venue":{"name":"Heritage Skills Development Centre","address":"2387 Eglinton Ave E, Scarborough, ON, M1K 2M5","lat":43.731392727,"lng":-79.268830069},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Do you have an idea, a passion, or the drive to build or grow your own business? \n\nThe Scarborough Youth Entrepreneurship Project is offering a 10-week in-person training program designed to help you turn your ideas into reality. In this training, you will gain hands-on skills in business development, financial literacy, leadership, and decision-making while connecting with mentors, funding opportunities, and a strong network of entrepreneurs. \n\n\n","categories":["Other"],"presenter":null,"image":"O7jOq6D42lNBBHU9VVcazQ","website":"https://forms.gle/KVzdgApj11XiCWUEA","tickets":null},{"id":"f697b734-765b-400c-a80e-2a075f1e5036","name":"SHADE by Jordan Shaw at Budapest Park","dates":[1787716800000,1787803200000,1787889600000,1787976000000,1788062400000,1788148800000,1788235200000,1788321600000,1788408000000,1788494400000,1788580800000,1788667200000,1788753600000,1788840000000,1788926400000,1789012800000,1789099200000,1789185600000,1789272000000,1789358400000,1789444800000,1789531200000,1789617600000,1789704000000,1789790400000,1789876800000,1789963200000,1790049600000,1790136000000,1790222400000,1790308800000,1790395200000,1790481600000,1790568000000,1790654400000,1790740800000,1790827200000,1790913600000,1791000000000,1791086400000,1791172800000,1791259200000,1791345600000,1791432000000,1791518400000,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000],"start":"2026-08-26T00:00:00-04:00","end":"2026-10-15T00:00:00-04:00","allDay":"Day Event","venue":{"name":"Budapest Park","address":"1575 Lake Shore Blvd W, Toronto, ON, M6R 1B5","lat":43.636828816,"lng":-79.446436254},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"At first, Shade appears as a series of aluminum lattice structures: geometric, quiet, casting patterns across the grass. Spend a few minutes observing and something shifts — the shadows have moved. As you move around the structures, perspectives change. What becomes clear is that the work has two authors — you and the sun. The sun continues its arc regardless, changing the work's shadows and presence throughout the day. Shade is analog interactivity in its most elemental form — a reminder that we move through a world that is constantly changing, independent of us. We bring our presence, our attention, our memory and the world brings everything else.\n\nJordan Shaw is a Toronto-based artist and creative technologist whose practice explores data as material, he works across sculpture, installation, light and textile. His public artworks have been installed at Ontario Place, the City of Pickering and municipalities across Canada. ","categories":["Arts/Exhibits"],"presenter":null,"image":"B4ojJZhax41imauSMd6vvg","website":null,"tickets":null},{"id":"690e450f-8b3f-4e4b-9053-b406cdb1179c","name":"SHADE by Jordan Shaw at Budapest Park","dates":[1787716800000,1787803200000,1787889600000,1787976000000,1788062400000,1788148800000,1788235200000,1788321600000,1788408000000,1788494400000,1788580800000,1788667200000,1788753600000,1788840000000,1788926400000,1789012800000,1789099200000,1789185600000,1789272000000,1789358400000,1789444800000,1789531200000,1789617600000,1789704000000,1789790400000,1789876800000,1789963200000,1790049600000,1790136000000,1790222400000,1790308800000,1790395200000,1790481600000,1790568000000,1790654400000,1790740800000,1790827200000,1790913600000,1791000000000,1791086400000,1791172800000,1791259200000,1791345600000,1791432000000,1791518400000,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000],"start":"2026-08-26T00:00:00-04:00","end":"2026-10-15T00:00:00-04:00","allDay":"Day Event","venue":{"name":"Budapest Park","address":"1575 Lake Shore Blvd W, Toronto, ON, M6R 1B5","lat":43.636828816,"lng":-79.446436254},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"At first, Shade appears as a series of aluminum lattice structures: geometric, quiet, casting patterns across the grass. Spend a few minutes observing and something shifts — the shadows have moved. As you move around the structures, perspectives change. What becomes clear is that the work has two authors — you and the sun. The sun continues its arc regardless, changing the work's shadows and presence throughout the day. Shade is analog interactivity in its most elemental form — a reminder that we move through a world that is constantly changing, independent of us. We bring our presence, our attention, our memory and the world brings everything else.\n\nJordan Shaw is a Toronto-based artist and creative technologist whose practice explores data as material, he works across sculpture, installation, light and textile. His public artworks have been installed at Ontario Place, the City of Pickering and municipalities across Canada. ","categories":["Arts/Exhibits"],"presenter":null,"image":"B4ojJZhax41imauSMd6vvg","website":null,"tickets":null},{"id":"9a80ced8-3332-41c4-a44e-1eb7eb1156e6","name":"SHADE by Jordan Shaw at Budapest Park","dates":[1787716800000,1787803200000,1787889600000,1787976000000,1788062400000,1788148800000,1788235200000,1788321600000,1788408000000,1788494400000,1788580800000,1788667200000,1788753600000,1788840000000,1788926400000,1789012800000,1789099200000,1789185600000,1789272000000,1789358400000,1789444800000,1789531200000,1789617600000,1789704000000,1789790400000,1789876800000,1789963200000,1790049600000,1790136000000,1790222400000,1790308800000,1790395200000,1790481600000,1790568000000,1790654400000,1790740800000,1790827200000,1790913600000,1791000000000,1791086400000,1791172800000,1791259200000,1791345600000,1791432000000,1791518400000,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000],"start":"2026-08-26T00:00:00-04:00","end":"2026-10-15T00:00:00-04:00","allDay":"Day Event","venue":{"name":"Budapest Park","address":"1575 Lake Shore Blvd W, Toronto, ON, M6R 1B5","lat":43.636828816,"lng":-79.446436254},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"At first, Shade appears as a series of aluminum lattice structures: geometric, quiet, casting patterns across the grass. Spend a few minutes observing and something shifts — the shadows have moved. As you move around the structures, perspectives change. What becomes clear is that the work has two authors — you and the sun. The sun continues its arc regardless, changing the work's shadows and presence throughout the day. Shade is analog interactivity in its most elemental form — a reminder that we move through a world that is constantly changing, independent of us. We bring our presence, our attention, our memory and the world brings everything else.\n\nJordan Shaw is a Toronto-based artist and creative technologist whose practice explores data as material, he works across sculpture, installation, light and textile. His public artworks have been installed at Ontario Place, the City of Pickering and municipalities across Canada. ","categories":["Arts/Exhibits"],"presenter":null,"image":"B4ojJZhax41imauSMd6vvg","website":null,"tickets":null},{"id":"83bdc323-d910-48b8-ad56-55ce1fb8dccc","name":"Exhibition: \"Returning to Ourselves and Michael Massie: now and then\"","dates":[1788987600000,1789056000000,1789142400000,1789228800000,1789574400000,1789660800000,1789747200000,1789833600000,1790179200000,1790265600000,1790352000000,1790438400000,1790784000000,1790870400000,1790956800000,1791043200000,1791388800000,1791475200000,1791561600000,1791648000000,1791993600000,1792080000000,1792166400000,1792252800000,1792598400000,1792684800000,1792771200000,1792857600000,1793203200000,1793289600000,1793376000000,1793462400000,1793811600000,1793898000000,1793984400000,1794070800000,1794416400000,1794502800000,1794589200000,1794675600000,1795021200000,1795107600000,1795194000000,1795280400000,1795626000000,1795712400000,1795798800000,1795885200000,1796230800000,1796317200000,1796403600000,1796490000000,1796835600000,1796922000000,1797008400000,1797094800000,1797440400000,1797526800000,1797613200000,1797699600000,1798045200000,1798131600000,1798218000000,1798304400000,1798650000000,1798736400000,1798822800000,1798909200000,1799254800000,1799341200000,1799427600000,1799514000000,1799859600000,1799946000000,1800032400000,1800118800000,1800464400000,1800550800000,1800637200000,1800723600000,1801069200000,1801155600000,1801242000000,1801328400000],"start":"2026-09-09T17:00:00-04:00","end":"2027-01-30T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Onsite Gallery","address":"199 Richmond St W, Toronto, ON, M5V 0H4","lat":43.649477,"lng":-79.388341},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Please join us at the 'Returning to Ourselves - Rebecca Baird and Kenny Alvin Baird: A Retrospective of Art and Design by Cree Métis Siblings'. Curated by Lisa Deanne Smith.\n\nThis exhibit presents over 40 years of transformative work by Rebecca Baird and Kenny Alvin Baird. The exhibition spans sculpture, painting and traditional material practices, alongside interior design and more.\n\n'Michael Massie: now and then' brings together works from across his career, including a large collection of teapots, previously unexhibited pieces and a new body of large-scale sculptural installations, to celebrate the enduring importance of joy, experimentation and humour in his work. Guest-curated by Alysa Procida and enjoy our Special Projects Gallery.","categories":["Arts/Exhibits","Artisan","Cultural"],"presenter":null,"image":null,"website":"https://www.ocadu.ca/events-and-exhibitions/michael-massie-now-and-then","tickets":"https://www.eventbrite.ca/e/opening-reception-returning-to-ourselves-michael-massie-now-and-then-tickets-1997059101532?aff=ebdsoporgprofile"},{"id":"ec5df75f-c935-439b-a9ed-761a0f6d2619","name":"Exhibition: \"Returning to Ourselves and Michael Massie: now and then\"","dates":[1788987600000,1789056000000,1789142400000,1789228800000,1789574400000,1789660800000,1789747200000,1789833600000,1790179200000,1790265600000,1790352000000,1790438400000,1790784000000,1790870400000,17909568000