81636400000,1782241200000,1782846000000,1783450800000,1784055600000,1784660400000,1785265200000,1785870000000,1786474800000,1787079600000,1787684400000,1788289200000,1788894000000,1789498800000,1790103600000,1790708400000,1791313200000,1791918000000,1792522800000,1793127600000],"start":"2026-05-05T15:00:00-04:00","end":"2026-10-27T15:00:00-04:00","allDay":"Day Event","venue":{"name":"Trinity Bellwoods Park","address":"1053 Dundas Street West","lat":43.64976901117809,"lng":-79.41732226545297},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Trinity Bellwoods Farmers' Market is of modest size and nestled in the north-west corner of the largest green space park in the downtown core. 2026 celebrates it’s 20 years of bringing to the neighbourhood fresh, local, sustainably grown agriculture and food artisans that prioritize local ingredients. It is farmer-focused, favours slow food not fast food and eating at the hearth and home. Human food only. Visit website for more info.  The market is operated by the generosity of part-time seasonal community volunteers. ","categories":["Farmers' Market","Other"],"presenter":null,"image":"I3mtanYM-El4GRbb-TAO2A","website":"https://www.tbfm.ca","tickets":null},{"id":"f5f3e03d-2f89-4531-b1f0-5271a93e43dd","name":"Trinity Bellwoods Farmers' Market","dates":[1778007600000,1778612400000,1779217200000,1779822000000,1780426800000,1781031600000,1781636400000,1782241200000,1782846000000,1783450800000,1784055600000,1784660400000,1785265200000,1785870000000,1786474800000,1787079600000,1787684400000,1788289200000,1788894000000,1789498800000,1790103600000,1790708400000,1791313200000,1791918000000,1792522800000,1793127600000],"start":"2026-05-05T15:00:00-04:00","end":"2026-10-27T15:00:00-04:00","allDay":"Day Event","venue":{"name":"Trinity Bellwoods Park","address":"1053 Dundas Street West","lat":43.64976901117809,"lng":-79.41732226545297},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Trinity Bellwoods Farmers' Market is of modest size and nestled in the north-west corner of the largest green space park in the downtown core. 2026 celebrates it’s 20 years of bringing to the neighbourhood fresh, local, sustainably grown agriculture and food artisans that prioritize local ingredients. It is farmer-focused, favours slow food not fast food and eating at the hearth and home. Human food only. Visit website for more info.  The market is operated by the generosity of part-time seasonal community volunteers. ","categories":["Farmers' Market","Other"],"presenter":null,"image":"I3mtanYM-El4GRbb-TAO2A","website":"https://www.tbfm.ca","tickets":null},{"id":"d87e469e-0a44-487c-aba7-8e6682993927","name":"Downsview Park Merchants Market","dates":[1779544800000,1779631200000,1780149600000,1780236000000,1780754400000,1780840800000,1781359200000,1781445600000,1781964000000,1782050400000,1782568800000,1782655200000,1783173600000,1783260000000,1783778400000,1783864800000,1784383200000,1784469600000,1784988000000,1785074400000,1785592800000,1785679200000,1786197600000,1786284000000,1786802400000,1786888800000,1787407200000,1787493600000,1788012000000,1788098400000,1788616800000,1788703200000,1789221600000,1789308000000,1789826400000,1789912800000,1790431200000,1790517600000,1791036000000,1791122400000,1791640800000,1791727200000,1792245600000,1792332000000,1792850400000,1792936800000,1793455200000,1793545200000,1794063600000,1794150000000,1794668400000,1794754800000,1795273200000,1795359600000,1795878000000,1795964400000,1796482800000,1796569200000,1797087600000,1797174000000,1797692400000,1797778800000,1798297200000,1798383600000,1798902000000,1798988400000,1799506800000,1799593200000,1800111600000,1800198000000,1800716400000,1800802800000,1801321200000,1801407600000,1801926000000,1802012400000,1802530800000,1802617200000,1803135600000,1803222000000,1803740400000,1803826800000,1804345200000,1804431600000,1804950000000,1805032800000,1805551200000,1805637600000,1806156000000,1806242400000,1806760800000,1806847200000,1807365600000,1807452000000,1807970400000,1808056800000,1808575200000,1808661600000,1809180000000,1809266400000],"start":"2026-05-23T10:00:00-04:00","end":"2027-05-02T10:00:00-04:00","allDay":"Day Event","venue":{"name":"40 Carl Hall Rd","address":"40 Carl Hall Rd, North York, ON, M3K 2C1","lat":43.7483766822,"lng":-79.4791132214},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Downsview Park Merchants Market is one of Toronto’s vibrant weekend destinations, offering a dynamic indoor marketplace experience for shoppers of all ages. Located in North York, the market features a diverse mix of local vendors offering clothing, accessories, home goods, beauty products, electronics, toys, collectibles, gifts, fresh produce, specialty items, and incredible deals. Visitors can also explore the farmers market section featuring fresh fruits, vegetables, and locally sourced goods, alongside an international food court offering a variety of delicious global cuisines and authentic flavours. With a lively, family-friendly atmosphere, the market is a perfect destination for bargain hunters, families, food lovers, and those looking to support local and small businesses. Open every Saturday and Sunday from 10 AM to 5 PM, Downsview Park Merchants Market combines shopping, food, culture, and community into one exciting weekend experience in Toronto.","categories":["Farmers' Market","Food/Culinary","Other"],"presenter":null,"image":"HsINX9unS5aRBvcRR5D6QA","website":"https://www.dpmarket.com","tickets":null},{"id":"8b8b9e8d-acf1-4059-96a4-0be3e420b1df","name":"Downsview Park Merchants Market","dates":[1779544800000,1779631200000,1780149600000,1780236000000,1780754400000,1780840800000,1781359200000,1781445600000,1781964000000,1782050400000,1782568800000,1782655200000,1783173600000,1783260000000,1783778400000,1783864800000,1784383200000,1784469600000,1784988000000,1785074400000,1785592800000,1785679200000,1786