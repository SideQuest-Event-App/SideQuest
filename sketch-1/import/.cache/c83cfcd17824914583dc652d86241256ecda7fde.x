0:00-05:00","allDay":"Night Event","venue":{"name":"Comedy Bar","address":"945 Bloor Street W, Toronto, ON, M6H 1L5","lat":43.66148,"lng":-79.428242},"free":false,"low":23,"high":null,"pwyc":null,"costNotes":null,"description":"Each month we're partying HARD and bringing the best sketch comedy this city has to offer, from the hottest up and coming troupes to long time fan favourite troupes and solo acts.\n\nGet ready for a wild night of expecting the unexpected and, of course, sketch comedy. Bring your best party trick and enjoy the vibes. There ain't no party like a S-KETCH PARTY!\n\nYou won’t want to miss this monthly shindig, come party-hardy with us!","categories":["Comedy"],"presenter":null,"image":"IoEFS6qmP2peTL7SwyQW_w","website":"https://comedybar.ca/shows/sketch-party","tickets":null},{"id":"e643098f-9a93-4afe-b7ed-5cebf4a49447","name":"The Leslieville Farmers' Market","dates":[1778418000000,1779022800000,1779627600000,1780232400000,1780837200000,1781442000000,1782046800000,1782651600000,1783256400000,1783861200000,1784466000000,1785070800000,1785675600000,1786280400000,1786885200000,1787490000000,1788094800000,1788699600000,1789304400000,1789909200000,1790514000000,1791118800000,1791723600000,1792328400000,1792933200000],"start":"2026-05-10T09:00:00-04:00","end":"2026-10-25T09:00:00-04:00","allDay":"Day Event","venue":{"name":"Greenwood Park","address":"150 Greenwood Ave, Toronto","lat":43.669638096,"lng":-79.328165388},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Each week, the Market brings together local farmers, food producers, artisans, small businesses, live music, and community programming for a lively Sunday gathering in the park.\n\nCome eat, dance, picnic and spend the day in beautiful Greenwood Park while supporting local food systems, small businesses, and community connection in Toronto’s east end! \n\nThe Leslieville Farmers’ Market is a non-profit outdoor farmers’ market held every Sunday in Greenwood Park from May to October. From November to May, the Market moves indoors to the East End Food Hub, with a short winter break in January and February.\n\nSee you Sunday!","categories":["Farmers' Market","Other"],"presenter":null,"image":"CzJE0RU9YcS__qOfyUvUWA","website":"https://www.leslievillemarket.com/","tickets":null},{"id":"e2bf5ab7-9877-4ed7-80f0-2a55dc982e66","name":"Toronto Sunday Market","dates":[1779634800000,1780239600000,1780844400000,1781449200000,1782054000000,1782658800000,1783263600000,1783868400000,1784473200000,1785078000000,1785682800000,1786287600000,1786892400000,1787497200000,1788102000000,1788706800000,1789311600000,1789916400000,1790521200000,1791126000000,1791730800000,1792335600000,1792940400000,1793548800000,1794153600000,1794758400000,1795363200000,1795968000000,1796572800000,1797177600000,1797782400000],"start":"2026-05-24T11:00:00-04:00","end":"2026-12-20T11:00:00-05:00","allDay":"Day Event","venue":{"name":"The Parkdale Hall","address":"1605 Queen St W, Toronto, ON, M6R 1A9","lat":43.638869,"lng":-79.444081},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"A vibrant weekly market celebrating local creators, delicious food & community\nHandmade Goods • Antiques • Vintage • Family-friendly\n\nSupport local. Shop small. Eat fresh.","categories":["Arts/Exhibits","Farmers' Market","Other"],"presenter":null,"image":"BomI95CaiWtmNfhqDjDNLg","website":"https://theparkdalehall.com/new/toronto-sunday-market/","tickets":null},{"id":"b2ace17c-fd27-4836-b374-9d3517a8e712","name":"Toronto Sunday Market","dates":[1779634800000,1780239600000,1780844400000,1781449200000,1782054000000,1782658800000,1783263600000,1783868400000,1784473200000,1785078000000,1785682800000,1786287600000,1786892400000,1787497200000,1788102000000,1788706800000,1789311600000,1789916400000,1790521200000,1791126000000,1791730800000,1792335600000,1792940400000,1793548800000,1794153600000,1794758400000,1795363200000,1795968000000,1796572800000,1797177600000,