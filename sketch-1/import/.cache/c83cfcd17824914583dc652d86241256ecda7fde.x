5600000,1783760400000,1784365200000,1784970000000,1785574800000,1786179600000,1786784400000,1787389200000,1787994000000,1788598800000,1789203600000,1789808400000,1790413200000,1791018000000,1791622800000,1792227600000,1792832400000,1793437200000,1794045600000,1794650400000,1795255200000,1795860000000,1796464800000,1797069600000,1797674400000,1798279200000,1798884000000],"start":"2026-05-23T05:00:00-04:00","end":"2027-01-02T05:00:00-05:00","allDay":"Night Event","venue":{"name":"St. Lawrence North Market","address":"92 Front St E, Toronto","lat":43.649145,"lng":-79.371526},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Visit the Saturday Farmers' Market in the newly redeveloped St. Lawrence Market North building. Discover seasonal produce, baked goods, meats, cheeses, flowers and pantry staples from local vendors all under one roof.","categories":["Food/Culinary"],"presenter":null,"image":"a0PsB9WOlmzpz_7ENsYW_A","website":"https://www.stlawrencemarket.com/","tickets":null},{"id":"4eac8bf1-8f92-4ce4-bf9a-40ef150fb0b2","name":"Saturday Farmers' Market at Evergreen Brick Works","dates":[1777723200000,1778328000000,1778932800000,1779537600000,1780142400000,1780747200000,1781352000000,1781956800000,1782561600000,1783166400000,1783771200000,1784376000000,1784980800000,1785585600000,1786190400000,1786795200000,1787400000000,1788004800000,1788609600000,1789214400000,1789819200000,1790424000000,1791028800000,1791633600000,1792238400000,1792843200000,1793448000000],"start":"2026-05-02T08:00:00-04:00","end":"2026-10-31T08:00:00-04:00","allDay":"Day Event","venue":{"name":"Evergreen Brick Works","address":"550 Bayview Ave, East York, ON, M4W 3X8","lat":43.683783,"lng":-79.365628},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover Toronto’s largest year-round farmers' market. Shop fresh, seasonal produce, artisanal goods and locally prepared foods from Ontario farmers and small businesses.\n\nGrab a coffee, wander through a vibrant market bursting with peak-season flavours and one-of-a-kind finds, and then enjoy a delicious brunch. Held in an open-air pavilion, the market runs rain or shine. Stick around to enjoy a free guided tour of the historic brick factory, take a stroll around the ponds and nearby nature trails or explore the Children's Garden. Getting there is easy with the free shuttle bus picking up next to Broadview Station or take the TTC's 28 bus from Davisville Station.\n\nThe farmers' market is operated by Evergreen, a national non-profit transforming public spaces in our cities to build a healthier future for people and our planet.","categories":["Environmental","Farmers' Market","Food/Culinary"],"presenter":null,"image":"g_7hN7bS9geSUWTPQPVycA","website":"https://www.evergreen.ca/evergreen-brick-work/activities/saturday-farmers-market/","tickets":null},{"id":"d8d0e223-c954-4a7c-92f2-66563a011105","name":"Saturday Farmers' Market at Evergreen Brick Works","dates":[1777723200000,1778328000000,1778932800000,1779537600000,1780142400000,1780747200000,1781352000000,1781956800000,1782561600000,1783166400000,1783771200000,1784376000000,1784980800000,1785585600000,1786190400000,1786795200000,1787400000000,1788004800000,1788609600000,1789214400000,1789819200000,1790424000000,1791028800000,1791633600000,1792238400000,1792843200000,1793448000000],"start":"2026-05-02T08:00:00-04:00","end":"2026-10-31T08:00:00-04:00","allDay":"Day Event","venue":{"name":"Evergreen Brick Works","address":"550 Bayview Ave, East York, ON, M4W 3X8","lat":43.683783,"lng":-79.365628},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover Toronto’s largest year-round farmers' market. Shop fresh, seasonal produce, artisanal goods and locally prepared foods from Ontario farmers and small businesses.\n\nGrab a coffee, wander through a vibrant market bursting with peak-season flavours and one-of-a-kind finds, and then enjoy a delicious brunch. Held in an open-air pavilion, the market runs rain or shine. Stick around to enjoy a free guided tour of the historic brick factory, take a stroll around the ponds and nearby nature trails or explore the Children's Garden. Getting there is easy with the free shuttle bus picking up next to Broadview Station or take the TTC's 28 bus from Davisville Station.\n\nThe farmers' market is operated by Evergreen, a national non-profit transforming public spaces in our cities to build a healthier future for people and our planet.","categories":["Environmental","Farmers' Market","Food/Culinary"],"presenter":null,"image":"g_7hN7bS9geSUWTPQPVycA","website":"https://www.evergreen.ca/evergreen-brick-work/activities/saturday-farmers-market/","tickets":null},{"id":"d0482784-7a98-4094-94c9-dc83c135ec43","name":"People and Places Art Exhibition at Montgomery's Inn","dates":[1788361200000,1788447600000,1788534000000,1788620400000,1788706800000,1788793200000,1788879600000,1788966000000,1789052400000,1789138800000,1789225200000,1789311600000,1789398000000,1789484400000,1789570800000,1789657200000,1789743600000,1789830000000,1789916400000,1790002800000,1790089200000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790607600000,1790694000000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000],"start":"2026-09-02T11:00:00-04:00","end":"2026-10-04T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Montgomery's Inn","address":"4709 Dundas St W, Etobicoke, ON, M9A 1A8","lat":43.651678917,"lng":-79.525658746},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"The York Artists' Guild is a community-based arts group with members from various walks of life. Enjoy their display of art reflecting various styles, techniques and tastes themed around the idea of gathering, people and places. View the art and meet some of the artists during the exhibit launch Saturday September 5th, 1-3pm. ","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":"York Artists' Guild","image":"6lo6jiuT3LdsPXXLZw6ndg","website":"https://www.toronto.ca/montgomerysinn","tickets":null},{"id":"0592a74e-40f8-433d-9947-92f88c13bb5f","name":"The Stop Farmers' Market @ Wychwood Barns Park","dates":[1779537600000,1780142400000,1780747200000,1781352000000,1781956800000,1782561600000,1783166400000,1783771200000,1784376000000,1784980800000,1785585600000,1786190400000,1786795200000,1787400000000,1788004800000,1788609600000,1789214400000,1789819200000,1790424000000,1791028800000,1791633600000,1792238400000,1792843200000,1793448000000,1794056400000,1794661200000,1795266000000,1795870800000,1796475600000,1797080400000,1797685200000],"start":"2026-05-23T08:00:00-04:00","end":"2026-12-19T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Wychwood Barns Park","address":"601 Christie St, Toronto, ON, M6G 4C7","lat":43.679958839,"lng":-79.424094918},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Featuring 35+ weekly vendors, the market brings together local farmers, food producers, and neighbours to increase access to healthy food in ways that build community. A program of The Stop Community Food Centre, the market supports both emerging and established small-scale producers while strengthening a resilient local food economy through responsibly grown and produced food. The market is committed to affordability, supporting racialized vendors, and creating welcoming, community-driven public spaces. Reflecting the diverse cultures of the neighbourhood and the broader GTA, the market celebrates the many food traditions that make Toronto vibrant.\n\nCome visit and support our year-round community market operating every Saturday in the Bathurst–St. Clair neighbourhood.","categories":["Farmers' Market","Other"],"presenter":null,"image":"7WHwqoysoRgdbIoHAZWiAw","website":"https://www.thestop.org/farmersmarket/","tickets":null},{"id":"5c2d0903-13f3-4734-b9fd-70ad92015768","name":"The Stop Farmers' Market @ Wychwood Barns 