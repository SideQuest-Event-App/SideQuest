50400000,1792036800000,1792123200000,1792209600000,1792296000000,1792382400000,1792468800000,1792555200000,1792641600000,1792728000000,1792814400000,1792900800000,1792987200000,1793073600000,1793160000000,1793246400000,1793332800000,1793419200000,1793505600000,1793595600000,1793682000000,1793768400000,1793854800000,1793941200000,1794027600000,1794114000000,1794200400000,1794286800000,1794373200000,1794459600000,1794546000000,1794632400000,1794718800000,1794805200000,1794891600000,1794978000000,1795064400000,1795150800000,1795237200000,1795323600000,1795410000000,1795496400000,1795582800000,1795669200000,1795755600000,1795842000000,1795928400000,1796014800000,1796101200000,1796187600000,1796274000000,1796360400000,1796446800000,1796533200000,1796619600000,1796706000000,1796792400000,1796878800000,1796965200000,1797051600000,1797138000000,1797224400000,1797310800000,1797397200000,1797483600000,1797570000000,1797656400000,1797742800000],"start":"2026-09-15T00:00:00-04:00","end":"2026-12-20T00:00:00-05:00","allDay":"Day Event","venue":{"name":"Toronto (virtual)","address":"","lat":null,"lng":null},"free":false,"low":10,"high":30,"pwyc":null,"costNotes":null,"description":"This international architectural competition invites participants to design a Persian Garden Suite pavilion in Toronto. \n\nThe initiative explores cultural heritage, urban design, and innovative architecture. Detailed competition guidelines, submission criteria and timelines are available for participants.","categories":["Cultural","Other"],"presenter":"Iranian-Canadian Architects and Artists Forum ","image":null,"website":"https://www.icaaf.ca/competition","tickets":"https://www.icaaf.ca/competition"},{"id":"e16e1446-9c03-499e-905e-871cdfb881a0","name":"Toronto International Festival of Authors 2026","dates":[1793212200000,1793298600000,1793385000000,1793455200000,1793547000000],"start":"2026-10-28T14:30:00-04:00","end":"2026-11-01T10:30:00-05:00","allDay":"Day Event","venue":{"name":"Victoria University at the University of Toronto","address":"91 Charles St W, Toronto, ON, M5S 1K5","lat":43.666951,"lng":-79.392113},"free":false,"low":15,"high":159,"pwyc":null,"costNotes":"\n5-Day, 2-Day, and Single Day Passes available. Masterclasses require separate registration. Box office also available on site during Festival hours.","description":"Welcome to Canada’s largest and longest-running literary festival.! \n\nThis fall, TIFA 2026 brings the world’s most compelling writers into conversation with one another and with you. Join us for over 100 events with some of the world’s most beloved authors.\n\nFrom author conversations to electric readings and intimate masterclasses, the Festival is where stories cross borders, ideas find each other, and readers discover that literature is very much alive. \n\nThis year’s guestlist includes Barbara Kingsolver, Dave Eggers, Marie Ndiaye, Ann-Marie MacDonald, Andrew Sean Greer, Patrick deWitt, David Szalay, Vivek Shraya, Canisia Lubrin and Téa Mutonji.","categories":["Literary","Live Performances"],"presenter":null,"image":"xo8dfCMetGe-UyXKAAVoiA","website":"https://festivalofauthors.ca/festival/?utm_source=eventlisting&utm_medium=eventlisting&utm_campaign=fallfestival","tickets":"https://festivalofauthors.ca/festival/?utm_source=eventlisting&utm_medium=eventlisting&utm_campaign=fallfestival"},{"id":"6b0659a7-71ab-42b3-b453-1c186b4fce38","name":"Night Shift","dates":[1792116000000,1792202400000,1792288800000],"start":"2026-10-15T22:00:00-04:00","end":"2026-10-17T22:00:00-04:00","allDay":"Night Event","venue":{"name":"The Citadel: Ross Centre for Dance","address":"304 Parliament St, Toronto, ON, M5A 3A4","lat":43.659033595,"lng":-79.366104722},"free":false,"low":15,"high":null,"pwyc":null,"costNotes":null,"description":"Join us at The Citadel for an immersive experience like no other. Enjoy nine unique performances programmed by curator BaKari IfaSegun Lindsay.\n\nNight Shift is an annual late-night fest that celebrates the many innovative and thought-provoking dance forms explored and practiced by Ontario-based artists.\n\nThis year, we are excited to welcome the following artists:\nTeagan Ariss, Kimia Farokhzad, Jayden Gigliotti, K.H. Kanna, Kemora Manning, Yvonne Ng, Buyi Philip, Takako Segawa, Winterhawk","categories":["Dance","Live Performances"],"presenter":"Citadel + Compagnie","image":"iYEZ53B9VDErVDghllkkZQ","website":"https://www.citadelcie.com/event/night-shift-2026/","tickets":"https://citadelcie.tickit.ca/events/35294"},{"id":"542b1de5-d712-42fa-adca-b9ff7ee28088","name":"Retracing Tatreez: Palestinian Thobes through the Twentieth Century","dates":[1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000,1799254800000,1799341200000,1799427600000,1799514000000,1799600400000,1799859600000,1799946000000,1800032400000,1800118800000,1800205200000,1800464400000,1800550800000,1800637200000,1800723600000,1800810000000,1801069200000,1801155600000,1801242000000,1801328400000,1801414800000,1801674000000,1801760400000,1801846800000,1801933200000,1802019600000],"start":"2026-09-24T12:00:00-04:00","end":"2027-02-07T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":"\nChildren 5 and under visit for free.","description":"Featuring several examples of Palestinian tatreez (embroidery) from the Textile Museum’s collection, most of which will be exhibited for the first time! \n\nRetracing Tatreez highlights what these belongings can tell us about the relationship between Palestinians and their homelands in the twentieth century and beyond.\n\nIn this exhibition, curator Nina Rafique showcases these pieces with restored historical context and invites visitors to re-engage with their ways of storytelling. \n\nIn doing so, Retracing Tatreez highlights what these embroideries can tell us about the unique regional connections between Palestinians and their homelands, as well as the journeys of these objects from the hands of their original creators to today.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"j37-eBOZLJMeQ8B7zUJpJg","website":"https://textilemuseum.ca/event/retracing-tatreez-palestinian-thobes-through-the-20th-century/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"623e0e4e-1bd1-45df-bc36-c614dbda0001","name":"Always In Fashion","dates":[1789574400000,1789660800000,1789747200000,1789833600000,1789920000000,1790179200000,1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000],"start":"2026-09-16T12:00:00-04:00","end":"2027-01-03T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Curated by Amber-Dawn Bear Robe, enjoy an immersive exploration of Indigenous design languages and their transformative impact on the fashion landscape of the lands we call Canada and the United States. \n\nThis exhibition emerges from the urgent need to recognize and celebrate Indigenous designers who are reshaping the industry by reclaiming cultural narratives, innovating with ancestral techniques, and challenging colonial frameworks within fashion. \n\nThrough research on Indigenous fashion history, cultural sustainability, and decolonial design practices, the exhibition highlights how contemporary Indigenous couturiers blend ancestral knowledge with cutting-edge innovation to redefine fashion on their own terms.\n\n","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"azAuMTKhii0Yt5PF3WwMYg","website":"https://textilemuseum.ca/event/always-in-fashion/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"59801b65-b689-47f2-a666-25d04ed4d30c","name":"Always In Fashion","dates":[1789574400000,1789660800