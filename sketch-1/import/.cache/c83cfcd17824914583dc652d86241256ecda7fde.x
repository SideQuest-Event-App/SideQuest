3600000,1793160000000,1793246400000,1793332800000,1793419200000,1793505600000,1793595600000,1793682000000,1793768400000,1793854800000,1793941200000,1794027600000,1794114000000,1794200400000,1794286800000,1794373200000,1794459600000,1794546000000,1794632400000,1794718800000,1794805200000,1794891600000,1794978000000,1795064400000,1795150800000,1795237200000,1795323600000,1795410000000,1795496400000,1795582800000,1795669200000,1795755600000,1795842000000,1795928400000,1796014800000,1796101200000,1796187600000,1796274000000,1796360400000,1796446800000,1796533200000,1796619600000,1796706000000,1796792400000,1796878800000,1796965200000,1797051600000,1797138000000,1797224400000,1797310800000,1797397200000,1797483600000,1797570000000,1797656400000,1797742800000],"start":"2026-09-15T00:00:00-04:00","end":"2026-12-20T00:00:00-05:00","allDay":"Day Event","venue":{"name":"Toronto (virtual)","address":"","lat":null,"lng":null},"free":false,"low":10,"high":30,"pwyc":null,"costNotes":null,"description":"This international architectural competition invites participants to design a Persian Garden Suite pavilion in Toronto. \n\nThe initiative explores cultural heritage, urban design, and innovative architecture. Detailed competition guidelines, submission criteria and timelines are available for participants.","categories":["Cultural","Other"],"presenter":"Iranian-Canadian Architects and Artists Forum ","image":null,"website":"https://www.icaaf.ca/competition","tickets":"https://www.icaaf.ca/competition"},{"id":"7d6e010a-c21b-47e9-a45c-b471ac9256bd","name":"Retracing Tatreez: Palestinian Thobes through the Twentieth Century","dates":[1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000,1799254800000,1799341200000,1799427600000,1799514000000,1799600400000,1799859600000,1799946000000,1800032400000,1800118800000,1800205200000,1800464400000,1800550800000,1800637200000,1800723600000,1800810000000,1801069200000,1801155600000,1801242000000,1801328400000,1801414800000,1801674000000,1801760400000,1801846800000,1801933200000,1802019600000],"start":"2026-09-24T12:00:00-04:00","end":"2027-02-07T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":"\nChildren 5 and under visit for free.","description":"Featuring several examples of Palestinian tatreez (embroidery) from the Textile Museum’s collection, most of which will be exhibited for the first time! \n\nRetracing Tatreez highlights what these belongings can tell us about the relationship between Palestinians and their homelands in the twentieth century and beyond.\n\nIn this exhibition, curator Nina Rafique showcases these pieces with restored historical context and invites visitors to re-engage with their ways of storytelling. \n\nIn doing so, Retracing Tatreez highlights what these embroideries can tell us about the unique regional connections between Palestinians and their homelands, as well as the journeys of these objects from the hands of their original creators to today.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"j37-eBOZLJMeQ8B7zUJpJg","website":"https://textilemuseum.ca/event/retracing-tatreez-palestinian-thobes-through-the-20th-century/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"19ea9373-5466-400d-b687-ce88b0630214","name":"50 Years of Etobicoke Civic Centre Art Gallery Exhibition - 50th Anniversary","dates":[1788264000000,1788350400000,1788436800000,1788523200000,1788616800000,1788782400000,1788868800000,1788955200000,1789041600000,1789128000000,1789221600000,1789387200000,1789473600000,1789560000000,1789646400000,1789732800000,1789826400000,1789992000000,1790078400000,1790164800000,1790251200000,1790337600000,1790431200000,1790596800000,1790683200000,1790769600000,1790856000000,1790942400000,1791036000000,1791201600000,1791288000000,1791374400000,1791460800000,1791547200000,1791640800000,1791806400000,1791892800000,1791979200000,1792065600000,1792152000000,1792245600000,1792411200000,1792497600000,1792584000000,1792670400000,1792756800000,1792850400000,1793016000000,1793102400000,1793188800000,1793275200000,1793361600000,1793455200000,1793624400000,1793710800000,1793797200000,1793883600000,1793970000000,1794063600000,1794229200000,1794315600000,1794402000000,1794488400000,1794574800000,1794668400000,1794834000000,1794920400000,1795006800000,1795093200000,1795179600000,1795273200000,1795438800000,1795525200000,1795611600000,1795698000000,1795784400000,1795878000000,1796043600000,1796130000000,1796216400000,1796302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000],"start":"2026-09-01T08:00:00-04:00","end":"2026-12-15T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Etobicoke Civic Centre Art Gallery","address":"399 The West Mall, Eto