icoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover the history of art at the Etobicoke Civic Centre with artifacts, prints, images and paintings from City of Toronto’s Fine Art, Artifact and Archival collections. Celebrate the present by witnessing a commissioned piece by early career artist Lise Round. Envision the future with new designs of the updated Etobicoke Civic Centre Art Gallery.","categories":["Arts/Exhibits"],"presenter":null,"image":"A6-VIKDNvgJfy1_SuU-UqA","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/?WT.rd_id=%2Feccartgallery","tickets":null},{"id":"0fbf7a0d-466b-484b-a649-0f2ff6e5e90c","name":"Branford Marsalis Quartet and Dianne Reeves","dates":[1801962000000],"start":"2027-02-06T20:00:00-05:00","end":"2027-02-06T20:00:00-05:00","allDay":"Night Event","venue":{"name":"Koerner Hall","address":"273 Bloor St W, Toronto, ON, M5S 1W2","lat":43.667856304,"lng":-79.396058814},"free":false,"low":75,"high":140,"pwyc":null,"costNotes":null,"description":"Two jazz titans join forces to pay tribute to the legendary 1963 collaboration between John Coltrane and Johnny Hartman. \n\nAfter the concert, enjoy a beverage and more music at the Postlude Performance in the Leslie and Anna Dan Galleria.\n","categories":["Live Performances","Music"],"presenter":null,"image":"CK553sWQDkkxqsMHnwpU_Q","website":"https://www.rcmusic.com/concert/branford-marsalis-and-dianne-reeves","tickets":"https://www.rcmusic.com/tickets/seats/430402"},{"id":"bce48143-1841-4e76-9e6d-43f7fefbc4bc","name":"Grand Soft Day","dates":[1808577000000,1808591400000,1808672400000,1808679600000,1809181800000,1809196200000,1809268200000,1809282600000],"start":"2027-04-24T10:30:00-04:00","end":"2027-05-02T14:30:00-04:00","allDay":"Day Event","venue":{"name":"Young People's Theatre","address":"165 Front St E, Toronto, ON, M5A 3Z4","lat":43.6499984416,"lng":-79.3687420725},"free":false,"low":27,"high":33,"pwyc":null,"costNotes":null,"description":"Splash in puddles, wind whipping your hair and the satisfying crunch of frost underfoot. Now that sounds like a perfect day for play! \n\nThis charming production invites children to step into the wilderness and experience the joy of adapting to whatever the sky brings.\n\nThe story is mostly non-verbal, unfolding through live music, physical storytelling, and a sprinkle of English, Irish, and Italian words. Co-created by the award-winning teams of Branar (Ireland) and NIE (UK/Norway), this sensory-filled performance shows that mustering the bravery to face the unexpected is what makes every day an adventure.\n","categories":["Family/Children","Live Performances"],"presenter":null,"image":"WMRwMsEXupzeYf4mjPBcCg","website":"https://www.youngpeoplestheatre.org/shows-tickets/grand-soft-day/","tickets":"https://www.youngpeoplestheatre.org/shows-tickets/grand-soft-day/"},{"id":"cccd9e2d-33aa-4f4d-95d5-a40a07155aa0","name":"50 Years of Etobicoke Civic Centre Art Gallery Exhibition - 50th Anniversary","dates":[1788264000000,1788350400000,1788436800000,1788523200000,1788616800000,1788782400000,1788868800000,1788955200000,1789041600000,1789128000000,1789221600000,1789387200000,1789473600000,1789560000000,1789646400000,1789732800000,1789826400000,1789992000000,1790078400000,1790164800000,1790251200000,1790337600000,1790431200000,1790596800000,1790683200000,1790769600000,1790856000000,1790942400000,1791036000000,1791201600000,1791288000000,1791374400000,1791460800000,1791547200000,1791640800000,1791806400000,1791892800000,1791979200000,1792065600000,1792152000000,1792245600000,1792411200000,1792497600000,1792584000000,1792670400000,1792756800000,1792850400000,1793016000000,1793102400000,1793188800000,1793275200000,1793361600000,1793455200000,1793624400000,1793710800000,1793797200000,1793883600000,1793970000000,1794063600000,1794229200000,1794315600000,179