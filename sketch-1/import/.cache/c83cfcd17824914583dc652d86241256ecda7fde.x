00000,1789304400000,1789390800000,1789477200000,1789563600000,1789650000000,1789736400000,1789822800000,1789909200000,1789995600000,1790082000000,1790168400000,1790254800000,1790341200000,1790427600000,1790514000000,1790600400000,1790686800000,1790773200000,1790859600000,1790946000000,1791032400000,1791118800000,1791205200000,1791291600000,1791378000000,1791464400000,1791550800000,1791637200000,1791723600000,1791810000000,1791896400000,1791982800000,1792069200000,1792155600000,1792242000000,1792328400000,1792414800000,1792501200000,1792587600000,1792674000000,1792760400000,1792846800000,1792933200000,1793019600000,1793106000000,1793192400000,1793278800000,1793365200000,1793451600000,1793541600000,1793628000000,1793714400000,1793800800000,1793887200000,1793973600000,1794060000000,1794146400000,1794232800000,1794319200000,1794405600000,1794492000000],"start":"2026-08-28T09:00:00-04:00","end":"2026-11-12T09:00:00-05:00","allDay":"Day Event","venue":{"name":"Clark Centre for the Arts","address":"191 Guildwood Pkwy, Scarborough, ON, M1E 1P5","lat":43.746893127,"lng":-79.193688812},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Delight in Paula Hartmann's Dancing Blossoms, a kinetic installation composed of dozens of delicate paper mobiles suspended in air, evoking the quiet poetry of spring trees swaying in the wind. Crafted from featherlight paper and fine wire, each mobile captures a fleeting moment of bloom, movement, and renewal.\n\nAbout the Artist\nPaula Hartmann is a Canadian visual artist whose joyful, kinetic sculptures transform humble materials into poetic, suspended worlds. Based in Toronto and originally from Germany, she draws on cultural traditions, folk aesthetics, and contemporary design to create works that explore impermanence, transformation, and belonging. Often incorporating paper, wire, and natural elements, her mobiles and installations invite viewers into moments of play, presence, and quiet wonder. Her installations have been featured in major public art events, including Toronto’s Nuit\nBlanche, the Burlington Waterfront Sculpture Trail, and City of Craft Toronto.","categories":["Arts/Exhibits","Cultural"],"presenter":null,"image":"6w2zOg_MReBeep-DtTCBng","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/clark-centre-for-the-arts/","tickets":null},{"id":"be9bdf10-e9ad-4faa-b352-ce2af25dbd6e","name":"Dancing Blossoms Installation","dates":[1787922000000,1788008400000,1788094800000,1788181200000,1788267600000,1788354000000,1788440400000,1788526800000,1788613200000,1788699600000,1788786000000,1788872400000,1788958800000,1789045200000,1789131600000,1789218000000,1789304400000,1789390800000,1789477200000,1789563600000,1789650000000,1789736400000,1789822800000,1789909200000,1789995600000,1790082000000,1790168400000,1790254800000,1790341200000,1790427600000,1790514000000,1790600400000,1790686800000,1790773200000,1790859600000,1790946000000,1791032400000,1791118800000,1791205200000,1791291600000,1791378000000,1791464400000,1791550800000,1791637200000,1791723600000,1791810000000,1791896400000,1791982800000,1792069200000,1792155600000,1792242000000,1792328400000,1792414800000,1792501200000,1792587600000,1792674000000,1792760400000,1792846800000,1792933200000,1793019600000,1793106000000,1793192400000,1793278800000,1793365200000,1793451600000,1793541600000,1793628000000,1793714400000,1793800800000,1793887200000,1793973600000,1794060000000,1794146400000,1794232800000,1794319200000,1794405600000,1794492000000],"start":"2026-08-28T09:00:00-04:00","end":"2026-11-12T09:00:00-05:00","allDay":"Day Event","venue":{"name":"Clark Centre for the Arts","address":"191 Guildwood Pkwy, Scarborough, ON, M1E 1P5","lat":43.746893127,"lng":-79.193688812},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Delight in Paula Hartmann's Dancing Blossoms, a kinetic installation composed of dozens of delicate paper mobiles suspended in air, evoking the quiet poetry of spring trees swaying in the wind. Crafted from featherlight paper and fine wire, each mobile captures a fleeting moment of bloom, movement, and renewal.\n\nAbout the Artist\nPaula Hartmann is a Canadian visual artist whose joyful, kinetic sculptures transform humble materials into poetic, suspended worlds. Based in Toronto and originally from Germany, she draws on cultural traditions, folk aesthetics, and contemporary design to create works that explore impermanence, transformation, and belonging. Often incorporating paper, wire, and natural elements, her mobiles and installations invite viewers into moments of play, presence, and quiet wonder. Her installations have been featured in major public art events, including Toronto’s Nuit\nBlanche, the Burlington Waterfront Sculpture Trail, and City of Craft Toronto.","categories":["Arts/Exhibits","Cultural"],"presenter":null,"image":"6w2zOg_MReBeep-DtTCBng","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/clark-centre-for-the-arts/","tickets":null},{"id":"b310eb46-0d5e-4d1c-9072-e58743a4f139","name":"Dancing Blossoms Installation","dates":[1787922000000,1788008400000,1788094800000,1788181200000,1788267600000,1788354000000,1788440400000,1788526800000,1788613200000,1788699600000,1788786000000,1788872400000,1788958800000,1789045200000,1789131600000,1789218000000,1789304400000,1789390800000,1789477200000,1789563600000,1789650000000,1789736400000,1789822800000,1789909200000,1789995600000,1790082000000,1790168400000,1790254800000,1790341200000,1790427600000,1790514000000,1790600400000,1790686800000,1790773200000,1790859600000,1790946000000,1791032400000,1791118800000,1791205200000,1791291600000,1791378000000,1791464400000,1791550800000,1791637200000,1791723600000,1791810000000,1791896400000,1791982800000,1792069200000,1792155600000,1792242000000,1792328400000,1792414800000,1792501200000,1792587600000,1792674000000,1792760400000,1792846800000,1792933200