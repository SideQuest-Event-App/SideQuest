000,1777215600000,1777820400000,1778425200000,1779030000000,1779634800000,1780239600000,1780844400000,1781449200000,1782054000000,1782658800000,1783263600000,1783868400000,1784473200000,1785078000000,1785682800000,1786287600000,1786892400000,1787497200000,1788102000000,1788706800000,1789311600000,1789916400000,1790521200000,1791126000000,1791730800000,1792335600000,1792940400000,1793548800000,1794153600000,1794758400000,1795363200000,1795968000000,1796572800000,1797177600000,1797782400000],"start":"2026-02-08T11:00:00-05:00","end":"2026-12-20T11:00:00-05:00","allDay":"Day Event","venue":{"name":"The Parkdale Hall","address":"1605 Queen St W, Toronto, ON, M6R 1A9","lat":43.638869,"lng":-79.444081},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrating local food, antiques, handmade goods and community.\n\n\n","categories":["Arts/Exhibits","Artisan","Consumer Show/Convention"],"presenter":null,"image":"ozk451_PfWrf5ssZGWAwoQ","website":"https://theparkdalehall.com/new/toronto-sunday-market/","tickets":"https://www.eventbrite.com/e/toronto-sunday-market-at-parkdale-hall-tickets-1981191495094"},{"id":"e3cfeb12-00b0-4491-bd4d-6bfb99d9d986","name":"A Christmas Carol","dates":[1794528000000,1794616200000,1794702600000,1794789000000,1794961800000,1795048200000,1795134600000,1795221000000,1795307400000,1795393800000,1795566600000,1795653000000,1795739400000,1795825800000,1795912200000,1795998600000,1796171400000,1796257800000,1796344200000,1796430600000,1796517000000,1796603400000,1796776200000,1796862600000,1796949000000,1797035400000,1797121800000,1797208200000,1797381000000,1797467400000,1797553800000,1797640200000,1797726600000,1797813000000,1797985800000,1798072200000],"start":"2026-11-12T19:00:00-05:00","end":"2026-12-23T19:30:00-05:00","allDay":"Night Event","venue":{"name":"The Fleck at Harbourfront Centre Theatre","address":"231 Queens Quay W, Toronto, ON, M5J 2G8","lat":43.63867054,"lng":-79.382157854},"free":false,"low":50,"high":140,"pwyc":null,"costNotes":null,"description":"Dickens’s timeless holiday story of transformation, kindness and human connection.\n\nThis fresh adaptation by Tim Carroll brings Charles Dickens’s world to life through inventive puppetry, towering ghosts that fill the stage, traditional carols and audience participation with spirited sing-alongs. Interactive performers mingle throughout the theatre, while beautifully detailed period costumes and sets create an atmospheric Victorian Christmas.\n\nMore than 175 years after Dickens first published A Christmas Carol, audiences still recognize themselves in Ebenezer Scrooge: someone who discovers that it’s never too late in life to choose kindness and human connection. For centuries, this iconic story has endured because its themes are still relevant today: What really matters to us? And can people truly change?\n","categories":["Literary","Live Performances","Theatre"],"presenter":null,"image":"LEdIigpmjGIgT9QepzspLw","website":"https://harbourfrontcentre.com/event/a-christmas-carol/","tickets":"https://ci.ovationtix.com/36999/production/1283036"},{"id":"c1757160-86a1-433a-8761-dc637fa2cbab","name":"A Christmas Carol","dates":[1794528000000,1794616200000,1794702600000,1794789000000,1794961800000,1795048200000,1795134600000,1795221000000,1795307400000,1795393800000,1795566600000,1795653000000,1795739400000,1795825800000,1795912200000,1795998600000,1796171400000,1796257800000,1796344200000,1796430600000,1796517000000,1796603400000,1796776200000,1796862600000,1796949000000,1797035400000,1797121800000,1797208200000,1797381000000,1797467400000,1797553800000,1797640200000,1797726600000,1797813000000,1797985800000,1798072200000],"start":"2026-11-12T19:00:00-05:00","end":"2026-12-23T19:30:00-05:00","allDay":"Night Event","venue":{"name":"The Fleck at Harbourfront Centre Theatre","address":"231 Queens Quay W, Toronto, ON, M5J 2G8","lat":43.63867054,"lng":-79.382157854},"free":false,"low":50,"high":140,"pwyc":null,"costNotes":null,"description":"Dickens’s timeless holiday story of transformation, kindness and human connection.\n\nThis fresh adaptation by Tim Carroll brings Charles Dickens’s world to life through inventive puppetry, towering ghosts that fill the stage, traditional carols and audience participation with spirited sing-alongs. Interactive performers mingle throughout the theatre, while beautifully detailed period costumes and sets create an atmospheric Victorian Christmas.\n\nMore than 175 years after Dickens first published A Christmas Carol, audiences still recognize themselves in Ebenezer Scrooge: someone who discovers that it’s never too late in life to choose kindness and human connection. For centuries, this iconic story has endured because its themes are still relevant today: What really matters to us? And can people truly change?\n","categories":["Literary","Live Performances","Theatre"],"presenter":null,"image":"LEdIigpmjGIgT9QepzspLw","website":"https://harbourfrontcentre.com/event/a-christmas-carol/","tickets":"https://ci.ovationtix.com/36999/production/1283036"},{"id":"40dc890c-8b5b-4a17-86b3-62974455b261","name":"In Broken Light Exhibition at Spadina Museum","dates":[1787756400000,1787842800000,1787929200000,1788015600000,1788102000000,1788361200000,1788447600000,1788534000000,1788620400000,1788706800000,1788966000000,1789052400000,1789138800000,1789225200000,1789311600000,1789570800000,1789657200000,1789743600000,1789830000000,1789916400000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000,1791385200000,1791471600000,1791558000000,1791644400000,1791730800000,1791990000000,1792076400000,1792162800000,1792249200000,1792335600000],"start":"2026-08-26T11:00:00-04:00","end":"2026-10-18T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Spadina Museum","address":"285 Spadina Rd, Toronto, ON, M5R 2V5","lat":43.679046946,"lng":-79.408181452},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":"Visit the reception desk to register. Tickets are first-come first-serve and subject to capacity.","description":"See a contemporary art exhibition of five sculptural interventions located throughout the historic Spadina Museum, created by artist Ry Van Der Hout and curated by Adrien Sun Hall. Working with photography, stained glass, mirrors, and acts of rupture and repair, Van Der Hout reveals the emotional residue held within objects, architecture and stories. Cracks and fractures become apertures through which forgotten stories emerge, the artworks functioning as contemporary reliquaries for lives remembered and overlooked.\n\nMoving between deep histories, the present day and an imagined future, this exhibition traces connections across time, where fragments persist, reflections multiply, and the boundaries between past, present and future remain open.","categories":["Arts/Exhibits","History","Museum"],"presenter":null,"image":"caTKB0eJSOICT9G9ZdiXWw","website":"https://toronto.ca/spadina","tickets":null},{"id":"66b04709-3caa-44d2-bc0e-2993569ed6d0","name":"A Christmas Carol","dates":[1794528000000,1794616200000,1794702600000,1794789000000,1794961800000,1795048200000,1795134600000,1795221000000,1795307400000,1795393800000,1795566600000,1795653000000,1795739400000,1795825800000,1795912200000,1795998600000,1796171400000,1796257800000,1796344200000,1796430600000,1796517000000,1796603400000,1796776200000,1796862600000,1796949000000,1797035400000,1797121800000,1797208200000,1797381000000,1797467400000,1797553800000,1797640200000,1797726600000,1797813000000,1797985800000,1798072200000],"start":"2026-11-12T19:00:00-05:00","end":"2026-12-23T19:30:00-05:00","allDay":"Night Event","venue":{"name":"The Fleck at Harbourfront Centre Theatre","address":"231 Queens Quay W, Toronto, ON, M5J 2G8","lat":43.63867054,"lng":-79.382157854},"free":false,"low":50,"high":140,"pwyc":null,"costNotes":null,"description":"Dickens’s timeless holiday story of transformat