96302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000],"start":"2026-09-01T08:00:00-04:00","end":"2026-12-15T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Etobicoke Civic Centre Art Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover the history of art at the Etobicoke Civic Centre with artifacts, prints, images and paintings from City of Toronto’s Fine Art, Artifact and Archival collections. Celebrate the present by witnessing a commissioned piece by early career artist Lise Round. Envision the future with new designs of the updated Etobicoke Civic Centre Art Gallery.","categories":["Arts/Exhibits"],"presenter":null,"image":"A6-VIKDNvgJfy1_SuU-UqA","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/?WT.rd_id=%2Feccartgallery","tickets":null},{"id":"78f3b533-d79f-4efd-8108-0f6a068fba09","name":"Lassonde Art Trail: Art + Nature Tour","dates":[1789228800000,1789833600000,1790438400000,1791043200000,1791648000000,1792252800000,1792857600000,1793462400000,1794070800000,1794675600000],"start":"2026-09-12T12:00:00-04:00","end":"2026-11-14T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Biidaasige Park ","address":"51 Commissioners St, Toronto, ON, M5A 1A6","lat":43.646495807,"lng":-79.348925214},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join LAT every Saturday at 12 pm or 2 pm for a drop-in Art + Nature tour led by a LAT Art Guide. These walking tours invite participants to explore the artworks along the Lassonde Art Trail while discovering the rich history, ecology, and ongoing transformation of Biidaasige Park.\n\n12 pm - Art + Nature Tour (30 minutes, slow paced)\n2 pm - Art + Nature Tour (1 hour)\nMeet in front of Old Fire Hall 30. All tours are drop-in and free to attend. Please be aware that the trees in the park system are not yet mature, so there is little shade. We recommend dressing according to the weather. Tours are subject to cancellation in the event of adverse weather. Please see Lassonde Art Trail website for further details.","categories":["Arts/Exhibits","Environmental","Tour"],"presenter":null,"image":"Xy_GPUCC1IStLKdFhFwxCg","website":"https://lassondearttrail.org/art-trail/","tickets":null},{"id":"ca09e972-7b36-44c2-b7cd-3c2fb477c589","name":"Lassonde Art Trail: Art + Nature Tour","dates":[1789228800000,1789833600000,1790438400000,1791043200000,1791648000000,1792252800000,1792857600000,1793462400000,1794070800000,1794675600000],"start":"2026-09-12T12:00:00-04:00","end":"2026-11-14T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Biidaasige Park ","address":"51 Commissioners St, Toronto, ON, M5A 1A6","lat":43.646495807,"lng":-79.348925214},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join LAT every Saturday at 12 pm or 2 pm for a drop-in Art + Nature tour led by a LAT Art Guide. These walking tours invite participants to explore the artworks along the Lassonde Art Trail while discovering the rich history, ecology, and ongoing transformation of Biidaasige Park.\n\n12 pm - Art + Nature Tour (30 minutes, slow paced)\n2 pm - Art + Nature Tour (1 hour)\nMeet in front of Old Fire Hall 30. All tours are drop-in and free to attend. Please be aware that the trees in the park system are not yet mature, so there is little shade. We recommend dressing according to the weather. Tours are subject to cancellation in the event of adverse weather. Please see Lassonde Art Trail website for further details.","categories":["Arts/Exhibits","Environmental","Tour"],"presenter":null,"image":"Xy_GPUCC1IStLKdFhFwxCg","website":"https://lassondearttrail.org/art-trail/","tickets":null},{"id":"eec37856-fc2a-444c-bb21-b74e2e40f16f","name":"Scarborough Village Community Centre - 2:30 to 4:30 p.m.","dates":[1791052200000],"start":"2026-10-03T14:30:00-04:00","end":"2026-10-03T14:30:00-04:00","allDay":"Day Event","venue":{"name":"Scarborough Village Community Centre","address":"3600 Kingston Rd, Scarborough, ON, M1M 1R9","lat":43.739991316,"lng":-79.216758124},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Play Mobile is a free touring sports program for all ages and skill levels, no registration or reservations are required to participate. The new soccer Play Mobile is dedicated to the world’s most popular game. All ages are invited to learn and celebrate soccer in a fun, supportive environment with no experience required.","categories":["Sports"],"presenter":null,"image":"D-JBEvzzMMBRxdflGESP0g","website":"https://www.toronto.ca/explore-enjoy/parks-recreation/places-spaces/parks-and-recreation-facilities/location/?id=633","tickets":null},{"id":"8ffcea97-fa35-4fb4-8391-3d27b965e83c","name":"Art for Alzheimer’s","dates":[1793894400000,1793980800000,1794067200000,1794153600000,1794412800000,1794499200000,1794585600000,1794672000000,1794758400000,1795017600000,1795104000000,1795190400000,1795276800000,1795363200000,1795622400000,1795708800000,1795795200000,1795881600000,1795968000000],"start":"2026-11-05T11:00:00-05:00","end":"2026-11-29T11:00:00-05:00","allDay":"Day Event","venue":{"name":"Todmorden Mills Heritage Site","address":"67 Pottery Rd, East York, ON, M4K 2B9","lat":43.686361,"lng":-79.360334},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Art for Alzheimer’s brings together an exceptional collection of original artwork by Canadian illustrator Doug Martin in support of the Alzheimer Society. \n\nSpanning 40 years of his career, the exhibition showcases original and commissioned works, offering guests the opportunity to discover, appreciate, and purchase one-of-a-kind artwork while supporting an important cause.\n\nAll proceeds will go to support Alzheimer's Society of York Region.\n","categories":["Arts/Exhibits","Charity/Cause"],"presenter":"Wherry and Associates Private Wealth Management","image":"rpynIin-O7Wi-LCJZ7z-Rg","website":"https://www.wherryandassociates.ca/events-and-seminars","tickets":null},{"id":"ce2f4146-89ea-4f9d-9b1c-ab0577b5ef82","name":"Humber Bay Shores Park- 2:30 p.m. to 4:30 p.m.","dates":[1791052200000],"start":"2026-10-03T14:30:00-04:00","end":"2026-10-03T14:30:00-04:00","allDay":"Day Event","venue":{"name":"Humber Bay Shores Park","address":"15 Marine Parade Dr, Etobicoke","lat":43.628986153,"lng":-79.475496342},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Try something new, get moving and connect through sport, Play Mobile is a free touring sports program for all ages and skill levels.\n\nWith a variety of sports equipment on board, vibrant vans tour neighbourhoods, transforming parks and outdoor spaces into pop-up sport hubs, bringing energy and excitement directly to communities around the city. Proudly powered in partnership with Nike, Play Mobile is committed to the future of youth sport, creating more equitable and inclusive access to play – with a focus on encouraging girls to participate and stay involved in sport.","categories":["Sports"],"presenter":null,"image":"JY5NZWRAS6Lt1TXJKw_GWw","website":"https://www.toronto.ca/explore-enjoy/parks-recreation/places-spaces/parks-and-recreation-facilities/parks-and-community-recreation-centres-map/#location=140%20Stilecroft%20Dr&lat=43.746886&lng=-79.498855&zoom=17","tickets":null},{"id":"9beba36f-93b4-4ffd-8890-54e652f92b58","name":"Places That Stayed: Youth Photography Exhibit","dates":[1792123200000,1792209600000,1792296000000,1792382400000,1792468800000,1792555200000,1792641600000,1792728000000,1792814400000,1792900800000,1792987200000,1793073600000,1793160000000,1793246400000,1793332800000,1793419200000,1793505600000,1793595600000,1793682000000,1793768400000,1793854800000,1793941200000,1794027600000,1794114000000,1794200400000,1794286800000,1794373200000,1794459600000,1794546000000,1794632400000,1794718800000,1794805200000,1794891600000,1794978000000,1795064400000,1795150800000,1795237200000,1795323600000,1795410000000,1795496400000,1795582800000,1795669200000,1795755600000,1795842000000,1795928400000,1796014800000],"start":"2026-10-16T00:00:00-04:00","end":"2026-11-30T00:00:00-05:00","allDay":"Day Event","venue":{"name":"East Scarborough Storefront","address":"4040 Lawrence Ave E, Scarborough, ON, M1E 2R2","lat":43.766003524,"lng":-79.199011833},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover Kingston-Galloway-Orton Park (KGO) through the eyes of local youth in this outdoor photography exhibit. Created as part of a youth placemaking and photography project, the exhibit features photographs documenting the places and spaces that make the neighbourhood unique, from familiar gathering spots and busy streets to quiet corners, overlooked landscapes, parks, and community spaces. Installed along the community garden fence at East Scarborough Storefront, the exhibit invites visitors to explore the neighbourhood through the perspectives of local youth and reflect on the places that shape community life.\n\nA City of Toronto Cultural Hotspot SPARK Project.\n","categories":["Arts/Exhibits","Cultural","Family/Children"],"presenter":"itsneerby","image":"6qUPh0-04BnPvAhTFhcOaA","website":"https://www.itsneerby.ca/","tickets":null},{"id":"46c45bad-c1a9-4318-8f6a-145ba839ad45","name":"Places That Stayed: Youth Photography Exhibit","dates":[1792123200000,1792209600000,1792296000000,1792382400000,1792468800000,1792555200000,1792641600000,1792728000000,1792814400000,1792900800000,1792987200000,1793073600000,1793160000000,1793246400000,1793332800000,1793419200000,1793505600000,1793595600000,1793682000000,1793768400000,1793854800000,1793941200000,1794027600000,1794114000000,1794200400000,1794286800000,1794373200000,1794459600000,1794546000000,1794632400000,1794718800000,1794805200000,1794891600000,1794978000000,1795064400000,1795150800000,1795237200000,1795323600000,1795410000000,1795496400000,1795582800000,1795669200000,1795755600000,1795842000000,1795928400000,1796014800000],"start":"2026-10-16T00:00:00-04:00","end":"2026-11-30T00:00:00-05:00","allDay":"Day Event","venue":{"name":"East Scarborough Storefront","address":"4040 Lawrence Ave E, Scarborough, ON, M1E 2R2","lat":43.766003524,"lng":-79.199011833},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover Kingston-Galloway-Orton Park (KGO) through the eyes of local youth in this outdoor photography exhibit. Created as part of a youth placemaking and photography project, the exhibit features photographs documenting the places and spaces that make the neighbourhood unique, from familiar gathering spots and busy streets to quiet corners, overlooked landscapes, parks, and community spaces. Installed along the community garden fence at East Scarborough Storefront, the exhibit invites visitors to explore the neighbourhood through the perspectives of local youth and reflect on the places that shape community life.\n\nA City of Toronto Cultural Hotspot SPARK Project.\n","categories":["Arts/Exhibits","Cultural","Family/Children"],"presenter":"itsneerby","image":"6qUPh0-04BnPvAhTFhcOaA","website":"https://www.itsneerby.ca/","tickets":null},{"id":"da6cc5f8-8e20-41f2-abfd-76d3477fccec","name":"Lantern Tours at Montgomery's Inn: Beyond Mourning","dates":[1792879200000,1792886400000,1792965600000,1792972800000,1793311200000,1793318400000,1793397600000,1793404800000],"start":"2026-10-24T18:00:00-04:00","end":"2026-10-30T20:00:00-04:00","allDay":"Night Event","venue":{"name":"Montgomery's Inn","address":"4709 Dundas St W, Etobicoke, ON, M9A 1A8","lat":43.651679,"lng":-79.525659},"free":false,"low":22,"high":null,"pwyc":null,"costNotes":null,"description":"This Halloween, uncover eerie tales about the past inhabitants of the Inn and the Old Town of Islington. Journey from the dimly lit historic house to the Islington burial ground, learn about Victorian death practices, and hear new stories connecting to Toronto’s past. \n\nContent warning: Topics include illness, death and related subjects.\nRecommended for ages 14 and up. Anyone under 17 must be accompanied by an adult.\n\n","categories":["History","Museum","Tour","Halloween"],"presenter":null,"image":"OGMQ_a1JowZ9TDZayyn_6Q","website":"https://www.toronto.ca/montgomerysinn","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/aae32edb-e8f5-4760-b053-81cb44cc2186"},{"id":"80a9d969-2ecc-424d-afb8-212ed96f4ae0","name":"MULTIfest Interactive Art festival","dates":[1790888400000,1790974800000,1791061200000,1791147600000,1791234000000,1791320400000,1791406800000,1791493200000],"start":"2026-10-01T17:00:00-04:00","end":"2026-10-08T17:00:00-04:00","allDay":"Day Event","venue":{"name":"Stackt Market","address":"28 Bathurst St, Toronto, ON, M5V 0R4","lat":43.640948,"lng":-79.402169},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Toronto’s new festival of interactive and digital art, returns to STACKT Market!\n\nWe're bringing together interactive art installations, audiovisual performances and beginner-friendly workshops, alongside artist talks, family programming and community events.\n\nExplore immersive digital artworks, interact with responsive installations, experience live audiovisual performances, and get hands-on with creative technology through workshops in electronic music making, projection mapping and more.\n\nTogether with Nuit Blanche, enjoy an afternoon Show and Tell and immersive round table, followed by an Immersive Happy Hour with DJs, live visuals and interactive art.\n","categories":["Arts/Exhibits","Live Performances","Music"],"presenter":null,"image":"KoSi1GfJkywyaekelu014A","website":"https://multi-fest.ca/","tickets":null},{"id":"879e8a90-c321-4978-8734-a8dd7a4adca2","name":"Fall Flavours &  Crafts at Scarborough Museum","dates":[1791039600000,1791126000000,1791644400000,1791730800000,1792249200000,1792335600000,1792854000000,1792940400000,1793458800000],"start":"2026-10-03T11:00:00-04:00","end":"2026-10-31T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Scarborough Museum","address":"1007 Brimley Rd, Scarborough, ON, M1P 3E8","lat":43.757624474,"lng":-79.254809969},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy fall-themed fun at Scarborough Museum throughout October weekends. Sip a warm drink from the museum kitchen and savour a treat prepared on the historic stove. Spark creativity with family-friendly paper crafts, a scavenger hunt, and seasonal activities designed for all ages.\n\nAll ages. Drop-In. FREE. All are welcome. ","categories":["Family/Children","History","Museum"],"presenter":"Toronto History Museums","image":"BA9dThVY5VHcVGOcWEUaCw","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/scarborough-museum/","tickets":null},{"id":"9c0c33e4-438c-454e-b2af-9845d175f888","name":"Fall Flavours &  Crafts at Scarborough Museum","dates":[1791039600000,1791126000000,1791644400000,1791730800000,1792249200000,1792335600000,1792854000000,1792940400000,1793458800000],"start":"2026-10-03T11:00:00-04:00","end":"2026-10-31T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Scarborough Museum","address":"1007 Brimley Rd, Scarborough, ON, M1P 3E8","lat":43.757624474,"lng":-79.254809969},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy fall-themed fun at Scarborough Museum throughout October weekends. Sip a warm drink from the museum kitchen and savour a treat prepared on the historic stove. Spark creativity with family-friendly paper crafts, a scavenger hunt, and seasonal activities designed for all ages.\n\nAll ages. Drop-In. FREE. All are welcome. ","categories":["Family/Children","History","Museum"],"presenter":"Toronto History Museums","image":"BA9dThVY5VHcVGOcWEUaCw","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/scarborough-museum/","tickets":null},{"id":"5e3439bc-b995-4b6a-9704-930e60883de1","name":"Artemis: Sketches of Miles and Trane of Thought","dates":[1806796800000],"start":"2027-04-03T20:00:00-04:00","end":"2027-04-03T20:00:00-04:00","allDay":"Night Event","venue":{"name":"Koerner Hall","address":"273 Bloor St W, Toronto, ON, M5S 1W2","lat":43.667856304,"lng":-79.396058814},"free":false,"low":50,"high":110,"pwyc":null,"costNotes":null,"description":"The trailblazing ensemble Artemis performs a tribute to Miles Davis. Toronto supergroup Trane of Thought, featuring ex-Coltrane drummer Terry Clarke, pays homage to John Coltrane.\n\nAfter the concert, enjoy a beverage and more music at the Postlude Performance in the Leslie and Anna Dan Galleria.\n","categories":["Live Performances","Music"],"presenter":null,"image":null,"website":"https://www.rcmusic.com/concert/artemis-sketches-of-miles-430802","tickets":"https://www.rcmusic.com/tickets/seats/430802"},{"id":"58863383-8358-468b-8be5-bdbb44c51f9f","name":"Music Toronto - Danny Driver","dates":[1805239800000],"start":"2027-03-16T19:30:00-04:00","end":"2027-03-16T19:30:00-04:00","allDay":"Night Event","venue":{"name":"Jane Mallett Theatre, St. Lawrence Centre for the Arts","address":"27 Front St E, Toronto, ON, M5E 1B4","lat":43.647405296,"lng":-79.375214232},"free":false,"low":40,"high":70,"pwyc":null,"costNotes":"\nSubscribe and Save up to 40%","description":"Returning to Music Toronto for a third appearance, British pianist Danny Driver brings his exceptional artistry to a program of waltzes and variations spanning three centuries. \n\nGeorge Frideric Handel’s elegant Suite No. 5, Maurice Ravel’s shimmering Valses Nobles et Sentimentales and Morton Feldman’s Spare Variations lead to the evening’s centerpiece, Ludwig van Beethoven’s monumental Diabelli Variations. Rarely heard in concert, this astonishing cycle of 33 variations transforms a simple waltz into an imaginative and profound work in the piano repertoire, offering a special experience in a Beethoven anniversary year.\n\n“Impossible to overestimate Driver’s impeccable technique and musicianship.” — Gramophone","categories":["Cultural","Live Performances","Music"],"presenter":null,"image":"l2SaxcSAnn8X_HXn2GRpxA","website":"https://musictorontoconcerts.com/2026-27-concerts/danny-driver","tickets":"https://musictorontoconcerts.com/2026-27-concerts/danny-driver"},{"id":"1f820255-eea9-4871-bfb0-a79492c2e55b","name":"Public Pier","dates":[1789768800000,1789837200000,1790373600000,1790442000000,1790978400000,1791046800000],"start":"2026-09-18T18:00:00-04:00","end":"2026-10-03T13:00:00-04:00","allDay":"Night Event","venue":{"name":"Marina Quay West","address":"539 Queens Quay West, Toronto","lat":43.636696,"lng":-79.394687},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Public Pier is turning Marina Quay West into a day-to-night cultural destination right in Toronto's Waterfront - featuring music, dance, food, public art and immersive nighttime projections\n\nEnjoy day-to-night experiences on the waterfront including food and drink from The Super Yummy Market, local DJs including CYRO Sounds, Introspkt and Nabz, free beginner-friendly dance workshops, and public art including SILO Nights, where each evening the Canada Malting Silos will be illuminated with immersive artworks by local and international artists.\n\n\n ","categories":["Arts/Exhibits","Food/Culinary","Music"],"presenter":null,"image":"c6PLTik8EeSto-SlLgqhKw","website":"https://publicpier.ca/","tickets":null},{"id":"21ebe4b0-f46f-4ea4-b2a3-7b2f8ed0bef8","name":"Sala-Manca Group: Like a Bird’s Nest","dates":[1790204400000,1790269200000,1790352000000,1790438400000,1790524800000,1790787600000,1790874000000,1790956800000,1791043200000,1791129600000,1791392400000,1791478800000,1791561600000,1791648000000,1791734400000,1791997200000,1792083600000,1792166400000,1792252800000,1792339200000,1792602000000,1792688400000,1792771200000,1792857600000,1792944000000,1793206800000,1793293200000,1793376000000,1793462400000,1793552400000,1793815200000,1793901600000,1793984400000,1794070800000,1794157200000,1794420000000,1794506400000,1794589200000,1794675600000,1794762000000,1795024800000,1795111200000,1795194000000,1795280400000,1795366800000,1795629600000,1795716000000,1795798800000,1795885200000,1795971600000],"start":"2026-09-23T19:00:00-04:00","end":"2026-11-29T12:00:00-05:00","allDay":"Day Event","venue":{"name":"PIX FILM Gallery","address":"1411 Dufferin St, Toronto, ON, M6H 4C7","lat":43.670941,"lng":-79.439848},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy a landmark retrospective from the international artist collective, the Sala-Manca Group.\n\nInstallation, video and photography are exhibited together for the first time, all connected to the ritual object of the sukkah, a temporary hut traditionally erected during the Jewish festival of Sukkot.\n\nOver the last twenty years, Sala-Manca has explored the symbolism and function of the sukkah and related themes of shelter, impermanence, displacement, and liberation. In their hands, the sukkah is interchangeably a ritual structure, an ethnographic object, a work of art, an ephemeral monument, a site of protest, and a performative arena. \n\nThis exhibition traverses unlikely geographies, travelling through time and place, from a small town in Germany where no Jews remain to a Jahalin Bedouin community in Khan al-Ahmar; from the contested streets of Jerusalem to the fraught landscapes of Ontario. ","categories":["Arts/Exhibits","Cultural","Talks"],"presenter":"Fentster Gallery","image":"T7PtQvwfAsgTqCPeW8LzYw","website":"https://fentster.org/birds-nest","tickets":null},{"id":"0e8b24c3-5737-4585-a241-df1838f55d7b","name":"Sala-Manca Group: Like a Bird’s Nest","dates":[1790204400000,1790269200000