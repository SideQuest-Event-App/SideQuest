8000000,1791993600000,1792080000000,1792166400000,1792252800000,1792598400000,1792684800000,1792771200000,1792857600000,1793203200000,1793289600000,1793376000000,1793462400000,1793811600000,1793898000000,1793984400000,1794070800000,1794416400000,1794502800000,1794589200000,1794675600000,1795021200000,1795107600000,1795194000000,1795280400000,1795626000000,1795712400000,1795798800000,1795885200000,1796230800000,1796317200000,1796403600000,1796490000000,1796835600000,1796922000000,1797008400000,1797094800000,1797440400000,1797526800000,1797613200000,1797699600000,1798045200000,1798131600000,1798218000000,1798304400000,1798650000000,1798736400000,1798822800000,1798909200000,1799254800000,1799341200000,1799427600000,1799514000000,1799859600000,1799946000000,1800032400000,1800118800000,1800464400000,1800550800000,1800637200000,1800723600000,1801069200000,1801155600000,1801242000000,1801328400000],"start":"2026-09-09T17:00:00-04:00","end":"2027-01-30T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Onsite Gallery","address":"199 Richmond St W, Toronto, ON, M5V 0H4","lat":43.649477,"lng":-79.388341},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Please join us at the 'Returning to Ourselves - Rebecca Baird and Kenny Alvin Baird: A Retrospective of Art and Design by Cree Métis Siblings'. Curated by Lisa Deanne Smith.\n\nThis exhibit presents over 40 years of transformative work by Rebecca Baird and Kenny Alvin Baird. The exhibition spans sculpture, painting and traditional material practices, alongside interior design and more.\n\n'Michael Massie: now and then' brings together works from across his career, including a large collection of teapots, previously unexhibited pieces and a new body of large-scale sculptural installations, to celebrate the enduring importance of joy, experimentation and humour in his work. Guest-curated by Alysa Procida and enjoy our Special Projects Gallery.","categories":["Arts/Exhibits","Artisan","Cultural"],"presenter":null,"image":null,"website":"https://www.ocadu.ca/events-and-exhibitions/michael-massie-now-and-then","tickets":"https://www.eventbrite.ca/e/opening-reception-returning-to-ourselves-michael-massie-now-and-then-tickets-1997059101532?aff=ebdsoporgprofile"},{"id":"6e43af4d-07f4-4b1a-b572-d02ed8e39d89","name":"Exhibition: \"Returning to Ourselves and Michael Massie: now and then\"","dates":[1788987600000,1789056000000,1789142400000,1789228800000,1789574400000,1789660800000,1789747200000,1789833600000,1790179200000,1790265600000,1790352000000,1790438400000,1790784000000,1790870400000,1790956800000,1791043200000,1791388800000,1791475200000,1791561600000,1791648000000,1791993600000,1792080000000,1792166400000,1792252800000,1792598400000,1792684800000,1792771200000,1792857600000,1793203200000,1793289600000,1793376000000,1793462400000,1793811600000,1793898000000,1793984400000,1794070800000,1794416400000,1794502800000,1794589200000,1794675600000,1795021200000,1795107600000,1795194000000,1795280400000,1795626000000,1795712400000,1795798800000,1795885200000,1796230800000,1796317200000,1796403600000,1796490000000,1796835600000,1796922000000,1797008400000,1797094800000,1797440400000,1797526800000,1797613200000,1797699600000,1798045200000,1798131600000,1798218000000,1798304400000,1798650000000,1798736400000,1798822800000,1798909200000,1799254800000,1799341200000,1799427600000,1799514000000,1799859600000,1799946000000,1800032400000,1800118800000,1800464400000,1800550800000,1800637200000,1800723600000,1801069200000,1801155600000,1801242000000,1801328400000],"start":"2026-09-09T17:00:00-04:00","end":"2027-01-30T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Onsite Gallery","address":"199 Richmond St W, Toronto, ON, M5V 0H4","lat":43.649477,"lng":-79.388341},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Please join us at the 'Returning to Ourselves - Rebecca Baird and Kenny Alvin Baird: A Retrospective of Art and Design by Cree Métis Siblings'. Curated by Lisa Deanne Smith.\n\nThis exhibit presents over 40 years of transformative work by Rebecca Baird and Kenny Alvin Baird. The exhibition spans sculpture, painting and traditional material practices, alongside interior design and more.\n\n'Michael Massie: now and then' brings together works from across his career, including a large collection of teapots, previously unexhibited pieces and a new body of large-scale sculptural installations, to celebrate the enduring importance of joy, experimentation and humour in his work. Guest-curated by Alysa Procida and enjoy our Special Projects Gallery.","categories":["Arts/Exhibits","Artisan","Cultural"],"presenter":null,"image":null,"website":"https://www.ocadu.ca/events-and-exhibitions/michael-massie-now-and-then","tickets":"https://www.eventbrite.ca/e/opening-reception-returning-to-ourselves-michael-massie-now-and-then-tickets-1997059101532?aff=ebdsoporgprofile"},{"id":"c3b57f60-cd0f-4a14-b3cc-a614633c67d1","name":"Richard Avedon: Immortal: Portraits of Aging","dates":[1788966000000,1789052400000,1789138800000,1789225200000,1789311600000,1789398000000,1789484400000,1789570800000,1789657200000,1789743600000,1789830000000,1789916400000,1790002800000,1790089200000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790607600000,1790694000000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000,1791212400000,1791298800000,1791385200000,1791471600000,1791558000000,1791644400000,1791730800000,1791817200000,1791903600000,1791990000000,1792076400000,1792162800000,1792249200000,1792335600000,1792422000000,1792508400000,1792594800000,1792681200000,1792767600000,1792854000000,1792940400000,1793026800000,1793113200000,1793199600000,1793286000000,1793372400000,1793458800000,1793548800000,1793635200000,1793721600000,1793808000000,1793894400000,1793980800000,1794067200000,1794153600000,1794240000000,1794326400000,1794412800000,1794499200000,1794585600000,1794672000000,1794758400000,1794844800000,1794931200000,1795017600000,1795104000000,1795190400000,1795276800000,1795363200000,1795449600000,1795536000000,1795622400000,1795708800000,1795795200000,1795881600000,1795968000000,1796054400000,1796140800000,1796227200000,1796313600000,1796400000000,1796486400000],"start":"2026-09-09T11:00:00-04:00","end":"2026-12-05T11:00:00-05:00","allDay":"Day Event","venue":{"name":"The Image Centre","address":"33 Gould St, Toronto, ON, M5B 1E9","lat":43.657662387,"lng":-79.379262289},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"For nearly half a century, celebrated American photographer Richard Avedon confronted one of portraiture’s enduring taboos: aging. \n\nFrom his earliest years at Harper’s Bazaar, Avedon broke with the conventions of idealized celebrity portraiture, revealing the marks of time on his subjects’ faces with unsparing clarity. \n\nBringing together nearly 100 portraits made between the early 1950s and 2004, the exhibition features artists, writers, musicians and cultural icons including Toni Morrison, Gabriel García Márquez, Duke Ellington, Ronald Reagan, the Duke and Duchess of Windsor, Patti Smith, Truman Capote and the Dalai Lama. \n\nImmortal also includes a restaging of Avedon’s seminal 1974 Museum of Modern Art exhibition Jacob Israel Avedon, which chronicled his father’s final years in nine extraordinary portraits. Taken as a whole, the photographs reveal a lesser-known dimension of Avedon’s practice and offer an unprecedented exploration of aging through his distinctive vision.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":null,"website":"https://theimagecentre.ca/exhibition/richard-avedon-immortal/","tickets":null},{"id":"8ba69eb1-5cab-4025-80da-4f8f03a82a45","name":"In Broken Light Exhibition at Spadina Museum","dates":[1787756400000,1787842800000,1787929200000,1788015600000,1788102000000,1788361200000,1788447600000,1788534000000,1788620400000,1788706800000,1788966000000,1789052400000,1789138800000,1789225200000,1789311600000,1789570800000,1789657200000,1789743600000,1789830000000,1789916400000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000,1791385200000,1791471600000,1791558000000,1791644400000,1791730800000,1791990000000,1792076400000,1792162800000,1792249200000,1792335600000],"start":"2026-08-26T11:00:00-04:00","end":"2026-10-18T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Spadina Museum","address":"285 Spadina Rd, Toronto, ON, M5R 2V5","lat":43.679046946,"lng":-79.408181452},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":"Visit the reception desk to register. Tickets are first-come first-serve and subject to capacity.","description":"See a contemporary art exhibition of five sculptural interventions located throughout the historic Spadina Museum, created by artist Ry Van Der Hout and curated by Adrien Sun Hall. Working with photography, stained glass, mirrors, and acts of rupture and repair, Van Der Hout reveals the emotional residue held within objects, architecture and stories. Cracks and fractures become apertures through which forgotten stories emerge, the artworks functioning as contemporary reliquaries for lives remembered and overlooked.\n\nMoving between deep histories, the present day and an imagined future, this exhibition traces connections across time, where fragments persist, reflections multiply, and the boundaries between past, present and future remain open.","categories":["Arts/Exhibits","History","Museum"],"presenter":null,"image":"caTKB0eJSOICT9G9ZdiXWw","website":"https://toronto.ca/spadina","tickets":null},{"id":"55c14394-ddd2-426d-840e-208721b9060e","name":"A Fine Balance","dates":[1787700600000,1787787000000,1787873400000,1787959800000,1788046200000,1788132600000,1788219000000,1788305400000,1788391800000,1788478200000,1788564600000,1788651000000,1788737400000,1788823800000,1788910200000,1788996600000,1789083000000,1789169400000,1789255800000,1789342200000,1789428600000,1789515000000,1789601400000,1789687800000,1789774200000,1789860600000,1789947000000,1790033400000,1790119800000,1790206200000,1790292600000,1790379000000,1790465400000,1790551800000,1790638200000,1790724600000,1790811000000,1790897400000,1790983800000,1791070200000,1791156600000,1791243000000,1791329400000,1791415800000,1791502200000,1791588600000,1791675000000,1791761400000],"start":"2026-08-25T19:30:00-04:00","end":"2026-10-11T19:30:00-04:00","allDay":"Night Event","venue":{"name":"Crow's Theatre","address":"345 Carlaw Ave, Toronto, ON, M4M 2T1","lat":43.66515638,"lng":-79.341549283},"free":false,"low":30,"high":110,"pwyc":null,"costNotes":null,"description":"Rohinton Mistry’s beloved novel exploring resilience and injustice during India’s 1975 emergency comes to life in a new stage adaptation.\n\nIn a cramped Bombay apartment turned illegal garment factory, four unlikely companions are thrown together. As the political crisis deepens and the country reels under authoritarian crackdown, this fragile household becomes a refuge and an unexpected bond begins to take hold.\n\nAs devastating as it is humane, A Fine Balance, adapted by Anosh Irani, Governor General’s Literary Award finalist and recipient of the Writers’ Trust Engel Findley Award, vividly brings Mistry's powerful story to the stage.\n\nAccolades for the novel include the Giller Prize, 1995, Los Angeles Times Book Prize for Fiction, 1996, Oprah’s Book Club, November 2001, Commonwealth Writers’ Prize, 1996 and Booker Prize Shortlisted Finalist, 1996.","categories":["Literary","Live Performances","Theatre"],"presenter":null,"image":"nYaJaPii2CPhcIO2l_b2ZQ","website":"https://www.crowstheatre.com/shows-events/a-fine-balance","tickets":"https://www.crowstheatre.com/shows-events/calendar?shows=1076"},{"id":"3ed30de1-814b-4288-9afe-c9c8051544c1","name":"A Fine Balance","dates":[1787700600000,1787787000000,1787873400000,1787959800000,1