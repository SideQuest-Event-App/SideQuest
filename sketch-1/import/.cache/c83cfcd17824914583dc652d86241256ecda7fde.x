ne conditions. ","categories":["Arts/Exhibits","History","Museum","Black History Month"],"presenter":null,"image":"qZyjxxbPBbXkbmhYN7I9Sg","website":"https://www.toronto.ca/montgomerysinn","tickets":null},{"id":"4047d255-b805-43a5-9ae2-4e998fa602ed","name":"Agency & Defiance: Exhibit at Montgomery's Inn","dates":[1793980800000,1794067200000,1794153600000,1794412800000,1794499200000,1794585600000,1794672000000,1794758400000,1795017600000,1795104000000,1795190400000,1795276800000,1795363200000,1795622400000,1795708800000,1795795200000,1795881600000,1795968000000,1796227200000,1796313600000,1796400000000,1796486400000,1796572800000,1796832000000,1796918400000,1797004800000,1797091200000,1797177600000,1797436800000,1797523200000,1797609600000,1797696000000,1797782400000,1798041600000,1798128000000,1798214400000,1798300800000,1798387200000,1798646400000,1798732800000,1798819200000,1798905600000,1798992000000,1799251200000,1799337600000,1799424000000,1799510400000,1799596800000,1799856000000,1799942400000,1800028800000,1800115200000,1800201600000,1800460800000,1800547200000,1800633600000,1800720000000,1800806400000,1801065600000,1801152000000,1801238400000,1801324800000,1801411200000,1801670400000,1801756800000,1801843200000,1801929600000,1802016000000,1802275200000,1802361600000,1802448000000,1802534400000,1802620800000,1802880000000,1802966400000,1803052800000,1803139200000,1803225600000,1803484800000,1803571200000,1803657600000,1803744000000,1803830400000],"start":"2026-11-06T11:00:00-05:00","end":"2027-02-28T11:00:00-05:00","allDay":"Day Event","venue":{"name":"Montgomery's Inn","address":"4709 Dundas St W, Etobicoke, ON, M9A 1A8","lat":43.651679,"lng":-79.525659},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Experience Agency and Defiance, featuring never-before-seen works by Toronto-based artist Frantz Brent-Harris inspired by Jamaican Junkanoo. Through these figures, the artist shares the enduring legacy of agency, defiance, resilie