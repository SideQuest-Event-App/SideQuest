,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000,1792123200000,1792209600000,1792296000000,1792382400000,1792468800000,1792555200000,1792641600000,1792728000000,1792814400000,1792900800000,1792987200000,1793073600000,1793160000000,1793246400000,1793332800000,1793419200000,1793505600000,1793595600000,1793682000000,1793768400000,1793854800000,1793941200000,1794027600000,1794114000000,1794200400000,1794286800000,1794373200000,1794459600000,1794546000000,1794632400000,1794718800000,1794805200000,1794891600000,1794978000000,1795064400000,1795150800000,1795237200000,1795323600000,1795410000000,1795496400000,1795582800000,1795669200000,1795755600000,1795842000000,1795928400000,1796014800000,1796101200000,1796187600000,1796274000000,1796360400000,1796446800000,1796533200000,1796619600000,1796706000000,1796792400000,1796878800000,1796965200000,1797051600000,1797138000000,1797224400000,1797310800000,1797397200000,1797483600000,1797570000000,1797656400000,1797742800000],"start":"2026-09-15T00:00:00-04:00","end":"2026-12-20T00:00:00-05:00","allDay":"Day Event","venue":{"name":"Toronto (virtual)","address":"","lat":null,"lng":null},"free":false,"low":10,"high":30,"pwyc":null,"costNotes":null,"description":"This international architectural competition invites participants to design a Persian Garden Suite pavilion in Toronto. \n\nThe initiative explores cultural heritage, urban design, and innovative architecture. Detailed competition guidelines, submission criteria and timelines are available for participants.","categories":["Cultural","Other"],"presenter":"Iranian-Canadian Architects and Artists Forum ","image":null,"website":"https://www.icaaf.ca/competition","tickets":"https://www.icaaf.ca/competition"},{"id":"1b16c007-e6a1-4d12-a5a0-f9f7bafca997","name":"Kayaking at Biidaasige Park","dates":[1789075800000,1789221600000,1789680600000,1789826400000,1790285400000,1790431200000,1790890200000,1791036000000],"start":"2026-09-10T17:30:00-04:00","end":"2026-10-03T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Biidaasige Park ","address":"51 Commissioners St, Toronto, ON, M5A 1A6","lat":43.646495807,"lng":-79.348925214},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":"Register using the correct link below:\nSat September 26 Kayaking\n10 am, 12 pm, 2:30 pm - https://www.eventbrite.ca/e/1999635854670\nThursday Oct 1 Kayaking\n5:30 pm - https://www.eventbrite.ca/e/2002225124245\n\n","description":"Discover Toronto’s newest waterfront destination from a whole new perspective! Join Don't Mess with The Don for an unforgettable guided kayaking experience at Biidaasige Park. Paddle through calm waters, enjoy stunning views of the city skyline, and connect with nature in one of Toronto’s most exciting new parks.\n\nWhether you’re a first-time paddler or an experienced kayaker, this welcoming session is designed for all skill levels. The DMWTD experienced team will provide equipment, safety instruction, and on-water guidance so you can relax and enjoy the adventure.\n\nBring your sense of exploration, dress for the weather, and get ready to experience the beauty of Toronto’s waterfront at golden hour. Spaces are limited and advance registration is required.\n\nPerfect for: beginners, outdoor enthusiasts, friends, families, and anyone looking for a fun activity on the water.\n\nCome paddle, explore, and make summer memories at Biidaasige Park! 🚣‍♀️🌊☀️","categories":["Environmental","Sports","Tour"],"presenter":null,"image":"Za-23fnhcvn_BacwEju5hw","website":"https://www.dontmesswiththedon.ca/kayaking","tickets":null},{"id":"2755c685-cd84-4ef8-bc8b-9d4b0f81afb5","name":"Music Toronto - Gryphon Trio with James Campbell","dates":[1796949000000],"start":"2026-12-10T19:30:00-05:00","end":"2026-12-10T19:30:00-05:00","allDay":"Night Event","venue":{"name":"Jane Mallett Theatre, St. Lawrence Centre for the Arts","address":"27 Front St E, Toronto, ON, M5E 1B4","lat":43.647405296,"lng":-79.375214232},"free":false,"low":40,"high":70,"pwyc":null,"costNotes":"\nSubscribe and Save up to 40%","description":"In its early years as a Music Toronto ensemble-in-residence, the Gryphon Trio first performed Olivier Messiaen’s visionary \"Quartet for the End of Time\" with revered Canadian clarinetist James Campbell. Composed in a prisoner-of-war camp during the Second World War, the work stands as one of the 20th century’s most profound musical testaments of faith, transcendence and human resilience. \n\nTwenty-five years and countless performances later, the Gryphon Trio and Campbell return to this monumental masterpiece that has become a defining thread in their artistic story. The program opens with the stormy passion of Johannes Brahms’ dramatic Piano Trio in C minor and also features the world premiere of a new work for piano trio by Graham Campbell.","categories":["Cultural","Live Performances","Music"],"presenter":null,"image":"7IMo4WqtODZKTNky-fNtvQ","website":"https://musictorontoconcerts.com/2026-27-concerts/gryphon-trio-james-campbell","tickets":"https://musictorontoconcerts.com/2026-27-concerts/gryphon-trio-james-campbell"},{"id":"a7a4589c-a11a-48ef-a9f8-a78646c97714","name":"Fall Flavours &  Crafts at Scarborough Museum","dates":[1791039600000,1791126000000,1791644400000,1791730800000,1792249200000,1792335600000,1792854000000,1792940400000,1793458800000],"start":"2026-10-03T11:00:00-04:00","end":"2026-10-31T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Scarborough Museum","address":"1007 Brimley Rd, Scarborough, ON, M1P 3E8","lat":43.757624474,"lng":-79.254809969},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy fall-themed fun at Scarborough Museum throughout October weekends. Sip a warm drink from the museum kitchen and savour a treat prepared on the historic stove. Spark creativity with family-friendly paper crafts, a scavenger hunt, and seasonal activities designed for all ages.\n\nAll ages. Drop-In. FREE. All are welcome. ","categories":["Family/Children","History","Museum"],"presenter":"Toronto History Museums","image":"BA9dThVY5VHcVGOcWEUaCw","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/scarborough-museum/","tickets":null},{"id":"e919769e-d097-48bb-9654-d7670bba0593","name":"Fall Flavours &  Crafts at Scarborough Museum","dates":[1791039600000,1791126000000,1791644400000,1791730800000,1792249200000,1792335600000,1792854000000,1792940400000,1793458800000],"start":"2026-10-03T11:00:00-04:00","end":"2026-10-31T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Scarborough Museum","address":"1007 Brimley Rd, Scarborough, ON, M1P 3E8","lat":43.757624474,"lng":-79.254809969},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy fall-themed fun at Scarborough Museum throughout October weekends. Sip a warm drink from the museum kitchen and savour a treat prepared on the historic stove. Spark creativity with family-friendly paper crafts, a scavenger hunt, and seasonal activities designed for all ages.\n\nAll ages. Drop-In. FREE. All are welcome. ","categories":["Family/Children","History","Museum"],"presenter":"Toronto History Museums","image":"BA9dThVY5VHcVGOcWEUaCw","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/scarborough-museum/","tickets":null},{"id":"491edfde-c917-407c-b52d-6476e6ee8f87","name":"Fall Flavours &  Crafts at Scarborough Museum","dates":[1791039600000,1791126000000,1791644400000,1791730800000,1792249200000,1792335600000,1792854000000,1792940400000,1793458800000],"start":"2026-10-03T11:00:00-04:00","end":"2026-10-31T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Scarborough Museum","address":"1007 Brimley Rd, Scarborough, ON, M1P 3E8","lat":43.757624474,"lng":-79.254809969},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy fall-themed fun at Scarborough Museum throughout October weekends. Sip a warm drink from the museum kitchen and savour a treat prepared on the historic stove. Spark creativity with family-friendly paper crafts, a scavenger hunt, and seasonal activities designed for all ages.\n\nAll ages. Drop-In. FREE. All are welcome. ","categories":["Family/Children","History","Museum"],"presenter":"Toronto History Museums","image":"BA9dThVY5VHcVGOcWEUaCw","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/scarborough-museum/","tickets":null},{"id":"a6732b0b-6e1c-4ea6-8496-de23c1f62351","name":"Holiday Run and Taste 5K","dates":[1795878000000],"start":"2026-11-28T10:00:00-05:00","end":"2026-11-28T10:00:00-05:00","allDay":"Day Event","venue":{"name":"Meeting Point: Circle and Squares Bakery","address":"77 King St W, Toronto, ON, M5K 2A1","lat":43.647859,"lng":-79.382056},"free":false,"low":65,"high":85,"pwyc":null,"costNotes":null,"description":"Get ready to jog, sip, and savor your way through Toronto’s brightest season! \n\nWe're combining a high-energy winter fun run with a festive holiday food crawl featuring five signature tastings along downtown’s iconic districts.\n\nYour registration includes a Holiday Dessert Spoon Medal (dig right into your winter treats!), five signature holiday tastings at local pit stops and an official race bib kit and festive swag.","categories":["Food/Culinary","Run/Walk","Winter Holidays"],"presenter":null,"image":null,"website":"https://runandtaste.ca","tickets":"https://runandtaste.ca"},{"id":"887083a0-738c-463f-ab95-3c42f7d06b69","name":"Retracing Tatreez: Palestinian Thobes through the Twentieth Century","dates":[1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000,1799254800000,1799341200000,1799427600000,1799514000000,1799600400000,1799859600000,1799946000000,1800032400000,1800118800000,1800205200000,1800464400000,1800550800000,1800637200000,1800723600000,1800810000000,1801069200000,1801155600000,1801242000000,1801328400000,1801414800000,1801674000000,1801760400000,1801846800000,1801933200000,1802019600000],"start":"2026-09-24T12:00:00-04:00","end":"2027-02-07T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":"\nChildren 5 and under visit for free.","description":"Featuring several examples of Palestinian tatreez (embroidery) from the Textile Museum’s collection, most of which will be exhibited for the first time! \n\nRetracing Tatreez highlights what these belongings can tell us about the relationship between Palestinians and their homelands in the twentieth century and beyond.\n\nIn this exhibition, curator Nina Rafique showcases these pieces with restored historical context and invites visitors to re-engage with their ways of storytelling. \n\nIn doing so, Retracing Tatreez highlights what these embroideries can tell us about the unique regional connections between Palestinians and their homelands, as well as the journeys of these objects from the hands of their original creators to today.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"j37-eBOZLJMeQ8B7zUJpJg","website":"https://textilemuseum.ca/event/retracing-tatreez-palestinian-thobes-through-the-20th-century/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"bf3c12f0-4731-44cf-a8be-72a1aecca942","name":"Retracing Tatreez: Palestinian Thobes through the Twentieth Century","dates":[1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000,1799254800000,1799341200000,1799427600000,1799514000000,1799600400000,1799859600000,1799946000000,1800032400000,1800118800000,1800205200000,1800464400000,1800550800000,1800637200000,1800723600000,1800810000000,1801069200000,1801155600000,1801242000000,1801328400000,1801414800000,1801674000000,1801760400000,1801846800000,1801933200000,1802019600000],"start":"2026-09-24T12:00:00-04:00","end":"2027-02-07T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":"\nChildren 5 and under visit for free.","description":"Featuring several examples of Palestinian tatreez (embroidery) from the Textile Museum’s collection, most of which will be exhibited for the first time! \n\nRetracing Tatreez highlights what these belongings can tell us about the relationship between Palestinians and their homelands in the twentieth century and beyond.\n\nIn this exhibition, curator Nina Rafique showcases these pieces with restored historical context and invites visitors to re-engage with their ways of storytelling. \n\nIn doing so, Retracing Tatreez highlights what these embroideries can tell us about the unique regional connections between Palestinians and their homelands, as well as the journeys of these objects from the hands of their original creators to today.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"j37-eBOZLJMeQ8B7zUJpJg","website":"https://textilemuseum.ca/event/retracing-tatreez-palestinian-thobes-through-the-20th-century/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"3542d329-5049-4403-932b-180543e4bacc","name":"Retracing Tatreez: Palestinian Thobes through the Twentieth Century","dates":[1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,179571240000