,1789041600000,1789128000000,1789221600000,1789387200000,1789473600000,1789560000000,1789646400000,1789732800000,1789826400000,1789992000000,1790078400000,1790164800000,1790251200000,1790337600000,1790431200000,1790596800000,1790683200000,1790769600000,1790856000000,1790942400000,1791036000000,1791201600000,1791288000000,1791374400000,1791460800000,1791547200000,1791640800000,1791806400000,1791892800000,1791979200000,1792065600000,1792152000000,1792245600000,1792411200000,1792497600000,1792584000000,1792670400000,1792756800000,1792850400000,1793016000000,1793102400000,1793188800000,1793275200000],"start":"2026-08-06T08:00:00-04:00","end":"2026-10-29T08:00:00-04:00","allDay":"Day Event","venue":{"name":"Ascent Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Visual perceptions of the human gaze are analysed in this dual exhibit created by James Rose and Emmanuel Udeh. Rose depicts various forms of body modification to demonstrate how physical changes can have a sacred, transformative, spiritual effect that exceeds the body’s limitation. Udeh creates technically skilled, conceptually grounded drawings that balance realism with imagination; quiet yet powerful visual meditations explore what it means to watch and be watched.\n\nReception: August 15, 2–4 p.m.","categories":["Arts/Exhibits"],"presenter":null,"image":"aT6_lLHg3nQFe3YvB7TNHQ","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/","tickets":null},{"id":"7aae3540-6595-4d15-b0f3-c2f07a02af92","name":"Ritual / Still Without Shelter","dates":[1786017600000,1786104000000,1786197600000,1786363200000,1786449600000,1786536000000,1786622400000,1786708800000,1786802400000,1786968000000,1787054400000,1787140800000,1787227200000,1787313600000,1787407200000,1787572800000,1787659200000,1787745600000,1787832000000,17