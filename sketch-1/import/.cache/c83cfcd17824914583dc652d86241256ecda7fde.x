90510400000,1790596800000,1790683200000,1790769600000,1790856000000,1790942400000,1791028800000,1791115200000,1791201600000,1791288000000,1791374400000,1791460800000,1791547200000,1791633600000,1791720000000,1791806400000,1791892800000,1791979200000,1792065600000,1792152000000,1792238400000,1792324800000,1792411200000,1792497600000,1792584000000,1792670400000,1792756800000,1792843200000,1792929600000,1793016000000,1793102400000,1793188800000,1793275200000,1793361600000,1793448000000,1793538000000,1793624400000,1793710800000,1793797200000,1793883600000,1793970000000,1794056400000,1794142800000,1794229200000],"start":"2026-08-03T08:00:00-04:00","end":"2026-11-09T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Mount Pleasant Cemetery","address":"375 Mount Pleasant Road","lat":43.712625,"lng":-79.357673},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Walk through a series of artistic and interpretive installations across ten cemetery sites and several funeral centres.\n\nAcross the participating sites, visitors will encounter a constellation of experiences, including interpretive panels, meditative spaces, soundscapes, experimental film, symbolic thresholds, and opportunities to leave a message of their own.\n\nCemeteries bring generations into conversation. They hold names, trees, monuments, rituals, and traces of lives that still shape the world around us. The project invites visitors to reflect on how grief, memory, nature, design and community shape the places we inherit and the futures we share.\n","categories":["Arts/Exhibits","History","Museum"],"presenter":"Mount Pleasant Group","image":"nid4j8jkM4_7uRp7j1JIyQ","website":"https://mpg200.ca/installations","tickets":null},{"id":"e57b5a8d-d8c0-4f63-9cde-527f5bbf1c19","name":"Yesterday. Today. Forever.","dates":[1785758400000,1785844800000,1785931200000,1786017600000,1786104000000,1786190400000,1786276800000,1786363200000,1786449600000,1786536000000,1786622400000,1786708800000,1