200000,1788447600000,1788534000000,1788620400000,1788706800000,1788966000000,1789052400000,1789138800000,1789225200000,1789311600000,1789570800000,1789657200000,1789743600000,1789830000000,1789916400000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000,1791385200000,1791471600000,1791558000000,1791644400000,1791730800000,1791990000000,1792076400000,1792162800000,1792249200000,1792335600000],"start":"2026-08-26T11:00:00-04:00","end":"2026-10-18T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Spadina Museum","address":"285 Spadina Rd, Toronto, ON, M5R 2V5","lat":43.679046946,"lng":-79.408181452},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":"Visit the reception desk to register. Tickets are first-come first-serve and subject to capacity.","description":"See a contemporary art exhibition of five sculptural interventions located throughout the historic Spadina Museum, created by artist Ry Van Der Hout and curated by Adrien Sun Hall. Working with photography, stained glass, mirrors, and acts of rupture and repair, Van Der Hout reveals the emotional residue held within objects, architecture and stories. Cracks and fractures become apertures through which forgotten stories emerge, the artworks functioning as contemporary reliquaries for lives remembered and overlooked.\n\nMoving between deep histories, the present day and an imagined future, this exhibition traces connections across time, where fragments persist, reflections multiply, and the boundaries between past, present and future remain open.","categories":["Arts/Exhibits","History","Museum"],"presenter":null,"image":"caTKB0eJSOICT9G9ZdiXWw","website":"https://toronto.ca/spadina","tickets":null},{"id":"bd3464c8-4efc-4f48-9c6b-289120ce94c1","name":"In Broken Light Exhibition at Spadina Museum","dates":[1787756400000,1787842800000,1787929200000,1788015600000,1788102000000,1788361200000,1788447600000,178853400000