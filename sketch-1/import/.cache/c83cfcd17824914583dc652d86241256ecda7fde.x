listing&utm_campaign=huntsandtours"},{"id":"5b263d34-46ec-4fc1-9304-911497b3ed2b","name":"Flemo Farmer Market","dates":[1782414000000,1783018800000,1783623600000,1784228400000,1784833200000,1785438000000,1786042800000,1786647600000,1787252400000,1787857200000,1788462000000,1789066800000,1789671600000,1790276400000,1790881200000,1791486000000,1792090800000],"start":"2026-06-25T15:00:00-04:00","end":"2026-10-15T15:00:00-04:00","allDay":"Day Event","venue":{"name":"Flemingdon Community Centre","address":"150 Grenoble Dr, North York, ON M3C 1E3","lat":43.713176,"lng":-79.326454},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"This unique market right in the middle of Flemington Park is a vibrant community space that celebrates local farmers, fresh produce, and the diverse cultural foods grown at Flemo Farm. Visit the market to connect with community growers, learn about local food production, and enjoy fresh, seasonal harvests.\n\nJoin us every Thursday to shop for affordable fresh produce, meet the farmers, and be part of a thriving community food hub. 🍅🌿🥕","categories":["Farmers' Market","Other"],"presenter":null,"image":"oVnnqDTdmLUsjVQ3CmSMvg","website":"https://www.flemofarm.ca","tickets":null},{"id":"6ba5ae2d-2a9b-4aae-98f4-4e611f4d336d","name":"Flemo Farmer Market","dates":[1782414000000,1783018800000,1783623600000,1784228400000,1784833200000,1785438000000,1786042800000,1786647600000,1787252400000,1787857200000,1788462000000,1789066800000,1789671600000,1790276400000,1790881200000,1791486000000,1792090800000],"start":"2026-06-25T15:00:00-04:00","end":"2026-10-15T15:00:00-04:00","allDay":"Day Event","venue":{"name":"Flemingdon Community Centre","address":"150 Grenoble Dr, North York, ON M3C 1E3","lat":43.713176,"lng":-79.326454},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"This unique market right in the middle of Flemington Park is a vibrant community space that celebrates local farmers, fresh produc