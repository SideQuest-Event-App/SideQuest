200000,1793883600000,1793970000000,1794063600000,1794229200000,1794315600000,1794402000000,1794488400000,1794574800000,1794668400000,1794834000000,1794920400000,1795006800000,1795093200000,1795179600000,1795273200000,1795438800000,1795525200000,1795611600000,1795698000000,1795784400000,1795878000000,1796043600000,1796130000000,1796216400000,1796302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000],"start":"2026-09-01T08:00:00-04:00","end":"2026-12-15T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Etobicoke Civic Centre Art Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover the history of art at the Etobicoke Civic Centre with artifacts, prints, images and paintings from City of Toronto’s Fine Art, Artifact and Archival collections. Celebrate the present by witnessing a commissioned piece by early career artist Lise Round. Envision the future with new designs of the updated Etobicoke Civic Centre Art Gallery.","categories":["Arts/Exhibits"],"presenter":null,"image":"A6-VIKDNvgJfy1_SuU-UqA","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/?WT.rd_id=%2Feccartgallery","tickets":null},{"id":"2c347659-83fb-48eb-8cac-6f72b5fd3b49","name":"Ravine Days Stewarding with Toronto Nature Stewards Highland Creek Park 18-Oct-2026","dates":[1792335600000],"start":"2026-10-18T11:00:00-04:00","end":"2026-10-18T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Highland Creek Park ","address":"428 Livingston Rd N, Scarborough, ON, M1E 1M4","lat":43.7559834431,"lng":-79.2033254851},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"As part of City of Toronto Ravine Days, the Toronto Nature Stewards Highland Creek team will be adding short talks (~5-10 minutes) - about the beauty, biodiversity and cultural significance of our ravines - to our scheduled nature stewarding. The topic for this event will be invasive plants in Highland Creek ravine.\n\nRoll up your sleeves, take part in ecological restoration by removing invasive plants and learn something new about Highland Creek Park!\n\nNote: this is one of a series of 4 opportunities to participate in Ravine Days Stewarding at Highland Creek Park. The full series takes place on the following dates: 27-Sep-2026 (Creation of Highland Creek Ravine), 30-Sep-2026 (Indigenous Peoples and Highland Creek), 11-Oct-2026 (Early Settlers and a Changing Highland Creek), 18-Oct-2026 (Invasive Plants in Highland Creek Ravine).","categories":["Environmental"],"presenter":null,"image":"BRABavBBU50VtLedFh2r2w","website":"https://www.eventbrite.ca/e/ravine-days-stewarding-with-toronto-nature-stewards-highland-creek-park-tickets-2000527798498?aff=oddtdtcreator","tickets":"https://www.eventbrite.ca/e/ravine-days-stewarding-with-toronto-nature-stewards-highland-creek-park-tickets-2000527798498?aff=oddtdtcreator"},{"id":"3e9dd7d9-e836-40bf-b22f-3de971bca8ba","name":"Lantern Tours at Colborne Lodge: The Unexplained","dates":[1793143800000,1793145600000,1793149200000,1793230200000,1793232000000,1793235600000,1793316600000,1793318400000,1793322000000,1793403000000,1793404800000,1793408400000],"start":"2026-10-27T19:30:00-04:00","end":"2026-10-30T21:00:00-04:00","allDay":"Night Event","venue":{"name":"Colborne Lodge Museum","address":"11 Colborne Lodge Dr, Toronto","lat":43.640347955,"lng":-79.459963485},"free":false,"low":25,"high":null,"pwyc":null,"costNotes":"Recommended for ages 12 and up. Youth 12-16 must be accompanied by an adult.\n\nAll ticket sales are non-refundable. Tickets are transferable.","description":"Join us for a chilling tour at Colborne Lodge in High Park. Visit the gravesite of John and Jemima Howard. Delve deeply into ideas about death and the afterlife 