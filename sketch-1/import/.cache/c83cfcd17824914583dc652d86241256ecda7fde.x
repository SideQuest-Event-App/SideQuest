173600000,1783778400000,1784383200000,1784988000000,1785592800000,1786197600000,1786802400000,1787407200000,1788012000000,1788616800000,1789221600000,1789826400000,1790431200000,1791036000000,1791640800000,1792245600000,1792850400000,1793455200000,1794063600000,1794668400000,1795273200000,1795878000000,1796482800000,1797087600000,1797692400000,1798297200000,1798902000000,1799506800000,1800111600000,1800716400000,1801321200000,1801926000000,1802530800000,1803135600000,1803740400000,1804345200000,1804950000000,1805551200000,1806156000000,1806760800000,1807365600000,1807970400000,1808575200000,1809180000000],"start":"2026-05-02T10:00:00-04:00","end":"2027-05-01T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Children's Conservatory","address":"19 Horticultural Ave, Toronto, ON, M5A 2P2","lat":43.661418998,"lng":-79.37480223},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrate local food, community, and sustainable agriculture. Discover fresh produce, artisanal products, and small-scale producers - all while connecting with the people who grow and create them.We invite you to come meet the vendors, discover new favourites, and taste the heart of your community!\n\nThe Allan Gardens Farmers’ Market facilitates a direct exchange between local farmers, food producers, artisan makers, and consumers. Everything sold at the market (50%+1) must be grown, sourced, made, and/or prepared in Toronto and the surrounding  area—ensuring that every purchase supports your neighbourhood economy.\n\nJoin us year- round every Saturday from 10am-2pm, in the beautiful Allan Gardens Children’s Conservatory & Teaching Garden. ","categories":["Farmers' Market"],"presenter":null,"image":"1_2B-asoDqdvJSyiKMPiaQ","website":"https://www.friendsofallangardens.ca/saturday-farmers-market","tickets":null},{"id":"8d467f15-975f-49c2-94d0-c74757da6f85","name":"Allan Gardens Saturday Farmers' Market","dates":[1777730400000,1778335200000,1778940000000,177954480000