w.secondcity.com/shows/toronto/the-second-city-mainstage-92nd-revue-tor"},{"id":"079154ee-ec9e-45cc-b589-c002bc080232","name":"Mohsen Sharifian","dates":[1796432400000],"start":"2026-12-04T20:00:00-05:00","end":"2026-12-04T20:00:00-05:00","allDay":"Night Event","venue":{"name":"Koerner Hall","address":"273 Bloor St W, Toronto, ON M5S 1W2","lat":43.667924,"lng":-79.396238},"free":false,"low":60,"high":300,"pwyc":null,"costNotes":null,"description":"Experience a breathtaking celebration of Persian Gulf music, pairing the spellbinding artistry of Iranian maestro Mohsen Sharifian with a magnificent 23-piece string ensemble in masterful works by acclaimed composers Kaveh Mirhosseini and Pouya Hamidi.\n","categories":["Live Performances","Music"],"presenter":null,"image":"D1WqVqarYqMojDS-VyxEOw","website":"https://www.rcmusic.com/concert/mohsen-sharifian-453401","tickets":"https://www.rcmusic.com/tickets/seats/453401"},{"id":"c2f25cde-4237-42e9-acae-872a86d03cfe","name":"A Translucent City: Collective Memories of the Future","dates":[1788789600000,1788876000000,1788962400000,1789048800000,1789135200000,1789221600000,1789394400000,1789480800000,1789567200000,1789653600000,1789740000000,1789826400000,1789999200000,1790085600000,1790172000000,1790258400000,1790344800000,1790431200000,1790604000000,1790690400000,1790776800000,1790863200000,1790949600000,1791036000000,1791208800000,1791295200000,1791381600000,1791468000000,1791554400000,1791640800000,1791813600000,1791900000000,1791986400000,1792072800000,1792159200000,1792245600000,1792418400000,1792504800000,1792591200000,1792677600000,1792764000000,1792850400000,1793023200000,1793109600000,1793196000000,1793282400000,1793368800000,1793455200000,1793631600000,1793718000000,1793804400000,1793890800000,1793977200000,1794063600000,1794236400000,1794322800000,1794409200000,1794495600000,1794582000000,1794668400000,1794841200000,1794927600000,1795014000000,1795100400000,1795186800000,1795273200000,1795446000000,1795532400000,1795