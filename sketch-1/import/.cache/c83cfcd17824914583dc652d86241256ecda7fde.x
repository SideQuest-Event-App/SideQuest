0000,1792850400000,1793016000000,1793102400000,1793188800000,1793275200000,1793361600000,1793455200000,1793624400000,1793710800000,1793797200000,1793883600000,1793970000000,1794063600000,1794229200000,1794315600000,1794402000000,1794488400000,1794574800000,1794668400000,1794834000000,1794920400000,1795006800000,1795093200000,1795179600000,1795273200000,1795438800000,1795525200000,1795611600000,1795698000000,1795784400000,1795878000000,1796043600000,1796130000000,1796216400000,1796302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000],"start":"2026-09-01T08:00:00-04:00","end":"2026-12-15T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Etobicoke Civic Centre Art Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover the history of art at the Etobicoke Civic Centre with artifacts, prints, images and paintings from City of Toronto’s Fine Art, Artifact and Archival collections. Celebrate the present by witnessing a commissioned piece by early career artist Lise Round. Envision the future with new designs of the updated Etobicoke Civic Centre Art Gallery.","categories":["Arts/Exhibits"],"presenter":null,"image":"A6-VIKDNvgJfy1_SuU-UqA","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/?WT.rd_id=%2Feccartgallery","tickets":null},{"id":"2eb70817-978c-45e5-9dc1-bf176e0bc47e","name":"BAM! Nuit Blanche Night Market","dates":[1791068400000,1791154800000],"start":"2026-10-03T19:00:00-04:00","end":"2026-10-04T19:00:00-04:00","allDay":"Night Event","venue":{"name":"Wychwood Barns","address":"601 Christie St, Toronto, ON, M6G 4C7","lat":43.679958839,"lng":-79.424094918},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join us for a night of contemporary art! Our market supports local artists of all career stages! \n\nShop and explore the work of various talents within our diverse community.\n \nOver 35 professional artists will exhibit at BAM!, featuring jewellers, ceramists, poets, print makers and so much more! Meet new and emerging career artists at the BAM! Emerging Artist Centre.\n\nDon’t miss the other Nuit Blanche installations and activities happening all night long during Stories in Place at Wychwood Barns, and participate in a hands on art making experience with One Story, Four Places.","categories":["Arts/Exhibits","Cultural","Family/Children"],"presenter":null,"image":"HvogoSkaDpWEsqM0QYl8nQ","website":"https://wychwoodbarns.ca/bam-nuit-blanche-night-market-on-oct-3","tickets":null},{"id":"4c8ffcae-2054-413c-b042-02e761ce5a65","name":"MULTIfest Interactive Art festival","dates":[1790888400000,1790974800000,1791061200000,1791147600000,1791234000000,1791320400000,1791406800000,1791493200000],"start":"2026-10-01T17:00:00-04:00","end":"2026-10-08T17:00:00-04:00","allDay":"Day Event","venue":{"name":"Stackt Market","address":"28 Bathurst St, Toronto, ON, M5V 0R4","lat":43.640948,"lng":-79.402169},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Toronto’s new festival of interactive and digital art, returns to STACKT Market!\n\nWe're bringing together interactive art installations, audiovisual performances and beginner-friendly workshops, alongside artist talks, family programming and community events.\n\nExplore immersive digital artworks, interact with responsive installations, experience live audiovisual performances, and get hands-on with creative technology through workshops in electronic music making, projection mapping and more.\n\nTogether with Nuit Blanche, enjoy an afternoon Show and Tell and immersive round table, followed by an Immersive Happy Hour with DJs, live visuals and interactive art.\n","categories":["Arts/Exhibits","Live Performances","Music"],"presenter":null,"image":"KoSi1GfJkywyaekelu014A","website":"https://multi-fest.ca/","tickets":null},{"id":"dcbcb57f-85f6-4c9f-81c1-b4b5010ede76","name":"MULTIfest Interactive Art festival","dates":[1790888400000,1790974800000,1791061200000,1791147600000,1791234000000,1791320400000,1791406800000,1791493200000],"start":"2026-10-01T17:00:00-04:00","end":"2026-10-08T17:00:00-04:00","allDay":"Day Event","venue":{"name":"Stackt Market","address":"28 Bathurst St, Toronto, ON, M5V 0R4","lat":43.640948,"lng":-79.402169},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Toronto’s new festival of interactive and digital art, returns to STACKT Market!\n\nWe're bringing together interactive art installations, audiovisual performances and beginner-friendly workshops, alongside artist talks, family programming and community events.\n\nExplore immersive digital artworks, interact with responsive installations, experience live audiovisual performances, and get hands-on with creative technology through workshops in electronic music making, projection mapping and more.\n\nTogether with Nuit Blanche, enjoy an afternoon Show and Tell and immersive round table, followed by an Immersive Happy Hour with DJs, live visuals and interactive art.\n","categories":["Arts/Exhibits","Live Performances","Music"],"presenter":null,"image":"KoSi1GfJkywyaekelu014A","website":"https://multi-fest.ca/","tickets":null},{"id":"e7d2c596-c3f2-46d2-b2f6-5b8ad4a391c0","name":"The Descent of Orpheus","dates":[1792711800000,1792798200000,1792884600000,1792953000000],"start":"2026-10-22T19:30:00-04:00","end":"2026-10-25T14:30:00-04:00","allDay":"Day Event","venue":{"name":"TELUS Centre for Performance and Learning at Koerner Hall","address":"273 Bloor St W, Toronto, ON, M5S 1W2","lat":43.667856304,"lng":-79.396058814},"free":false,"low":85,"high":250,"pwyc":null,"costNotes":null,"description":"Enjoy our season premiere with Canada’s first fully-staged production of M.A. Charpentier’s The Descent of Orpheus. \n\nFounding Co-Artistic Directors Marshall Pynkoski, C.M. and Jeannette Lajeunesse Zingg, C.M. direct and choreograph this fresh, contemporary, and emotionally-driven staging of Charpentier’s masterpiece, grounded in the concept of period performance. \n\nThe production is the earliest known French operatic take on the Orpheus myth from Ovid's Metamorphoses. Celebrated American tenor Daniel McGrew is making his Canadian debut with Opera Atelier as Orpheus opposite French-Canadian soprano Mireille Asselin as Eurydice. ","categories":["Dance","Live Performances","Music"],"presenter":"Opera Atelier","image":"5Kjgp2yeVCQPw_sKJnSawg","website":"https://www.operaatelier.com/shows/the-descent-of-orpheus/","tickets":"https://www.rcmusic.com/concerts?tps_activeFacetTab=Concerts%20Presented%20By%20Others&fq=eventpresenter%7C%7COpera+Atelier"},{"id":"347bde7d-1930-4c78-b159-fe036d6a574c","name":"Art for Alzheimer’s","dates":[1793894400000,1793980800000,1794067200000,1794153600000,1794412800000,1794499200000,1794585600000,1794672000000,1794758400000,1795017600000,1795104000000,1795190400000,1795276800000,1795363200000,1795622400000,1795708800000,1795795200000,1795881600000,1795968000000],"start":"2026-11-05T11:00:00-05:00","end":"2026-11-29T11:00:00-05:00","allDay":"Day Event","venue":{"name":"Todmorden Mills Heritage Site","address":"67 Pottery Rd, East York, ON, M4K 2B9","lat":43.686361,"lng":-79.360334},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Art for Alzheimer’s brings together an exceptional collection of original artwork by Canadian illustrator Doug Martin in support of the Alzheimer Society. \n\nSpanning 40 years of his career, the exhibition showcases original and commissioned works, offering guests the opportunity to discover, appreciate, and purchase one-of-a-kind artwork while supporting an important cause.\n\nAll proceeds will go to support Alzheimer's Society of York Region.\n","categories":["Arts/Exhibits","Charity/Cause"],"presenter":"Wherry and Associates Private Wealth Management","image":"rpynIin-O7Wi-LCJZ7z-Rg","website":"https://www.wherryandassociates.ca/events-and-seminars","tickets":null},{"id":"fc885e48-d686-4c5c-a0f8-7978c363f6f7","name":"Art for Alzheimer’s","dates":[1793894400000,1793980800000,1794067200000,1794153600000,1794412800000,1794499200000,1794585600000,1794672000000,1794758400000,1795017600000,1795104000000,1795190400000,1795276800000,1795363200000,1795622400000,1795708800000,1795795200000,1795881600000,1795968000000],"start":"2026-11-05T11:00:00-05:00","end":"2026-11-29T11:00:00-05:00","allDay":"Day Event","venue":{"name":"Todmorden Mills Heritage Site","address":"67 Pottery Rd, East York, ON, M4K 2B9","lat":43.686361,"lng":-79.360334},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Art for Alzheimer’s brings together an exceptional collection of original artwork by Canadian illustrator Doug Martin in support of the Alzheimer Society. \n\nSpanning 40 years of his career, the exhibition showcases original and commissioned works, offering guests the opportunity to discover, appreciate, and purchase one-of-a-kind artwork while supporting an important cause.\n\nAll proceeds will go to support Alzheimer's Society of York Region.\n","categories":["Arts/Exhibits","Charity/Cause"],"presenter":"Wherry and Associates Private Wealth Management","image":"rpynIin-O7Wi-LCJZ7z-Rg","website":"https://www.wherryandassociates.ca/events-and-seminars","tickets":null},{"id":"92cfc052-811b-4041-b159-0775af541849","name":"Essence of the Garden: Plein Air Art Exhibition and Sale","dates":[1791037800000,1791124200000,1791210600000,1791297000000,1791383400000,1791469800000,1791556200000,1791642600000,1791729000000,1791815400000,1791901800000,1791988200000,1792074600000,1792161000000,1792247400000,1792333800000],"start":"2026-10-03T10:30:00-04:00","end":"2026-10-18T10:30:00-04:00","allDay":"Day Event","venue":{"name":"Toronto Botanical Garden","address":"777 Lawrence Ave E, North York, ON, M3C 1P2","lat":43.734346145,"lng":-79.358667018},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrating art, nature and community! \n\nEnjoy over 100 original artworks created outdoors by 46 talented local artists at Toronto Botanical Garden and Edwards Gardens and participate in artist-led workshops and more!\n\nThis curated, site-specific show invites visitors to experience the Garden through the eyes of the artists who paint here, capturing moments of light, movement, and the essence of the natural world.\n\nThis exhibition coincides with Toronto’s Ravine Days, an annual city-wide celebration of Toronto’s ravine system.\n","categories":["Arts/Exhibits","Environmental"],"presenter":null,"image":"dTOLixZ5zgHzXQkFocfpqg","website":"https://torontobotanicalgarden.ca/event/essence-of-the-garden-plein-air-art-exhibition-sale/","tickets":null},{"id":"fc11b43d-a97a-4907-8ce4-4146d68c69a3","name":"ICONIC: The Big Fun Party","dates":[1792794600000,1792881000000],"start":"2026-10-23T18:30:00-04:00","end":"2026-10-24T18:30:00-04:00","allDay":"Night Event","venue":{"name":"Daniels Spectrum","address":"585 Dundas St E, Toronto, ON M5A 2B7","lat":43.6601,"lng":-79.360417},"free":false,"low":250,"high":400,"pwyc":null,"costNotes":null,"description":"The city’s newest, hottest event is back! \n\nGet ready to sparkle and slay at our unforgettable evening of divas and dancing featuring fierce, show-stopping performances by legendary talent followed by a spectacular dance party.\n\nBut remember, ICONIC is not just a party, it is a movement with every beat and step supporting equitable and essential 2SLGBTQIA+ health care programs at Sherbourne Health.\n\nJoin the movement and be ICONIC!\n\n","categories":["Charity/Cause","2SLGBTQ+","Nightlife"],"presenter":null,"image":"2Hh5U4lww_FRbJ_696jjfQ","website":"https://iconicparty.ca","tickets":"https://iconicparty.ca"},{"id":"b09982dd-1c2e-4a33-9b01-47033d94d56d","name":"Piece by Piece: Mosaics for Seniors at East Scarborough Storefront","dates":[1789578000000,1789750800000,1790182800000,1790355600000,1790787600000,1790960400000,1791392400000,1791565200000,1791997200000,1792170000000],"start":"2026-09-16T13:00:00-04:00","end":"2026-10-16T13:00:00-04:00","allDay":"Day Event","venue":{"name":"East Scarborough Storefront","address":"4040 Lawrence Ave E, Scarborough, ON, M1E 2R2","lat":43.766003524,"lng":-79.199011833},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join Mural Routes for a free multi-session mosaic art workshop series for older adults. Led by mosaic mural artist Cristina Delago, participants will learn mosaic-making techniques, create a personalized artwork to take home, and contribute to a larger community mosaic installation. A final culminating event held on October 23 will take place after workshops are complete to celebrate all participants and what they have accomplished.\n\nThe project is delivered through two separate cohorts running concurrently at different locations. Please ensure you select your intended workshop series (cohort), as each cohort has its own location and schedule. All materials are provided and advance registration is required.\n\nA City of Toronto Cultural Hotspot Signature Project","categories":["Arts/Exhibits","Seminars/Workshops"],"presenter":"Mural Routes","image":"F4gQpCvBNPCjggJ5mJPA0g","website":"https://muralroutes.ca/mosaics-for-seniors-2026-storefront/","tickets":"https://muralroutes.ca/mosaics-for-seniors-2026-storefront/"},{"id":"54ee78f4-52d2-4bdf-ac2f-fcf916f8904f","name":"Piece by Piece: Mosaics for Seniors at East Scarborough Storefront","dates":[1789578000000,1789750800000,1790182800000,1790355600000,1790787600000,1790960400000,1791392400000,1791565200000,1791997200000,1792170000000],"start":"2026-09-16T13:00:00-04:00","end":"2026-10-16T13:00:00-04:00","allDay":"Day Event","venue":{"name":"East Scarborough Storefront","address":"4040 Lawrence Ave E, Scarborough, ON, M1E 2R2","lat":43.766003524,"lng":-79.199011833},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join Mural Routes for a free multi-session mosaic art workshop series for older adults. Led by mosaic mural artist Cristina Delago, participants will learn mosaic-making techniques, create a personalized artwork to take home, and contribute to a larger community mosaic installation. A final culminating event held on October 23 will take place after workshops are complete to celebrate all participants and what they have accomplished.\n\nThe project is delivered through two separate cohorts running concurrently at different locations. Please ensure you select your intended workshop series (cohort), as each cohort has its own location and schedule. All materials are provided and advance registration is required.\n\nA City of Toronto Cultural Hotspot Signature Project","categories":["Arts/Exhibits","Seminars/Workshops"],"presenter":"Mural Routes","image":"F4gQpCvBNPCjggJ5mJPA0g","website":"https://muralroutes.ca/mosaics-for-seniors-2026-storefront/","tickets":"https://muralroutes.ca/mosaics-for-seniors-2026-storefront/"},{"id":"0c0f2c28-3697-4a9f-aaf6-adcf708e369c","name":"Rebirth: The Quiet Becoming Installation at Fort York","dates":[1785938400000,1786024800000,1786111200000,1786197600000,1786284000000,1786543200000,1786629600000,1786716000000,1786802400000,1786888800000,1787148000000,1787234400000,1787320800000,1787407200000,1787493600000,1787752800000,1787839200000,1787925600000,1788012000000,1788098400000,1788357600000,1788444000000,1788530400000,1788616800000,1788703200000,1788962400000,1789048800000,1789135200000,1789221600000,1789308000000,1789567200000,1789653600000,1789740000000,1789826400000,1789912800000,1790172000000,1790258400000,1790344800000,1790431200000,1790517600000,1790776800000,1790863200000,1790949600000,1791036000000,1791122400000,1791381600000,1791468000000,1791554400000,1791640800000,1791727200000,1791986400000,1792072800000,1792159200000,1792245600000,1792332000000,1792591200000,1792677600000,1792764000000,1792850400000,1792936800000,1793196000000,1793282400000,1793368800000,1793455200000],"start":"2026-08-05T10:00:00-04:00","end":"2026-10-31T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864096,"lng":-79.406314887},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Experience a bold new outdoor installation on the Gardiner Expressway beside Fort York Visitor Centre. Created by artists Delali Cofie and Yuma Dean Hester, it reimagines the site’s layered histories through contemporary art. An accompanying exhibition inside the Visitor Centre deepens the experience, inviting visitors to encounter the Fort as a living cultural landscape shaped by reflection, dialogue and collaboration.","categories":["Arts/Exhibits","History","Museum"],"presenter":null,"image":"_QHlUAQMVyNc88AaSDfQ8A","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":null},{"id":"f2160d6c-8be1-46fb-948b-aaa1790ae569","name":"Sala-Manca Group: Like a Bird’s Nest","dates":[1790204400000,1790269200000,1790352000000,1790438400000,1790524800000,1790787600000,1790874000000,1790956800000,1791043200000,1791129600000,1791392400000,1791478800000,1791561600000,1791648000000,1791734400000,1791997200000,1792083600000,1792166400000,1792252800000,1792339200000,1792602000000,1792688400000,1792771200000,1792857600000,1792944000000,1793206800000,1793293200000,1793376000000,1793462400000,1793552400000,1793815200000,1793901600000,1793984400000,1794070800000,1794157200000,1794420000000,1794506400000,1794589200000,1794675600000,1794762000000,1795024800000,1795111200000,1795194000000,1795280400000,1795366800000,1795629600000,1795716000000,1795798800000,1795885200000,1795971600000],"start":"2026-09-23T19:00:00-04:00","end":"2026-11-29T12:00:00-05:00","allDay":"Day Event","venue":{"name":"PIX FILM Gallery","address":"1411 Dufferin St, Toronto, ON, M6H 4C7","lat":43.670941,"lng":-79.439848},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy a landmark retrospective from the international artist collective, the Sala-Manca Group.\n\nInstallation, video and photography are exhibited together for the first time, all connected to the ritual object of the sukkah, a temporary hut traditionally erected during the Jewish festival of Sukkot.\n\nOver the last twenty years, Sala-Manca has explored the symbolism and function of the sukkah and related themes of shelter, impermanence, displacement, and liberation. In their hands, the sukkah is interchangeably a ritual structure, an ethnographic object, a work of art, an ephemeral monument, a site of protest, and a performative arena. \n\nThis exhibition traverses unlikely geographies, travelling through time and place, from a small town in Germany where no Jews remain to a Jahalin Bedouin community in Khan al-Ahmar; from the contested streets of Jerusalem to the fraught landscapes of Ontario. ","categories":["Arts/Exhibits","Cultural","Talks"],"presenter":"Fentster Gallery","image":"T7PtQvwfAsgTqCPeW8LzYw","website":"https://fentster.org/birds-nest","tickets":null},{"id":"efe53a70-7fc6-4a87-9c0c-ba3523819cd7","name":"Rebirth: The Quiet Becoming Installation at Fort York","dates":[1785938400000,1786024800000,1786111200000,1786197600000,1786284000000,1786543200000,1786629600000,1786716000000,1786802400000,1786888800000,1787148000000,1787234400000,1787320800000,1787407200000,1787493600000,1787752800000,1787839200000,1787925600000,1788012000000,1788098400000,1788357600000,1788444000000,1788530400000,1788616800000,1788703200000,1788962400000,1789048800000,1789135200000,1789221600000,1789308000000,1789567200000,1789653600000,1789740000000,1789826400000,1789912800000,1790172000000,1790258400000,1790344800000,1790431200000,1790517600000,1790776800000,1790863200000,1790949600000,1791036000000,1791122400000,1791381600000,1791468000000,1791554400000,1791640800000,1791727200000,1791986400000,1792072800000,1792159200000,1792245600000,1792332000000,1792591200000,1792677600000,1792764000000,1792850400000,1792936800000,1793196000000,1793282400000,1793368800000,1793455200000],"start":"2026-08-05T10:00:00-04:00","end":"2026-10-31T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864096,"lng":-79.406314887},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Experience a bold new outdoor installation on the Gardiner Expressway beside Fort York Visitor Centre. Created by artists Delali Cofie and Yuma Dean Hester, it reimagines the site’s layered histories through contemporary art. An accompanying exhibition inside the Visitor Centre deepens the experience, inviting visitors to encounter the Fort as a living cultural landscape shaped by reflection, dialogue and collaboration.","categories":["Arts/Exhibits","History","Museum"],"presenter":null,"image":"_QHlUAQMVyNc88AaSDfQ8A","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":null},{"id":"c9369428-d00b-479a-af66-977069b468dc","name":"Death on the Hills","dates":[1793577600000],"start":"2026-11-01T19:00:00-05:00","end":"2026-11-01T19:00:00-05:00","allDay":"Night Event","venue":{"name":"The Great Hall Toronto","address":"1087 Queen St W, Toronto, ON, M6J 1H3","lat":43.643349301,"lng":-79.422058241},"free":false,"low":25,"high":50,"pwyc":null,"costNotes":null,"description":"We summon you to join a cortège of excommunicated choristers gathers to ask a question the living cannot answer: what happens when we die?\n\nWitches, friars, hermits, and heathens convene on hallowed grounds, reckoning with the fear and fascination of what lies beyond the veil. \n\nAs our pilgrims explore immortal works from Verdi’s otherworldly telling of Macbeth to Elgar’s eerie choral apologue Death on the Hills, fear, peace, judgment and relief are unearthed as Death and his shadowy train ride across the hill. \n\nFeaturing Nicholas Borg, Victoria Borg, Ryan Downey, Gwenna Fairchild-Taylor, Claire Harris, Leanne Kaufman, John Kirby, Megan Quick, and Daevyd Pepper.\nWorks by Elgar, Verdi, Barber, Clarke, Britten, Heggie and more.","categories":["Arts/Exhibits","Live Performances","Music","Halloween"],"presenter":null,"image":"fx29fKHPSfaCAckj716aBQ","website":"https://buytickets.at/deathonthehills","tickets":"https://www.tickettailor.com/events/deathonthehills"},{"id":"08c2acf8-ddbb-4349-b24a-2c8625a03867","name":"Historic Holiday Gingerbread Workshop at Fort York","dates":[1797696000000,1797706800000,1797782400000,1797793200000,1798041600000,1798052400000,1798128000000,1798138800000,1798387200000,1798398000000,1798646400000,1798657200000,1798732800000,1798743600000,1798905600000,1798916400000,1798992000000,1799002800000],"start":"2026-12-19T11:00:00-05:00","end":"2027-01-03T14:00:00-05:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site ","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864,"lng":-79.406315},"free":false,"low":20,"high":null,"pwyc":null,"costNotes":null,"description":"Experience the warmth of the holiday season through a hands-on baking workshop in the historic Officers' Mess Kitchen.  Children and teens aged 8 to 14 can prepare an historic recipe using traditional methods including creaming butter, pounding sugar, grating spices, sifting flour, rolling and cutting dough.  \n\nWhile the gingerbread bakes, participants can enjoy a festive scavenger hunt in the Fort and return back to the kitchen to sample their freshly baked gingerbread biscuits and take home the historic recipe to recreate in their own kitchens.  ","categories":["Food/Culinary","History","Museum","Winter Holidays"],"presenter":null,"image":"OOkRdDMZf1TJSEdlmkqvKg","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/f778e3cc-f1b6-403a-baa6-4c8276e34a34"},{"id":"6cfe11e5-f9ab-4f6e-b2f8-537c20a54570","name":"Agency & Defiance: Exhibit at Montgomery's Inn","dates":[1793980800000,1794067200000,1794153600000,1794412800000,1794499200000,1794585600000,1794672000000,1794758400000,1795017600000,1795104000000,1795190400000,1795276800000,1795363200000,1795622400000,1795708800000,1795795200000,1795881600000,1795968000000,1796227200000,1796313600000,1796400000000,1796486400000,1796572800000,1796832000000,1796918400000,1797004800000,1797091200000,1797177600000,1797436800000,1797523200000,1797609600000,1797696000000,1797782400000,1798041600000,1798128000000,1798214400000,1798300800000,1798387200000,1798646400000,1798732800000,1798819200000,1798905600000,1798992000000,1799251200000,1799337600000,1799424000000,1799510400000,1799596800000,1799856000000,1799942400000,1800028800000,1800115200000,1800201600000,1800460800000,1800547200000,1800633600000,1800720000000,1800806400000,1801065600000,1801152000000,1801238400000,1801324800000,1801411200000,1801670400000,1801756800000,1801843200000,1801929600000,1802016000000,1802275200000,1802361600000,1802448000000,1802534400000,1802620800000,1802880000000,1802966400000,1803052800000,1803139200000,1803225600000,1803484800000,1803571200000,1803657600000,1803744000000,1803830400000],"start":"2026-11-06T11:00:00-05:00","end":"2027-02-28T11:00:00-05:00","allDay":"Day Event","venue":{"name":"Montgomery's Inn","address":"4709 Dundas St W, Etobicoke, ON, M9A 1A8","lat":43.651679,"lng":-79.525659},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Experience Agency and Defiance, featuring never-before-seen works by Toronto-based artist Frantz Brent-Harris inspired by Jamaican Junkanoo. Through these figures, the artist shares the enduring legacy of agency, defiance, resilience, joy, love, and cultural expression that sustained enslaved peoples and their descendants, even under inhumane conditions. ","categories":["Arts/Exhibits","History","Museum","Black History Month"],"presenter":null,"image":"qZyjxxbPBbXkbmhYN7I9Sg","website":"https://www.toronto.ca/montgomerysinn","tickets":null},{"id":"67c37c78-b084-4cce-a18c-9d4dfc8b9746","name":"Agency & Defiance: Exhibit at Montgomery's Inn","dates":[1793980800000,1794067200000,1794153600000,1794412800000,1794499200000,1794585600000,1794672000000,1794758400000,1795017600000,1795104000000,1795190400000,1795276800000,1795363200000,1795622400000,1795708800000,1795795200000,1795881600000,1795968000000,1796227200000,1796313600000,1796400000000,1796486400000,1796572800000,1796832000000,1796918400000,1797004800000,1797091200000,1797177600000,1797436800000,1797523200000,1797609600000,1797696000000,1797782400000,1798041600000,1798128000000,1798214400000,1798300800000,1798387200000,1798646400000,1798732800000,1798819200000,1798905600000,1798992000000,1799251200000,1799337600000,1799424000000,1799510400000,1799596800000,1799856000000,1799942400000,1800028800000,1800115200000,1800201600000,1800460800000,1800547200000,1800633600000,1800720000000,1800806400000,1801065600000,1801152000000,1801238400000,1801324800000,1801411200000,1801670400000,1801756800000,1801843200000,1801929600000,1802016000000,1802275200000,1802361600000,1802448000000,1802534400000,1802620800000,1802880000000,1802966400000,1803052800000,1803139200000,1803225600000,1803484800000,1803571200000,1803657600000,1803744000000,1803830400000],"start":"2026-11-06T11:00:00-05:00","end":"2027-02-28T11:00:00-05:00","allDay":"Day Event","venue":{"name":"Montgomery's Inn","address":"4709 Dundas St W, Etobicoke, ON, M9A 1A8","lat":43.651679,"lng":-79.525659},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Experience Agency and Defiance, featuring never-before-seen works by Toronto-based artist Frantz Brent-Harris inspired by Jamaican Junkanoo. Through these figures, the artist shares the enduring legacy of agency, defiance, resilience, joy, love, and cultural expression that sustained enslaved peoples and their descendants, even under inhumane conditions. ","categories":["Arts/Exhibits","History","Museum","Black History Month"],"presenter":null,"image":"qZyjxxbPBbXkbmhYN7I9Sg","website":"https://www.toronto.ca/montgomerysinn","tickets":null},{"id":"94b92957-1ba6-4e7d-86e0-435f78db5b69","name":"Agency & Defiance: Exhibit at Montgomery's Inn","dates":[1793980800000,1794067200000,1794153600000,1794412800000,1794499200000,1794585600000,1794672000000,1794758400000,1795017600000,1795104000000,1795190400000,1795276800000,1795363200000,1795622400000,1795708800000,1795795200000,1795881600000,1795968000000,1796227200000,1796313600000,1796400000000,1796486400000,1796572800000,1796832000000,1796918400000,1797004800000,1797091200000,1797177600000,1797436800000,1797523200000,1797609600000,1797696000000,1797782400000,1798041600000,1798128000000,1798214400000,1798300800000,1798387200000,1798646400000,1798732800000,1798819200000,1798905600000,1798992000000,1799251200000,1799337600000,1799424000000,1799510400000,1799596800000,1799856000000,1799942400000,1800028800000,1800115200000,1800201600000,1800460800000,1800547200000,1800633600000,1800720000000,1800806400000,1801065600000,1801152000000,1801238400000,1801324800000,1801411200000,1801670400000,1801756800000,1801843200000,1801929600000,1802016000000,1802275200000,1802361600000,1802448000000,1802534400000,1802620800000,1802880000000,1802966400000,1803052800000,1803139200000,1803225600000,1803484800000,1803571200000,1803657600000,1803744000000,1803830400000],"start":"2026-11-06T11:00:00-05:00","end":"2027-02-28T11:00:00-05:00","allDay":"Day Event","venue":{"name":"Montgomery's Inn","address":"4709 Dundas St W, Etobicoke, ON, M9A 1A8","lat":43.651679,"lng":-79.525659},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Experience Agency and Defiance, featuring never-before-seen works by Toronto-based artist Frantz Brent-Harris inspired by Jamaican Junkanoo. Through these figures, the artist shares the enduring legacy of agency, defiance, resilience, joy, love, and cultural expression that sustained enslaved peoples and their descendants, even under inhumane conditions. ","categories":["Arts/Exhibits","History","Museum","Black History Month"],"presenter":null,"image":"qZyjxxbPBbXkbmhYN7I9Sg","website":"https://www.toronto.ca/montgomerysinn","tickets":null},{"id":"f08acca6-6996-464e-96ff-30966cca9a91","name":"Patterns That Aren't Exhibition","dates":[1792846800000,1792933200000,1793019600000,1793106000000,1793192400000,1793278800000,1793365200000,1793451600000,1793541600000,1793628000000,1793714400000,1793800800000,1793887200000,1793973600000,1794060000000,1794146400000,1794232800000,1794319200000,1794405600000,1794492000000,1794578400000,1794664800000,1794751200000,1794837600000,1794924000000,1795010400000],"start":"2026-10-24T09:00:00-04:00","end":"2026-11-18T09:00:00-05:00","allDay":"Day Event","venue":{"name":"Cedar Ridge Creative Centre","address":"225 Confederation Dr, Scarborough, ON, M1G 1B2","lat":43.75743,"lng":-79.207132},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Step into the intricate world of artist David Currie as he explores how humans are hard-wired to seek out patterns as a means of adapting to their environment, whether connecting imaginary lines to stars or writing algorithms that direct a robot’s movements. But once a pattern is understood, interest tends to fade. Here, Currie has developed a refreshingly new visual vocabulary, one built to engage rather than fade into the background in his series of large-scale, mixed media, papercut artworks that combine recent discoveries in mathematics with a lifetime of the artist’s skill, development and commitment.","categories":["Arts/Exhibits","Artisan","Cultural"],"presenter":null,"image":"kuVTMxi1tk-BXO-t1GOSLw","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/cedar-ridge-creative-centre/","tickets":null},{"id":"95385ba3-2976-4d29-8072-009c7dc5711f","name":"Patterns That Aren't Exhibition","dates":[1792846800000,1792933200000,1793019600000,1793106000000,1793192400000,1793278800000,1793365200000,1793451600000,1793541600000,1793628000000,1793714400000,1793800800000,1793887200000,1793973600000,1794060000000,1794146400000,1794232800000,1794319200000,1794405600000,1794492000000,1794578400000,1794664800000,1794751200000,1794837600000,1794924000000,1795010400000],"start":"2026-10-24T09:00:00-04:00","end":"2026-11-18T09:00:00-05:00","allDay":"Day Event","venue":{"name":"Cedar Ridge Creative Centre","address":"225 Confederation Dr, Scarborough, ON, M1G 1B2","lat":43.75743,"lng":-79.207132},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Step into the intricate world of artist David Currie as he explores how humans are hard-wired to seek out patterns as a means of adapting to their environment, whether connecting imaginary lines to stars or writing algorithms that direct a robot’s movements. But once a pattern is understood, interest tends to fade. Here, Currie has developed a refreshingly new visual vocabulary, one built to engage rather than fade into the background in his series of large-scale, mixed media, papercut artworks that combine recent discoveries in mathematics with a lifetime of the artist’s skill, development and commitment.","categories":["Arts/Exhibits","Artisan","Cultural"],"presenter":null,"image":"kuVTMxi1tk-BXO-t1GOSLw","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/cedar-ridge-creative-centre/","tickets":null},{"id":"3d5ae582-1bac-416d-b3b0-8ded52771db0","name":"Agency & Defiance: Exhibit at Montgomery's Inn","dates":[17939808