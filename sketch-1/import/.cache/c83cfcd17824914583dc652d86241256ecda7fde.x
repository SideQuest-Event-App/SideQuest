er"],"presenter":null,"image":"WxjChgoUOpqklJ1chm1hgQ","website":"https://juliekinnear.com/blogs/east-york-farmers-market","tickets":null},{"id":"3768ecf5-bd95-4861-8bc1-8e4b56f06cfd","name":"Malvern Farmers' Market","dates":[1781121600000,1781726400000,1782331200000,1782936000000,1783540800000,1784145600000,1784750400000,1785355200000,1785960000000,1786564800000,1787169600000,1787774400000,1788379200000,1788984000000,1789588800000,1790193600000,1790798400000,1791403200000,1792008000000],"start":"2026-06-10T16:00:00-04:00","end":"2026-10-14T16:00:00-04:00","allDay":"Day Event","venue":{"name":"Malvern F","address":"90 Littles Rd, Scarborough, ON M1B 5E2","lat":43.81863198739519,"lng":-79.2054285862019},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Fresh, local food at the heart of the neighbourhood Every Wednesday evening from June to October, a weekly space for connection, culture, and community-grown food.\n\nThe market features:\n-Produce grown at Malvern Urban Farm by local farmers\n-Hot meals from community restaurants and caterers\n-Family-friendly activities and information tables\n-Seasonal events and neighbourhood updates\n‍\nThe market is more than a place to shop. It is where stories are shared, flavours are celebrated, and residents reconnect with the land and each other.","categories":["Farmers' Market","Other"],"presenter":null,"image":"Jh5madSLtr7021cfDf95IQ","website":"https://www.mfrc.org/urban-agriculture-and-food-programs","tickets":null},{"id":"ba1ec32d-9c61-4780-b048-707c6e90287c","name":"Malvern Farmers' Market","dates":[1781121600000,1781726400000,1782331200000,1782936000000,1783540800000,1784145600000,1784750400000,1785355200000,1785960000000,1786564800000,1787169600000,1787774400000,1788379200000,1788984000000,1789588800000,1790193600000,1790798400000,1791403200000,1792008000000],"start":"2026-06-10T16:00:00-04:00","end":"2026-10-14T16:00:00-04:00","allDay":"Day Event","venue":{"name":"Malvern F","address":"9