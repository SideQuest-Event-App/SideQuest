1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000,1799254800000,1799341200000,1799427600000,1799514000000,1799600400000,1799859600000,1799946000000,1800032400000,1800118800000,1800205200000,1800464400000,1800550800000,1800637200000,1800723600000,1800810000000,1801069200000,1801155600000,1801242000000,1801328400000,1801414800000,1801674000000,1801760400000,1801846800000,1801933200000,1802019600000],"start":"2026-09-24T12:00:00-04:00","end":"2027-02-07T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":"\nChildren 5 and under visit for free.","description":"Featuring several examples of Palestinian tatreez (embroidery) from the Textile Museum’s collection, most of which will be exhibited for the first time! \n\nRetracing Tatreez highlights what these belongings can tell us about the relationship between Palestinians and their homelands in the twentieth century and beyond.\n\nIn this exhibition, curator Nina Rafique showcases these pieces with restored historical context and invites visitors to re-engage with their ways of storytelling. \n\nIn doing so, Retracing Tatreez highlights what these embroideries can tell us about the unique regional connections between Palestinians and their homelands, as well as the journeys of these objects from the hands of their original creators to today.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"j37-eBOZLJMeQ8B7zUJpJg","website":"https://textilemuseum.ca/event/retracing-tatreez-palestinian-thobes-through-the-20th-century/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"d2a5aacd-38a1-4a37-8438-a01a9aef87ae","name":"Retracing Tatreez: Palestinian Thobes through the Twentieth Century","dates":[1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000,1799254800000,1799341200000,1799427600000,1799514000000,1799600400000,1799859600000,1799946000000,1800032400000,1800118800000,1800205200000,1800464400000,1800550800000,1800637200000,1800723600000,1800810000000,1801069200000,1801155600000,1801242000000,1801328400000,1801414800000,1801674000000,1801760400000,1801846800000,1801933200000,1802019600000],"start":"2026-09-24T12:00:00-04:00","end":"2027-02-07T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":"\nChildren 5 and under visit for free.","description":"Featuring several examples of Palestinian tatreez (embroidery) from the Textile Museum’s collection, most of which will be exhibited for the first time! \n\nRetracing Tatreez highlights what these belongings can tell us about the relationship between Palestinians and their homelands in the twentieth century and beyond.\n\nIn this exhibition, curator Nina Rafique showcases these pieces with restored historical context and invites visitors to re-engage with their ways of storytelling. \n\nIn doing so, Retracing Tatreez highlights what these embroideries can tell us about the unique regional connections between Palestinians and their homelands, as well as the journeys of these objects from the hands of their original creators to today.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"j37-eBOZLJMeQ8B7zUJpJg","website":"https://textilemuseum.ca/event/retracing-tatreez-palestinian-thobes-through-the-20th-century/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"2c4d71f6-ed1e-42c5-afe7-b24e46e57fd6","name":"Retracing Tatreez: Palestinian Thobes through the Twentieth Century","dates":[1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000,1799254800000,1799341200000,1799427600000,1799514000000,1799600400000,1799859600000,1799946000000,1800032400000,1800118800000,1800205200000,1800464400000,1800550800000,1800637200000,1800723600000,1800810000000,1801069200000,1801155600000,1801242000000,1801328400000,1801414800000,1801674000000,1801760400000,1801846800000,1801933200000,1802019600000],"start":"2026-09-24T12:00:00-04:00","end":"2027-02-07T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":"\nChildren 5 and under visit for free.","description":"Featuring several examples of Palestinian tatreez (embroidery) from the Textile Museum’s collection, most of which will be exhibited for the first time! \n\nRetracing Tatreez highlights what these belongings can tell us about the relationship between Palestinians and their homelands in the twentieth century and beyond.\n\nIn this exhibition, curator Nina Rafique showcases these pieces with restored historical context and invites visitors to re-engage with their ways of storytelling. \n\nIn doing so, Retracing Tatreez highlights what these embroideries can tell us about the unique regional connections between Palestinians and their homelands, as well as the journeys of these objects from the hands of their original creators to today.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"j37-eBOZLJMeQ8B7zUJpJg","website":"https://textilemuseum.ca/event/retracing-tatreez-palestinian-thobes-through-the-20th-century/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"7d3c3387-6158-463d-93d5-1dc222a583cb","name":"TD Encounters: Orison","dates":[1796085000000],"start":"2026-11-30T19:30:00-05:00","end":"2026-11-30T19:30:00-05:00","allDay":"Night Event","venue":{"name":"Hugh's Room","address":"296 Broadview Ave, Toronto, ON, M4M 2G7","lat":43.663844723,"lng":-79.352266217},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Orison (prayer) is a musical collaboration from musician Daniel Áñez and composer James O’Callaghan, connecting science fiction imagery with spirituality and the idea of ‘alien-ness’ in all of its senses: social, cultural, psychological, extra-terrestrial. The work centres the unique early electronic instrument, the ondes Martenot, as a jumping-off point to interact with synthesized soundscapes, field recordings, techno, poetic text, and documentary-like spoken confessionals.\n\n Featuring Ánez on the incredibly evocative ondes Martenot, with O’Callaghan on electronics, this Encounters event presents the current musical stage in the development of a new music theatre work. Audiences will experience fragments, improvisatory excerpts, and other material from this long-term work in progress, offering a rare opportunity to engage with the creative process as the piece continues to evolve. \n\n Please join us for this unique musical experience.","categories":["Live Performances","Music","Nightlife"],"presenter":null,"image":"ApsswJKfFnz-UrtoJktk-Q","website":"https://soundstreams.ca/events/td-encounters-orison/","tickets":"https://soundstreams.ca/events/td-encounters-orison/"},{"id":"e682bf43-757d-40a0-be31-cdd5e84e961f","name":"Art Toronto 2026","dates":[1793304000000,1793376000000,1793462400000,1793552400000],"start":"2026-10-29T16:00:00-04:00","end":"2026-11-01T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Metro Toronto Convention Centre","address":"255 Front St W, Toronto, ON, M5V 2W6","lat":43.644049656,"lng":-79.386720757},"free":false,"low":25,"high":440,"pwyc":null,"costNotes":null,"description":"Canada’s leading international fair for modern and contemporary art will bring together 105 galleries, organizations and cultural institutions from across Canada, the United States, Latin America and Europe.\n\nEnjoy thousands of works by emerging and established artists across painting, sculpture, photography, textiles, installation and new media.\n\nHighlights include the return of Arte Sur, featuring 11 galleries from Mexico, Central America and South America, as well as solo presentations dedicated to individual artists and new programming for emerging collectors. \n\nNearly one-third of participating galleries will present work by Indigenous artists. \n\nVisitors can also take part in curator-led tours, Platform Talks and educational programming designed to make collecting more accessible.\n","categories":["Arts/Exhibits"],"presenter":null,"image":"yjzdEkBXJtQkDio5WDHxpQ","website":"https://arttoronto.ca/home/","tickets":"https://arttoronto.ca/home/tickets/?gad_source=1&gad_campaignid=22937691808&gbraid=0AAAABAIViEuF591mb7ytL22VlsqQ59F77&gclid=CjwKCAjwq8PVBhAKEiwA2i3SHfXK2uu4R_jwkDAZLzJTTvotY6tTc5gybgEiTsGq5YvEuZT1MkbmOhoC1hYQAvD_BwE"},{"id":"c78b3ad4-552f-4013-a229-072bd57b7d13","name":"Art Toronto 2026","dates":[1793304000000,1793376000000,1793462400000,1793552400000],"start":"2026-10-29T16:00:00-04:00","end":"2026-11-01T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Metro Toronto Convention Centre","address":"255 Front St W, Toronto, ON, M5V 2W6","lat":43.644049656,"lng":-79.386720757},"free":false,"low":25,"high":440,"pwyc":null,"costNotes":null,"description":"Canada’s leading international fair for modern and contemporary art will bring together 105 galleries, organizations and cultural institutions from across Canada, the United States, Latin America and Europe.\n\nEnjoy thousands of works by emerging and established artists across painting, sculpture, photography, textiles, installation and new media.\n\nHighlights include the return of Arte Sur, featuring 11 galleries from Mexico, Central America and South America, as well as solo presentations dedicated to individual artists and new programming for emerging collectors. \n\nNearly one-third of participating galleries will present work by Indigenous artists. \n\nVisitors can also take part in curator-led tours, Platform Talks and educational programming designed to make collecting more accessible.\n","categories":["Arts/Exhibits"],"presenter":null,"image":"yjzdEkBXJtQkDio5WDHxpQ","website":"https://arttoronto.ca/home/","tickets":"https://arttoronto.ca/home/tickets/?gad_source=1&gad_campaignid=22937691808&gbraid=0AAAABAIViEuF591mb7ytL22VlsqQ59F77&gclid=CjwKCAjwq8PVBhAKEiwA2i3SHfXK2uu4R_jwkDAZLzJTTvotY6tTc5gybgEiTsGq5YvEuZT1MkbmOhoC1hYQAvD_BwE"},{"id":"6eee62e1-bb97-40f1-882d-15e26409233e","name":"Canvas Chronicles","dates":[1790164800000,1790251200000,1790337600000,1790431200000,1790596800000,1790683200000,1790769600000,1790856000000,1790942400000,1791036000000,1791201600000,1791288000000,1791374400000,1791460800000,1791547200000,1791640800000,1791806400000,1791892800000,1791979200000,1792065600000,1792152000000,1792245600000,1792411200000,1792497600000,1792584000000],"start":"2026-09-23T08:00:00-04:00","end":"2026-10-21T08:00:00-04:00","allDay":"Day Event","venue":{"name":"Etobicoke Civic Centre Art Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Every brushstroke tells a story in the Federation of Canadian Artists Toronto exhibit. This collection captures the artist’s thoughts, emotions, and moments in time, weaving technical skill and personality into complex visual narratives. The adventurous members invite you to engage with their inspired works—art that stirs imagination, reveals process, and celebrates the stories behind each creation.\n\nReception: September 27, 2–4 p.m.","categories":["Arts/Exhibits"],"presenter":null,"image":"4-Cfo3Q5_lOCyFEhvqYtpQ","website":"https://www.toronto.ca/explore-