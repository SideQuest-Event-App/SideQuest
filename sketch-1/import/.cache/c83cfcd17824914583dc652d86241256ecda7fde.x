74800000,1786179600000,1786784400000,1787389200000,1787994000000,1788598800000,1789203600000,1789808400000,1790413200000,1791018000000,1791622800000,1792227600000,1792832400000,1793437200000,1794045600000,1794650400000,1795255200000,1795860000000,1796464800000,1797069600000,1797674400000,1798279200000,1798884000000],"start":"2026-05-23T05:00:00-04:00","end":"2027-01-02T05:00:00-05:00","allDay":"Night Event","venue":{"name":"St. Lawrence North Market","address":"92 Front St E, Toronto","lat":43.649145,"lng":-79.371526},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Visit the Saturday Farmers' Market in the newly redeveloped St. Lawrence Market North building. Discover seasonal produce, baked goods, meats, cheeses, flowers and pantry staples from local vendors all under one roof.","categories":["Food/Culinary"],"presenter":null,"image":"a0PsB9WOlmzpz_7ENsYW_A","website":"https://www.stlawrencemarket.com/","tickets":null},{"id":"edf768e6-410b-4fce-adf1-e54ff88d7b8a","name":"Saturday Farmers' Market","dates":[1779526800000,1780131600000,1780736400000,1781341200000,1781946000000,1782550800000,1783155600000,1783760400000,1784365200000,1784970000000,1785574800000,1786179600000,1786784400000,1787389200000,1787994000000,1788598800000,1789203600000,1789808400000,1790413200000,1791018000000,1791622800000,1792227600000,1792832400000,1793437200000,1794045600000,1794650400000,1795255200000,1795860000000,1796464800000,1797069600000,1797674400000,1798279200000,1798884000000],"start":"2026-05-23T05:00:00-04:00","end":"2027-01-02T05:00:00-05:00","allDay":"Night Event","venue":{"name":"St. Lawrence North Market","address":"92 Front St E, Toronto","lat":43.649145,"lng":-79.371526},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Visit the Saturday Farmers' Market in the newly redeveloped St. Lawrence Market North building. Discover seasonal produce, baked goods, meats, cheeses, flowers and pantry staples from local vendors all under one roof.","categories":["Food/Culinary"],"presenter":null,"image":"a0PsB9WOlmzpz_7ENsYW_A","website":"https://www.stlawrencemarket.com/","tickets":null},{"id":"09537927-cd9b-4087-981a-86bbe486b928","name":"A Christmas Carol","dates":[1794528000000,1794616200000,1794702600000,1794789000000,1794961800000,1795048200000,1795134600000,1795221000000,1795307400000,1795393800000,1795566600000,1795653000000,1795739400000,1795825800000,1795912200000,1795998600000,1796171400000,1796257800000,1796344200000,1796430600000,1796517000000,1796603400000,1796776200000,1796862600000,1796949000000,1797035400000,1797121800000,1797208200000,1797381000000,1797467400000,1797553800000,1797640200000,1797726600000,1797813000000,1797985800000,1798072200000],"start":"2026-11-12T19:00:00-05:00","end":"2026-12-23T19:30:00-05:00","allDay":"Night Event","venue":{"name":"The Fleck at Harbourfront Centre Theatre","address":"231 Queens Quay W, Toronto, ON, M5J 2G8","lat":43.63867054,"lng":-79.382157854},"free":false,"low":50,"high":140,"pwyc":null,"costNotes":null,"description":"Dickens’s timeless holiday story of transformation, kindness and human connection.\n\nThis fresh adaptation by Tim Carroll brings Charles Dickens’s world to life through inventive puppetry, towering ghosts that fill the stage, traditional carols and audience participation with spirited sing-alongs. Interactive performers mingle throughout the theatre, while beautifully detailed period costumes and sets create an atmospheric Victorian Christmas.\n\nMore than 175 years after Dickens first published A Christmas Carol, audiences still recognize themselves in Ebenezer Scrooge: someone who discovers that it’s never too late in life to choose kindness and human connection. For centuries, this iconic story has endured because its themes are still relevant today: What really matters to us? And can people truly change?\n","categories":["Literary","Live Performances","Theatre"],"presenter":null,"image":"LEdIigpmjGIgT9QepzspLw","website":"https://harbourfrontcentre.com/event/a-christmas-carol/","tickets":"https://ci.ovationtix.com/36999/production/1283036"},{"id":"ec838598-27ce-4f05-9818-c3c6c0c24962","name":"A Christmas Carol","dates":[1794528000000,1794616200000,1794702600000,1794789000000,1794961800000,1795048200000,1795134600000,1795221000000,1795307400000,1795393800000,1795566600000,1795653000000,1795739400000,1795825800000,1795912200000,1795998600000,1796171400000,1796257800000,1796344200000,1796430600000,1796517000000,1796603400000,1796776200000,1796862600000,1796949000000,1797035400000,1797121800000,1797208200000,1797381000000,1797467400000,1797553800000,1797640200000,1797726600000,1797813000000,1797985800000,1798072200000],"start":"2026-11-12T19:00:00-05:00","end":"2026-12-23T19:30:00-05:00","allDay":"Night Event","venue":{"name":"The Fleck at Harbourfront Centre Theatre","address":"231 Queens Quay W, Toronto, ON, M5J 2G8","lat":43.63867054,"lng":-79.382157854},"free":false,"low":50,"high":140,"pwyc":null,"costNotes":null,"description":"Dickens’s timeless holiday story of transformation, kindness and human connection.\n\nThis fresh adaptation by Tim Carroll brings Charles Dickens’s world to life through inventive puppetry, towering ghosts that fill the stage, traditional carols and audience participation with spirited sing-alongs. Interactive performers mingle throughout the theatre, while beautifully detailed period costumes and sets create an atmospheric Victorian Christmas.\n\nMore than 175 years after Dickens first published A Christmas Carol, audiences still recognize themselves in Ebenezer Scrooge: someone who discovers that it’s never too late in life to choose kindness and human connection. For centuries, this iconic story has endured because its themes are still relevant today: What really matters to us? And can people truly change?\n","categories":["Literary","Live Performances","Theatre"],"presenter":null,"image":"LEdIigpmjGIgT9QepzspLw","website":"https://harbourfrontce