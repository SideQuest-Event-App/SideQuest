ickets":"https://www.eventbrite.com/e/toronto-sunday-market-at-parkdale-hall-tickets-1981191495094"},{"id":"5de2ea40-703c-41d8-ac77-44b8783b3a68","name":"Toronto Sunday Market","dates":[1770566400000,1771171200000,1771776000000,1772380800000,1772982000000,1773586800000,1774191600000,1774796400000,1775401200000,1776006000000,1776610800000,1777215600000,1777820400000,1778425200000,1779030000000,1779634800000,1780239600000,1780844400000,1781449200000,1782054000000,1782658800000,1783263600000,1783868400000,1784473200000,1785078000000,1785682800000,1786287600000,1786892400000,1787497200000,1788102000000,1788706800000,1789311600000,1789916400000,1790521200000,1791126000000,1791730800000,1792335600000,1792940400000,1793548800000,1794153600000,1794758400000,1795363200000,1795968000000,1796572800000,1797177600000,1797782400000],"start":"2026-02-08T11:00:00-05:00","end":"2026-12-20T11:00:00-05:00","allDay":"Day Event","venue":{"name":"The Parkdale Hall","address":"1605 Queen St W, Toronto, ON, M6R 1A9","lat":43.638869,"lng":-79.444081},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrating local food, antiques, handmade goods and community.\n\n\n","categories":["Arts/Exhibits","Artisan","Consumer Show/Convention"],"presenter":null,"image":"ozk451_PfWrf5ssZGWAwoQ","website":"https://theparkdalehall.com/new/toronto-sunday-market/","tickets":"https://www.eventbrite.com/e/toronto-sunday-market-at-parkdale-hall-tickets-1981191495094"},{"id":"0f2be93d-b4f8-441c-92a8-2c16020d3ad4","name":"Immersion Festival","dates":[1794153600000,1794263400000,1794439800000,1794526200000,1794702600000,1794769200000,1794958200000,1795131000000,1795221000000,1795287600000,1795307400000,1795374000000,1795379400000],"start":"2026-11-08T11:00:00-05:00","end":"2026-11-22T15:30:00-05:00","allDay":"Day Event","venue":{"name":"Betty Oliphant Theatre","address":"404 Jarvis St, Toronto, ON M4Y 2G6","lat":43.6643,"lng":-79.3777},"free":false,"low":0,"high":150,"pwyc":null,"costNotes":null,"description":"Join us for a celebration of Canadian cultural life for audiences and a sought-after performance and networking opportunity for renowned and aspiring artists, with three distinct stage performances, twelve workshops, a dance education roundtable, and community gatherings. Performances and workshops are open to all!\n\nEnjoy The Vanguard Presentation includes commissioned works by Katlyn Addison and Tanya Charles, Travis Knights and Divine Brown, and Nubian Néné. The National Presentation features Ebnflōh Dance Company, Lua Shayenne Dance Company, and N.A.P.P.Y. Dance, while the Next Gen showcase highlights emerging Black youth artists.\n\nOur workshops for youth, beginners, and professionals are led by Kwasi Obeng-Adjei, Reequal Smith, Natasha Powell, and Isaac Gasangwa, exploring diverse Black and diasporic movement practices. \n\nThree gathering events bring together presenters, artists, and academics to connect, exchange ideas, and celebrate Black dance across Canada.","categories":["Dance","Live Performances","Seminars/Workshops"],"presenter":"dance Immersion","image":"sERkkQuapznV_lRLtFWEKw","website":"https://danceimmersion.ca/immersionfestival/","tickets":"https://danceimmersion.ca/immersionfestival/#full-festival-info"},{"id":"08cf00cc-432b-4490-b0d6-56efd9f5884d","name":"Downsview Park Merchants Market","dates":[1779544800000,1779631200000,1780149600000,1780236000000,1780754400000,1780840800000,1781359200000,1781445600000,1781964000000,1782050400000,1782568800000,1782655200000,1783173600000,1783260000000,1783778400000,1783864800000,1784383200000,1784469600000,1784988000000,1785074400000,1785592800000,1785679200000,1786197600000,1786284000000,1786802400000,1786888800000,1787407200000,1787493600000,1788012000000,1788098400000,1788616800000,1788703200000,1789221600000,1789308000000,1789826400000,1789912800000,1790431200000,1790517600000,1791036000000,1791122400000,1791640800000,1791727200000,1792245600000,1792332000000,1792850400000,1792936800000,1793455200000,1793545200000,1794063600000,1794150000000,1794668400000,1794754800000,1795273200000,1795359600000,1795878000000,1795964400000,1796482800000,1796569200000,1797087600000,1797174000000,1797692400000,1797778800000,1798297200000,1798383600000,1798902000000,1798988400000,1799506800000,1799593200000,1800111600000,1800198000000,1800716400000,1800802800000,1801321200000,1801407600000,1801926000000,1802012400000,1802530800000,1802617200000,1803135600000,1803222000000,1803740400000,1803826800000,1804345200000,1804431600000,1804950000000,1805032800000,1805551200000,1805637600000,1806156000000,1806242400000,1806760800000,1806847200000,1807365600000,1807452000000,1807970400000,1808056800000,1808575200000,1808661600000,1809180000000,1809266400000],"start":"2026-05-23T10:00:00-04:00","end":"2027-05-02T10:00:00-04:00","allDay":"Day Event","venue":{"name":"40 Carl Hall Rd","address":"40 Carl Hall Rd, North York, ON, M3K 2C1","lat":43.7483766822,"lng":-79.4791132214},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Downsview Park Merchants Market is one of Toronto’s vibrant weekend destinations, offering a dynamic indoor marketplace experience for shoppers of all ages. Located in North York, the market features a diverse mix of local vendors offering clothing, accessories, home goods, beauty products, electronics, toys, collectibles, gifts, fresh produce, specialty items, and incredible deals. Visitors can also explore the farmers market section featuring fresh fruits, vegetables, and locally sourced goods, alongside an international food court offering a variety of delicious global cuisines and authentic flavours. With a lively, family-friendly atmosphere, the market is a perfect destination for bargain hunters, families, food lovers, and those looking to support local and small businesses. Open every Saturday and Sunday from 10 AM to 5 PM, Downsview Park Merchants Market combines shopping, food, culture, and community into one exciting weekend experience in Toronto.","categories":["Farmers' Market","Food/Culinary","Other"],"presenter":null,"image":"HsINX9unS5aRBvcRR5D6QA","website":"https://www.dpmarket.com","tickets":null},{"id":"825c0153-2602-4925-8240-86c91e2589b5","name":"Market 707","dates":[1779462000000,1779548400000,1779807600000,1779894000000,1779980400000,1780066800000,1780153200000,1780412400000,1780498800000,1780585200000,1780671600000,1780758000000,1781017200000,1781103600000,1781190000000,1781276400000,1781362800000,1781622000000,1781708400000,1781794800000,1781881200000,1781967600000,1782226800000,1782313200000,1782399600000,1782486000000,1782572400000,1782831600000,1782918000000,1783004400000,1783090800000,1783177200000,1783436400000,1783522800000,1783609200000,1783695600000,1783782000000,1784041200000,1784127600000,1784214000000,1784300400000,1784386800000,1784646000000,1784732400000,1784818800000,1784905200000,1784991600000,1785250800000,1785337200000,1785423600000,1785510000000,1785596400000,1785855600000,1785942000000,1786028400000,1786114800000,1786201200000,1786460400000,1786546800000,1786633200000,1786719600000,1786806000000,1787065200000,1787151600000,1787238000000,1787324400000,1787410800000,1787670000000,1787756400000,1787842800000,1787929200000,1788015600000,1788274800000,1788361200000,1788447600000,1788534000000,1788620400000,1788879600000,1788966000000,1789052400000,1789138800000,1789225200000,1789484400000,1789570800000,1789657200000,1789743600000,1789830000000,1790089200000,1790175600000,1790262000000,1790348400000,1790434800000,1790694000000,1790780400000,1790866800000,1790953200000,1791039600000],"start":"2026-05-22T11:00:00-04:00","end":"2026-10-03T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Scadding Court Community Centre","address":"707 Dundas St W, Toronto, ON M5T 2W6","lat":43.651713739404556,"lng":-79.40508261942017},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Market 707 is a stretch of sidewalk near 