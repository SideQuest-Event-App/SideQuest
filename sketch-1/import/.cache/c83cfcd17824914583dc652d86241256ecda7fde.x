4:00","allDay":"Day Event","venue":{"name":"Royal Ontario Museum","address":"100 Queen's Park, Toronto, ON, M5S 2C6","lat":43.667795,"lng":-79.394212},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":"Click the \"Book Tickets\" button at the top of the webpage. Then, select the 3rd Tuesday of the month on the calendar, and check the box for “3rd Tuesday Nights Free.” \n\nNote: Tickets are released 2 weeks prior to the event.","description":"Access to most galleries will be free for everyone, on the third Tuesday Night of each month!\n","categories":["Cultural","History","Museum"],"presenter":"Royal Ontario Museum","image":"HL82fxGUvbszy_QZLUul-Q","website":"https://www.rom.on.ca/whats-on/special-programs/third-tuesday-nights-free?utm_source=cityoftoronto&utm_medium=listing&utm_campaign=ttnf&utm_content=tourism","tickets":"https://www.rom.on.ca/whats-on/special-programs/third-tuesday-nights-free?utm_source=cityoftoronto&utm_medium=listing&utm_campaign=ttnf&utm_content=tourism"},{"id":"0d8e763b-fc35-4617-8c6d-82b5ec00b971","name":"A Spore on its Journey","dates":[1793797200000,1793883600000,1793970000000,1794063600000,1794229200000,1794315600000,1794402000000,1794488400000,1794574800000,1794668400000,1794834000000,1794920400000,1795006800000,1795093200000,1795179600000,1795273200000,1795438800000,1795525200000,1795611600000,1795698000000,1795784400000,1795878000000,1796043600000,1796130000000,1796216400000,1796302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000,1797426000000,1797512400000,1797598800000,1797692400000,1797858000000,1797944400000,1798030800000,1798117200000,1798203600000,1798297200000,1798462800000,1798549200000,1798635600000,1798722000000,1798808400000,1798902000000,1799067600000,1799154000000,1799240400000,1799326800000,1799413200000,1799506800000,1799672400000,1799758800000,1799845200000,1799931600000,1800018000000,1800111600000,1800277200000,1800363600000,1800450000000,1800536400000,1800622800000,1800716400000,1800882000000,1800968400000,1801054800000,1801141200000],"start":"2026-11-04T08:00:00-05:00","end":"2027-01-28T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Ascent Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Huan Chen transforms native fungi and lichen into a powerful metaphor for the immigrant experience, telling stories of heritage, struggle, adaptation and new beginnings. Through striking imagery, the work also reflects on human impact on natural habitats and the cultural shifts shaping urban life. Don’t miss this thought-provoking installation that connects nature, identity and community in surprising ways.","categories":["Arts/Exhibits"],"presenter":null,"image":"I1QKlptauUx7hjNseGr6og","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/","tickets":null},{"id":"96a07023-469f-476e-ba87-b3acda7d9440","name":"New Vistas","dates":[1796216400000,1796302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000,1797426000000,1797512400000,1797598800000,1797692400000,1797858000000,1797944400000,1798030800000,1798117200000,1798203600000,1798297200000,1798462800000,1798549200000,1798635600000,1798722000000,1798808400000,1798902000000,1799067600000,1799154000000,1799240400000,1799326800000,1799413200000,1799506800000,1799672400000,1799758800000,1799845200000,1799931600000],"start":"2026-12-02T08:00:00-05:00","end":"2027-01-14T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Etobicoke Civic Centre Art Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrate eme