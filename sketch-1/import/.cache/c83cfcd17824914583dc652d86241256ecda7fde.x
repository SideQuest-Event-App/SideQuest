1713739404556,"lng":-79.40508261942017},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Market 707 is a stretch of sidewalk near Dundas and Bathurst lined with upcycled shipping containers that offer sweet and savoury foods, services, and everything in between. \n\nPresided over by the Scadding Court Community Centre, this impromptu open-air pedestrian mall has one of the most eclectic collection of startup businesses in the city.","categories":["Other"],"presenter":null,"image":"oa2xxPdB_5ibesOE3pMKmA","website":"https://mkt707.ca/","tickets":null},{"id":"bd87f4a7-1c34-46a0-8e90-4cc4bd92bfc4","name":"Underpass Park Farmers' Market","dates":[1778788800000,1779393600000,1779998400000,1780603200000,1781208000000,1781812800000,1782417600000,1783022400000,1783627200000,1784232000000,1784836800000,1785441600000,1786046400000,1786651200000,1787256000000,1787860800000,1788465600000,1789070400000,1789675200000,1790280000000,1790884800000,1791489600000,1792094400000],"start":"2026-05-14T16:00:00-04:00","end":"2026-10-15T16:00:00-04:00","allDay":"Day Event","venue":{"name":"Underpass Park","address":"29 Lower River Street, Toronto, ON M5A 1M6","lat":43.65585,"lng":-79.354586},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover the magic of Underpass Park Farmers' Market—a vibrant gem in Toronto's Corktown and one of the city's most unique farmers market destinations! Surrounded by colorful murals from local artists, this lively outdoor market bursts with farm-fresh fruits and vegetables, mouthwatering baked goods, homemade preserves, and a tempting selection of artisanal treats.\n\nFrom May to October—rain or shine—this pet-friendly hotspot invites you to soak up live music, browse the stalls, and mingle with adorable pups for a truly unforgettable market experience.","categories":["Farmers' Market","Other"],"presenter":null,"image":"w3Jiy9MEVv3kfA1fQck79w","website":"https://underpassparkmarket.com/","tickets":null},{"id":"d492c190-38f7-454c-b256-f39b0f25dff6","name":"Courtyard Farmers' Market","dates":[1780515000000,1781119800000,1781724600000,1782329400000,1782934200000,1783539000000,1784143800000,1784748600000,1785353400000,1785958200000,1786563000000,1787167800000,1787772600000,1788377400000,1788982200000,1789587000000,1790191800000,1790796600000,1791401400000],"start":"2026-06-03T15:30:00-04:00","end":"2026-10-07T15:30:00-04:00","allDay":"Day Event","venue":{"name":"Robertson Parkette- 1549 Danforth Avenue at Coxwell Avenue ","address":"Robertson Parkette- 1549 Danforth Avenue at Coxwell Avenue ","lat":43.683008,"lng":-79.324328},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy local, farm-fresh Ontario produce, freshly baked loaves, pastries, Grab and Go treats and so much more at the Robertson Parkette\nThe Courtyard Farmers' Markets celebrates our third season in the community🍎  \n\nThank you!  Continued blessings!  \nOne💖!\n","categories":["Food/Culinary","Live Performances","Other"],"presenter":null,"image":"KhfKbq6xgZXAO1Cqc_Z-Og","website":"https://courtyardfarmersmkt.ca","tickets":null},{"id":"78a84a5f-52f0-43a8-abbc-4c25c9146b22","name":"Block Party","dates":[1790897400000],"start":"2026-10-01T19:30:00-04:00","end":"2026-10-01T19:30:00-04:00","allDay":"Night Event","venue":{"name":"IDK Social Bar","address":"172 Ossington Ave, Toronto, ON, M6J 2Z7","lat":43.648102314,"lng":-79.420538448},"free":false,"low":15,"high":null,"pwyc":null,"costNotes":null,"description":"Toronto’s best comedians hit us up! Grab your tickets and join the party!\n\nCome out for an electric lineup of comics who have performed on stages all across Canada.\n\nGood drinks, great vibes and even better laughs.","categories":["Comedy","Live Performances"],"presenter":null,"image":null,"website":"https://www.eventbrite.com/cc/block-party-upcoming-shows-4804040","tickets":"https://blockpartycomedyoct1.eventbrite.ca"},{"id":"7df088ad-e914-401b-ab44-c57d41937dcb","name":"Historic Holiday Gingerbread Workshop at Fort York","dates":[1797696000000,1797706800000,1797782400000,1797793200000,1798041600000,1798052400000,1798128000000,1798138800000,1798387200000,1798398000000,1798646400000,1798657200000,1798732800000,1798743600000,1798905600000,1798916400000,1798992000000,1799002800000],"start":"2026-12-19T11:00:00-05:00","end":"2027-01-03T14:00:00-05:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site ","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864,"lng":-79.406315},"free":false,"low":20,"high":null,"pwyc":null,"costNotes":null,"description":"Experience the warmth of the holiday season through a hands-on baking workshop in the historic Officers' Mess Kitchen.  Children and teens aged 8 to 14 can prepare an historic recipe using traditional methods including creaming butter, pounding sugar, grating spices, sifting flour, rolling and cutting dough.  \n\nWhile the gingerbread bakes, participants can enjoy a festive scavenger hunt in the Fort and return back to the kitchen to sample their freshly baked gingerbread biscuits and take home the historic recipe to recreate in their own kitchens.  ","categories":["Food/Culinary","History","Museum","Winter Holidays"],"presenter":null,"image":"OOkRdDMZf1TJSEdlmkqvKg","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/f778e3cc-f1b6-403a-baa6-4c8276e34a34"},{"id":"3ae64fb6-3439-407f-982d-83cd8bfc9be6","name":"GATHER in Toronto Exhibition","dates":[1784818800000,1784905200000,1784991600000,1785078000000,1785337200000,1785423600000,1785510000000,1785596400000,1785682800000,1785942000000,1786028400000,1786114800000,1786201200000,1786287600000,1786546800000,1786633200000,1786719600000,1786806000000,1786892400000,1787151600000,1787238000000,1787324400000,1787410800000,1787497200000,1787756400000,1787842800000,1787929200000,1788015600000,1788102000000,1788361200000,1788447600000,1788534000000,1788620400000,1788706800000,1788966000000,1789052400000,1789138800000,1789225200000,1789311600000,1789570800000,1789657200000,1789743600000,1789830000000,1789916400000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000,1791385200000,1791471600000,1791558000000,1791644400000,1791730800000,1791990000000,1792076400000,1792162800000,1792249200000,1792335600000,1792594800000,1792681200000,1792767600000,1792854000000,1792940400000,1793199600000,1793286000000,1793372400000,1793458800000,1793548800000],"start":"2026-07-23T11:00:00-04:00","end":"2026-11-01T11:00:00-05:00","allDay":"Day Event","venue":{"name":"Market Gallery","address":"95 Front Street East, 2nd floor","lat":43.649129,"lng":-79.371765},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Come learn about ways we move through the world, honouring the land, our stories and each other, celebrating triumphs in our journeys, strengthening fibres in our connectedness. It is within this sacred act of coming together that we find common values, building a unified vision for our future.\n \nListen to local sports origin stories alongside artistic reflections on identity, resilience, and belonging through works that highlight the power of connection across cultures and communities.\n \nThe exhibition features documentaries on Deskaheh, Herb Carnegie, and the St. Christopher House Lacrosse Organization; contemporary art by Marina Dempster, Maria Hupfield, Safoura Zahedi, Ben Spears, Pedro Zepeda, Milo Osceola, Daniel Henhawk, and David Barnett; as well as new acquisitions alongside historic items from the City of Toronto Art and Artifact Collection.\n","categories":["Arts/Exhibits","Museum"],"presenter":"TD Bank Group","image":"-m6p-aI3Br63z-qiiUz5dg","website":"http://toronto.ca/marketgallery","tickets":null},{"id":"019701b0-7140-49