00000,1794924000000,1795010400000,1795096800000,1795183200000,1795269600000,1795356000000,1795442400000,1795528800000,1795615200000,1795701600000,1795788000000,1795874400000,1795960800000,1796047200000,1796133600000,1796220000000,1796306400000],"start":"2026-11-03T09:00:00-05:00","end":"2026-12-03T09:00:00-05:00","allDay":"Day Event","venue":{"name":"Clark Centre for the Arts","address":"191 Guildwood Pkwy, Scarborough, ON, M1E 1P5","lat":43.746893127,"lng":-79.193688812},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy this photography exhibition by a diverse group of artists as they present their unique interpretations of our world, from realistic to abstract, including techniques such as macro photography, intentional movement and digital compositing. This collection promises a rich visual experience that reflects the wide-ranging creativity of Beach Photo Club members.\n\n","categories":["Arts/Exhibits"],"presenter":null,"image":"4UNkAN-HEr_AYUwhK0vhfw","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/clark-centre-for-the-arts/","tickets":null},{"id":"1976c692-7693-4d73-baa2-ab992207a4b7","name":"In Broken Light Exhibition at Spadina Museum","dates":[1787756400000,1787842800000,1787929200000,1788015600000,1788102000000,1788361200000,1788447600000,1788534000000,1788620400000,1788706800000,1788966000000,1789052400000,1789138800000,1789225200000,1789311600000,1789570800000,1789657200000,1789743600000,1789830000000,1789916400000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000,1791385200000,1791471600000,1791558000000,1791644400000,1791730800000,1791990000000,1792076400000,1792162800000,1792249200000,1792335600000],"start":"2026-08-26T11:00:00-04:00","end":"2026-10-18T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Spadina Museum","address":"285 Spadina Rd, Toronto, ON, M5R 2V5","lat":43.679046946,"lng":-79.408181452},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":"Visit the reception desk to register. Tickets are first-come first-serve and subject to capacity.","description":"See a contemporary art exhibition of five sculptural interventions located throughout the historic Spadina Museum, created by artist Ry Van Der Hout and curated by Adrien Sun Hall. Working with photography, stained glass, mirrors, and acts of rupture and repair, Van Der Hout reveals the emotional residue held within objects, architecture and stories. Cracks and fractures become apertures through which forgotten stories emerge, the artworks functioning as contemporary reliquaries for lives remembered and overlooked.\n\nMoving between deep histories, the present day and an imagined future, this exhibition traces connections across time, where fragments persist, reflections multiply, and the boundaries between past, present and future remain open.","categories":["Arts/Exhibits","History","Museum"],"presenter":null,"image":"caTKB0eJSOICT9G9ZdiXWw","website":"https://toronto.ca/spadina","tickets":null},{"id":"cdca1863-4723-4c69-805f-708bb430ca1c","name":"In Broken Light Exhibition at Spadina Museum","dates":[1787756400000,1787842800000,1787929200000,1788015600000,1788102000000,1788361200000,1788447600000,1788534000000,1788620400000,1788706800000,1788966000000,1789052400000,1789138800000,1789225200000,1789311600000,1789570800000,1789657200000,1789743600000,1789830000000,1789916400000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000,1791385200000,1791471600000,1791558000000,1791644400000,1791730800000,1791990000000,1792076400000,1792162800000,1792249200000,1792335600000],"start":"2026-08-26T11:00:00-04:00","end":"2026-10-18T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Spadina Museum","address":"285 Spadina Rd, Toronto, ON, M5R 2V5","lat":43.679046946,"lng":-79.408181452},"fre