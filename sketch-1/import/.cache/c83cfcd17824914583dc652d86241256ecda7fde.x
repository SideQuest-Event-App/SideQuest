789398000000,1789484400000,1789570800000,1789657200000,1789743600000,1789830000000,1789916400000,1790002800000,1790089200000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790607600000,1790694000000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000,1791212400000,1791298800000,1791385200000,1791471600000,1791558000000,1791644400000,1791730800000,1791817200000,1791903600000,1791990000000,1792076400000,1792162800000,1792249200000,1792335600000,1792422000000,1792508400000,1792594800000,1792681200000,1792767600000,1792854000000,1792940400000,1793026800000,1793113200000,1793199600000,1793286000000,1793372400000,1793458800000,1793548800000,1793635200000,1793721600000,1793808000000,1793894400000,1793980800000,1794067200000,1794153600000,1794240000000,1794326400000,1794412800000,1794499200000,1794585600000,1794672000000,1794758400000,1794844800000,1794931200000,1795017600000,1795104000000,1795190400000,1795276800000,1795363200000,1795449600000,1795536000000,1795622400000,1795708800000,1795795200000,1795881600000,1795968000000,1796054400000,1796140800000,1796227200000,1796313600000,1796400000000,1796486400000],"start":"2026-09-09T11:00:00-04:00","end":"2026-12-05T11:00:00-05:00","allDay":"Day Event","venue":{"name":"The Image Centre","address":"33 Gould St, Toronto, ON, M5B 1E9","lat":43.657662387,"lng":-79.379262289},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"For nearly half a century, celebrated American photographer Richard Avedon confronted one of portraiture’s enduring taboos: aging. \n\nFrom his earliest years at Harper’s Bazaar, Avedon broke with the conventions of idealized celebrity portraiture, revealing the marks of time on his subjects’ faces with unsparing clarity. \n\nBringing together nearly 100 portraits made between the early 1950s and 2004, the exhibition features artists, writers, musicians and cultural icons including Toni Morrison, Gabriel García Márquez, Duke Ellington, Ronald Reagan, the Duke and Duchess of Windsor, Patti Smith, Truman Capote and the Dalai Lama. \n\nImmortal also includes a restaging of Avedon’s seminal 1974 Museum of Modern Art exhibition Jacob Israel Avedon, which chronicled his father’s final years in nine extraordinary portraits. Taken as a whole, the photographs reveal a lesser-known dimension of Avedon’s practice and offer an unprecedented exploration of aging through his distinctive vision.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":null,"website":"https://theimagecentre.ca/exhibition/richard-avedon-immortal/","tickets":null},{"id":"548288ab-8873-4650-9046-b1ccae61baf6","name":"Richard Avedon: Immortal: Portraits of Aging","dates":[1788966000000,1789052400000,1789138800000,1789225200000,1789311600000,1789398000000,1789484400000,1789570800000,1789657200000,1789743600000,1789830000000,1789916400000,1790002800000,1790089200000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790607600000,1790694000000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000,1791212400000,1791298800000,1791385200000,1791471600000,1791558000000,1791644400000,1791730800000,1791817200000,1791903600000,1791990000000,1792076400000,1792162800000,1792249200000,1792335600000,1792422000000,1792508400000,1792594800000,1792681200000,1792767600000,1792854000000,1792940400000,1793026800000,1793113200000,1793199600000,1793286000000,1793372400000,1793458800000,1793548800000,1793635200000,1793721600000,1793808000000,1793894400000,1793980800000,1794067200000,1794153600000,1794240000000,1794326400000,1794412800000,1794499200000,1794585600000,1794672000000,1794758400000,1794844800000,1794931200000,1795017600000,1795104000000,1795190400000,1795276800000,1795363200000,1795449600000,1795536000000,1795622400000,1795708800000,1795795200000,1795881600000,1795968000000,1796054400000,1796140800000,1796227200000,1796313600000,1796400000000,1796486400000],"start":"2026-09-09T11:00:00-04:00","e