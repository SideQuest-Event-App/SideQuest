6800000,1788523200000,1788609600000,1788696000000,1788782400000,1788868800000,1788955200000,1789041600000,1789128000000,1789214400000,1789300800000,1789387200000,1789473600000,1789560000000,1789646400000,1789732800000,1789819200000,1789905600000,1789992000000,1790078400000,1790164800000,1790251200000,1790337600000,1790424000000,1790510400000,1790596800000,1790683200000,1790769600000,1790856000000,1790942400000,1791028800000,1791115200000,1791201600000,1791288000000,1791374400000,1791460800000,1791547200000,1791633600000,1791720000000,1791806400000,1791892800000,1791979200000,1792065600000,1792152000000,1792238400000,1792324800000,1792411200000,1792497600000,1792584000000,1792670400000,1792756800000,1792843200000,1792929600000,1793016000000,1793102400000,1793188800000,1793275200000,1793361600000,1793448000000,1793538000000,1793624400000,1793710800000,1793797200000,1793883600000,1793970000000,1794056400000,1794142800000,1794229200000],"start":"2026-08-03T08:00:00-04:00","end":"2026-11-09T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Mount Pleasant Cemetery","address":"375 Mount Pleasant Road","lat":43.712625,"lng":-79.357673},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Walk through a series of artistic and interpretive installations across ten cemetery sites and several funeral centres.\n\nAcross the participating sites, visitors will encounter a constellation of experiences, including interpretive panels, meditative spaces, soundscapes, experimental film, symbolic thresholds, and opportunities to leave a message of their own.\n\nCemeteries bring generations into conversation. They hold names, trees, monuments, rituals, and traces of lives that still shape the world around us. The project invites visitors to reflect on how grief, memory, nature, design and community shape the places we inherit and the futures we share.\n","categories":["Arts/Exhibits","History","Museum"],"presenter":"Mount Pleasant Group","image":"nid4j8jkM4_7uRp7j1JIyQ","website":"https://mpg200.ca/installations","tickets":null},{"id":"273e62f0-ca85-4f61-aa4a-c07a8bef9c16","name":"Yesterday. Today. Forever.","dates":[1785758400000,1785844800000,1785931200000,1786017600000,1786104000000,1786190400000,1786276800000,1786363200000,1786449600000,1786536000000,1786622400000,1786708800000,1786795200000,1786881600000,1786968000000,1787054400000,1787140800000,1787227200000,1787313600000,1787400000000,1787486400000,1787572800000,1787659200000,1787745600000,1787832000000,1787918400000,1788004800000,1788091200000,1788177600000,1788264000000,1788350400000,1788436800000,1788523200000,1788609600000,1788696000000,1788782400000,1788868800000,1788955200000,1789041600000,1789128000000,1789214400000,1789300800000,1789387200000,1789473600000,1789560000000,1789646400000,1789732800000,1789819200000,1789905600000,1789992000000,1790078400000,1790164800000,1790251200000,1790337600000,1790424000000,1790510400000,1790596800000,1790683200000,1790769600000,1790856000000,1790942400000,1791028800000,1791115200000,1791201600000,1791288000000,1791374400000,1791460800000,1791547200000,1791633600000,1791720000000,1791806400000,1791892800000,1791979200000,1792065600000,1792152000000,1792238400000,1792324800000,1792411200000,1792497600000,1792584000000,1792670400000,1792756800000,1792843200000,1792929600000,1793016000000,1793102400000,1793188800000,1793275200000,1793361600000,1793448000000,1793538000000,1793624400000,1793710800000,1793797200000,1793883600000,1793970000000,1794056400000,1794142800000,1794229200000],"start":"2026-08-03T08:00:00-04:00","end":"2026-11-09T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Mount Pleasant Cemetery","address":"375 Mount Pleasant Road","lat":43.712625,"lng":-79.357673},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Walk through a series of artistic and interpretive installations across ten cemetery sites and several funeral centres.\n\nAcross the participating sites, visitors will encounter a constellation of experiences, including interpretive panels, meditative spaces, soundscapes, experimental film, symbolic thresholds, and opportunities to leave a message of their own.\n\nCemeteries bring generations into conversation. They hold names, trees, monuments, rituals, and traces of lives that still shape the world around us. The project invites visitors to reflect on how grief, memory, nature, design and community shape the places we inherit and the futures we share.\n","categories":["Arts/Exhibits","History","Museum"],"presenter":"Mount Pleasant Group","image":"nid4j8jkM4_7uRp7j1JIyQ","website":"https://mpg200.ca/installations","tickets":null},{"id":"3e69fe8f-091e-436f-b73d-8a68b2f8c0c1","name":"Newcomer Planting Event: Sweeney Park","dates":[1791468000000],"start":"2026-10-08T10:00:00-04:00","end":"2026-10-08T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Sweeney Park","address":"110 Sweeney Dr, North York, ON M4A","lat":43.735816,"lng":-79.316203},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":"\nIndividuals and small groups do not need to register. We require groups of five or more to register in advance to ensure we have enough materials and tools at each event. Email us to register.","description":"Join us at Sweeney Park for a special newcomer planting event. We will be enhancing our tree canopy by planting native trees and shrubs.\n\nEvent site conditions vary. Contact us for more information, including accessibility. If you would like to request accessibility support, contact us as soon as possible.","categories":["Environmental"],"presenter":null,"image":"6UK-WezmMaxp70l-MracuA","website":"https://www.toronto.ca/community-people/get-involved/volunteer-with-the-city/tree-planting-stewardship/","tickets":null},{"id":"1b8fe4b3-bbdc-4c63-a530-1902566dbbe1","name":"Exhibition: \"Returning to Ourselves and Michael Massie: now and then\"","dates":[1788987600000,1789056000000,1789142400000,1789228800000,1789574400000,1789660800000,1789747200000,1789833600000,1790179200000,1790265600000,1790352000000,1790438400000,1790784000000,1790870400000,1790956800000,1791043200000,1791388800000,1791475200000,1791561600000,1791648000000,1791993600000,1792080000000,1792166400000,1792252800000,1792598400000,1792684800000,1792771200000,1792857600000,1793203200000,1793289600000,1793376000000,1793462400000,1793811600000,1793898000000,1793984400000,1794070800000,1794416400000,1794502800000,1794589200000,1794675600000,1795021200000,1795107600000,1795194000000,1795280400000,1795626000000,1795712400000,1795798800000,1795885200000,1796230800000,1796317200000,1796403600000,1796490000000,1796835600000,1796922000000,1797008400000,1797094800000,1797440400000,1797526800000,1797613200000,1797699600000,1798045200000,1798131600000,1798218000000,1798304400000,1798650000000,1798736400000,1798822800000,1798909200000,1799254800000,1799341200000,1799427600000,1799514000000,1799859600000,1799946000000,1800032400000,1800118800000,1800464400000,1800550800000,1800637200000,1800723600000,1801069200000,1801155600000,1801242000000,1801328400000],"start":"2026-09-09T17:00:00-04:00","end":"2027-01-30T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Onsite Gallery","address":"199 Richmond St W, Toronto, ON, M5V 0H4","lat":43.649477,"lng":-79.388341},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Please join us at the 'Returning to Ourselves - Rebecca Baird and Kenny Alvin Baird: A Retrospective of Art and Design by Cree Métis Siblings'. Curated by Lisa Deanne Smith.\n\nThis exhibit presents over 40 years of transformative work by Rebecca Baird and Kenny Alvin Baird. The exhibition spans sculpture, painting and traditional material practices, alongside interior design and more.\n\n'Michael Massie: now and then' brings together works from across his career, including a large collection of teapots, previously unexhibited pieces and a new body of large-scale sculptural installations, to celebrate the enduring importance of joy, experimentation and humour in his work. Guest-curated by Alysa Procida and enjoy our Special Projects Gallery.","categories":["Arts/Exhibits","Artisan","Cultural"],"presenter":null,"image":null,"website":"https://www.ocadu.ca/events-and-exhibitions/michael-massie-now-and-then","tickets":"https://www.eventbrite.ca/e/opening-reception-returning-to-ourselves-michael-massie-now-and-then-tickets-1997059101532?aff=ebdsoporgprofile"},{"id":"f27495e2-2cae-4a6f-be67-ba01f8a0a49d","name":"Exhibition: \"Returning to Ourselves and Michael Massie: now and then\"","dates":[1788987600000,1789056000000,1789142400000,1789228800000,1789574400000,1789660800000,1789747200000,1789833600000,1790179200000,1790265600000,1790352000000,1790438400000,1790784000000,1790870400000,1790956800000,1791043200000,1791388800000,1791475200000,1791561600000,1791648000000,1791993600000,1792080000000,1792166400000,1792252800000,1792598400000,1792684800000,1792771200000,1792857600000,1793203200000,1793289600000,1793376000000,1793462400000,1793811600000,1793898000000,1793984400000,1794070800000,1794416400000,1794502800000,1794589200000,1794675600000,1795021200000,1795107600000,1795194000000,1795280400000,1795626000000,1795712400000,1795798800000,1795885200000,1796230800000,1796317200000,1796403600000,1796490000000,1796835600000,1796922000000,1797008400000,1797094800000,1797440400000,1797526800000,1797613200000,1797699600000,1798045200000,1798131600000,1798218000000,1798304400000,1798650000000,1798736400000,1798822800000,1798909200000,1799254800000,1799341200000,1799427600000,1799514000000,1799859600000,1799946000000,1800032400000,1800118800000,1800464400000,1800550800000,1800637200000,1800723600000,1801069200000,1801155600000,1801242000000,1801328400000],"start":"2026-09-09T17:00:00-04:00","end":"2027-01-30T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Onsite Gallery","address":"199 Richmond St W, Toronto, ON, M5V 0H4","lat":43.649477,"lng":-79.388341},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Please join us at the 'Returning to Ourselves - Rebecca Baird and Kenny Alvin Baird: A Retrospective of Art and Design by Cree Métis Siblings'. Curated by Lisa Deanne Smith.\n\nThis exhibit presents over 40 years of transformative work by Rebecca Baird and Kenny Alvin Baird. The exhibition spans sculpture, painting and traditional material practices, alongside interior design and more.\n\n'Michael Massie: now and then' brings together works from across his career, including a large collection of teapots, previously unexhibited pieces and a new body of large-scale sculptural installations, to celebrate the enduring importance of joy, experimentation and humour in his work. Guest-curated by Alysa Procida and enjoy our Special Projects Gallery.","categories":["Arts/Exhibits","Artisan","Cultural"],"presenter":null,"image":null,"website":"https://www.ocadu.ca/events-and-exhibitions/michael-massie-now-and-then","tickets":"https://www.eventbrite.ca/e/opening-reception-returning-to-ourselves-michael-massie-now-and-then-tickets-1997059101532?aff=ebdsoporgprofile"},{"id":"63bb968e-d9e2-4c1f-a519-5de869796b23","name":"Dancing Blossoms Installation","dates":[1787922000000,1788008400000,1788094800000,1788181200000,1788267600000,1788354000000,1788440400000,1788526800000,1788613200000,1788699600000,1788786000000,1788872400000,1788958800000,1789045200000,1789131600000,1789218000000,1789304400000,1789390800000,1789477200000,1789563600000,1789650000000,1789736400000,1789822800000,1789909200000,1789995600000,1790082000000,1790168400000,1790254800000,1790341200000,1790427600000,1790514000000,1790600400000,1790686800000,1790773200000,1790859600000,1790946000000,1791032400000,1791118800000,1791205200000,1791291600000,1791378000000,1791464400000,1791550800000,1791637200000,1791723600000,1791810000000,1791896400000,1791982800000,1792069200000,1792155600000,1792242000000,1792328400000,1792414800000,1792501200000,1792587600000,1792674000000,1792760400000,1792846800000,1792933200000,1793019600000,1793106000000,1793192400000,1793278800000,1793365200000,1793451600000,1793541600000,1793628000000,1793714400000,1793800800000,1793887200000,1793973600000,1794060000000,1794146400000,1794232800000,1794319200000,1794405600000,1794492000000],"start":"2026-08-28T09:00:00-04:00","end":"2026-11-12T09:00:00-05:00","allDay":"Day Event","venue":{"name":"Clark Centre for the Arts","address":"191 Guildwood Pkwy, Scarborough, ON, M1E 1P5","lat":43.746893127,"lng":-79.193688812},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Delight in Paula Hartmann's Dancing Blossoms, a kinetic installation composed of dozens of delicate paper mobiles suspended in air, evoking the quiet poetry of spring trees swaying in the wind. Crafted from featherlight paper and fine wire, each mobile captures a fleeting moment of bloom, movement, and renewal.\n\nAbout the Artist\nPaula Hartmann is a Canadian visual artist whose joyful, kinetic sculptures transform humble materials into poetic, suspended worlds. Based in Toronto and originally from Germany, she draws on cultural traditions, folk aesthetics, and contemporary design to create works that explore impermanence, transformation, and belonging. Often incorporating paper, wire, and natural elements, her mobiles and installations invite viewers into moments of play, presence, and quiet wonder. Her installations have been featured in major public art events, including Toronto’s Nuit\nBlanche, the Burlington Waterfront Sculpture Trail, and City of Craft Toronto.","categories":["Arts/Exhibits","Cultural"],"presenter":null,"image":"6w2zOg_MReBeep-DtTCBng","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/clark-centre-for-the-arts/","tickets":null},{"id":"4838c6f8-de86-4f43-b4d5-a2623718f323","name":"Dancing Blossoms Installation","dates":[1787922000000,1788008400000,1788094800000,1788181200000,1788267600000,178