vailable for participants.","categories":["Cultural","Other"],"presenter":"Iranian-Canadian Architects and Artists Forum ","image":null,"website":"https://www.icaaf.ca/competition","tickets":"https://www.icaaf.ca/competition"},{"id":"832ae2fe-6206-4a01-9c4e-f433bd4d570d","name":"Historic Holiday Gingerbread Workshop at Fort York","dates":[1797696000000,1797706800000,1797782400000,1797793200000,1798041600000,1798052400000,1798128000000,1798138800000,1798387200000,1798398000000,1798646400000,1798657200000,1798732800000,1798743600000,1798905600000,1798916400000,1798992000000,1799002800000],"start":"2026-12-19T11:00:00-05:00","end":"2027-01-03T14:00:00-05:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site ","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864,"lng":-79.406315},"free":false,"low":20,"high":null,"pwyc":null,"costNotes":null,"description":"Experience the warmth of the holiday season through a hands-on baking workshop in the historic Officers' Mess Kitchen.  Children and teens aged 8 to 14 can prepare an historic recipe using traditional methods including creaming butter, pounding sugar, grating spices, sifting flour, rolling and cutting dough.  \n\nWhile the gingerbread bakes, participants can enjoy a festive scavenger hunt in the Fort and return back to the kitchen to sample their freshly baked gingerbread biscuits and take home the historic recipe to recreate in their own kitchens.  ","categories":["Food/Culinary","History","Museum","Winter Holidays"],"presenter":null,"image":"OOkRdDMZf1TJSEdlmkqvKg","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/f778e3cc-f1b6-403a-baa6-4c8276e34a34"},{"id":"9ba7a58f-d541-4447-9f64-4167a45b47d0","name":"MULTIfest Interactive Art festival","dates":[1790888400000,1790974800000,1791061200000,1791147600000,1791234000000,1791320400000,1791406800000,1791493200000],"start":"2026-10-01T17:00:00-04:00","end":"2026-10-08T17:00:00-04:00","allDay":"Day Event","venue":{"name":"Stackt Market","address":"28 Bathurst St, Toronto, ON, M5V 0R4","lat":43.640948,"lng":-79.402169},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Toronto’s new festival of interactive and digital art, returns to STACKT Market!\n\nWe're bringing together interactive art installations, audiovisual performances and beginner-friendly workshops, alongside artist talks, family programming and community events.\n\nExplore immersive digital artworks, interact with responsive installations, experience live audiovisual performances, and get hands-on with creative technology through workshops in electronic music making, projection mapping and more.\n\nTogether with Nuit Blanche, enjoy an afternoon Show and Tell and immersive round table, followed by an Immersive Happy Hour with DJs, live visuals and interactive art.\n","categories":["Arts/Exhibits","Live Performances","Music"],"presenter":null,"image":"KoSi1GfJkywyaekelu014A","website":"https://multi-fest.ca/","tickets":null},{"id":"e9101814-3ff7-416c-9752-9746f66e3d3d","name":"Lantern Tours at Montgomery's Inn: Beyond Mourning","dates":[1792879200000,1792886400000,1792965600000,1792972800000,1793311200000,1793318400000,1793397600000,1793404800000],"start":"2026-10-24T18:00:00-04:00","end":"2026-10-30T20:00:00-04:00","allDay":"Night Event","venue":{"name":"Montgomery's Inn","address":"4709 Dundas St W, Etobicoke, ON, M9A 1A8","lat":43.651679,"lng":-79.525659},"free":false,"low":22,"high":null,"pwyc":null,"costNotes":null,"description":"This Halloween, uncover eerie tales about the past inhabitants of the Inn and the Old Town of Islington. Journey from the dimly lit historic house to the Islington burial ground, learn about Victorian death practices, and hear new stories connecting to Toronto’s past. \n\nContent warning: Topics include illness, death and related subjects.\nRecommended for ages 14 and up. Anyone under 17 must be accompanied by an adult.\n\n","categories":["History","Museum","Tour","Halloween"],"presenter":null,"image":"OGMQ_a1JowZ9TDZayyn_6Q","website":"https://www.toronto.ca/montgomerysinn","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/aae32edb-e8f5-4760-b053-81cb44cc2186"},{"id":"06758805-e6da-49e6-9b35-89731d3e0251","name":"Lantern Tours at Montgomery's Inn: Beyond Mourning","dates":[1792879200000,1792886400000,1792965600000,1792972800000,1793311200000,1793318400000,1793397600000,1793404800000],"start":"2026-10-24T18:00:00-04:00","end":"2026-10-30T20:00:00-04:00","allDay":"Night Event","venue":{"name":"Montgomery's Inn","address":"4709 Dundas St W, Etobicoke, ON, M9A 1A8","lat":43.651679,"lng":-79.525659},"free":false,"low":22,"high":null,"pwyc":null,"costNotes":null,"description":"This Halloween, uncover eerie tales about the past inhabitants of the Inn and the Old Town of Islington. Journey from the dimly lit historic house to the Islington burial ground, learn about Victorian death practices, and hear new stories connecting to Toronto’s past. \n\nContent warning: Topics include illness, death and related subjects.\nRecommended for ages 14 and up. Anyone under 17 must be accompanied by an adult.\n\n","categories":["History","Museum","Tour","Halloween"],"presenter":null,"image":"OGMQ_a1JowZ9TDZayyn_6Q","website":"https://www.toronto.ca/montgomerysinn","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/aae32edb-e8f5-4760-b053-81cb44cc2186"},{"id":"7c6850fb-35a9-4e59-875c-82c546fc6a7a","name":"Essence of the Garden: Plein Air Art Exhibition and Sale","dates":[1791037800000,1791124200000,1791210600000,1791297000000,1791383400000,1791469800000,1791556200000,1791642600000,1791729000000,1791815400000,1791901800000,1791988200000,1792074600000,1792161000000,1792247400000,1792333800000],"start":"2026-10-03T10:30:00-04:00","end":"2026-10-18T10:30:00-04:00","allDay":"Day Event","venue":{"name":"Toronto Botanical Garden","address":"777 Lawrence Ave E, North York, ON, M3C 1P2","lat":43.734346145,"lng":-79.358667018},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrating art, nature and community! \n\nEnjoy over 100 original artworks created outdoors by 46 talented local artists at Toronto Botanical Garden and Edwards Gardens and participate in artist-led workshops and more!\n\nThis curated, site-specific show invites visitors to experience the Garden through the eyes of the artists who paint here, capturing moments of light, movement, and the essence of the natural world.\n\nThis exhibition coincides with Toronto’s Ravine Days, an annual city-wide celebration of Toronto’s ravine system.\n","categories":["Arts/Exhibits","Environmental"],"presenter":null,"image":"dTOLixZ5zgHzXQkFocfpqg","website":"https://torontobotanicalgarden.ca/event/essence-of-the-garden-plein-air-art-exhibition-sale/","tickets":null},{"id":"035413ff-385d-4795-a271-40e85e64b103","name":"Essence of the Garden: Plein Air Art Exhibition and Sale","dates":[1791037800000,1791124200000,1791210600000,1791297000000,1791383400000,1791469800000,1791556200000,1791642600000,1791729000000,1791815400000,1791901800000,1791988200000,1792074600000,1792161000000,1792247400000,1792333800000],"start":"2026-10-03T10:30:00-04:00","end":"2026-10-18T10:30:00-04:00","allDay":"Day Event","venue":{"name":"Toronto Botanical Garden","address":"777 Lawrence Ave E, North York, ON, M3C 1P2","lat":43.734346145,"lng":-79.358667018},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrating art, nature and community! \n\nEnjoy over 100 original artworks created outdoors by 46 talented local artists at Toronto Botanical Garden and Edwards Gardens and participate in artist-led workshops and more!\n\nThis curated, site-specific show invites visitors to experience the Garden through the eyes of the artists who paint here, capturing moments of light, movement, and the essence of the natural world.\n\nThis exhibition coincides with Toronto’s Ravine Days, an annual city-wide celebration of Toronto’s ravine system.\n","categories":["Arts/Exhibits","Environmental"],"presenter":null,"image":"dTOLixZ5zgHzXQkFocfpqg","website":"https://torontobotanicalgarden.ca/event/essence-of-the-garden-plein-air-art-exhibition-sale/","tickets":null},{"id":"32337e94-feea-475b-b216-9452af1c548c","name":"Essence of the Garden: Plein Air Art Exhibition and Sale","dates":[1791037800000,1791124200000,1791210600000,1791297000000,1791383400000,1791469800000,1791556200000,1791642600000,1791729000000,1791815400000,1791901800000,1791988200000,1792074600000,1792161000000,1792247400000,1792333800000],"start":"2026-10-03T10:30:00-04:00","end":"2026-10-18T10:30:00-04:00","allDay":"Day Event","venue":{"name":"Toronto Botanical Garden","address":"777 Lawrence Ave E, North York, ON, M3C 1P2","lat":43.734346145,"lng":-79.358667018},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrating art, nature and community! \n\nEnjoy over 100 original artworks created outdoors by 46 talented local artists at Toronto Botanical Garden and Edwards Gardens and participate in artist-led workshops and more!\n\nThis curated, site-specific show invites visitors to experience the Garden through the eyes of the artists who paint here, capturing moments of light, movement, and the essence of the natural world.\n\nThis exhibition coincides with Toronto’s Ravine Days, an annual city-wide celebration of Toronto’s ravine system.\n","categories":["Arts/Exhibits","Environmental"],"presenter":null,"image":"dTOLixZ5zgHzXQkFocfpqg","website":"https://torontobotanicalgarden.ca/event/essence-of-the-garden-plein-air-art-exhibition-sale/","tickets":null},{"id":"a3fd95ad-1391-4388-b644-42e3abe05e5d","name":"Rebellion Talks: Riots & the Rebel Mayor","dates":[1801346400000],"start":"2027-01-30T17:00:00-05:00","end":"2027-01-30T17:00:00-05:00","allDay":"Day Event","venue":{"name":"Mackenzie House","address":"82 Bond St, Toronto, ON, M5B 1X2","lat":43.65569364,"lng":-79.378310375},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Learn about the riots that shook Toronto to its core in the years before and after the Rebellion of 1837 in the rebel mayor’s former home. Political violence was a common occurrence in Toronto; rival factions battled in our streets. Hear the history behind the riots that helped convince Mackenzie that an armed revolution was his only option and explore the riots that continued to rage long after his rebellion was over.\n\nFrom October 2026 to April 2027, historian Adam Bunch brings Toronto’s history to life in a series of talks exploring the Upper Canada Rebellion and its lasting impact on the city. From spies and taverns to political reform, rural rebels and the Patriot War, each talk reveals a different story connected to the museum where it takes place.","categories":["History","Museum","Talks"],"presenter":"Toronto History Museums","image":"3C8DjBfQY3xa9bWxsX87fQ","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/mackenzie-house/","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/6551fc34-0588-4ae7-b4de-88044fd99d6d"},{"id":"4e978bfe-24a7-4e14-a52e-dd20047591bc","name":"Tales of the Damned: Immersive Theatre Experience","dates":[1792020600000,1792193400000,1792279200000,1792366200000,1792539000000,1792625400000,1792798200000,1792884600000,1792971000000,1793143800000,1793230200000,1793403000000,1793498400000,1793579400000],"start":"2026-10-14T19:30:00-04:00","end":"2026-11-01T19:30:00-05:00","allDay":"Night Event","venue":{"name":"Campbell House Museum","address":"160 Queen St W, Toronto, ON, M5H 3H3","lat":43.651058,"lng":-79.387322},"free":false,"low":42.15,"high":54.99,"pwyc":null,"costNotes":null,"description":"Experience a bone-chilling Halloween tradition!\n\nFrom the creators of the immersive sensations “Tales of the Grotesque” (2023, 2024) and the landmark production of “Tales of the Damned” (2025) comes the revival of Toronto’s favourite gothic horror anthology. \n\nWith fresh characters, familiar tales, and its twisted brand of terror, this site-specific theatrical experience brings literature’s most depraved characters to life and death. \n\nAfter a lady of the night is murdered, a mad doctor strikes a pact with the Devil to raise her from the dead. But all hell breaks loose when he comes face-to-face with her killer at a masquerade. Descend into madness with Victor Frankenstein, Henry Jekyll, and Dorian Gray to discover the results of playing God, and the monstrous repercussions when the Devil comes to collect. \n\nStep into the story as you move through the candlelit Campbell House mansion to confront history's most iconic villains. Ages 14 and up, minors must be accompanied by an adult.","categories":["Live Performances","Museum","Theatre","Halloween"],"presenter":"Campbell House Museum","image":"vywbbYFbH0ca7m8NLmLaow","website":"https://www.whitemillstheatreco.com/upcoming-events-1","tickets":"https://www.whitemillstheatreco.com/upcoming-events-1"},{"id":"bd256f8b-535e-4802-9e57-599e221d67c2","name":"Tales of the Damned: Immersive Theatre Experience","dates":[1792020600000,1792193400000,1792279200000,1792366200000,1792539000000,1792625400000,1792798200000,1792884600000,1792971000000,1793143800000,1793230200000,1793403000000,1793498400000,1793579400000],"start":"2026-10-14T19:30:00-04:00","end":"2026-11-01T19:30:00-05:00","allDay":"Night Event","venue":{"name":"Campbell House Museum","address":"160 Queen St W, Toronto, ON, M5H 3H3","lat":43.651058,"lng":-79.387322},"free":false,"low":42.15,"high":54.99,"pwyc":null,"costNotes":null,"description":"Experience a bone-chilling Halloween tradition!\n\nFrom the creators of the immersive sensations “Tales of the Grotesque” (2023, 2024) and the landmark production of “Tales of the Damned” (2025) comes the revival of Toronto’s favourite gothic horror anthology. \n\nWith fresh characters, familiar tales, and its twisted brand of terror, this site-specific theatrical experience brings literature’s most depraved characters to life and death. \n\nAfter a lady of the night is murdered, a mad doctor strikes a pact with the Devil to raise her from the dead. But all hell breaks loose when he comes face-to-face with her killer at a masquerade. Descend into madness with Victor Frankenstein, Henry Jekyll, and Dorian Gray to discover the results of playing God, and the monstrous repercussions when the Devil comes to collect. \n\nStep into the story as you move through the candlelit Campbell House mansion to confront history's most iconic villains. Ages 14 and up, minors must be accompanied by an adult.","categories":["Live Performances","Museum","Theatre","Halloween"],"presenter":"Campbell House Museum","image":"vywbbYFbH0ca7m8NLmLaow","website":"https://www.whitemillstheatreco.com/upcoming-events-1","tickets":"https://www.whitemillstheatreco.com/upcoming-events-1"},{"id":"df9215ff-2c48-4fce-9f5e-8dc2511e813d","name":"Art Toronto 2026","dates":[1793304000000,1793376000000,1793462400000,1793552400000],"start":"2026-10-29T16:00:00-04:00","end":"2026-11-01T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Metro Toronto Convention Centre","address":"255 Front St W, Toronto, ON, M5V 2W6","lat":43.644049656,"lng":-79.386720757},"free":false,"low":25,"high":440,"pwyc":null,"costNotes":null,"description":"Canada’s leading international fair for modern and contemporary art will bring together 105 galleries, organizations and cultural institutions from across Canada, the United States, Latin America and Europe.\n\nEnjoy thousands of works by emerging and established artists across painting, sculpture, photography, textiles, installation and new media.\n\nHighlights include the return of Arte Sur, featuring 11 galleries from Mexico, Central America and South America, as well as solo presentations dedicated to individual artists and new programming for emerging collectors. \n\nNearly one-third of participating galleries will present work by Indigenous artists. \n\nVisitors can also take part in curator-led tours, Platform Talks and educational programming designed to make collecting more accessible.\n","categories":["Arts/Exhibits"],"presenter":null,"image":"yjzdEkBXJtQkDio5WDHxpQ","website":"https://arttoronto.ca/home/","tickets":"https://arttoronto.ca/home/tickets/?gad_source=1&gad_campaignid=22937691808&gbraid=0AAAABAIViEuF591mb7ytL22VlsqQ59F77&gclid=CjwKCAjwq8PVBhAKEiwA2i3SHfXK2uu4R_jwkDAZLzJTTvotY6tTc5gybgEiTsGq5YvEuZT1MkbmOhoC1hYQAvD_BwE"},{"id":"993f5fe8-98ef-409e-b9ca-9c7b77738397","name":"Taste of Downtown Yonge Fall Flavours: Walking Food Tour","dates":[1789659000000,1790263800000,1790868600000,1791473400000,1792078200000,1792683000000,1793287800000,1793896200000,1794501000000,1795105800000,1795710600000],"start":"2026-09-17T11:30:00-04:00","end":"2026-11-26T11:30:00-05:00","allDay":"Day Event","venue":{"name":"Meeting point: Fusettes","address":"407 Yonge St, Toronto, ON, M5B 1S9","lat":43.659499524,"lng":-79.382002835},"free":false,"low":20,"high":null,"pwyc":null,"costNotes":null,"description":"Fall Flavours is a seasonal one-hour food tour designed especially for people who work in and around the neighbourhood. \n\nDiscover the flavours of the season while visiting local restaurants, cafés and food spots, with tasting-sized bites and stories from the streets of Downtown Yonge. \n\nIt’s a quick, delicious way to make your lunch hour feel like a little adventure! Find some new local favourites along the way.\n\nOne hour. Multiple food stops. A taste of the season and of the city!  Come hungry and discover somewhere new.","categories":["Food/Culinary","Run/Walk","Tour"],"presenter":"Downtown Yonge BIA","image":null,"website":"http://www.downtownyonge.com/foodtours","tickets":"http://www.downtownyonge.com/foodtours"},{"id":"13a99143-7b82-4457-803c-5156bcb33bc2","name":"Taste of Downtown Yonge Fall Flavours: Walking Food Tour","dates":[1789659000000,1790263800000,1790868600000,1791473400000,1792078200000,1792683000000,1793287800000,1793896200000,1794501000000,1795105800000,1795710600000],"start":"2026-09-17T11:30:00-04:00","end":"2026-11-26T11:30:00-05:00","allDay":"Day Event","venue":{"name":"Meeting point: Fusettes","address":"407 Yonge St, Toronto, ON, M5B 1S9","lat":43.659499524,"lng":-79.382002835},"free":false,"low":20,"high":null,"pwyc":null,"costNotes":null,"description":"Fall Flavours is a seasonal one-hour food tour designed especially for people who work in and around the neighbourhood. \n\nDiscover the flavours of the season while visiting local restaurants, cafés and food spots, with tasting-sized bites and stories from the streets of Downtown Yonge. \n\nIt’s a quick, delicious way to make your lunch hour feel like a little adventure! Find some new local favourites along the way.\n\nOne hour. Multiple food stops. A taste of the season and of the city!  Come hungry and discover somewhere new.","categories":["Food/Culinary","Run/Walk","Tour"],"presenter":"Downtown Yonge BIA","image":null,"website":"http://www.downtownyonge.com/foodtours","tickets":"http://www.downtownyonge.com/foodtours"},{"id":"961d9f67-1225-413d-b902-9f48dd9a333d","name":"Giltspur Park - 11 a.m .to 1 p.m.","dates":[1791644400000],"start":"2026-10-10T11:00:00-04:00","end":"2026-10-10T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Giltspur Park","address":"85 Magellan Dr, North York","lat":43.736046692,"lng":-79.508397341},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Try something new, get moving and connect through sport, Play Mobile is a free touring sports program for all ages and skill levels.\n\nWith a variety of sports equipment on board, vibrant vans tour neighbourhoods, transforming parks and outdoor spaces into pop-up sport hubs, bringing energy and excitement directly to communities around the city. Proudly powered in partnership with Nike, Play Mobile is committed to the future of youth sport, creating more equitable and inclusive access to play – with a focus on encouraging girls to participate and stay involved in sport.","categories":["Sports"],"presenter":null,"image":"JY5NZWRAS6Lt1TXJKw_GWw","website":"https://www.toronto.ca/explore-enjoy/parks-recreation/places-spaces/parks-and-recreation-facilities/parks-and-community-recreation-centres-map/#location=790%20Queen%20St%20W&lat=43.647889&lng=-79.414226&zoom=17","tickets":null},{"id":"85960667-3a1d-40e8-9b32-b0c04beaa81a","name":"Rebirth: The Quiet Becoming Installation at Fort York","dates":[1785938400000,1786024800000,1786111200000,1786197600000,1786284000000,1786543200000,1786629600000,1786716000000,1786802400000,1786888800000,1787148000000,1787234400000,1787320800000,1787407200000,1787493600000,1787752800000,1787839200000,1787925600000,1788012000000,1788098400000,1788357600000,1788444000000,1788530400000,1788616800000,1788703200000,1788962400000,1789048800000,1789135200000,1789221600000,1789308000000,1789567200000,1789653600000,1789740000000,1789826400000,1789912800000,1790172000000,1790258400000,1790344800000,1790431200000,1790517600000,1790776800000,1790863200000,1790949600000,1791036000000,1791122400000,1791381600000,1791468000000,1791554400000,1791640800000,1791727200000,1791986400000,1792072800000,1792159200000,1792245600000,1792332000000,1792591200000,1792677600000,1792764000000,1792850400000,1792936800000,1793196000000,1793282400000,1793368800000,1793455200000],"start":"2026-08-05T10:00:00-04:00","end":"2026-10-31T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864096,"lng":-79.406314887},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Experience a bold new outdoor installation on the Gardiner Expressway beside Fort York Visitor Centre. Created by artists Delali Cofie and Yuma Dean Hester, it reimagines the site’s layered histories through contemporary art. An accompanying exhibition inside the Visitor Centre deepens the experience, inviting visitors to encounter the Fort as a living cultural landscape shaped by reflection, dialogue and collaboration.","categories":["Arts/Exhibits","History","Museum"],"presenter":null,"image":"_QHlUAQMVyNc88AaSDfQ8A","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":null},{"id":"7e438037-8166-40e3-a0ba-d70a832dd982","name":"Rebirth: The Quiet Becoming Installation at Fort York","dates":[1785938400000,1786024800000,1786111200000,1786197600000,1786284000000,1786543200000,1786629600000,1786716000000,1786802400000,1786888800000,1787148000000,1787234400000,1787320800000,1787407200000,1787493600000,1787752800000,1787839200000,1787925600000,1788012000000,1788098400000,1788357600000,1788444000000,1788530400000,1788616800000,1788703200000,1788962400000,1789048800000,1789135200000,1789221600000,1789308000000,1789567200000,1789653600000,1789740000000,1789826400000,1789912800000,1790172000000,1790258400000,1790344800000,1790431200000,1790517600000,1790776800000,1790863200000,1790949600000,1791036000000,1791122400000,1791381600000,1791468000000,1791554400000,1791640800000,1791727200000,1791986400000,1792072800000,1792159200000,1792245600000,1792332000000,1792591200000,1792677600000,1792764000000,1792850400000,1792936800000,1793196000000,1793282400000,1793368800000,1793455200000],"start":"2026-08-05T10:00:00-04:00","end":"2026-10-31T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864096,"lng":-79.406314887},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Experience a bold new outdoor installation on the Gardiner Expressway beside Fort York Visitor Centre. Created by artists Delali Cofie and Yuma Dean Hester, it reimagines the site’s layered histories through contemporary art. An accompanying exhibition inside the Visitor Centre deepens the experience, inviting visitors to encounter the Fort as a living cultural landscape shaped by reflection, dialogue and collaboration.","categories":["Arts/Exhibits","History","Museum"],"presenter":null,"image":"_QHlUAQMVyNc88AaSDfQ8A","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":null},{"id":"1fc73a91-a131-4086-96f4-784035823048","name":"Historic Holiday Gingerbread Workshop at Fort York","dates":[1797696000000,1797706800000,1797782400000,1797793200000,1798041600000,1798052400000,1798128000000,1798138800000,1798387200000,1798398000000,1798646400000,1798657200000,1798732800000,1798743600000,1798905600000,1798916400000,1798992000000,1799002800000],"start":"2026-12-19T11:00:00-05:00","end":"2027-01-03T14:00:00-05:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site ","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864,"lng":-79.406315},"free":false,"low":20,"high":null,"pwyc":null,"costNotes":null,"description":"Experience the warmth of the holiday season through a hands-on baking workshop in the historic Officers' Mess Kitchen.  Children and teens aged 8 to 14 can prepare an historic recipe using traditional methods including creaming butter, pounding sugar, grating spices, sifting flour, rolling and cutting dough.  \n\nWhile the gingerbread bakes, participants can enjoy a festive scavenger hunt in the Fort and return back to the kitchen to sample their freshly baked gingerbread biscuits and take home the historic recipe to recreate in their own kitchens.  ","categories":["Food/Culinary","History","Museum","Winter Holidays"],"presenter":null,"image":"OOkRdDMZf1TJSEdlmkqvKg","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/f778e3cc-f1b6-403a-baa6-4c8276e34a34"},{"id":"be67d18c-a14b-4de4-907a-bfdadf090fd9","name":"Historic Holiday Gingerbread Workshop at Fort York","dates":[1797696000000,1797706800000,1797782400000,1797793200000,1798041600000,1798052400000,1798128000000,1798138800000,1798387200000,1798398000000,1798646400000,1798657200000,1798732800000,1798743600000,1798905600000,1798916400000,1798992000000,1799002800000],"start":"2026-12-19T11:00:00-05:00","end":"2027-01-03T14:00:00-05:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site ","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864,"lng":-79.406315},"free":false,"low":20,"high":null,"pwyc":null,"costNotes":null,"description":"Experience the warmth of the holiday season through a hands-on baking workshop in the historic Officers' Mess Kitchen.  Children and teens aged 8 to 14 can prepare an historic recipe using traditional methods including creaming butter, pounding sugar, grating spices, sifting flour, rolling and cutting dough.  \n\nWhile the gingerbread bakes, participants can enjoy a festive scavenger hunt in the Fort and return back to the kitchen to sample their freshly baked gingerbread biscuits and take home the historic recipe to recreate in their own kitchens.  ","categories":["Food/Culinary","History","Museum","Winter Holidays"],"presenter":null,"image":"OOkRdDMZf1TJSEdlmkqvKg","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/f778e3cc-f1b6-403a-baa6-4c8276e34a34"},{"id":"1fb67c9a-4e71-4bee-b1cd-ff35de7cf49b","name":"Historic Holiday Gingerbread Workshop at Fort York","dates":[1797696000000,1797706800000,1797782400000,1797793200000,1798041600000,1798052400000,1798128000000,1798138800000,1798387200000,1798398000000,1798646400000,1798657200000,1798732800000,1798743600000,1798905600000,1798916400000,1798992000000,1799002800000],"start":"2026-12-19T11:00:00-05:00","end":"2027-01-03T14:00:00-05:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site ","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864,"lng":-79.406315},"free":false,"low":20,"high":null,"pwyc":null,"costNotes":null,"description":"Experience the warmth of the holiday season through a hands-on baking workshop in the historic Officers' Mess Kitchen.  Children and teens aged 8 to 14 can prepare an historic recipe using traditional methods including creaming butter, pounding sugar, grating spices, sifting flour, rolling and cutting dough.  \n\nWhile the gingerbread bakes, participants can enjoy a festive scavenger hunt in the Fort and return back to the kitchen to sample their freshly baked gingerbread biscuits and take home the historic recipe to recreate in their own kitchens.  ","categories":["Food/Culinary","History","Museum","Winter Holidays"],"presenter":null,"image":"OOkRdDMZf1TJSEdlmkqvKg","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/f778e3cc-f1b6-403a-baa6-4c8276e34a34"},{"id":"07d365fe-df02-41c7-8aeb-064ab3cfb91c","name":"Historic Holiday Gingerbread Workshop at Fort York","dates":[1797696000000,1797706800000,1797782400000,1797793200000,1798041600000,1798052400000,1798128000000,1798138800000,1798387200000,1798398000000,1798646400000,1798657200000,1798732800000,1798743600000,1798905600000,1798916400000,1798992000000,1799002800000],"start":"2026-12-19T11:00:00-05:00","end":"2027-01-03T14:00:00-05:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site ","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864,"lng":-79.406315},"free":false,"low":20,"high":null,"pwyc":null,"costNotes":null,"description":"Experience the warmth of the holiday season through a hands-on baking workshop in the historic Officers' Mess Kitchen.  Children and teens aged 8 to 14 can prepare an historic recipe using traditional methods including creaming butter, pounding sugar, grating spices, sifting flour, rolling and cutting dough.  \n\nWhile the gingerbread bakes, participants can enjoy a festive scavenger hunt in the Fort and return back to the kitchen to sample their freshly baked gingerbread biscuits and take home the historic recipe to recreate in their own kitchens.  ","categories":["Food/Culinary","History","Museum","Winter Holidays"],"presenter":null,"image":"OOkRdDMZf1TJSEdlmkqvKg","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/f778e3cc-f1b6-403a-baa6-4c8276e34a34"},{"id":"86c6f03d-7b1d-4300-9acd-34380e3ff560","name":"Patterns That Aren't Exhibition","dates":[1792846800000,1792933200000,1793019600000,1793106000000,1793192400000,1793278800000,1793365200000,1793451600000,1793541600000,1793628000000,1793714400000,1793800800000,1793887200000,1793973600000,1794060000000,1794146400000,1794232800000,1794319200000,1794405600000,1794492000000,1794578400000,1794664800000,1794751200000,1794837600000,1794924000000,1795010400000],"start":"2026-10-24T09:00:00-04:00","end":"2026-11-18T09:00:00-05:00","allDay":"Day Event","venue":{"name":"Cedar Ridge Creative Centre","address":"225 Confederation Dr, Scarborough, ON, M1G 1B2","lat":43.75743,"lng":-79.207132},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Step into the intricate world of artist David Currie as he explores how humans are hard-wired to seek out patterns as a means of adapting to their environment, whether connecting imaginary lines to stars or writing algorithms that direct a robot’s movements. But once a pattern is understood, interest tends to fade. Here, Currie has developed a refreshingly new visual vocabulary, one built to engage rather than fade into the background in his series of large-scale, mixed media, papercut artworks that combine recent discoveries in mathematics with a lifetime of the artist’s skill, development and commitment.","categories":["Arts/Exhibits","Artisan","Cultural"],"presenter":null,"image":"kuVTMxi1tk-BXO-t1GOSLw","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/cedar-ridge-creative-centre/","tickets":null},{"id":"7873e3af-55d3-48d1-9f68-5805fba32d93","name":"Wonderland Road by Carrianne Leung – By the Lake Book Club","dates":[1828224000000],"start":"2027-12-07T19:00:00-05:00","end":"2027-12-07T19:00:00-05:00","allDay":"Night Event","venue":{"name":"Assembly Hall","address":"1 Colonel Samuel Smith Park Dr, Etobicoke, ON, M8V 4B6","lat":43.597660441,"lng":-79.515824559},"free":false,"low":10,"high":21,"pwyc":null,"costNotes":null,"description":"Presented by: City of Toronto’s Assembly Hall, Humber Polytechnic’s Faculty of Media, Creative Arts and Design\n\nWonderland Road is a dystopian novel set in a near future shaped by uncertainty, where three lives intertwine in a neighbourhood struggling to endure loss, isolation and change. Through characters searching for safety and connection, Carrianne Leung explores survival, community, family and hope in an unpredictable world. In conversation, she'll speak about the ideas that sparked the novel and how resilience, compassion and human connection emerge throughout the story.\n\nBy the Lake Book Club offers six Tuesday-night events, between February and December featuring leading Canadian authors in conversation with Humber Polytechnics alumni. Each in-person event includes a reading, discussion, audience Q&A, book-signing and American sign language interpretation. Virtual events are subtitled live.\n","categories":["Literary","Talks"],"presenter":null,"image":"e8RR4B7wlgk8ioYlvAucQQ","website":"https://toronto.ca/BookClub","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/084a6d2b-8730-4643-90e0-9a2be6b977ec"},{"id":"fcb7e296-c2ea-41bd-864d-9a72696a4ede","name":"Turning in the Light Exhibition","dates":[1791032400000,1791118800000,1791205200000,1791291600000,1791378000000,1791464400000,1791550800000,1791637200000,1791723600000,1791810000000,1791896400000,1791982800000,1792069200000,1792155600000,1792242000000,1792328400000,1792414800000,1792501200000,1792587600000,1792674000000,1792760400000,1792846800000,1792933200000,1793019600000,1793106000000,1793192400000,1793278800000],"start":"2026-10-03T09:00:00-04:00","end":"2026-10-29T09:00:00-04:00","allDay":"Day Event","venue":{"name":"Clark Centre for the Arts","address":"191 Guildwood Pkwy, Scarborough, ON, M1E 1P5","lat":43.746893127,"lng":-79.193688812},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Be inspired by Katharine Harvey's new body of work which explores the remarkable architectural fragments preserved at Guild Park. Historic stone carvings rescued from demolished Toronto buildings now coexist with forests, gardens and Lake Ontario. Through vibrant paintings, Harvey reveals layered stories that connect built heritatge, nature and memory, inviting viewers to see the park with fresh eyes.\n\nAbout the Artist\nKatharine Harvey is a Canadian conceptual painter and multi-media artist based in Toronto. Throughout her career, she has switched naturally between mediums, allowing her paintings to inform her public artwork and vice versa. This process inspired Katharine to create a body of work that includes multi-layered acrylic paintings, recycled plastic installations, monumental public art, kinetic sculptures and an illuminated drone show.","categories":["Arts/Exhibits"],"presenter":null,"image":"7EEr156fHjrgxMEyH4K5ew","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/clark-centre-for-the-arts/","tickets":null},{"id":"9fa2d2b4-18d7-46a1-9c74-c5066d91abf3","name":"The Life of a Creature by Nadja Lubiw-Hazard – By the Lake Book Club","dates":[1804636800000],"start":"2027-03-09T19:00:00-05:00","end":"2027-03-09T19:00:00-05:00","allDay":"Night Event","venue":{"name":"Assembly Hall","address":"1 Colonel Samuel Smith Park Dr, Etobicoke, ON, M8V 4B6","lat":43.597660441,"lng":-79.515824559},"free":false,"low":10,"high":28,"pwyc":null,"costNotes":null,"description":"Presented by: City of Toronto’s Assembly Hall, Humber Polytechnic’s Faculty of Media, Creative Arts and Design\n\nThrough interconnected stories, The Life of a Creature explores human-animal bonds. Nadja Lubiw-Hazard examines trauma, grief, healing and connection through characters including a veterinarian, a grieving mother and a woman reflecting on Chernobyl's feral dogs, revealing how all living beings are linked. She'll discuss the collection's themes, her approach to writing these bonds and how loss, resilience and transformation shape the stories.\n\nBy the Lake Book Club offers six Tuesday-night events, between February and December featuring leading Canadian authors in conversation with Humber Polytechnic alumni. Each in-person event includes a reading, discussion, audience Q&A, book signing and American sign language interpretation. Virtual events are subtitled live.","categories":["Literary","Talks"],"presenter":null,"image":"y6UlxWQBrC8Mq4YueQCtaQ","website":"https://toronto.ca/BookClub","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/8e6d46bc-02a0-4756-9f61-5e366042241f"},{"id":"ae61c228-5735-47b8-8db5-3287f221c00c","name":"Turning in the Light Exhibition","dates":[1791032400000,1791118800000,1791205200000,1791291600000,1791378000000,1791464400000,1791550800000,1791637200000,1791723600000,1791810000000,1791896400000,1791982800000,1792069200000,1792155600000,1792242000000,1792328400000,1792414800000,1792501200000,1792587600000,1792674000000,1792760400000,1792846800000,1792933200000,1793019600000,1793106000000,1793192400000,1793278800000],"start":"2026-10-03T09:00:00-04:00","end":"2026-10-29T09:00:00-04:00","allDay":"Day Event","venue":{"name":"Clark Centre for the Arts","address":"191 Guildwood Pkwy, Scarborough, ON, M1E 1P5","lat":43.746893127,"lng":-79.193688812},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Be inspired by Katharine Harvey's new body of work which explores the remarkable architectural fragments preserved at Guild Park. Historic stone carvings rescued from demolished Toronto buildings now coexist with forests, gardens and Lake Ontario. Through vibrant paintings, Harvey reveals layered stories that connect built heritatge, nature and memory, inviting viewers to see the park with fresh eyes.\n\nAbout the Artist\nKatharine Harvey is a Canadian conceptual painter and multi-media artist based in Toronto. Throughout her career, she has switched naturally between mediums, allowing her paintings to inform her public artwork and vice versa. This process inspired Katharine to create a body of work that includes multi-layered acrylic paintings, recycled plastic installations, monumental public art, kinetic sculptures and an illuminated drone show.","categories":["Arts/Exhibits"],"presenter":null,"image":"7EEr156fHjrgxMEyH4K5ew","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/clark-centre-for-the-arts/","tickets":null},{"id":"bbdeb206-a47a-408d-9e70-a472330797c3","name":"Tenfold: 10 year anniversary exhibition","dates":[1791496800000,1791576000000,1791651600000],"start":"2026-10-08T18:00:00-04:00","end":"2026-10-10T13:00:00-04:00","allDay":"Day Event","venue":{"name":"Remote Gallery","address":"568 Richmond St W, Toronto, ON, M5V 1Y9","lat":43.647051565,"lng":-79.401506964},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"We celebrate ten years of artistic practice, collaboration, and community. \n\nTo mark this milestone, artists from the studios were invited to bring their work together in a collective exhibition. \n\nThe title \"Tenfold\" speaks both to this ten-year journey and to the many ways creativity expands when developed collectively. \n\nWhile each artist explores distinct questions through their own techniques and visual language, Tenfold highlights the dialogues, affinities, and contrasts that emerge between their practices. \nIndividual voices remain visible, while their hared experiences reveal the rich sense of exchange fostered within the Akin studio community.\n\nParticipating artists include Anne Kobayashi, Barbara Bailey, Bernadette Peets, Bettina Westwood, Carrie Fisher, Eli Moser, Hamid Mohammadi, Loren Kaplan, Mark Buck, Miles Ingrassia, MP Guillot, Robert Simoni, Shayla Bond, Tatjana Reithofer and Veronica Zaretski.","categories":["Arts/Exhibits","Celebrations"],"presenter":"Akin Dupont Studios","image":null,"website":"https://www.eventbrite.ca/e/tenfold-akin-duponts-10-year-anniversary-exhibition-tickets-2001630172729","tickets":"https://www.eventbrite.ca/e/tenfold-akin-duponts-10-year-anniversary-exhibition-tickets-2001630172729"},{"id":"d6e3b0ff-566c-49e9-b8e4-0e7ebf5a85d7","name":"50 Years of Etobicoke Civic Centre Art Gallery Exhibition - 50th Anniversary","dates":[1788264000000,1788350400000,1788436800000,1788523200000,1788616800000,1788782400000,1788868800000,1788955200000,1789041600000,1789128000000,1789221600000,1789387200000,1789473600000,1789560000000,1789646400000,1789732800000,1789826400000,1789992000000,1790078400000,1790164800000,1790251200000,1790337600000,1790431200000,1790596800000,1790683200000,1790769600000,1790856000000,1790942400000,1791036000000,1791201600000,1791288000000,1791374400000,1791460800000,1791547200000,1791640800000,1791806400000,1791892800000,1791979200000,1792065600000,1792152000000,1792245600000,1792411200000,1792497600000,1792584000000,1792670400000,1792756800000,1792850400000,1793016000000,1793102400000,1793188800000,1793275200000,1793361600000,1793455200000,1793624400000,1793710800000,1793797200000,1793883600000,1793970000000,1794063600000,1794229200000,1794315600000,1794402000000,1794488400000,1794574800000,1794668400000,1794834000000,1794920400000,1795006800000,1795093200000,1795179600000,1795273200000,1795438800000,1795525200000,1795611600000,1795698000000,1795784400000,1795878000000,1796043600000,1796130000000,1796216400000,1796302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000],"start":"2026-09-01T08:00:00-04:00","end":"2026-12-15T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Etobicoke Civic Centre Art Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover the history of art at the Etobicoke Civic Centre with artifacts, prints, images and paintings from City of Toronto’s Fine Art, Artifact and Archival collections. Celebrate the present by witnessing a commissioned piece by early career artist Lise Round. Envision the future with new designs of the updated Etobicoke Civic Centre Art Gallery.","categories":["Arts/Exhibits"],"presenter":null,"image":"A6-VIKDNvgJfy1_SuU-UqA","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/?WT.rd_id=%2Feccartgallery","tickets":null},{"id":"793bc5e9-5df6-4f8c-9674-e086c735e743","name":"Lassonde Art Trail: Art + Nature Tour","dates":[1789228800000,1789833600000,1790438400000,1791043200000,1791648000000,1792252800000,1792857600000,1793462400000,1794070800000,1794675600000],"start":"2026-09-12T12:00:00-04:00","end":"2026-11-14T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Biidaasige Park ","address":"51 Commissioners St, Toronto, ON, M5A 1A6","lat":43.646495807,"lng":-79.348925214},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join LAT every Saturday at 12 pm or 2 pm for a drop-in Art + Nature tour led by a LAT Art Guide. These walking tours invite participants to explore the artworks along the Lassonde Art Trail while discovering the rich history, ecology, and ongoing transformation of Biidaasige Park.\n\n12 pm - Art + Nature Tour (30 minutes, slow paced)\n2 pm - Art + Nature Tour (1 hour)\nMeet in front of Old Fire Hall 30. All tours are drop-in and free to attend. Please be aware that the trees in the park system are not yet mature, so there is little shade. We recommend dressing according to the weather. Tours are subject to cancellation in the event of adverse weather. Please see Lassonde Art Trail website for further details.","categories":["Arts/Exhibits","Environmental","Tour"],"presenter":null,"image":"Xy_GPUCC1IStLKdFhFwxCg","website":"https://lassondearttrail.org/art-trail/","tickets":null},{"id":"c49352c1-bc73-4274-8af9-b8d4f9e33abf","name":"Lassonde Art Trail: Art + Nature Tour","dates":[1789228800000,1789833600000,1790438400000,1791043200000,1791648000000,1792252800000,1792857600000,1793462400000,1794070800000,1794675600000],"start":"2026-09-12T12:00:00-04:00","end":"2026-11-14T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Biidaasige Park ","address":"51 Commissioners St, Toronto, ON, M5A 1A6","lat":43.646495807,"lng":-79.348925214},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join LAT every Saturday at 12 pm or 2 pm for a drop-in Art + Nature tour led by a LAT Art Guide. These walking tours invite participants to explore the artworks along the Lassonde Art Trail while discovering the rich history, ecology, and ongoing transformation of Biidaasige Park.\n\n12 pm - Art + Nature Tour (30 minutes, slow paced)\n2 pm - Art + Nature Tour (1 hour)\nMeet in front of Old Fire Hall 30. All tours are drop-in and free to attend. Please be aware that the trees in the park system are not yet mature, so there is little shade. We recommend dressing according to the weather. Tours are subject to cancellation in the event of adverse weather. Please see Lassonde Art Trail website for further details.","categories":["Arts/Exhibits","Environmental","Tour"],"presenter":null,"image":"Xy_GPUCC1IStLKdFhFwxCg","website":"https://lassondearttrail.org/art-trail/","tickets":null},{"id":"8e7ac48c-72a7-49d0-ae46-117e516ede17","name":"Lassonde Art Trail: Art + Nature Tour","dates":[1789228800000,1789833600000,1790438400000,1791043200000,1791648000000,1792252800000,1792857600000,1793462400000,1794070800000,1794675600000],"start":"2026-09-12T12:00:00-04:00","end":"2026-11-14T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Biidaasige Park ","address":"51 Commissioners St, Toronto, ON, M5A 1A6","lat":43.646495807,"lng":-79.348925214},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join LAT every Saturday at 12 pm or 2 pm for a drop-in Art + Nature tour led by a LAT Art Guide. These walking tours invite participants to explore the artworks along the Lassonde Art Trail while discovering the rich history, ecology, and ongoing transformation of Biidaasige Park.\n\n12 pm - Art + Nature Tour (30 minutes, slow paced)\n2 pm - Art + Nature Tour (1 hour)\nMeet in front of Old Fire Hall 30. All tours are drop-in and free to attend. Please be aware that the trees in the park system are not yet mature, so there is little shade. We recommend dressing according to the weather. Tours are subject to cancellation in the event of adverse weather. Please see Lassonde Art Trail website for further details.","categories":["Arts/Exhibits","Environmental","Tour"],"presenter":null,"image":"Xy_GPUCC1IStLKdFhFwxCg","website":"https://lassondearttrail.org/art-trail/","tickets":null},{"id":"86a3eefd-eacd-44d4-9a5f-f83c865217e5","name":"Lassonde Art Trail: Art + Nature Tour","dates":[1789228800000,1789833600000,1790438400000,1791043200000,1791648000000,1792252800000,1792857600000,1793462400000,1794070800000,1794675600000],"start":"2026-09-12T12:00:00-04:00","end":"2026-11-14T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Biidaasige Park ","address":"51 Commissioners St, Toronto, ON, M5A 1A6","lat":43.646495807,"lng":-79.348925214},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join LAT every Saturday at 12 pm or 2 pm for a drop-in Art + Nature tour led by a LAT Art Guide. These walking tours invite participants to explore the artworks along the Lassonde Art Trail while discovering the rich history, ecology, and ongoing transformation of Biidaasige Park.\n\n12 pm - Art + Nature Tour (30 minutes, slow paced)\n2 pm - Art + Nature Tour (1 hour)\nMeet in front of Old Fire Hall 30. All tours are drop-in and free to attend. Please be aware that the trees in the park system are not yet mature, so there is little shade. We recommend dressing according to the weather. Tours are subject to cancellation in the event of adverse weather. Please see Lassonde Art Trail website for further details.","categories":["Arts/Exhibits","Environmental","Tour"],"presenter":null,"image":"Xy_GPUCC1IStLKdFhFwxCg","website":"https://lassondearttrail.org/art-trail/","tickets":null},{"id":"716743af-96e0-46fc-b6ea-9bfb606fc4d6","name":"Riverdale Park East  - 11 a.m. to 1 p.m.","dates":[1791039600000],"start":"2026-10-03T11:00:00-04:00","end":"2026-10-03T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Riverdale Park East","address":"550 Broadview Ave, Toronto","lat":43.671456859,"lng":-79.355162656},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Play Mobile is a free touring sports program for all ages and skill levels, no registration or reservations are required to participate. The new soccer Play Mobile is dedicated to the world’s most popular game. All ages are invited to learn and celebrate soccer in a fun, supportive environment with no experience required.","categories":["Sports"],"presenter":null,"image":"D-JBEvzzMMBRxdflGESP0g","website":"https://www.toronto.ca/explore-enjoy/parks-recreation/places-spaces/parks-and-recreation-facilities/parks-and-community-recreation-centres-map/#location=2000%20MCNICOLL%20AVE&lat=43.812658&lng=-79.305013&zoom=11","tickets":null},{"id":"3b00a0a7-e6cf-4007-9aae-344068274dbb","name":"Tales of the Damned: Immersive Theatre Experience","dates":[1792020600000,1792193400000,1792279200000,1792366200000,1792539000000,1792625400000,1792798200000,1792884600000,1792971000000,1793143800000,1793230200000,1793403000000,1793498400000,1793579400000],"start":"2026-10-14T19:30:00-04:00","end":"2026-11-01T19:30:00-05:00","allDay":"Night Event","venue":{"name":"Campbell House Museum","address":"160 Queen St W, Toronto, ON, M5H 3H3","lat":43.651058,"lng":-79.387322},"free":false,"low":42.15,"high":54.99,"pwyc":null,"costNotes":null,"description":"Experience a bone-chilling Halloween tradition!\n\nFrom the creators of the immersive sensations “Tales of the Grotesque” (2023, 2024) and the landmark production of “Tales of the Damned” (2025) comes the revival of Toronto’s favourite gothic horror anthology. \n\nWith fresh characters, familiar tales, and its twisted brand of terror, this site-specific theatrical experience brings literature’s most depraved characters to life and death. \n\nAfter a lady of the night is murdered, a mad doctor strikes a pact with the Devil to raise her from the dead. But all hell breaks loose when he comes face-to-face with her killer at a masquerade. Descend into madness with Victor Frankenstein, Henry Jekyll, and Dorian Gray to discover the results of playing God, and the monstrous repercussions when the Devil comes to collect. \n\nStep into the story as you move through the candlelit Campbell House mansion to confront history's most iconic villains. Ages 14 and up, minors must be accompanied by an adult.","categories":["Live Performances","Museum","Theatre","Halloween"],"presenter":"Campbell House Museum","image":"vywbbYFbH0ca7m8NLmLaow","website":"https://www.whitemillstheatreco.com/upcoming-events-1","tickets":"https://www.whitemillstheatreco.com/upcoming-events-1"},{"id":"c777dfc0-391f-4ea1-b121-e53083fa4386","name":"Seeing Sound Exhibit (A Synesthetic Experience) by Pauline Douady","dates":[1789822800000,1789993800000,1790080200000,1790166600000,1790253000000,1790339400000,1790425800000,1790598600000,1790685000000,1790771400000,1790857800000,1790944200000,1791030600000,1791203400000,1791289800000,1791376200000,1791462600000,1791549000000,1791635400000,1791808200000,1791894600000,1791981000000,1792067400000,1792153800000,1792240200000],"start":"2026-09-19T09:00:00-04:00","end":"2026-10-17T08:30:00-04:00","allDay":"Day Event","venue":{"name":"Alliance Française Toronto","address":"24 Spadina Rd, Toronto, ON, M5R 2S7","lat":43.668767,"lng":-79.40519},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"French Synesthete artist Pauline Douady transforms sounds, voices, and atmospheres into visual art: drawings, prints, and paintings. \n\nThe exhibition is enriched with audio content accessible accessible directly on your phone via QR codes, creating a space for pause and inner reflection. \n\nFor the full immersive experience, don't forget your headphones!","categories":["Arts/Exhibits"],"presenter":null,"image":"W3jrGDlvLLzVpEEUh4WDlw","website":"https://www.alliance-francaise.ca/en/art/cultural-season/308-seeing-sound-a-synesthetic-experience-by-pauline-douady","tickets":"https://www.eventbrite.ca/e/voir-les-sons-seeing-sound-by-pauline-douady-tickets-1992241897144?aff=oddtdtcreator&keep_tld=true"},{"id":"05f45ba5-f61e-4de1-91ad-513712f07048","name":"Seeing Sound Exhibit (A Synesthetic Experience) by Pauline Douady","dates":[1789822800000,1789993800000,1790080200000,1790166600000,1790253000000,1790339400000,1790425800000,1790598600000,1790685000000,1790771400000,1790857800000,1790944200000,1791030600000,1791203400000,1791289800000,1791376200000,1791462600000,1791549000000,1791635400000,1791808200000,1791894600000,1791981000000,1792067400000,1792153800000,