9225200000,1789484400000,1789570800000,1789657200000,1789743600000,1789830000000,1790089200000,1790175600000,1790262000000,1790348400000,1790434800000,1790694000000,1790780400000,1790866800000,1790953200000,1791039600000],"start":"2026-05-22T11:00:00-04:00","end":"2026-10-03T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Scadding Court Community Centre","address":"707 Dundas St W, Toronto, ON M5T 2W6","lat":43.651713739404556,"lng":-79.40508261942017},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Market 707 is a stretch of sidewalk near Dundas and Bathurst lined with upcycled shipping containers that offer sweet and savoury foods, services, and everything in between. \n\nPresided over by the Scadding Court Community Centre, this impromptu open-air pedestrian mall has one of the most eclectic collection of startup businesses in the city.","categories":["Other"],"presenter":null,"image":"oa2xxPdB_5ibesOE3pMKmA","website":"https://mkt707.ca/","tickets":null},{"id":"822f9eb2-cd84-4729-90ff-9e9d357d1dc5","name":"Underpass Park Farmers' Market","dates":[1778788800000,1779393600000,1779998400000,1780603200000,1781208000000,1781812800000,1782417600000,1783022400000,1783627200000,1784232000000,1784836800000,1785441600000,1786046400000,1786651200000,1787256000000,1787860800000,1788465600000,1789070400000,1789675200000,1790280000000,1790884800000,1791489600000,1792094400000],"start":"2026-05-14T16:00:00-04:00","end":"2026-10-15T16:00:00-04:00","allDay":"Day Event","venue":{"name":"Underpass Park","address":"29 Lower River Street, Toronto, ON M5A 1M6","lat":43.65585,"lng":-79.354586},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover the magic of Underpass Park Farmers' Market—a vibrant gem in Toronto's Corktown and one of the city's most unique farmers market destinations! Surrounded by colorful murals from local artists, this lively outdoor market bursts with farm-fresh fruits and vegetables, mouthwatering baked goods, homemade preserves, and a tempting selection of artisanal treats.\n\nFrom May to October—rain or shine—this pet-friendly hotspot invites you to soak up live music, browse the stalls, and mingle with adorable pups for a truly unforgettable market experience.","categories":["Farmers' Market","Other"],"presenter":null,"image":"w3Jiy9MEVv3kfA1fQck79w","website":"https://underpassparkmarket.com/","tickets":null},{"id":"6ecfd304-ec79-485e-876e-b8b1c215fa20","name":"Underpass Park Farmers' Market","dates":[1778788800000,1779393600000,1779998400000,1780603200000,1781208000000,1781812800000,1782417600000,1783022400000,1783627200000,1784232000000,1784836800000,1785441600000,1786046400000,1786651200000,1787256000000,1787860800000,1788465600000,1789070400000,1789675200000,1790280000000,1790884800000,1791489600000,1792094400000],"start":"2026-05-14T16:00:00-04:00","end":"2026-10-15T16:00:00-04:00","allDay":"Day Event","venue":{"name":"Underpass Park","address":"29 Lower River Street, Toronto, ON M5A 1M6","lat":43.65585,"lng":-79.354586},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover the magic of Underpass Park Farmers' Market—a vibrant gem in Toronto's Corktown and one of the city's most unique farmers market destinations! Surrounded by colorful murals from local artists, this lively outdoor market bursts with farm-fresh fruits and vegetables, mouthwatering baked goods, homemade preserves, and a tempting selection of artisanal treats.\n\nFrom May to October—rain or shine—this pet-friendly hotspot invites you to soak up live music, browse the stalls, and mingle with adorable pups for a truly unforgettable market experience.","categories":["Farmers' Market","Other"],"presenter":null,"image":"w3Jiy9MEVv3kfA1fQck79w","website":"https://underpassparkmarket.com/","tickets":null},{"id":"af4caf4f-c8de-4067-9135-77542ce0f1f1","name":"Withrow Park Farmers' Market","dates":[1780146000000,1780750800000,1781355600000,1781960400000,1782565200000,1783170000000,1783774800000,1784379600000,1784984400000,1785589200000,1786194000000,1786798800000,1787403600000,1788008400000,1788613200000,1789218000000,1789822800000,1790427600000,1791032400000,1791637200000,1792242000000,1792846800000],"start":"2026-05-30T09:00:00-04:00","end":"2026-10-24T09:00:00-04:00","allDay":"Day Event","venue":{"name":"Withrow Park ","address":"725 Logan Ave, Toronto, ON M4K 3B9","lat":43.67657084103454,"lng":-79.34742988876354},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Just steps from Danforth Avenue in vibrant Greektown, Withrow Park Farmers’ Market bursts to life every season! Since 2006, it’s been the go-to destination for fresh food, lively music, local art, and a joyful sense of community—celebrating the best of Toronto while championing local farmers, producers, and artisans.\n\nFrom June to October, the park transforms into a buzzing hub of delicious discoveries and vibrant connection. We’re passionate about creating an inclusive, sustainable, and community-powered market where every visit is an adventure—and everyone’s welcome!","categories":["Farmers' Market","Other"],"presenter":null,"image":"L8DDBTjIOMKrxChhtduF6Q","website":"https://withrowmarket.ca/","tickets":null},{"id":"a8ccf9f7-70e3-4ba9-a4fe-3486364b73a9","name":"Withrow Park Farmers' Market","dates":[1780146000000,1780750800000,1781355600000,1781960400000,1782565200000,1783170000000,1783774800000,1784379600000,1784984400000,1785589200000,1786194000000,1786798800000,1787403600000,1788008400000,1788613200000,1789218000000,1789822800000,1790427600000,1791032400000,1791637200000,1792242000000,1792846800000],"start":"2026-05-30T09:00:00-04:00","end":"2026-10-24T09:00:00-04:00","allDay":"Day Event","venue":{"name":"Withrow Park ","address":"725 Logan Ave, Toronto, ON M4K 3B9","lat":43.67657084103454,"lng":-79.34742988876354},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Just steps from Danforth Avenue in vibrant Greektown, Withrow Park Farmers’ Market bursts to life every season! Since 2006, it’s been the go-to destination for fresh food, lively music, local art, and a joyful sense of community—celebrating the best of Toronto while championing local farmers, producers, and artisans.\n\nFrom June to October, the park transforms into a buzzing hub of delicious discoveries and vibrant connection. We’re passionate about creating an inclusive, sustainable, and community-powered market where every visit is an adventure—and everyone’s welcome!","categories":["Farmers' Market","Other"],"presenter":null,"image":"L8DDBTjIOMKrxChhtduF6Q","website":"https://withrowmarket.ca/","tickets":null},{"id":"49c22735-8224-478d-862a-12ff78630dfd","name":"East York Farmers' Market","dates":[1778587200000,1779192000000,1779796800000,1780401600000,1781006400000,1781611200000,1782216000000,1782820800000,1783425600000,1784030400000,1784635200000,1785240000000,1785844800000,1786449600000,1787054400000,1787659200000,1788264000000,1788868800000,1789473600000,1790078400000,1790683200000,1791288000000,1791892800000,1792497600000,1793102400000],"start":"2026-05-12T08:00:00-04:00","end":"2026-10-27T08:00:00-04:00","allDay":"Day Event","venue":{"name":"East York Civic Centre","address":"850 Coxwell Ave, East York, ON M4C 5R1","lat":43.69130125251015,"lng":-79.3283791194498},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Thank you all for a wonderful opening day! It was so lovely to see everyone again after a very long winter. \nHere’s to a fantastic 2026 market season full of delicious, local produce and so much more!","categories":["Farmers' Market","Other"],"presenter":null,"image":"WxjChgoUOpqklJ1chm1hgQ","website":"https://juliekinnear.com/blogs/east-york-farmers-market","tickets":null},{"id":"8035b594-be59-4c80-8bd5-44be29c4e708","name":"East York Farmers' Market","dates":[1778587200000,1779192000000,1779796800000,1780401600000,1781006400000,178161120000