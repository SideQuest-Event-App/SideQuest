74800000,1784379600000,1784984400000,1785589200000,1786194000000,1786798800000,1787403600000,1788008400000,1788613200000,1789218000000,1789822800000,1790427600000,1791032400000,1791637200000,1792242000000,1792846800000,1793451600000],"start":"2026-05-16T09:00:00-04:00","end":"2026-10-31T09:00:00-04:00","allDay":"Day Event","venue":{"name":"Baird Park","address":"275 Keele St, Toronto, ON M6P 2K5, Canada","lat":43.663023721805715,"lng":-79.46217817047676},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Step into the lively Junction Farmers Market, where every visit is a celebration of fresh, local, and sustainably produced food! Join a vibrant community supporting passionate growers and producers while discovering delicious finds around every corner.\n\nExperience the joy of healthy, accessible food for everyone in and around the Junction—your next great food adventure starts here!","categories":["Farmers' Market","Other"],"presenter":null,"image":"1QtxyeTQD-ylYXlIjttO-g","website":"https://junctionmarket.ca/","tickets":null},{"id":"a81e3896-33c9-470f-a790-7994ef40eb16","name":"Thorncliffe Park Women Community Bazaar","dates":[1778869800000,1779474600000,1780079400000,1780684200000,1781289000000,1781893800000,1782498600000,1783103400000,1783708200000,1784313000000,1784917800000,1785522600000,1786127400000,1786732200000,1787337000000,1787941800000,1788546600000,1789151400000,1789756200000,1790361000000,1790965800000,1791570600000],"start":"2026-05-15T14:30:00-04:00","end":"2026-10-09T14:30:00-04:00","allDay":"Day Event","venue":{"name":"Burguess Park","address":"46 Thorncliffe Park Dr, East York, ON M4H 1K8","lat":43.703975361240246,"lng":-79.34348238869404},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"A grassroots women led organization dedicated to creating and implementing public space enhancement projects in the community of Thorncliffe Park. The community bazaar happens every Friday during from June to October. As vendors at our weekly markets, women from the neighbourhood are able to advance the skills and knowledge they already possess, and are provided with opportunities to gain new ones that can translate into better employment opportunities.\n\n","categories":["Cultural","Food/Culinary","Other"],"presenter":null,"image":"fO6IaSWH7zDJNLIydPtWHA","website":"https://tpwomenscomm.org/our-community-market/","tickets":null},{"id":"e113ae92-dd4e-4d5a-8b9e-2a1221dc8355","name":"Thorncliffe Park Women Community Bazaar","dates":[1778869800000,1779474600000,1780079400000,1780684200000,1781289000000,1781893800000,1782498600000,1783103400000,1783708200000,1784313000000,1784917800000,1785522600000,1786127400000,1786732200000,1787337000000,1787941800000,1788546600000,1789151400000,1789756200000,1790361000000,1790965800000,1791570600000],"start":"2026-05-15T14:30:00-04:00","end":"2026-10-09T14:30:00-04:00","allDay":"Day Event","venue":{"name":"Burguess Park","address":"46 Thorncliffe Park Dr, East York, ON M4H 1K8","lat":43.703975361240246,"lng":-79.34348238869404},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"A grassroots women led organization dedicated to creating and implementing public space enhancement projects in the community of Thorncliffe Park. The community bazaar happens every Friday during from June to October. As vendors at our weekly markets, women from the neighbourhood are able to advance the skills and knowledge they already possess, and are provided with opportunities to gain new ones that can translate into better employment opportunities.\n\n","categories":["Cultural","Food/Culinary","Other"],"presenter":null,"image":"fO6IaSWH7zDJNLIydPtWHA","website":"https://tpwomenscomm.org/our-community-market/","tickets":null},{"id":"98aa5d48-11e3-48a3-acd2-4359e7cc6de2","name":"East Lynn Park Farmers' Market","dates":[1780599600000,1781204400000,1781809200000,1782414000000,1783018800000,1783623600000,1784228400000,1784833200000,