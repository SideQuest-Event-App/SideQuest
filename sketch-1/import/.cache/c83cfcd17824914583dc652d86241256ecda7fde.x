00000,1789743600000,1789830000000,1789916400000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000,1791385200000,1791471600000,1791558000000,1791644400000,1791730800000,1791990000000,1792076400000,1792162800000,1792249200000,1792335600000,1792594800000,1792681200000,1792767600000,1792854000000,1792940400000,1793199600000,1793286000000,1793372400000,1793458800000,1793548800000],"start":"2026-07-23T11:00:00-04:00","end":"2026-11-01T11:00:00-05:00","allDay":"Day Event","venue":{"name":"Market Gallery","address":"95 Front Street East, 2nd floor","lat":43.649129,"lng":-79.371765},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Come learn about ways we move through the world, honouring the land, our stories and each other, celebrating triumphs in our journeys, strengthening fibres in our connectedness. It is within this sacred act of coming together that we find common values, building a unified vision for our future.\n \nListen to local sports origin stories alongside artistic reflections on identity, resilience, and belonging through works that highlight the power of connection across cultures and communities.\n \nThe exhibition features documentaries on Deskaheh, Herb Carnegie, and the St. Christopher House Lacrosse Organization; contemporary art by Marina Dempster, Maria Hupfield, Safoura Zahedi, Ben Spears, Pedro Zepeda, Milo Osceola, Daniel Henhawk, and David Barnett; as well as new acquisitions alongside historic items from the City of Toronto Art and Artifact Collection.\n","categories":["Arts/Exhibits","Museum"],"presenter":"TD Bank Group","image":"-m6p-aI3Br63z-qiiUz5dg","website":"http://toronto.ca/marketgallery","tickets":null},{"id":"d6204918-b71a-4c64-861d-fd82c1c62935","name":"GATHER in Toronto Exhibition","dates":[1784818800000,1784905200000,1784991600000,1785078000000,1785337200000,1785423600000,1785510000000,1785596400000,1785682800000,