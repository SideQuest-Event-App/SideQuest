,1791374400000,1791460800000,1791547200000,1791640800000,1791806400000,1791892800000,1791979200000,1792065600000,1792152000000,1792245600000,1792411200000,1792497600000,1792584000000,1792670400000,1792756800000,1792850400000,1793016000000,1793102400000,1793188800000,1793275200000,1793361600000,1793455200000,1793624400000,1793710800000,1793797200000,1793883600000,1793970000000,1794063600000,1794229200000,1794315600000,1794402000000,1794488400000,1794574800000,1794668400000,1794834000000,1794920400000,1795006800000,1795093200000,1795179600000,1795273200000,1795438800000,1795525200000,1795611600000,1795698000000,1795784400000,1795878000000,1796043600000,1796130000000,1796216400000,1796302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000],"start":"2026-09-01T08:00:00-04:00","end":"2026-12-15T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Etobicoke Civic Centre Art Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover the history of art at the Etobicoke Civic Centre with artifacts, prints, images and paintings from City of Toronto’s Fine Art, Artifact and Archival collections. Celebrate the present by witnessing a commissioned piece by early career artist Lise Round. Envision the future with new designs of the updated Etobicoke Civic Centre Art Gallery.","categories":["Arts/Exhibits"],"presenter":null,"image":"A6-VIKDNvgJfy1_SuU-UqA","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/?WT.rd_id=%2Feccartgallery","tickets":null},{"id":"4b9e7d06-0c8c-4eb5-be8a-faf29ca350b8","name":"Lodestar Poetry Evening with Laboni Islam and Lisa Hirmer","dates":[1792267200000],"start":"2026-10-17T16:00:00-04:00","end":"2026-10-17T16:00:00-04:00","allDay":"Day Event","venue":{"name":"Biidaasige Park","address":"51 Commissioners St, Toronto, ON, M5A 1A6","lat":43.646496,"lng":-79.348925},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join LAT for an evening of poetry inspired by Lisa Hirmer’s artwork 'Lodestar' on the Lassonde Art Trail.\n \n​Facilitated by Laboni Islam and planned in collaboration with Lisa Hirmer, this poetry evening invites participants to reflect on notions of home. ​Participants will visit a number of the Lassonde Art Trail’s artworks during the program, participate in dialogue, and write in response to generative poetry prompts.\n \n​Stretching from afternoon to sunset, this gathering will begin with a reading of Lodestar by artist Lisa Hirmer and conclude with a fireside poetry reading where participants will have the opportunity to share their writing in community with others.\n \n​​No previous poetry or writing experience is required.\n \n​Please bring:\n \n​A pen or pencil\n​A notebook in which to write (a hard cover is helpful)\n​Comfortable walking shoes and weather-appropriate clothing\n​Your curiosity and creativity\n \nPlease visit LAT website for further details","categories":["Arts/Exhibits","Cultural","Environmental"],"presenter":null,"image":"-ckcfikSwtJFRX-Iqre_zg","website":"https://lassondearttrail.org/events/lodestar-poetry-gathering-with-laboni-islam/","tickets":"https://luma.com/9ekjp1cn"},{"id":"1c4ba845-d9c5-4b02-b3d6-5b6aa351584a","name":"Places That Stayed: Youth Photography Exhibit","dates":[1792123200000,1792209600000,1792296000000,1792382400000,1792468800000,1792555200000,1792641600000,1792728000000,1792814400000,1792900800000,1792987200000,1793073600000,1793160000000,1793246400000,1793332800000,1793419200000,1793505600000,1793595600000,1793682000000,1793768400000,1793854800000,1793941200000,1794027600000,1794114000000,1794200400000,1794286800000,1794373200000,1794459600000,1794546000000,1794632400000,1794718800000,1794805200000,1794891600000,1794978000000,1795064400000,1795150800000,1795237200000,1795323600000,1795410000000,1795496400000,1795582800000,1795669200000,1795755600000,1795842000000,1795928400000,1796014800000],"start":"2026-10-16T00:00:00-04:00","end":"2026-11-30T00:00:00-05:00","allDay":"Day Event","venue":{"name":"East Scarborough Storefront","address":"4040 Lawrence Ave E, Scarborough, ON, M1E 2R2","lat":43.766003524,"lng":-79.199011833},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover Kingston-Galloway-Orton Park (KGO) through the eyes of local youth in this outdoor photography exhibit. Created as part of a youth placemaking and photography project, the exhibit features photographs documenting the places and spaces that make the neighbourhood unique, from familiar gathering spots and busy streets to quiet corners, overlooked landscapes, parks, and community spaces. Installed along the community garden fence at East Scarborough Storefront, the exhibit invites visitors to explore the neighbourhood through the perspectives of local youth and reflect on the places that shape community life.\n\nA City of Toronto Cultural Hotspot SPARK Project.\n","categories":["Arts/Exhibits","Cultural","Family/Children"],"presenter":"itsneerby","image":"6qUPh0-04BnPvAhTFhcOaA","website":"https://www.itsneerby.ca/","tickets":null},{"id":"206b8231-b174-496f-a852-f951e5e7e3ab","name":"Places That Stayed: Youth Photography Exhibit","dates":[1792123200000,1792209600000,1792296000000,1792382400000,1792468800000,1792555200000,1792641600000,1792728000000,1792814400000,1792900800000,1792987200000,1793073600000,1793160000000,1793246400000,1793332800000,1793419200000,1793505600000,1793595600000,1793682000000,1793768400000,1793854800000,1793941200000,1794027600000,1794114000000,1794200400000,1794286800000,1794373200000,1794459600000,1794546000000,1794632400000,1794718800000,1794805200000,1794891600000,1794978000000,1795064400000,1795150800000,1795237200000,1795323600000,1795410000000,179549640000