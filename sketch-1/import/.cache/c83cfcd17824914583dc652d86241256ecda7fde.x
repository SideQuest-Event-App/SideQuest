797094800000,1797440400000,1797526800000,1797613200000,1797699600000,1798045200000,1798131600000,1798218000000,1798304400000,1798650000000,1798736400000,1798822800000,1798909200000,1799254800000,1799341200000,1799427600000,1799514000000,1799859600000,1799946000000,1800032400000,1800118800000,1800464400000,1800550800000,1800637200000,1800723600000,1801069200000,1801155600000,1801242000000,1801328400000],"start":"2026-09-09T17:00:00-04:00","end":"2027-01-30T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Onsite Gallery","address":"199 Richmond St W, Toronto, ON, M5V 0H4","lat":43.649477,"lng":-79.388341},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Please join us at the 'Returning to Ourselves - Rebecca Baird and Kenny Alvin Baird: A Retrospective of Art and Design by Cree Métis Siblings'. Curated by Lisa Deanne Smith.\n\nThis exhibit presents over 40 years of transformative work by Rebecca Baird and Kenny Alvin Baird. The exhibition spans sculpture, painting and traditional material practices, alongside interior design and more.\n\n'Michael Massie: now and then' brings together works from across his career, including a large collection of teapots, previously unexhibited pieces and a new body of large-scale sculptural installations, to celebrate the enduring importance of joy, experimentation and humour in his work. Guest-curated by Alysa Procida and enjoy our Special Projects Gallery.","categories":["Arts/Exhibits","Artisan","Cultural"],"presenter":null,"image":null,"website":"https://www.ocadu.ca/events-and-exhibitions/michael-massie-now-and-then","tickets":"https://www.eventbrite.ca/e/opening-reception-returning-to-ourselves-michael-massie-now-and-then-tickets-1997059101532?aff=ebdsoporgprofile"},{"id":"74f7d195-48c7-4820-a917-161b6d6a0e21","name":"Exhibition: \"Returning to Ourselves and Michael Massie: now and then\"","dates":[1788987600000,1789056000000,1789142400000,1789228800000,1789574400000,1789660800000,1789747200000,