0000,1791979200000,1792065600000,1792152000000,1792245600000,1792411200000,1792497600000,1792584000000,1792670400000,1792756800000,1792850400000,1793016000000,1793102400000,1793188800000,1793275200000,1793361600000,1793455200000,1793624400000,1793710800000,1793797200000,1793883600000,1793970000000,1794063600000,1794229200000,1794315600000,1794402000000,1794488400000,1794574800000,1794668400000,1794834000000,1794920400000,1795006800000,1795093200000,1795179600000,1795273200000,1795438800000,1795525200000,1795611600000,1795698000000,1795784400000,1795878000000,1796043600000,1796130000000,1796216400000,1796302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000],"start":"2026-09-01T08:00:00-04:00","end":"2026-12-15T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Etobicoke Civic Centre Art Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover the history of art at the Etobicoke Civic Centre with artifacts, prints, images and paintings from City of Toronto’s Fine Art, Artifact and Archival collections. Celebrate the present by witnessing a commissioned piece by early career artist Lise Round. Envision the future with new designs of the updated Etobicoke Civic Centre Art Gallery.","categories":["Arts/Exhibits"],"presenter":null,"image":"A6-VIKDNvgJfy1_SuU-UqA","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/?WT.rd_id=%2Feccartgallery","tickets":null},{"id":"ba4627dd-8013-4827-9db3-ca1b49952d86","name":"Lassonde Art Trail: Art + Nature Tour","dates":[1789228800000,1789833600000,1790438400000,1791043200000,1791648000000,1792252800000,1792857600000,1793462400000,1794070800000,1794675600000],"start":"2026-09-12T12:00:00-04:00","end":"2026-11-14T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Biidaasige Park ","address":"51 Commissioners St, Toronto, ON, M5A 1A6","lat":43.646495807,"lng":-79.348925214},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join LAT every Saturday at 12 pm or 2 pm for a drop-in Art + Nature tour led by a LAT Art Guide. These walking tours invite participants to explore the artworks along the Lassonde Art Trail while discovering the rich history, ecology, and ongoing transformation of Biidaasige Park.\n\n12 pm - Art + Nature Tour (30 minutes, slow paced)\n2 pm - Art + Nature Tour (1 hour)\nMeet in front of Old Fire Hall 30. All tours are drop-in and free to attend. Please be aware that the trees in the park system are not yet mature, so there is little shade. We recommend dressing according to the weather. Tours are subject to cancellation in the event of adverse weather. Please see Lassonde Art Trail website for further details.","categories":["Arts/Exhibits","Environmental","Tour"],"presenter":null,"image":"Xy_GPUCC1IStLKdFhFwxCg","website":"https://lassondearttrail.org/art-trail/","tickets":null},{"id":"a999fae4-dccd-4013-bfe9-9ab7271f340e","name":"Lassonde Art Trail: Art + Nature Tour","dates":[1789228800000,1789833600000,1790438400000,1791043200000,1791648000000,1792252800000,1792857600000,1793462400000,1794070800000,1794675600000],"start":"2026-09-12T12:00:00-04:00","end":"2026-11-14T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Biidaasige Park ","address":"51 Commissioners St, Toronto, ON, M5A 1A6","lat":43.646495807,"lng":-79.348925214},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join LAT every Saturday at 12 pm or 2 pm for a drop-in Art + Nature tour led by a LAT Art Guide. These walking tours invite participants to explore the artworks along the Lassonde Art Trail while discovering the rich history, ecology, and ongoing transformation of Biidaasige Park.\n\n12 pm - Art + Nature Tour (30 minutes, slow paced)\n2 pm - Art + Nature Tour (1 hour)\nMeet in front of Old Fire Hall 30. All tours are drop-in and free to attend. Please be aware that the trees in the park system are not yet mature, so there is little shade. We recommend dressing according to the weather. Tours are subject to cancellation in the event of adverse weather. Please see Lassonde Art Trail website for further details.","categories":["Arts/Exhibits","Environmental","Tour"],"presenter":null,"image":"Xy_GPUCC1IStLKdFhFwxCg","website":"https://lassondearttrail.org/art-trail/","tickets":null},{"id":"e4a872d5-af25-46a6-b16f-830951e2c140","name":"Youth Voices Creative Workshop Series","dates":[1790200800000,1790805600000,1791410400000,1792015200000,1792620000000],"start":"2026-09-23T18:00:00-04:00","end":"2026-10-21T18:00:00-04:00","allDay":"Night Event","venue":{"name":"East Scarborough Storefront","address":"4040 Lawrence Ave E, Scarborough, ON, M1E 2R2","lat":43.766004,"lng":-79.199012},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join a free arts-based program where youth can explore different forms of creative expression while developing original work for a community showcase. Through weekly workshops, participants will experiment with a range of artistic disciplines, build creative skills, and collaborate with peers and facilitators in a supportive environment. Through the program, youth will explore and express their experiences, identities, and perspectives through the arts. The program culminates in the Youth Voices Community Showcase, held on October 22 at Tropicana Community Services 1385 Huntingwood Dr., Scarborough, ON, M1S 3J1, where participants will share their work and celebrate the creativity of local youth.\n\nA City of Toronto Cultural Hotspot Signature Project.","categories":["Arts/Exhibits","Seminars/Workshops","Other"],"presenter":"East Scarborough Storefront","image":"P5CxD-jd5C-8DdRxgpxBRA","website":null,"tickets":null},{"id":"85d0d15f-f258-4887-8ced-25b9f609d545","name":"Raised by Women","dates":[1806190200000,1806256800000,1806449400000,1806535800000,1806622200000,1806708600000,1806775200000,1806795000000,1806861600000,1807054200000,1807117200000,1807140600000,1807227000000,1807313400000,1807380000000,1807399800000,1807466400000],"start":"2027-03-27T19:30:00-04:00","end":"2027-04-11T14:00:00-04:00","allDay":"Night Event","venue":{"name":"Berkeley Street Theatre","address":"26 Berkeley St, Toronto, ON, M5A 2W3","lat":43.650577241,"lng":-79.36426063},"free":false,"low":35,"high":120,"pwyc":null,"costNotes":null,"description":"Join Métis playwright and performer Keith Barker in an intimate, stand-up-inspired solo show that’s as funny as it is searching. With sharp wit and big heart, Keith traces his upbringing by formidable women in Northern Ontario and the complicated legacy of a father who was largely absent but never insignificant.\n\nMoving seamlessly between laughter and reflection, this deeply personal performance finds grace in the mess, proving the funniest stories are often the most true.","categories":["Comedy","Theatre"],"presenter":"Canadian Stage ","image":"PpRZw7S1GaDYkY1vKfSEQg","website":"https://www.canadianstage.com/shows-events/season/raised-by-women","tickets":"https://my.canadianstage.com/overview/9700"},{"id":"5b6ab604-09e5-492d-83f5-494895f93b17","name":"Piece by Piece: Mosaics for Seniors at East Scarborough Storefront","dates":[1789578000000,1789750800000,1790182800000,1790355600000,1790787600000,1790960400000,1791392400000,1791565200000,1791997200000,1792170000000],"start":"2026-09-16T13:00:00-04:00","end":"2026-10-16T13:00:00-04:00","allDay":"Day Event","venue":{"name":"East Scarborough Storefront","address":"4040 Lawrence Ave E, Scarborough, ON, M1E 2R2","lat":43.766003524,"lng":-79.199011833},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join Mural Routes for a free multi-session mosaic art workshop series for older adults. Led by mosaic mural artist Cristina Delago, participants will learn mosaic-making techniques, create a personalized artwork to take home, and contribute to a larger community mosaic installation. A final culminating event held on October 23 will take place after workshops are complete to celebrate all participants and what they have accomplished.\n\nThe project is delivered through two separate cohorts running concurrently at different locations. Please ensure you select your intended workshop series (cohort), as each cohort has its own location and schedule. All materials are provided and advance registration is required.\n\nA City of Toronto Cultural Hotspot Signature Project","categories":["Arts/Exhibits","Seminars/Workshops"],"presenter":"Mural Routes","image":"F4gQpCvBNPCjggJ5mJPA0g","website":"https://muralroutes.ca/mosaics-for-seniors-2026-storefront/","tickets":"https://muralroutes.ca/mosaics-for-seniors-2026-storefront/"},{"id":"53337ae8-082d-4de9-8c6c-7c0701de44cb","name":"The Great Nuit Debate: Public Art vs. Public Opinion","dates":[1791500400000],"start":"2026-10-08T19:00:00-04:00","end":"2026-10-08T19:00:00-04:00","allDay":"Night Event","venue":{"name":"Old City Hall","address":"60 Queen St W, Toronto, ON, M5H 2M3","lat":43.652350814,"lng":-79.381863479},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Nuit Blanche was only meant to be one year. Now long-running and going into its 20th anniversary, it has become a major annual art staple in the city, attracting visitors, championing local artists, pushing limits of ideas of public art and celebrating contemporary art. However, critics argue that there is not enough art, line ups are too long, it is overcrowded, that the event's artistic edge has been diluted by red tape.\n\nJoin us for a fun, satirical yet critical debate and hear from voices who have shaped or have been impacted by Nuit Blanche Toronto.  Hosted by Steve Patterson, featuring local artists and curators-turned-debaters.\n\nWhile there, visitors can also view the Nuit Blanche 2026 extended project at Old City Hall, including: \"The Museum of Lost Things\" by Rhonda Weppler & Trevor Mahovsky, \"Ephemera: The Art We Didn't Make\" by Blessyl Buan, \"Simile Aria\" by Maggy Hamel-Metsos, \"At the edge of remembering\" by Par Nair and more. \n","categories":["Arts/Exhibits","Talks"],"presenter":null,"image":"E960THLKkJ6I1cM0u1F0rQ","website":"https://www.toronto.ca/explore-enjoy/festivals-events/nuitblanche/","tickets":null},{"id":"d0f34b24-3f51-4fdb-ad25-7029176f416f","name":"Youth Voices Creative Workshop Series","dates":[1790200800000,1790805600000,1791410400000,1792015200000,1792620000000],"start":"2026-09-23T18:00:00-04:00","end":"2026-10-21T18:00:00-04:00","allDay":"Night Event","venue":{"name":"East Scarborough Storefront","address":"4040 Lawrence Ave E, Scarborough, ON, M1E 2R2","lat":43.766004,"lng":-79.199012},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join a free arts-based program where youth can explore different forms of creative expression while developing original work for a community showcase. Through weekly workshops, participants will experiment with a range of artistic disciplines, build creative skills, and collaborate with peers and facilitators in a supportive environment. Through the program, youth will explore and express their experiences, identities, and perspectives through the arts. The program culminates in the Youth Voices Community Showcase, held on October 22 at Tropicana Community Services 1385 Huntingwood Dr., Scarborough, ON, M1S 3J1, where participants will share their work and celebrate the creativity of local youth.\n\nA City of Toronto Cultural Hotspot Signature Project.","categories":["Arts/Exhibits","Seminars/Workshops","Other"],"presenter":"East Scarborough Storefront","image":"P5CxD-jd5C-8DdRxgpxBRA","website":null,"tickets":null},{"id":"0d571e6a-5ac1-4026-8e10-a96543f4233c","name":"Riverside Holiday Market","dates":[1795968000000],"start":"2026-11-29T11:00:00-05:00","end":"2026-11-29T11:00:00-05:00","allDay":"Day Event","venue":{"name":"Ralph Thornton Community Centre","address":"765 Queen St E, Toronto, ON, M4M 1H3","lat":43.659191904,"lng":-79.347569552},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Bring holiday cheer and enjoy holiday activities including a Meet and Greet with Santa, live music, hot chocolate, arts and crafts and lots of local shopping.\n\nVisit website for more event perks and promos.","categories":["Family/Children","Winter Holidays"],"presenter":"Riverside BIA","image":"f2WjiWcjbDb7RXFIpjXd9A","website":"https://riverside-to.com/riverside-holiday-market/","tickets":"https://riverside-to.com/riverside-holiday-market/"},{"id":"401e280c-03bb-4130-a6f9-903bfaba1446","name":"Curator’s Talk: Time, Labour and the Value of Beads","dates":[1796083200000],"start":"2026-11-30T19:00:00-05:00","end":"2026-11-30T19:00:00-05:00","allDay":"Night Event","venue":{"name":"Bata Shoe Museum","address":"327 Bloor St W, Toronto, ON, M5S 1W7","lat":43.667232212,"lng":-79.400148381},"free":false,"low":25,"high":null,"pwyc":null,"costNotes":null,"description":"Beads may be small and intricate, but their histories reveal powerful stories of identity, value, and status. \n\nIn celebration of Brilliant: The Art of Beaded Footwear Around the World, join Director and Senior Curator Elizabeth Semmelhack for an informative and illuminating exploration of beadwork traditions from around the world and their role as markers of wealth, prestige, and cultural meaning.\n\nFrom royal adornment and ceremonial regalia to trade and personal expression, this lecture traces how beads have signaled belonging across time and place. At its core is the labour behind the work: the skilled craftsmanship, generational knowledge, and cultural practices embedded in every stitch. \n\nBy centering time and labour, the talk challenges conventional ideas of value and asks what makes something “luxurious,” and who defines luxury.","categories":["Arts/Exhibits","Museum","Talks"],"presenter":null,"image":"utIZolbikfzCpjgIIE5TYA","website":"https://batashoemuseum.ca/event/curators-talk-beads/","tickets":"https://batashoemuseum.ca/event/curators-talk-beads/"},{"id":"b04723e4-4657-4f08-9682-21cf53f4bbb6","name":"Bertrand Chamayou, Piano","dates":[1801422000000,1801425600000],"start":"2027-01-31T14:00:00-05:00","end":"2027-01-31T15:00:00-05:00","allDay":"Day Event","venue":{"name":"Koerner Hall","address":"273 Bloor St W, Toronto, ON, M5S 1W2","lat":43.667856304,"lng":-79.396058814},"free":false,"low":50,"high":110,"pwyc":null,"costNotes":null,"description":"Please join us for an unforgettable evening with Bertrand Chamayou, one of today’s most strikingly brilliant pianists, as he performs a program celebrating the Romantic and French repertoires!\n\nChamayou has been recognised for his revelatory performances, at once powerfully virtuosic, imaginative and breathtakingly beautiful. A leading interpreter of French music, his vast repertoire includes major bodies of work such as the complete piano works of Ravel, Liszt’s Etudes and Années de Pèlerinage, and Messiaen's Vingt regards sur l'Enfant Jésus. He performs regularly with fellow musicians including cellist Sol Gabetta and is creating a Messiaen project with soprano-conductor Barbara Hannigan, with whom he performed in Koerner Hall in 2024. \n\nThis concert is preceded by a short performance by talented students of The Royal Conservatory. ","categories":["Live Performances","Music"],"presenter":null,"image":"H8mRp1LEsdKmUcCdCRHHPw","website":"https://www.rcmusic.com/concert/bertrand-chamayou-piano-429601","tickets":"https://www.rcmusic.com/tickets/seats/429601"},{"id":"98a84cbb-a85e-492d-b75c-c2f4cb5e8494","name":"In Broken Light Exhibition at Spadina Museum","dates":[1787756400000,1787842800000,1787929200000,1788015600000,1788102000000,1788361200000,1788447600000,1788534000000,1788620400000,1788706800000,1788966000000,1789052400000,1789138800000,1789225200000,1789311600000,1789570800000,1789657200000,1789743600000,1789830000000,1789916400000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000,1791385200000,1791471600000,1791558000000,1791644400000,1791730800000,1791990000000,1792076400000,1792162800000,1792249200000,1792335600000],"start":"2026-08-26T11:00:00-04:00","end":"2026-10-18T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Spadina Museum","address":"285 Spadina Rd, Toronto, ON, M5R 2V5","lat":43.679046946,"lng":-79.408181452},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":"Visit the reception desk to register. Tickets are first-come first-serve and subject to capacity.","description":"See a contemporary art exhibition of five sculptural interventions located throughout the historic Spadina Museum, created by artist Ry Van Der Hout and curated by Adrien Sun Hall. Working with photography, stained glass, mirrors, and acts of rupture and repair, Van Der Hout reveals the emotional residue held within objects, architecture and stories. Cracks and fractures become apertures through which forgotten stories emerge, the artworks functioning as contemporary reliquaries for lives remembered and overlooked.\n\nMoving between deep histories, the present day and an imagined future, this exhibition traces connections across time, where fragments persist, reflections multiply, and the boundaries between past, present and future remain open.","categories":["Arts/Exhibits","History","Museum"],"presenter":null,"image":"caTKB0eJSOICT9G9ZdiXWw","website":"https://toronto.ca/spadina","tickets":null},{"id":"a3ca0e9a-733e-48b1-828f-60c4d33169ba","name":"A Translucent City: Collective Memories of the Future","dates":[1788789600000,1788876000000,1788962400000,1789048800000,1789135200000,1789221600000,1789394400000,1789480800000,1789567200000,1789653600000,1789740000000,1789826400000,1789999200000,1790085600000,1790172000000,1790258400000,1790344800000,1790431200000,1790604000000,1790690400000,1790776800000,1790863200000,1790949600000,1791036000000,1791208800000,1791295200000,1791381600000,1791468000000,1791554400000,1791640800000,1791813600000,1791900000000,1791986400000,1792072800000,1792159200000,1792245600000,1792418400000,1792504800000,1792591200000,1792677600000,1792764000000,1792850400000,1793023200000,1793109600000,1793196000000,1793282400000,1793368800000,1793455200000,1793631600000,1793718000000,1793804400000,1793890800000,1793977200000,1794063600000,1794236400000,1794322800000,1794409200000,1794495600000,1794582000000,1794668400000,1794841200000,1794927600000,1795014000000,1795100400000,1795186800000,1795273200000,1795446000000,1795532400000,1795618800000,1795705200000,1795791600000,1795878000000,1796050800000,1796137200000,1796223600000,1796310000000,1796396400000,1796482800000,1796655600000,1796742000000,1796828400000,1796914800000,1797001200000,1797087600000,1797260400000,1797346800000,1797433200000,1797519600000,1797606000000,1797692400000,1797865200000,1797951600000,1798038000000,1798124400000,1798210800000,1798297200000,1798470000000,1798556400000,1798642800000,1798729200000],"start":"2026-09-07T10:00:00-04:00","end":"2026-12-31T10:00:00-05:00","allDay":"Day Event","venue":{"name":"Urbanspace Gallery","address":"401 Richmond St W, Toronto, ON, M5V 3A8","lat":43.647755,"lng":-79.394748},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"What do cities remember? How do our stories, relationships and experiences shape the places we call home?\n\nDrawing on community conversations, storytelling, a Sharing Circle and arts-based research, this evolving exhibition, featuring illuminated textile maps, documentary film and opportunities for public participation, explores how people connect to place and imagine urban futures. \n\nVisitors are invited to return throughout the exhibition, contribute to a growing textile installation and experience how the work changes over time.\n","categories":["Arts/Exhibits","Cultural","Film"],"presenter":null,"image":"NgegXWP7YyX5G3PIBLwp2g","website":"https://www.urbanspacegallery.ca/event/a-translucent-city-collective-memories-of-the-future/","tickets":null},{"id":"e6d70fb3-24dc-41e2-a66b-d95a647cae33","name":"Duende International Flamenco Festival: Flamenco and the World","dates":[1795042800000,1795136400000,1795222800000,1795309200000,1795395600000],"start":"2026-11-18T18:00:00-05:00","end":"2026-11-22T20:00:00-05:00","allDay":"Night Event","venue":{"name":"Aga Khan Museum","address":"77 Wynford Dr, North York, ON M3C 1K1","lat":43.725278,"lng":-79.332045},"free":false,"low":45,"high":150,"pwyc":null,"costNotes":null,"description":"Celebrate flamenco’s global transformation!\n\nExperience the vibrant evolution of flamenco, from its regional roots in Andalusia to a dynamic global art form shaped by cross-cultural exchange. \n\nThis year’s lineup spans both traditional flamenco from Andalusia and innovative collaborations at the crossroads of qawwali and Persian muqam, tracing the art form’s evolution from its regional roots to a global practice.","categories":["Dance","Live Performances","Museum"],"presenter":"Aga Khan Museum","image":"qp_RMmWPShlY0lOpIswCKQ","website":"https://agakhanmuseum.org/whats-on/duende-2026/?utm_source=city+of+toronto&utm_medium=event+listing&utm_campaign=duende+26","tickets":"https://agakhanmuseum.org/whats-on/duende-2026/?utm_source=city+of+toronto&utm_medium=event+listing&utm_campaign=duende+26"},{"id":"413bd678-ef50-48d0-8789-9543300ab318","name":"Curator’s Talk: André Perugia","dates":[1797375600000],"start":"2026-12-15T18:00:00-05:00","end":"2026-12-15T18:00:00-05:00","allDay":"Night Event","venue":{"name":"Bata Shoe Museum","address":"327 Bloor St W, Toronto, ON, M5S 1W7","lat":43.667232212,"lng":-79.400148381},"free":false,"low":25,"high":null,"pwyc":null,"costNotes":null,"description":"Step behind the scenes of the new exhibit André Perugia: A Design Legend Unveiled for a curator talk with Nishi Bassi.\n\nNishi will speak on all parts of the exhibit, from sourcing rare loans to the curatorial decisions that shaped the many intricate design and storytelling elements. \n\nDiscover how Perugia’s innovative designs revolutionized footwear through bold experimentation, architectural form and technical mastery, and how, nearly a century later, Perugia’s designs continue to influence fashion’s most daring creators.","categories":["Arts/Exhibits","Museum","Talks"],"presenter":null,"image":"_hQ4Ck9HQscJpkxx0EAqKg","website":"https://batashoemuseum.ca/event/curators-talk-andre-perugia/","tickets":"https://batashoemuseum.ca/event/curators-talk-andre-perugia/"},{"id":"9e6618c1-17fa-44cb-b85d-b83918b140dc","name":"Rebirth: The Quiet Becoming Installation at Fort York","dates":[1785938400000,1786024800000,1786111200000,1786197600000,1786284000000,1786543200000,1786629600000,1786716000000,1786802400000,1786888800000,1787148000000,1787234400000,1787320800000,1787407200000,1787493600000,1787752800000,1787839200000,1787925600000,1788012000000,1788098400000,1788357600000,1788444000000,1788530400000,1788616800000,1788703200000,1788962400000,1789048800000,1789135200000,1789221600000,1789308000000,1789567200000,1789653600000,1789740000000,1789826400000,1789912800000,1790172000000,1790258400000,1790344800000,1790431200000,1790517600000,1790776800000,1790863200000,1790949600000,1791036000000,1791122400000,1791381600000,1791468000000,1791554400000,1791640800000,1791727200000,1791986400000,1792072800000,1792159200000,1792245600000,1792332000000,1792591200000,1792677600000,1792764000000,1792850400000,1792936800000,1793196000000,1793282400000,1793368800000,1793455200000],"start":"2026-08-05T10:00:00-04:00","end":"2026-10-31T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864096,"lng":-79.406314887},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Experience a bold new outdoor installation on the Gardiner Expressway beside Fort York Visitor Centre. Created by artists Delali Cofie and Yuma Dean Hester, it reimagines the site’s layered histories through contemporary art. An accompanying exhibition inside the Visitor Centre deepens the experience, inviting visitors to encounter the Fort as a living cultural landscape shaped by reflection, dialogue and collaboration.","categories":["Arts/Exhibits","History","Museum"],"presenter":null,"image":"_QHlUAQMVyNc88AaSDfQ8A","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":null},{"id":"f1b5a6e2-82fc-4b84-a67f-94c3cd9e883d","name":"A Translucent City: Collective Memories of the Future","dates":[1788789600000,1788876000000,1788962400000,1789048800000,1789135200000,1789221600000,1789394400000,1789480800000,1789567200000,1789653600000,1789740000000,1789826400000,1789999200000,1790085600000,1790172000000,1790258400000,1790344800000,1790431200000,1790604000000,1790690400000,1790776800000,1790863200000,1790949600000,1791036000000,1791208800000,1791295200000,1791381600000,1791468000000,1791554400000,1791640800000,1791813600000,1791900000000,1791986400000,1792072800000,1792159200000,1792245600000,1792418400000,1792504800000,1792591200000,1792677600000,1792764000000,1792850400000,1793023200000,1793109600000,1793196000000,1793282400000,1793368800000,1793455200000,1793631600000,1793718000000,1793804400000,1793890800000,1793977200000,1794063600000,1794236400000,1794322800000,1794409200000,1794495600000,1794582000000,1794668400000,1794841200000,1794927600000,1795014000000,1795100400000,1795186800000,1795273200000,1795446000000,1795532400000,1795618800000,1795705200000,1795791600000,1795878000000,1796050800000,1796137200000,1796223600000,1796310000000,1796396400000,1796482800000,1796655600000,1796742000000,1796828400000,1796914800000,1797001200000,1797087600000,1797260400000,1797346800000,1797433200000,1797519600000,1797606000000,1797692400000,1797865200000,1797951600000,1798038000000,1798124400000,1798210800000,1798297200000,1798470000000,1798556400000,1798642800000,1798729200000],"start":"2026-09-07T10:00:00-04:00","end":"2026-12-31T10:00:00-05:00","allDay":"Day Event","venue":{"name":"Urbanspace Gallery","address":"401 Richmond St W, Toronto, ON, M5V 3A8","lat":43.647755,"lng":-79.394748},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"What do cities remember? How do our stories, relationships and experiences shape the places we call home?\n\nDrawing on community conversations, storytelling, a Sharing Circle and arts-based research, this evolving exhibition, featuring illuminated textile maps, documentary film and opportunities for public participation, explores how people connect to place and imagine urban futures. \n\nVisitors are invited to return throughout the exhibition, contribute to a growing textile installation and experience how the work changes over time.\n","categories":["Arts/Exhibits","Cultural","Film"],"presenter":null,"image":"NgegXWP7YyX5G3PIBLwp2g","website":"https://www.urbanspacegallery.ca/event/a-translucent-city-collective-memories-of-the-future/","tickets":null},{"id":"2a7acdbb-09e9-4896-a380-ecea8794d5f7","name":"A Translucent City: Collective Memories of the Future","dates":[1788789600000,1788876000000,1788962400000,1789048800000,1789135200000,1789221600000,1789394400000,1789480800000,1789567200000,1789653600000,1789740000000,1789826400000,1789999200000,1790085600000,1790172000000,1790258400000,1790344800000,1790431200000,1790604000000,1790690400000,1790776800000,1790863200000,1790949600000,1791036000000,1791208800000,1791295200000,1791381600000,1791468000000,1791554400000,1791640800000,1791813600000,1791900000000,1791986400000,1792072800000,1792159200000,1792245600000,1792418400000,1792504800000,1792591200000,1792677600