000,1794063600000,1794236400000,1794322800000,1794409200000,1794495600000,1794582000000,1794668400000,1794841200000,1794927600000,1795014000000,1795100400000,1795186800000,1795273200000,1795446000000,1795532400000,1795618800000,1795705200000,1795791600000,1795878000000,1796050800000,1796137200000,1796223600000,1796310000000,1796396400000,1796482800000,1796655600000,1796742000000,1796828400000,1796914800000,1797001200000,1797087600000,1797260400000,1797346800000,1797433200000,1797519600000,1797606000000,1797692400000,1797865200000,1797951600000,1798038000000,1798124400000,1798210800000,1798297200000,1798470000000,1798556400000,1798642800000,1798729200000],"start":"2026-09-07T10:00:00-04:00","end":"2026-12-31T10:00:00-05:00","allDay":"Day Event","venue":{"name":"Urbanspace Gallery","address":"401 Richmond St W, Toronto, ON, M5V 3A8","lat":43.647755,"lng":-79.394748},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"What do cities remember? How do our stories, relationships and experiences shape the places we call home?\n\nDrawing on community conversations, storytelling, a Sharing Circle and arts-based research, this evolving exhibition, featuring illuminated textile maps, documentary film and opportunities for public participation, explores how people connect to place and imagine urban futures. \n\nVisitors are invited to return throughout the exhibition, contribute to a growing textile installation and experience how the work changes over time.\n","categories":["Arts/Exhibits","Cultural","Film"],"presenter":null,"image":"NgegXWP7YyX5G3PIBLwp2g","website":"https://www.urbanspacegallery.ca/event/a-translucent-city-collective-memories-of-the-future/","tickets":null},{"id":"7ebde1ea-74fa-4ca1-bb5a-cb84631e87b3","name":"Molly Steels: I Am/Was/Always","dates":[1793199600000,1793289600000,1793376000000,1793462400000,1793811600000,1793898000000,1793984400000,1794070800000,1794416400000,1794502800000,1794589200000,1794675600000,1795021200000,1795107600000,1795194000000,1795280400000,1795626000000,1795712400000,1795798800000,1795885200000,1796230800000,1796317200000,1796403600000,1796490000000],"start":"2026-10-28T11:00:00-04:00","end":"2026-12-05T12:00:00-05:00","allDay":"Day Event","venue":{"name":"The Image Centre","address":"33 Gould St, Toronto, ON, M5B 1E9","lat":43.657662387,"lng":-79.379262289},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"The philosopher Diana Prokofyeva considers a photograph to be a phenomenon that exists as a way to avoid death by copying a moment and suspending it within time - a way to be between two worlds:, the living and the dead. She suggests that a photograph gives confidence of existence, a way to state, “Here I am and was, and always shall have been.”.\n\nView this evolving series that looks to photography as a method of conceptualizing grief and mortality. Using family archives from the past century and conceptual imagery, I locate myself within a chain of human experience. I look to the women who came before me, observing the proof of their existence with reverence and the knowledge that I will one day add to this catalogue. Through this series I aim to overshadow existential fear with curiosity.\n\nEphemeral aspects of nature are woven into this work as both an unrelenting force and a source of comfort. ","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"oUxX7buKjY1V2s_fjb6MLg","website":"https://theimagecentre.ca/exhibition/molly-steels-iamwasalways/","tickets":null},{"id":"9ae06738-10f5-40a3-8c82-58b51c96812e","name":"Bouchara: The Light of Other Worlds","dates":[1800756000000],"start":"2027-01-23T21:00:00-05:00","end":"2027-01-23T21:00:00-05:00","allDay":"Night Event","venue":{"name":"Temerty Theatre","address":"273 Bloor St W, Toronto, ON M5S 1W2","lat":43.667924,"lng":-79.396281},"free":false,"low":21,"high":null,"pwyc":null,"costNotes":null,"description":"Brian Current leads Glenn Gould School students in bold contemporary music that opens imagined worlds. Enjoy pieces from Claude Vivier’s Bouchara to works by Hannah Kendall and Francis Battah.\n\nBouchara, Vivier’s luminous work for soprano and ensemble, is widely recognized as one of his most beautiful and singular creations. Sung in an invented, intimate language, it opens a sound world that feels both ancient and deeply personal.\n\nAlongside it, shouting forever into the receiver by Hannah Kendall, one of today’s most compelling international voices, and Francis Battah’s Musique d’un monde sans carte, extend this sense of hidden worlds: places we cannot quite name, where sound becomes a space of memory, imagination and discovery.\n","categories":["Live Performances","Music"],"presenter":null,"image":"PVo90lg9GgsYWvL9ohDh6w","website":"https://www.rcmusic.com/concert/ggs-new-music-ensemble-bouchara-the-light-of-other-worlds-453601","tickets":"https://www.rcmusic.com/tickets/seats/453601"},{"id":"21af1234-d172-4b9d-8aaf-92c65e0db451","name":"To a Flame","dates":[1790119800000,1790206200000,1790292600000,1790379000000,1790445600000,1790465400000,1790532000000,1790724600000,1790811000000,1790897400000,1790983800000,1791050400000,1791070200000,1791136800000],"start":"2026-09-22T19:30:00-04:00","end":"2026-10-04T14:00:00-04:00","allDay":"Night Event","venue":{"name":"Nancy and Ed Jackman Performance Centre","address":"877 Yonge St, Toronto, ON, M4W 3M2","lat":43.674248952,"lng":-79.387972597},"free":false,"low":15,"high":65,"pwyc":null,"costNotes":null,"description":"Be entranced by an explosive theatrical feast of image and language that pulls the audience deep into a Victorian Gothic Horror. \n\nThree confined women await the conclusion of their stories in the ancestral home of the man they call Father. Secrets burn to be revealed, aches of the past refuse to be suppressed, and the very house itself vibrates with desire for revenge. \n\nThis groundbreaking new work by Governor General Award-winning playwright Erin Shields and directed by Josette Bushell-Mingo intertwines American Sign Language and English with vibrant movement and live music into a haunting, multi-sensory performance that brings Deaf and hearing audiences into a shared theatrical experience through its bilingual artistic design. The ensemble cast features Deaf performer and cultural leader Dawn Jani Birley, with Nickeshia Garrick and Juliana Monk, accompanied by cellist Beth Silver. ","categories":["Theatre"],"presenter":null,"image":"yZg0SMTeDvFbyWzuteU1Lg","website":"https://www.nightwoodtheatre.net/to-a-flame/","tickets":"https://tapestryopera.my.salesforce-sites.com/ticket/#/events/a0SOF000002l5vx2AA"},{"id":"1d9c2853-49b1-4cdc-aa2c-75c36c3cfdfa","name":"SHADE by Jordan Shaw at Budapest Park","dates":[1787716800000,1787803200000,1787889600000,1787976000000,1788062400000,1788148800000,1788235200000,1788321600000,1788408000000,1788494400000,1788580800000,1788667200000,1788753600000,1788840000000,1788926400000,1789012800000,1789099200000,1789185600000,1789272000000,1789358400000,1789444800000,1789531200000,1789617600000,1789704000000,1789790400000,1789876800000,1789963200000,1790049600000,1790136000000,1790222400000,1790308800000,1790395200000,1790481600000,1790568000000,1790654400000,1790740800000,1790827200000,1790913600000,1791000000000,1791086400000,1791172800000,1791259200000,1791345600000,1791432000000,1791518400000,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000],"start":"2026-08-26T00:00:00-04:00","end":"2026-10-15T00:00:00-04:00","allDay":"Day Event","venue":{"name":"Budapest Park","address":"1575 Lake Shore Blvd W, Toronto, ON, M6R 1B5","lat":43.636828816,"lng":-79.446436254},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"At first, Shade appears as a series of aluminum lattice structures: geometric, quiet, casting patterns across the grass. Spend a few minutes observing and something shifts — the shadows have moved. As you move around the structures, perspectives change. What becomes clear is that the work has two authors — you and the sun. The sun continues its arc regardless, changing the work's shadows and presence throughout the day. Shade is analog interactivity in its most elemental form — a reminder that we move through a world that is constantly changing, independent of us. We bring our presence, our attention, our memory and the world brings everything else.\n\nJordan Shaw is a Toronto-based artist and creative technologist whose practice explores data as material, he works across sculpture, installation, light and textile. His public artworks have been installed at Ontario Place, the City of Pickering and municipalities across Canada. ","categories":["Arts/Exhibits"],"presenter":null,"image":"B4ojJZhax41imauSMd6vvg","website":null,"tickets":null},{"id":"ca587e45-60b0-4d40-bb50-ab7a06e632a9","name":"SHADE by Jordan Shaw at Budapest Park","dates":[1787716800000,1787803200000,1787889600000,1787976000000,1788062400000,1788148800000,1788235200000,1788321600000,1788408000000,1788494400000,1788580800000,1788667200000,1788753600000,1788840000000,1788926400000,1789012800000,1789099200000,1789185600000,1789272000000,1789358400000,1789444800000,1789531200000,1789617600000,1789704000000,1789790400000,1789876800000,1789963200000,1790049600000,1790136000000,1790222400000,1790308800000,1790395200000,1790481600000,1790568000000,1790654400000,1790740800000,1790827200000,1790913600000,1791000000000,1791086400000,1791172800000,1791259200000,1791345600000,1791432000000,1791518400000,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000],"start":"2026-08-26T00:00:00-04:00","end":"2026-10-15T00:00:00-04:00","allDay":"Day Event","venue":{"name":"Budapest Park","address":"1575 Lake Shore Blvd W, Toronto, ON, M6R 1B5","lat":43.636828816,"lng":-79.446436254},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"At first, Shade appears as a series of aluminum lattice structures: geometric, quiet, casting patterns across the grass. Spend a few minutes observing and something shifts — the shadows have moved. As you move around the structures, perspectives change. What becomes clear is that the work has two authors — you and the sun. The sun continues its arc regardless, changing the work's shadows and presence throughout the day. Shade is analog interactivity in its most elemental form — a reminder that we move through a world that is constantly changing, independent of us. We bring our presence, our attention, our memory and the world brings everything else.\n\nJordan Shaw is a Toronto-based artist and creative technologist whose practice explores data as material, he works across sculpture, installation, light and textile. His public artworks have been installed at Ontario Place, the City of Pickering and municipalities across Canada. ","categories":["Arts/Exhibits"],"presenter":null,"image":"B4ojJZhax41imauSMd6vvg","website":null,"tickets":null},{"id":"8c53b967-dccc-4439-b65d-4342f122c46e","name":"SHADE by Jordan Shaw at Budapest Park","dates":[1787716800000,1787803200000,1787889600000,1787976000000,1788062400000,1788148800000,1788235200000,1788321600000,1788408000000,1788494400000,1788580800000,1788667200000,1788753600000,1788840000000,1788926400000,1789012800000,1789099200000,1789185600000,1789272000000,1789358400000,1789444800000,1789531200000,1789617600000,1789704000000,1789790400000,1789876800000,1789963200000,1790049600000,1790136000000,1790222400000,1790308800000,1790395200000,1790481600000,1790568000000,1790654400000,1790740800000,1790827200000,1790913600000,1791000000000,1791086400000,1791172800000,1791259200000,1791345600000,1791432000000,1791518400000,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000],"start":"2026-08-26T00:00:00-04:00","end":"2026-10-15T00:00:00-04:00","allDay":"Day Event","venue":{"name":"Budapest Park","address":"1575 Lake Shore Blvd W, Toronto, ON, M6R 1B5","lat":43.636828816,"lng":-79.446436254},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"At first, Shade appears as a series of aluminum lattice structures: geometric, quiet, casting patterns across the grass. Spend a few minutes observing and something shifts — the shadows have moved. As you move around the structures, perspectives change. What becomes clear is that the work has two authors — you and the sun. The sun continues its arc regardless, changing the work's shadows and presence throughout the day. Shade is analog interactivity in its most elemental form — a reminder that we move through a world that is constantly changing, independent of us. We bring our presence, our attention, our memory and the world brings everything else.\n\nJordan Shaw is a Toronto-based artist and creative technologist whose practice explores data as material, he works across sculpture, installation, light and textile. His public artworks have been installed at Ontario Place, the City of Pickering and municipalities across Canada. ","categories":["Arts/Exhibits"],"presenter":null,"image":"B4ojJZhax41imauSMd6vvg","website":null,"tickets":null},{"id":"0a1b315f-2313-431a-99ba-b1fd7665ba14","name":"Dancing Blossoms Installation","dates":[1787922000000,1788008400000,1788094800000,1788181200000,1788267600000,1788354000000,1788440400000,1788526800000,1788613200000,1788699600000,1788786000000,1788872400000,1788958800000,1789045200000,1789131600000,1789218000000,1789304400000,1789390800000,1789477200000,1789563600000,1789650000000,1789736400000,1789822800000,1789909200000,1789995600000,1790082000000,1790168400000,1790254800000,1790341200000,1790427600000,1790514000000,1790600400000,1790686800000,1790773200000,1790859600000,1790946000000,1791032400000,1791118800000,1791205200000,1791291600000,1791378000000,1791464400000,1791550800000,1791637200000,1791723600000,1791810000000,1791896400000,1791982800000,1792069200000,1792155600000,1792242000000,1792328400000,1792414800000,1792501200000,1792587600000,1792674000000,1792760400000,1792846800000,1792933200000,1793019600000,1793106000000,1793192400000,1793278800000,1793365200000,1793451600000,1793541600000,1793628000000,1793714400000,1793800800000,1793887200000,1793973600000,1794060000000,1794146400000,1794232800000,1794319200000,1794405600000,1794492000000],"start":"2026-08-28T09:00:00-04:00","end":"2026-11-12T09:00:00-05:00","allDay":"Day Event","venue":{"name":"Clark Centre for the Arts","address":"191 Guildwood Pkwy, Scarborough, ON, M1E 1P5","lat":43.746893127,"lng":-79.193688812},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Delight in Paula Hartmann's Dancing Blossoms, a kinetic installation composed of dozens of delicate paper mobiles suspended in air, evoking the quiet poetry of spring trees swaying in the wind. Crafted from featherlight paper and fine wire, each mobile captures a fleeting moment of bloom, movement, and renewal.\n\nAbout the Artist\nPaula Hartmann is a Canadian visual artist whose joyful, kinetic sculptures transform humble materials into poetic, suspended worlds. Based in Toronto and originally from Germany, she draws on cultural traditions, folk aesthetics, and contemporary design to create works that explore impermanence, transformation, and belonging. Often incorporating paper, wire, and natural elements, her mobiles and installations invite viewers into moments of play, presence, and quiet wonder. Her installations have been featured in major public art events, including Toronto’s Nuit\nBlanche, the Burlington Waterfront Sculpture Trail, and City of Craft Toronto.","categories":["Arts/Exhibits","Cultural"],"presenter":null,"image":"6w2zOg_MReBeep-DtTCBng","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/clark-centre-for-the-arts/","tickets":null},{"id":"4139502d-7b86-46bc-a3a4-c59686f3480d","name":"Jean‑Michel Blais","dates":[1795914000000],"start":"2026-11-28T20:00:00-05:00","end":"2026-11-28T20:00:00-05:00","allDay":"Night Event","venue":{"name":"Koerner Hall","address":"273 Bloor St W, Toronto, ON M5S 1W2","lat":43.667899,"lng":-79.396252},"free":false,"low":45,"high":100,"pwyc":null,"costNotes":null,"description":"Jean-Michel Blais is a Montreal-based pianist, composer, and performer, signed to Arts & Crafts and Mercury KX (Decca). \n\nHis debut album, Il, was named one of Time magazine’s Top 10 Albums of 2016 and his music has since amassed over 580 million streams worldwide. \n\nA member of the LGBTQ+ community and living with Tourette’s syndrome, he also draws on his experiences as a special needs educator to create ecstatic yet intimate compositions, blending virtuosic piano with lush orchestral and electronic textures, infused with improvisation.\n","categories":["Live Performances","Music"],"presenter":null,"image":"ScMSRy4MonkdBTAyNwL2Xw","website":"https://www.rcmusic.com/concert/jean-michel-blais-451801","tickets":"https://www.rcmusic.com/tickets/seats/451801"},{"id":"2c564197-4fbb-4c51-8cd2-ee03400ff3c5","name":"SHADE by Jordan Shaw at Budapest Park","dates":[1787716800000,1787803200000,1787889600000,1787976000000,1788062400000,1788148800000,1788235200000,1788321600000,1788408000000,1788494400000,1788580800000,1788667200000,1788753600000,1788840000000,1788926400000,1789012800000,1789099200000,1789185600000,1789272000000,1789358400000,1789444800000,1789531200000,1789617600000,1789704000000,1789790400000,1789876800000,1789963200000,1790049600000,1790136000000,1790222400000,1790308800000,1790395200000,1790481600000,1790568000000,1790654400000,1790740800000,1790827200000,1790913600000,1791000000000,1791086400000,1791172800000,1791259200000,1791345600000,1791432000000,1791518400000,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000],"start":"2026-08-26T00:00:00-04:00","end":"2026-10-15T00:00:00-04:00","allDay":"Day Event","venue":{"name":"Budapest Park","address":"1575 Lake Shore Bl