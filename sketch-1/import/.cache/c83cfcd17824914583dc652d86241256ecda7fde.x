-04:00","allDay":"Day Event","venue":{"name":"Toronto Botanical Garden","address":"777 Lawrence Ave E, North York, ON, M3C 1P2","lat":43.734346145,"lng":-79.358667018},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrating art, nature and community! \n\nEnjoy over 100 original artworks created outdoors by 46 talented local artists at Toronto Botanical Garden and Edwards Gardens and participate in artist-led workshops and more!\n\nThis curated, site-specific show invites visitors to experience the Garden through the eyes of the artists who paint here, capturing moments of light, movement, and the essence of the natural world.\n\nThis exhibition coincides with Toronto’s Ravine Days, an annual city-wide celebration of Toronto’s ravine system.\n","categories":["Arts/Exhibits","Environmental"],"presenter":null,"image":"dTOLixZ5zgHzXQkFocfpqg","website":"https://torontobotanicalgarden.ca/event/essence-of-the-garden-plein-air-art-exhibition-sale/","tickets":null},{"id":"914d2ea8-34da-4ad3-94e0-75004088a4cb","name":"Piece by Piece: Mosaics for Seniors at Cedar Ridge Creative Centre","dates":[1789565400000,1789738200000,1790170200000,1790343000000,1790775000000,1790947800000,1791379800000,1791552600000,1791984600000,1792157400000],"start":"2026-09-16T09:30:00-04:00","end":"2026-10-16T09:30:00-04:00","allDay":"Day Event","venue":{"name":"Cedar Ridge Creative Centre","address":"225 Confederation Dr, Scarborough, ON, M1G 1B2","lat":43.75743,"lng":-79.207132},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join Mural Routes for a free multi-session mosaic art workshop series for older adults. Led by mosaic mural artist Cristina Delago, participants will learn mosaic-making techniques, create a personalized artwork to take home, and contribute to a larger community mosaic installation. A final culminating event held on October 23 will take place after workshops are complete to celebrate all participants and what they have accomplished.\n\nThe project is delivered through two separate cohorts running concurrently at different locations. Please ensure you select your intended workshop series (cohort), as each cohort has its own location and schedule. All materials are provided and advance registration is required.\n\nA City of Toronto Cultural Hotspot Signature Project.","categories":["Arts/Exhibits","Seminars/Workshops"],"presenter":"Mural Routes","image":"i2SMsQnvkRtaYNfLbdOTrw","website":"https://muralroutes.ca/mosaics-for-seniors-2026-cedarridge/","tickets":"https://muralroutes.ca/mosaics-for-seniors-2026-cedarridge/"},{"id":"3e3389ff-e856-4de5-b8c1-27d874b120fa","name":"Piece by Piece: Mosaics for Seniors at Cedar Ridge Creative Centre","dates":[1789565400000,1789738200000,1790170200000,1790343000000,1790775000000,1790947800000,1791379800000,1791552600000,1791984600000,1792157400000],"start":"2026-09-16T09:30:00-04:00","end":"2026-10-16T09:30:00-04:00","allDay":"Day Event","venue":{"name":"Cedar Ridge Creative Centre","address":"225 Confederation Dr, Scarborough, ON, M1G 1B2","lat":43.75743,"lng":-79.207132},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join Mural Routes for a free multi-session mosaic art workshop series for older adults. Led by mosaic mural artist Cristina Delago, participants will learn mosaic-making techniques, create a personalized artwork to take home, and contribute to a larger community mosaic installation. A final culminating event held on October 23 will take place after workshops are complete to celebrate all participants and what they have accomplished.\n\nThe project is delivered through two separate cohorts running concurrently at different locations. Please ensure you select your intended workshop series (cohort), as each cohort has its own location and schedule. All materials are provided and advance registration is required.\n\nA City of Toronto Cultural Hotspot Signature Project.","categories":["Arts/Exhibits","Seminars/Workshops"],"presenter":"Mural Routes","image":"i2SMsQnvkRtaYNfLbdOTrw","website":"https://muralroutes.ca/mosaics-for-seniors-2026-cedarridge/","tickets":"https://muralroutes.ca/mosaics-for-seniors-2026-cedarridge/"},{"id":"88f91a50-8227-4f80-8ca6-a8b806192fd5","name":"Piece by Piece: Mosaics for Seniors at Cedar Ridge Creative Centre","dates":[1789565400000,1789738200000,1790170200000,1790343000000,1790775000000,1790947800000,1791379800000,1791552600000,1791984600000,1792157400000],"start":"2026-09-16T09:30:00-04:00","end":"2026-10-16T09:30:00-04:00","allDay":"Day Event","venue":{"name":"Cedar Ridge Creative Centre","address":"225 Confederation Dr, Scarborough, ON, M1G 1B2","lat":43.75743,"lng":-79.207132},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join Mural Routes for a free multi-session mosaic art workshop series for older adults. Led by mosaic mural artist Cristina Delago, participants will learn mosaic-making techniques, create a personalized artwork to take home, and contribute to a larger community mosaic installation. A final culminating event held on October 23 will take place after workshops are complete to celebrate all participants and what they have accomplished.\n\nThe project is delivered through two separate cohorts running concurrently at different locations. Please ensure you select your intended workshop series (cohort), as each cohort has its own location and schedule. All materials are provided and advance registration is required.\n\nA City of Toronto Cultural Hotspot Signature Project.","categories":["Arts/Exhibits","Seminars/Workshops"],"presenter":"Mural Routes","image":"i2SMsQnvkRtaYNfLbdOTrw","website":"https://muralroutes.ca/mosaics-for-seniors-2026-cedarridge/","tickets":"https://muralroutes.ca/mosaics-for-seniors-2026-cedarridge/"},{"id":"0618948c-7c1d-409f-9a53-1d1aa1b17f16","name":"Paddleboarding at Biidaasige Park","dates":[1789223400000,1789828200000,1790433000000,1791037800000],"start":"2026-09-12T10:30:00-04:00","end":"2026-10-03T10:30:00-04:00","allDay":"Day Event","venue":{"name":"Biidaasige Park ","address":"51 Commissioners St, Toronto, ON, M5A 1A6","lat":43.646495807,"lng":-79.348925214},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":"Please register using the correct link below:\nSat September 12 Paddleboarding\n10:30 am, 12:30 pm - https://www.eventbrite.ca/e/1999636049252\nSat September 19 Paddleboarding\n10:30 am, 12:30 pm - https://www.eventbrite.ca/e/1999638061270\nSat September 26 Paddleboarding\n10:30 am, 12:30 pm - https://www.eventbrite.ca/e/1999638111420\n\n","description":"Get out on the water and experience Biidaasige Park from a whole new perspective! Join Don’t Mess with the Don for a fun and refreshing paddleboarding adventure along Toronto’s stunning new waterfront park. Whether you’re a first-timer or an experienced paddler, this is a great way to connect with nature, enjoy the river, and take in the park’s unique landscapes from the water. All equipment is provided, including a paddleboard, paddle, and personal flotation device (PFD). \n\nParticipants will have up to 1.5 hours to explore at their own pace. Please wear weather-appropriate clothing and water shoes, and bring water to stay hydrated. Recommended for ages 12+. \n\nCome discover the beauty of Biidaasige Park, build confidence on the water, and enjoy an unforgettable summer morning outdoors!","categories":["Environmental","Sports","Tour"],"presenter":null,"image":"L4b1C942bMoMQdF9ic2Ofw","website":"https://www.dontmesswiththedon.ca/","tickets":"https://www.eventbrite.ca/e/1998641932823"},{"id":"60a53098-d4ed-4a49-a058-7b606d497e99","name":"Rebirth: The Quiet Becoming Installation at Fort York","dates":[1785938400000,1786024800000,1786111200000,1786197600000,1786284000000,1786543200000,1786629600000,1786716000000,1786802400000,1786888800000,1787148000000,1787234400000,1787320800000,1787407200000,1787493600000,1787752800000,1787839200000,1787925600000,1788012000000,1788098400000,1788357600000,1788444000000,1788530400000,1788616800000,1788703200000,1788962400000,1789048800000,1789135200000,1789221600000,1789308000000,1789567200000,1789653600000,1789740000000,1789826400000,1789912800000,1790172000000,1790258400000,1790344800000,1790431200000,1790517600000,1790776800000,1790863200000,1790949600000,1791036000000,1791122400000,1791381600000,1791468000000,1791554400000,1791640800000,1791727200000,1791986400000,1792072800000,1792159200000,1792245600000,1792332000000,1792591200000,1792677600000,1792764000000,1792850400000,1792936800000,1793196000000,1793282400000,1793368800000,1793455200000],"start":"2026-08-05T10:00:00-04:00","end":"2026-10-31T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864096,"lng":-79.406314887},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Experience a bold new outdoor installation on the Gardiner Expressway beside Fort York Visitor Centre. Created by artists Delali Cofie and Yuma Dean Hester, it reimagines the site’s layered histories through contemporary art. An accompanying exhibition inside the Visitor Centre deepens the experience, inviting visitors to encounter the Fort as a living cultural landscape shaped by reflection, dialogue and collaboration.","categories":["Arts/Exhibits","History","Museum"],"presenter":null,"image":"_QHlUAQMVyNc88AaSDfQ8A","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":null},{"id":"a3678feb-be8d-4012-be74-e3404085c811","name":"International Architectural Design Competition 2026-2027: Persian Garden Suite","dates":[1789444800000,1789531200000,1789617600000,1789704000000,1789790400000,1789876800000,1789963200000,1790049600000,1790136000000,1790222400000,1790308800000,1790395200000,1790481600000,1790568000000,1790654400000,1790740800000,1790827200000,17