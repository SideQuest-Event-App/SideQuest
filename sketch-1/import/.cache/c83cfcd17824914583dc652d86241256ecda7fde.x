ary","History","Museum"],"presenter":null,"image":"egznsXPWUy9mZmA4HmCC9Q","website":"https://www.toronto.ca/montgomerysinn","tickets":null},{"id":"ffe1feb8-403e-46c0-a18c-ea1d2a464352","name":"Beach Photo Club Exhibition","dates":[1793714400000,1793800800000,1793887200000,1793973600000,1794060000000,1794146400000,1794232800000,1794319200000,1794405600000,1794492000000,1794578400000,1794664800000,1794751200000,1794837600000,1794924000000,1795010400000,1795096800000,1795183200000,1795269600000,1795356000000,1795442400000,1795528800000,1795615200000,1795701600000,1795788000000,1795874400000,1795960800000,1796047200000,1796133600000,1796220000000,1796306400000],"start":"2026-11-03T09:00:00-05:00","end":"2026-12-03T09:00:00-05:00","allDay":"Day Event","venue":{"name":"Clark Centre for the Arts","address":"191 Guildwood Pkwy, Scarborough, ON, M1E 1P5","lat":43.746893127,"lng":-79.193688812},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy this photography exhibition by a diverse group of artists as they present their unique interpretations of our world, from realistic to abstract, including techniques such as macro photography, intentional movement and digital compositing. This collection promises a rich visual experience that reflects the wide-ranging creativity of Beach Photo Club members.\n\n","categories":["Arts/Exhibits"],"presenter":null,"image":"4UNkAN-HEr_AYUwhK0vhfw","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/clark-centre-for-the-arts/","tickets":null},{"id":"b4b9c269-c386-4500-89fd-e8281573640b","name":"Threads of Connection and Conversation","dates":[1788444000000,1788530400000,1788616800000,1788789600000,1788876000000,1788962400000,1789048800000,1789135200000,1789221600000,1789394400000,1789480800000,1789567200000,1789653600000,1789740000000,1789826400000,1789999200000,1790085600000,1790172000000,1790258400000,1790344800000,1790431200000,1790604000000,1790690400000,1790776