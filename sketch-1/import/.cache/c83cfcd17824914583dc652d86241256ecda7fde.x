9unS5aRBvcRR5D6QA","website":"https://www.dpmarket.com","tickets":null},{"id":"b493b69d-1cb7-4d89-b2d0-72bf7014fc03","name":"Junction Farmers' Market","dates":[1778936400000,1779541200000,1780146000000,1780750800000,1781355600000,1781960400000,1782565200000,1783170000000,1783774800000,1784379600000,1784984400000,1785589200000,1786194000000,1786798800000,1787403600000,1788008400000,1788613200000,1789218000000,1789822800000,1790427600000,1791032400000,1791637200000,1792242000000,1792846800000,1793451600000],"start":"2026-05-16T09:00:00-04:00","end":"2026-10-31T09:00:00-04:00","allDay":"Day Event","venue":{"name":"Baird Park","address":"275 Keele St, Toronto, ON M6P 2K5, Canada","lat":43.663023721805715,"lng":-79.46217817047676},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Step into the lively Junction Farmers Market, where every visit is a celebration of fresh, local, and sustainably produced food! Join a vibrant community supporting passionate growers and producers while discovering delicious finds around every corner.\n\nExperience the joy of healthy, accessible food for everyone in and around the Junction—your next great food adventure starts here!","categories":["Farmers' Market","Other"],"presenter":null,"image":"1QtxyeTQD-ylYXlIjttO-g","website":"https://junctionmarket.ca/","tickets":null},{"id":"190c9eba-8d31-4741-a3ac-1524ecd46bb1","name":"Junction Farmers' Market","dates":[1778936400000,1779541200000,1780146000000,1780750800000,1781355600000,1781960400000,1782565200000,1783170000000,1783774800000,1784379600000,1784984400000,1785589200000,1786194000000,1786798800000,1787403600000,1788008400000,1788613200000,1789218000000,1789822800000,1790427600000,1791032400000,1791637200000,1792242000000,1792846800000,1793451600000],"start":"2026-05-16T09:00:00-04:00","end":"2026-10-31T09:00:00-04:00","allDay":"Day Event","venue":{"name":"Baird Park","address":"275 Keele St, Toronto, ON M6P 2K5, Canada","lat":43.663023721805715,"lng":-79.46217817047676},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Step into the lively Junction Farmers Market, where every visit is a celebration of fresh, local, and sustainably produced food! Join a vibrant community supporting passionate growers and producers while discovering delicious finds around every corner.\n\nExperience the joy of healthy, accessible food for everyone in and around the Junction—your next great food adventure starts here!","categories":["Farmers' Market","Other"],"presenter":null,"image":"1QtxyeTQD-ylYXlIjttO-g","website":"https://junctionmarket.ca/","tickets":null},{"id":"6122d2de-c88d-4999-8109-5e9ec0cf96bf","name":"Trinity Bellwoods Farmers' Market","dates":[1778007600000,1778612400000,1779217200000,1779822000000,1780426800000,1781031600000,1781636400000,1782241200000,1782846000000,1783450800000,1784055600000,1784660400000,1785265200000,1785870000000,1786474800000,1787079600000,1787684400000,1788289200000,1788894000000,1789498800000,1790103600000,1790708400000,1791313200000,1791918000000,1792522800000,1793127600000],"start":"2026-05-05T15:00:00-04:00","end":"2026-10-27T15:00:00-04:00","allDay":"Day Event","venue":{"name":"Trinity Bellwoods Park","address":"1053 Dundas Street West","lat":43.64976901117809,"lng":-79.41732226545297},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Trinity Bellwoods Farmers' Market is of modest size and nestled in the north-west corner of the largest green space park in the downtown core. 2026 celebrates it’s 20 years of bringing to the neighbourhood fresh, local, sustainably grown agriculture and food artisans that prioritize local ingredients. It is farmer-focused, favours slow food not fast food and eating at the hearth and home. Human food only. Visit website for more info.  The market is operated by the generosity of part-time seasonal community volunteers. ","categories":["Farmers' Market","Other"],"presenter":null,"image":"I3mtanYM-El4GRbb-TAO2A","website":"https://www.tbfm.ca","tickets":null},{"id":"01e2b322-76a1-47e0-8738-81855093e163","name":"Trinity Bellwoods Farmers' Market","dates":[1778007600000,1778612400000,1779217200000,1779822000000,1780426800000,1781031600000,1781636400000,1782241200000,1782846000000,1783450800000,1784055600000,1784660400000,1785265200000,1785870000000,1786474800000,1787079600000,1787684400000,1788289200000,1788894000000,1789498800000,1790103600000,1790708400000,1791313200000,1791918000000,1792522800000,1793127600000],"start":"2026-05-05T15:00:00-04:00","end":"2026-10-27T15:00:00-04:00","allDay":"Day Event","venue":{"name":"Trinity Bellwoods Park","address":"1053 Dundas Street West","lat":43.64976901117809,"lng":-79.41732226545297},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Trinity Bellwoods Farmers' Market is of modest size and nestled in the north-west corner of the largest green space park in the downtown core. 2026 celebrates it’s 20 years of bringing to the neighbourhood fresh, local, sustainably grown agriculture and food artisans that prioritize local ingredients. It is farmer-focused, favours slow food not fast food and eating at the hearth and home. Human food only. Visit website for more info.  The market is operated by the generosity of part-time seasonal community volunteers. ","categories":["Farmers' Market","Other"],"presenter":null,"image":"I3mtanYM-El4GRbb-TAO2A","website":"https://www.tbfm.ca","tickets":null},{"id":"d7395158-25a1-4ebf-8bca-6d094a9f8b7e","name":"Sorauren Farmers' Market","dates":[1777921200000,1778526000000,1779130800000,1779735600000,1780340400000,1780945200000,1781550000000,1782154800000,1782759600000,1783364400000,1783969200000,1784574000000,1785178800000,1785783600000,1786388400000,1786993200000,1787598000000,1788202800000,1788807600000,1789412400000,1790017200000,1790622000000,1791226800000,1791831600000,1792436400000,1793041200000],"start":"2026-05-04T15:00:00-04:00","end":"2026-10-26T15:00:00-04:00","allDay":"Day Event","venue":{"name":"Sorauren Park","address":"50 Wabash Ave, Toronto, ON M6R 1N2, Canada","lat":43.648147722995105,"lng":-79.44310115767041},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"This year round farmers' Market operates during the outdoor season, we operate in Sorauren Park which is a beautiful greenspace managed by the City of Toronto and animated by community group, Friends of Sorauren Park. Along with the Farmers’ Market, you’ll find an ice skating rink, dog walking park, community pizza oven, children’s soccer and baseball programmes and even movie nights and an annual pumpkin parade!","categories":["Farmers' Market","Food/Culinary","Other"],"presenter":null,"image":"pratsPJvmGxDUcIhkbTofA","website":"https://www.soraurenmarket.com/","tickets":null},{"id":"221422a7-aa1b-484d-a73f-22b02f75a1e3","name":"The Stop Farmers' Market @ Wychwood Barns Park","dates":[1779537600000,1780142400000,1780747200000,1781352000000,1781956800000,1782561600000,1783166400000,1783771200000,1784376000000,1784980800000,1785585600000,1786190400000,1786795200000,1787400000000,1788004800000,1788609600000,1789214400000,1789819200000,1790424000000,1791028800000,1791633600000,1792238400000,1792843200000,1793448000000,1794056400000,1794661200000,1795266000000,1795870800000,1796475600000,1797080400000,1797685200000],"start":"2026-05-23T08:00:00-04:00","end":"2026-12-19T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Wychwood Barns Park","address":"601 Christie St, Toronto, ON, M6G 4C7","lat":43.679958839,"lng":-79.424094918},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Featuring 35+ weekly vendors, the market brings together local farmers, food producers, and neighbours to increase access to healthy food in ways that build community. A program of The Stop Community Food Centre, the market supports both emerging and established small-scale producers while strengthening a resilient local food economy through responsibly grown and produced food. The market is committed to affordability, supporting racialized vendors, and creating welcoming, community-driven public spaces. Reflecting the diverse cultures of the neighbourhood and the broader GTA, the market celebrates the many food traditions that make Toronto vibrant.\n\nCome visit and support our year-round community market operating every Saturday in the Bathurst–St. Clair neighbourhood.","categories":["Farmers' Market","Other"],"presenter":null,"image":"7WHwqoysoRgdbIoHAZWiAw","website":"https://www.thestop.org/farmersmarket/","tickets":null},{"id":"8fce1dbb-3b2f-437b-9995-f50cba0528e2","name":"The Stop Farmers' Market @ Wychwood Barns Park","dates":[1779537600000,1780142400000,1780747200000,1781352000000,1781956800000,1782561600000,1783166400000,1783771200000,1784376000000,1784980800000,1785585600000,1786190400000,1786795200000,1787400000000,1788004800000,1788609600000,1789214400000,1789819200000,1790424000000,1791028800000,1791633600000,1792238400000,1792843200000,1793448000000,1794056400000,1794661200000,1795266000000,1795870800000,1796475600000,1797080400000,1797685200000],"start":"2026-05-23T08:00:00-04:00","end":"2026-12-19T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Wychwood Barns Park","address":"601 Christie St, Toronto, ON, M6G 4C7","lat":43.679958839,"lng":-79.424094918},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Featuring 35+ weekly vendors, the market brings together local farmers, food producers, and neighbours to increase access to healthy food in ways that build community. A program of The Stop Community Food Centre, the market supports both emerging and established small-scale producers while strengthening a resilient local food economy through responsibly grown and produced food. The market is committed to affordability, supporting racialized vendors, and creating welcoming, community-driven public spaces. Reflecting the diverse cultures of the neighbourhood and the broader GTA, the market celebrates the many food traditions that make Toronto vibrant.\n\nCome visit and support our year-round community market operating every Saturday in the Bathurst–St. Clair neighbourhood.","categories":["Farmers' Market","Other"],"presenter":null,"image":"7WHwqoysoRgdbIoHAZWiAw","website":"https://www.thestop.org/farmersmarket/","tickets":null},{"id":"8867f2d3-384b-425c-8f42-da1e0b5c481c","name":"The Stop Farmers' Market @ Wychwood Barns Park","dates":[1779537600000,1780142400000,1780747200000,1781352000000,1781956800000,1782561600000,1783166400000,1783771200000,1784376000000,1784980800000,1785585600000,1786190400000,1786795200000,1787400000000,1788004800000,1788609600000,1789214400000,1789819200000,1790424000000,1791028800000,1791633600000,1792238400000,1792843200000,1793448000000,1794056400000,1794661200000,1795266000000,1795870800000,1796475600000,1797080400000,1797685200000],"start":"2026-05-23T08:00:00-04:00","end":"2026-12-19T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Wychwood Barns Park","address":"601 Christie St, Toronto, ON, M6G 4C7","lat":43.679958839,"lng":-79.424094918},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Featuring 35+ weekly vendors, the market brings together local farmers, food producers, and neighbours to increase access to healthy food in ways that build community. A program of The Stop Community Food Centre, the market supports both emerging and established small-scale producers while strengthening a resilient local food economy through responsibly grown and produced food. The market is committed to affordability, supporting racialized vendors, and creating welcoming, community-driven public spaces. Reflecting the diverse cultures of the neighbourhood and the broader GTA, the market celebrates the many food traditions that make Toronto vibrant.\n\nCome visit and support our year-round community market operating every Saturday in the Bathurst–St. Clair neighbourhood.","categories":["Farmers' Market","Other"],"presenter":null,"image":"7WHwqoysoRgdbIoHAZWiAw","website":"https://www.thestop.org/farmersmarket/","tickets":null},{"id":"b0ef2236-440d-4f86-b021-11da9281d1c8","name":"Immersion Festival","dates":[1794153600000,1794263400000,1794439800000,1794526200000,1794702600000,1794769200000,1794958200000,1795131000000,1795221000000,1795287600000,1795307400000,1795374000000,1795379400000],"start":"2026-11-08T11:00:00-05:00","end":"2026-11-22T15:30:00-05:00","allDay":"Night Event","venue":{"name":"Betty Oliphant Theatre","address":"404 Jarvis St, Toronto, ON M4Y 2G6","lat":43.6643,"lng":-79.3777},"free":false,"low":0,"high":150,"pwyc":null,"costNotes":null,"description":"Join us for a celebration of Canadian cultural life for audiences and a sought-after performance and networking opportunity for renowned and aspiring artists, with three distinct stage performances, twelve workshops, a dance education roundtable, and community gatherings. Performances and workshops are open to all!\n\nEnjoy The Vanguard Presentation includes commissioned works by Katlyn Addison and Tanya Charles, Travis Knights and Divine Brown, and Nubian Néné. The National Presentation features Ebnflōh Dance Company, Lua Shayenne Dance Company, and N.A.P.P.Y. Dance, while the Next Gen showcase highlights emerging Black youth artists.\n\nOur workshops for youth, beginners, and professionals are led by Kwasi Obeng-Adjei, Reequal Smith, Natasha Powell, and Isaac Gasangwa, exploring diverse Black and diasporic movement practices. \n\nThree gathering events bring together presenters, artists, and academics to connect, exchange ideas, and celebrate Black dance across Canada.","categories":["Dance","Live Performances","Seminars/Workshops"],"presenter":"dance Immersion","image":"sERkkQuapznV_lRLtFWEKw","website":"https://danceimmersion.ca/immersionfestival/","tickets":"https://danceimmersion.ca/immersionfestival/#full-festival-info"},{"id":"10eebe64-9ef5-409e-9a89-64616c86326a","name":"Allan Gardens Saturday Farmers' Market","dates":[1777730400000,1778335200000,1778940000000,1779544800000,1780149600000,1780754400000,1781359200000,1781964000000,1782568800000,1783173600000,1783778400000,1784383200000,1784988000000,1785592800000,1786197600000,1786802400000,1787407200000,1788012000000,1788616800000,1789221600000,1789826400000,1790431200000,1791036000000,1791640800000,1792245600000,1792850400000,1793455200000,1794063600000,1794668400000,1795273200000,1795878000000,1796482800000,1797087600000,1797692400000,1798297200000,1798902000000,1799506800000,1800111600000,1800716400000,1801321200000,1801926000000,1802530800000,1803135600000,1803740400000,1804345200000,1804950000000,1805551200000,1806156000000,1806760800000,1807365600000,1807970400000,1808575200000,1809180000000],"start":"2026-05-02T10:00:00-04:00","end":"2027-05-01T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Children's Conservatory","address":"19 Horticultural Ave, Toronto, ON, M5A 2P2","lat":43.661418998,"lng":-79.37480223},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrate local food, community, and sustainable agriculture. Discover fresh produce, artisanal products, and small-scale producers - all while connecting with the people who grow and create them.We invite you to come meet the vendors, discover new favourites, and taste the heart of your community!\n\nThe Allan Gardens Farmers’ Market facilitates a direct exchange between local farmers, food producers, artisan makers, and consumers. Everything sold at the market (50%+1) must be grown, sourced, made, and/or prepared in Toronto and the surrounding  area—ensuring that every purchase supports your neighbourhood economy.\n\nJoin us year- round every Saturday from 10am-2pm, in the beautiful Allan Gardens Children’s Conservatory & Teaching Garden. ","categories":["Farmers' Market"],"presenter":null,"image":"1_2B-asoDqdvJSyiKMPiaQ","website":"https://www.friendsofallangardens.ca/saturday-farmers-market","tickets":null},{"id":"19e3fc66-ca3c-4bf1-8ff7-16e9c05c9325","name":"Allan Gardens Saturday Farmers' Market","dates":[1777730400000,1778335200000,1778940000000,1779544800000,1780149600000,1780754400000,1781359200000,1781964000000,1782568800000,1783173600000,1783778400000,1784383200000,1784988000000,1785592800000,1786197600000,1786802400000,1787407200000,1788012000000,1788616800000,1789221600000,1789826400000,1790431200000,1791036000000,1791640800000,1792245600000,1792850400000,1793455200000,1794063600000,1794668400000,1795273200000,1795878000000,1796482800000,1797087600000,1797692400000,1798297200000,1798902000000,1799506800000,1800111600000,1800716400000,1801321200000,1801926000000,1802530800000,1803135600000,1803740400000,1804345200000,1804950000000,1805551200000,1806156000000,1806760800000,1807365600000,1807970400000,1808575200000,1809180000000],"start":"2026-05-02T10:00:00-04:00","end":"2027-05-01T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Children's Conservatory","address":"19 Horticultural Ave, Toronto, ON, M5A 2P2","lat":43.661418998,"lng":-79.37480223},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrate local food, community, and sustainable agriculture. Discover fresh produce, artisanal products, and small-scale producers - all while connecting with the people who grow and create them.We invite you to come meet the vendors, discover new favourites, and taste the heart of your community!\n\nThe Allan Gardens Farmers’ Market facilitates a direct exchange between local farmers, food producers, artisan makers, and consumers. Everything sold at the market (50%+1) must be grown, sourced, made, and/or prepared in Toronto and the surrounding  area—ensuring that every purchase supports your neighbourhood economy.\n\nJoin us year- round every Saturday from 10am-2pm, in the beautiful Allan Gardens Children’s Conservatory & Teaching Garden. ","categories":["Farmers' Market"],"presenter":nul