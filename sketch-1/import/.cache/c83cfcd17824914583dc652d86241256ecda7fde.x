1795960800000,1796047200000,1796133600000,1796220000000,1796306400000],"start":"2026-11-03T09:00:00-05:00","end":"2026-12-03T09:00:00-05:00","allDay":"Day Event","venue":{"name":"Clark Centre for the Arts","address":"191 Guildwood Pkwy, Scarborough, ON, M1E 1P5","lat":43.746893127,"lng":-79.193688812},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy this photography exhibition by a diverse group of artists as they present their unique interpretations of our world, from realistic to abstract, including techniques such as macro photography, intentional movement and digital compositing. This collection promises a rich visual experience that reflects the wide-ranging creativity of Beach Photo Club members.\n\n","categories":["Arts/Exhibits"],"presenter":null,"image":"4UNkAN-HEr_AYUwhK0vhfw","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/clark-centre-for-the-arts/","tickets":null},{"id":"f98fcf88-ecbc-4997-bba0-b06cb43f081b","name":"Eglinton Way BIA Farmers' Market","dates":[1780833600000,1781438400000,1782043200000,1782648000000,1783252800000,1783857600000,1784462400000,1785067200000,1785672000000,1786276800000,1786881600000,1787486400000,1788091200000,1788696000000,1789300800000,1789905600000,1790510400000,1791115200000,1791720000000,1792324800000,1792929600000],"start":"2026-06-07T08:00:00-04:00","end":"2026-10-25T08:00:00-04:00","allDay":"Day Event","venue":{"name":"Green P Parking Lot #47","address":"125 Burnaby Blvd, Toronto","lat":43.70439991,"lng":-79.412600977},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Now in its 9th year, The Eglinton Way BIA Farmers' Market has become a staple Sunday event in Midtown Toronto dedicated to strengthening and promoting the connections between our community and Ontario farms, local artisans and small businesses. With 40+ vendors this season, find everything from fresh meat, eggs and produce, to baked goods, food & drink, household goods, arts, crafts and more! Our market features live music, free kids' activities, and special activations that are perfect for all ages. Follow us on Instagram at @EglintonWay for more information and updates!","categories":["Artisan","Farmers' Market","Other"],"presenter":null,"image":"uR4r0FHNt-y4Xe6-SE_U-g","website":"https://www.theeglintonway.com/farmersmarket","tickets":null},{"id":"54d5200c-a2f8-4400-a3e8-0bd512790e66","name":"Eglinton Way BIA Farmers' Market","dates":[1780833600000,1781438400000,1782043200000,1782648000000,1783252800000,1783857600000,1784462400000,1785067200000,1785672000000,1786276800000,1786881600000,1787486400000,1788091200000,1788696000000,1789300800000,1789905600000,1790510400000,1791115200000,1791720000000,1792324800000,1792929600000],"start":"2026-06-07T08:00:00-04:00","end":"2026-10-25T08:00:00-04:00","allDay":"Day Event","venue":{"name":"Green P Parking Lot #47","address":"125 Burnaby Blvd, Toronto","lat":43.70439991,"lng":-79.412600977},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Now in its 9th year, The Eglinton Way BIA Farmers' Market has become a staple Sunday event in Midtown Toronto dedicated to strengthening and promoting the connections between our community and Ontario farms, local artisans and small businesses. With 40+ vendors this season, find everything from fresh meat, eggs and produce, to baked goods, food & drink, household goods, arts, crafts and more! Our market features live music, free kids' activities, and special activations that are perfect for all ages. Follow us on Instagram at @EglintonWay for more information and updates!","categories":["Artisan","Farmers' Market","Other"],"presenter":null,"image":"uR4r0FHNt-y4Xe6-SE_U-g","website":"https://www.theeglintonway.com/farmersmarket","tickets":null},{"id":"fa3925ae-486d-4a87-9f9b-1bac32e89e7e","name":"Saturday Farmers' Market at Evergreen Brick Works","dates":[1777723200000,1778328000000,1778932800000,1779537600000,1780142400000,1780747200000,1781352000000,1781956800000,1782561600000,1783166400000,1783771200000,1784376000000,1784980800000,1785585600000,1786190400000,1786795200000,1787400000000,1788004800000,1788609600000,1789214400000,1789819200000,1790424000000,1791028800000,1791633600000,1792238400000,1792843200000,1793448000000],"start":"2026-05-02T08:00:00-04:00","end":"2026-10-31T08:00:00-04:00","allDay":"Day Event","venue":{"name":"Evergreen Brick Works","address":"550 Bayview Ave, East York, ON, M4W 3X8","lat":43.683783,"lng":-79.365628},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover Toronto’s largest year-round farmers' market. Shop fresh, seasonal produce, artisanal goods and locally prepared foods from Ontario farmers and small businesses.\n\nGrab a coffee, wander through a vibrant market bursting with peak-season flavours and one-of-a-kind finds, and then enjoy a delicious brunch. Held in an open-air pavilion, the market runs rain or shine. Stick around to enjoy a free guided tour of the historic brick factory, take a stroll around the ponds and nearby nature trails or explore the Children's Garden. Getting there is easy with the free shuttle bus picking up next to Broadview Station or take the TTC's 28 bus from Davisville Station.\n\nThe farmers' market is operated by Evergreen, a national non-profit transforming public spaces in our cities to build a healthier future for people and our planet.","categories":["Environmental","Farmers' Market","Food/Culinary"],"presenter":null,"image":"g_7hN7bS9geSUWTPQPVycA","website":"https://www.evergreen.ca/evergreen-brick-work/activities/saturday-farmers-market/","tickets":null},{"id":"95eb0422-4643-4b65-b605-87b1c0d3b39d","name":"Saturday Farmers' Market at Evergreen Brick Works","dates":[1777723200000,1778328000000,1778932800000,1779537600000,1780142400000,1780747200000,1781352000000,1781956800000,1782561600000,1783166400000,1783771200000,1784376000000,1784980800000,178558560