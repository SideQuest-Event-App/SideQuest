00000,1798808400000,1798902000000,1799067600000,1799154000000,1799240400000,1799326800000,1799413200000,1799506800000,1799672400000,1799758800000,1799845200000,1799931600000,1800018000000,1800111600000,1800277200000,1800363600000,1800450000000,1800536400000,1800622800000,1800716400000,1800882000000,1800968400000,1801054800000,1801141200000],"start":"2026-11-04T08:00:00-05:00","end":"2027-01-28T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Ascent Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Huan Chen transforms native fungi and lichen into a powerful metaphor for the immigrant experience, telling stories of heritage, struggle, adaptation and new beginnings. Through striking imagery, the work also reflects on human impact on natural habitats and the cultural shifts shaping urban life. Don’t miss this thought-provoking installation that connects nature, identity and community in surprising ways.","categories":["Arts/Exhibits"],"presenter":null,"image":"I1QKlptauUx7hjNseGr6og","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/","tickets":null},{"id":"89bcc779-ea97-4cf4-a918-2bdbf4b51861","name":"A Spore on its Journey","dates":[1793797200000,1793883600000,1793970000000,1794063600000,1794229200000,1794315600000,1794402000000,1794488400000,1794574800000,1794668400000,1794834000000,1794920400000,1795006800000,1795093200000,1795179600000,1795273200000,1795438800000,1795525200000,1795611600000,1795698000000,1795784400000,1795878000000,1796043600000,1796130000000,1796216400000,1796302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000,1797426000000,1797512400000,1797598800000,1797692400000,1797858000000,1797944400000,1798030800000,1798117200000,1798203600000,1798297200000,1798462800000,1798549200000,1798635600000,1798722000000,1798808400000,1798902000000,1799067600000,1799154000000,1799240400000,1799326800000,1799413200000,1799506800000,1799672400000,1799758800000,1799845200000,1799931600000,1800018000000,1800111600000,1800277200000,1800363600000,1800450000000,1800536400000,1800622800000,1800716400000,1800882000000,1800968400000,1801054800000,1801141200000],"start":"2026-11-04T08:00:00-05:00","end":"2027-01-28T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Ascent Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Huan Chen transforms native fungi and lichen into a powerful metaphor for the immigrant experience, telling stories of heritage, struggle, adaptation and new beginnings. Through striking imagery, the work also reflects on human impact on natural habitats and the cultural shifts shaping urban life. Don’t miss this thought-provoking installation that connects nature, identity and community in surprising ways.","categories":["Arts/Exhibits"],"presenter":null,"image":"I1QKlptauUx7hjNseGr6og","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/","tickets":null},{"id":"f2b24670-27d7-4472-92e8-8840768a9e32","name":"A Spore on its Journey","dates":[1793797200000,1793883600000,1793970000000,1794063600000,1794229200000,1794315600000,1794402000000,1794488400000,1794574800000,1794668400000,1794834000000,1794920400000,1795006800000,1795093200000,1795179600000,1795273200000,1795438800000,1795525200000,1795611600000,1795698000000,1795784400000,1795878000000,1796043600000,1796130000000,1796216400000,1796302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000,1797426000000,1797512400000,1797598800000,1797692400000,1797858000000,1797944400000,1798030800000,1798117200000,1798203600000,1798297200000,1798462800000,1798549200000,1798635600000,1798722000000,1798808400000,1798902000000,1799067600000,1799154000000,1799240400000,1799326800000,1799413200000,1799506800000,1799672400000,1799758800000,1799845200000,1799931600000,1800018000000,1800111600000,1800277200000,1800363600000,1800450000000,1800536400000,1800622800000,1800716400000,1800882000000,1800968400000,1801054800000,1801141200000],"start":"2026-11-04T08:00:00-05:00","end":"2027-01-28T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Ascent Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Huan Chen transforms native fungi and lichen into a powerful metaphor for the immigrant experience, telling stories of heritage, struggle, adaptation and new beginnings. Through striking imagery, the work also reflects on human impact on natural habitats and the cultural shifts shaping urban life. Don’t miss this thought-provoking installation that connects nature, identity and community in surprising ways.","categories":["Arts/Exhibits"],"presenter":null,"image":"I1QKlptauUx7hjNseGr6og","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/","tickets":null},{"id":"061096cb-fee5-42d6-9020-e980442130fc","name":"Maryvale Library Tour","dates":[1792692000000],"start":"2026-10-22T14:00:00-04:00","end":"2026-10-22T14:00:00-04:00","allDay":"Day Event","venue":{"name":"Maryvale Library","address":"85 Ellesmere Rd, Scarborough, ON, M1R 4B9","lat":43.757221156,"lng":-79.311852013},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"The Maryvale branch and its neighbourhood is home to a variety of trees. Join City of Toronto staff to explore the natural world on a local neighbourhood tour. Learn how to recognize different species, and fun facts about their cultural and ecological importance.\n\nChildren under 12 must be accompanied by a parent/caregiver.\n\nThe tour will start and end at the Maryvale branch and will be guided by City of Toronto staff. There may be uneven, unpaved surfaces along the route. Please dress and prepare accordingly for this outdoor program (e.g. gloves/mittens, hats, sunscreen, water, comfortable shoes). This program takes place rain or shine. In the event of severe inclement weather, registrants will be notified of an alternative date.\n\nRegistration is required. Registration will open one month before the event.","categories":["Environmental","Run/Walk","Tour"],"presenter":null,"image":"sN6K1aF_yf--rsv76FBuxA","website":"https://tpl.bibliocommons.com/v2/events/69aa0118491b809c6f1e6453","tickets":"https://tpl.bibliocommons.com/v2/events/69aa0118491b809c6f1e6453"},{"id":"3945e3c1-a24a-439a-acf7-4774c8c12b8f","name":"Locke Library Talk","dates":[1794942000000],"start":"2026-11-17T14:00:00-05:00","end":"2026-11-17T14:00:00-05:00","allDay":"Day Event","venue":{"name":"Locke Library","address":"3083 Yonge St, Toronto, ON, M4N 2K7","lat":43.724886259,"lng":-79.401728605},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Toronto has one of the largest urban forests in the world. Join the City of Toronto for an in-library presentation on this amazing natural habitat that reaches all corners of Toronto. We’ll discuss what makes the urban forest so special and share tools to help you explore and understand it better. Bring questions and curiosities, and leave with greater confidence and a deeper understanding of your City and the natural world around you.\n\nNo registration. This is a drop-in event.","categories":["Environmental","Talks"],"presenter":null,"image":"_waE92RfHHkZ9gMHGMUwFg","website":"https://tpl.bibliocommons.com/v2/events/6a7d07404027d701ebc3fc50","tickets":"https://tpl.bibliocommons.com/v2/events/6a7d07404027d701ebc3fc50"},{"id":"8206277c-8e77-4777-851b-c5bf5bc29516","name":"New Vistas","dates":[1796216400000,1796302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000,1797426000000,1797512400000,1797598800000,1797692400000,1797858000000,1797944400000,1798030800000,1798117200000,1798203600000,1798297200000,1798462800000,1798549200000,1798635600000,1798722000000,1798808400000,1798902000000,1799067600000,1799154000000,1799240400000,1799326800000,1799413200000,1799506800000,1799672400000,1799758800000,1799845200000,1799931600000],"start":"2026-12-02T08:00:00-05:00","end":"2027-01-14T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Etobicoke Civic Centre Art Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrate emerging voices in art at this annual exhibition, developed in partnership between the City of Toronto and Humber Polytechnic’s Arts Administration & Cultural Management Program. Showcasing early-career artists with focus on IBPOC, persons with disabilities, and 2SLGBTQIAS+, New Vistas highlights bold, fresh perspectives. Witness the creativity shaping the next generation of artists and arts leaders.\n\nReception: December 5, 2–4 p.m.","categories":["Arts/Exhibits"],"presenter":null,"image":"prQfzbnWAAkE_8xLZf6hbw","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/","tickets":null},{"id":"3c8951b7-1033-407d-9d2a-3593f6d6b77e","name":"New Vistas","dates":[1796216400000,1796302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000,1797426000000,1797512400000,1797598800000,1797692400000,1797858000000,1797944400000,1798030800000,1798117200000,1798203600000,1798297200000,1798462800000,17