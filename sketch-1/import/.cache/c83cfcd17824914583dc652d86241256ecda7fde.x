8800000,1795525200000,1795611600000,1795698000000,1795784400000,1795878000000,1796043600000,1796130000000,1796216400000,1796302800000,1796389200000,1796482800000,1796648400000,1796734800000,1796821200000,1796907600000,1796994000000,1797087600000,1797253200000,1797339600000,1797426000000,1797512400000,1797598800000,1797692400000,1797858000000,1797944400000,1798030800000,1798117200000,1798203600000,1798297200000,1798462800000,1798549200000,1798635600000,1798722000000,1798808400000,1798902000000,1799067600000,1799154000000,1799240400000,1799326800000,1799413200000,1799506800000,1799672400000,1799758800000,1799845200000,1799931600000,1800018000000,1800111600000,1800277200000,1800363600000,1800450000000,1800536400000,1800622800000,1800716400000,1800882000000,1800968400000,1801054800000,1801141200000],"start":"2026-11-04T08:00:00-05:00","end":"2027-01-28T08:00:00-05:00","allDay":"Day Event","venue":{"name":"Ascent Gallery","address":"399 The West Mall, Etobicoke, ON, M9C 2Y2","lat":43.643772026,"lng":-79.565452785},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Huan Chen transforms native fungi and lichen into a powerful metaphor for the immigrant experience, telling stories of heritage, struggle, adaptation and new beginnings. Through striking imagery, the work also reflects on human impact on natural habitats and the cultural shifts shaping urban life. Don’t miss this thought-provoking installation that connects nature, identity and community in surprising ways.","categories":["Arts/Exhibits"],"presenter":null,"image":"I1QKlptauUx7hjNseGr6og","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/cultural-centres-galleries/etobicoke-civic-centre-art-gallery/","tickets":null},{"id":"ad104739-03a6-49bd-b2a1-f0e8125b7bb0","name":"Immersion Festival","dates":[1794153600000,1794263400000,1794439800000,1794526200000,1794702600000,1794769200000,1794958200000,1795131000000,1795221000000,1795287600000,1795307400000,1795374000000,1795379400000],"start":"2026-11-08T11:00:00-05:00","end":"2026-11-22T15:30:00-05:00","allDay":"Day Event","venue":{"name":"Betty Oliphant Theatre","address":"404 Jarvis St, Toronto, ON M4Y 2G6","lat":43.6643,"lng":-79.3777},"free":false,"low":0,"high":150,"pwyc":null,"costNotes":null,"description":"Join us for a celebration of Canadian cultural life for audiences and a sought-after performance and networking opportunity for renowned and aspiring artists, with three distinct stage performances, twelve workshops, a dance education roundtable, and community gatherings. Performances and workshops are open to all!\n\nEnjoy The Vanguard Presentation includes commissioned works by Katlyn Addison and Tanya Charles, Travis Knights and Divine Brown, and Nubian Néné. The National Presentation features Ebnflōh Dance Company, Lua Shayenne Dance Company, and N.A.P.P.Y. Dance, while the Next Gen showcase highlights emerging Black youth artists.\n\nOur workshops for youth, beginners, and professionals are led by Kwasi Obeng-Adjei, Reequal Smith, Natasha Powell, and Isaac Gasangwa, exploring diverse Black and diasporic movement practices. \n\nThree gathering events bring together presenters, artists, and academics to connect, exchange ideas, and celebrate Black dance across Canada.","categories":["Dance","Live Performances","Seminars/Workshops"],"presenter":"dance Immersion","image":"sERkkQuapznV_lRLtFWEKw","website":"https://danceimmersion.ca/immersionfestival/","tickets":"https://danceimmersion.ca/immersionfestival/#full-festival-info"},{"id":"ff9d6390-16d2-4974-b361-ac6e4f572ba8","name":"Immersion Festival","dates":[1794153600000,1794263400000,1794439800000,1794526200000,1794702600000,1794769200000,1794958200000,1795131000000,1795221000000,1795287600000,1795307400000,1795374000000,1795379400000],"start":"2026-11-08T11:00:00-05:00","end":"2026-11-22T15:30:00-05:00","allDay":"Day Event","venue":{"name":"Betty Oliphant Theatre","address":"404 Jarvis St, Toronto, ON M4Y 2G6","lat":43.6643,"lng":-79.3777},"free":false,"low":0,"high":150,"pwyc":null,"costNotes":null,"description":"Join us for a celebration of Canadian cultural life for audiences and a sought-after performance and networking opportunity for renowned and aspiring artists, with three distinct stage performances, twelve workshops, a dance education roundtable, and community gatherings. Performances and workshops are open to all!\n\nEnjoy The Vanguard Presentation includes commissioned works by Katlyn Addison and Tanya Charles, Travis Knights and Divine Brown, and Nubian Néné. The National Presentation features Ebnflōh Dance Company, Lua Shayenne Dance Company, and N.A.P.P.Y. Dance, while the Next Gen showcase highlights emerging Black youth artists.\n\nOur workshops for youth, beginners, and professionals are led by Kwasi Obeng-Adjei, Reequal Smith, Natasha Powell, and Isaac Gasangwa, exploring diverse Black and diasporic movement practices. \n\nThree gathering events bring together presenters, artists, and academics to connect, exchange ideas, and celebrate Black dance across Canada.","categories":["Dance","Live Performances","Seminars/Workshops"],"presenter":"dance Immersion","image":"sERkkQuapznV_lRLtFWEKw","website":"https://danceimmersion.ca/immersionfestival/","tickets":"https://danceimmersion.ca/immersionfestival/#full-festival-info"},{"id":"7e73c9a7-b385-4a23-80c2-7b9406b80651","name":"Market 707","dates":[1779462000000,1779548400000,1779807600000,1779894000000,1779980400000,1780066800000,1780153200000,1780412400000,1780498800000,1780585200000,1780671600000,1780758000000,1781017200000,1781103600000,1781190000000,1781276400000,1781362800000,1781622000000,1781708400000,1781794800000,1781881200000,1781967600000,1782226800000,1782313200000,1782399600000,1782486000000,1782572400000,1782831600000,1782918000000,1783004400000,1783090800000,1783177200000,1783436400000,1783522800000,1783609200000,1783695600000,1783782000000,1784041200000,1784127600000,1784214000000,1784300400000,17843868000