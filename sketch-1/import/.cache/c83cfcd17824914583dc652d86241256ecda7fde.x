":["Cultural","Other"],"presenter":"Iranian-Canadian Architects and Artists Forum ","image":null,"website":"https://www.icaaf.ca/competition","tickets":"https://www.icaaf.ca/competition"},{"id":"0ce22aa8-dd05-4a0d-bad8-de879e7e4749","name":"Retracing Tatreez: Palestinian Thobes through the Twentieth Century","dates":[1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000,1799254800000,1799341200000,1799427600000,1799514000000,1799600400000,1799859600000,1799946000000,1800032400000,1800118800000,1800205200000,1800464400000,1800550800000,1800637200000,1800723600000,1800810000000,1801069200000,1801155600000,1801242000000,1801328400000,1801414800000,1801674000000,1801760400000,1801846800000,1801933200000,1802019600000],"start":"2026-09-24T12:00:00-04:00","end":"2027-02-07T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":"\nChildren 5 and under visit for free.","description":"Featuring several examples of Palestinian tatreez (embroidery) from the Textile Museum’s collection, most of which will be exhibited for the first time! \n\nRetracing Tatreez highlights what these belongings can tell us about the relationship between Palestinians and their homelands in the twentieth century and beyond.\n\nIn this exhibition, curator Nina Rafique showcases these pieces with restored historical context and invites visitors to re-engage with their ways of storytelling. \n\nIn doing so, Retracing Tatreez highlights what these embroideries can tell us about the unique regional connections between Palestinians and their homelands, as well as the journeys of these objects from the hands of their original creators to today.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"j37-eBOZLJMeQ8B7zUJpJg","website":"https://textilemuseum.ca/event/retracing-tatreez-palestinian-thobes-through-the-20th-century/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"b5898abe-9191-435c-b0d9-95e27331eb32","name":"Retracing Tatreez: Palestinian Thobes through the Twentieth Century","dates":[1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000,1799254800000,1799341200000,1799427600000,1799514000000,1799600400000,1799859600000,1799946000000,1800032400000,1800118800000,1800205200000,1800464400000,1800550800000,1800637200000,1800723600000,1800810000000,1801069200000,1801155600000,1801242000000,1801328400000,1801414800000,1801674000000,1801760400000,1801846800000,1801933200000,1802019600000],"start":"2026-09-24T12:00:00-04:00","end":"2027-02-07T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":"\nChildren 5 and under visit for free.","description":"Featuring several examples of Palestinian tatreez (embroidery) from the Textile Museum’s collection, most of which will be exhibited for the first time! \n\nRetracing Tatreez highlights what these belongings can tell us about the relationship between Palestinians and their homelands in the twentieth century and beyond.\n\nIn this exhibition, curator Nina Rafique showcases these pieces with restored historical context and invites visitors to re-engage with their ways of storytelling. \n\nIn doing so, Retracing Tatreez highlights what these embroideries can tell us about the unique regional connections between Palestinians and their homelands, as well as the journeys of these objects from the hands of their original creators to today.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"j37-eBOZLJMeQ8B7zUJpJg","website":"https://textilemuseum.ca/event/retracing-tatreez-palestinian-thobes-through-the-20th-century/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"dfcfb4d8-718b-4