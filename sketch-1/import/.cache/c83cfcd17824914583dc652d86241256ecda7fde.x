00000,1793682000000,1793768400000,1793854800000,1793941200000,1794027600000,1794114000000,1794200400000,1794286800000,1794373200000,1794459600000,1794546000000,1794632400000,1794718800000,1794805200000,1794891600000,1794978000000,1795064400000,1795150800000,1795237200000,1795323600000,1795410000000,1795496400000,1795582800000,1795669200000,1795755600000,1795842000000,1795928400000,1796014800000,1796101200000,1796187600000,1796274000000,1796360400000,1796446800000,1796533200000,1796619600000,1796706000000,1796792400000,1796878800000,1796965200000,1797051600000,1797138000000,1797224400000,1797310800000,1797397200000,1797483600000,1797570000000,1797656400000,1797742800000],"start":"2026-09-15T00:00:00-04:00","end":"2026-12-20T00:00:00-05:00","allDay":"Day Event","venue":{"name":"Toronto (virtual)","address":"","lat":null,"lng":null},"free":false,"low":10,"high":30,"pwyc":null,"costNotes":null,"description":"This international architectural competition invites participants to design a Persian Garden Suite pavilion in Toronto. \n\nThe initiative explores cultural heritage, urban design, and innovative architecture. Detailed competition guidelines, submission criteria and timelines are available for participants.","categories":["Cultural","Other"],"presenter":"Iranian-Canadian Architects and Artists Forum ","image":null,"website":"https://www.icaaf.ca/competition","tickets":"https://www.icaaf.ca/competition"},{"id":"7e30e9df-a51f-476d-bdce-0b2725a93d17","name":"Stacey Kent: A Tribute to Jobim","dates":[1808611200000],"start":"2027-04-24T20:00:00-04:00","end":"2027-04-24T20:00:00-04:00","allDay":"Night Event","venue":{"name":"Koerner Hall","address":"273 Bloor St W, Toronto, ON, M5S 1W2","lat":43.667856304,"lng":-79.396058814},"free":false,"low":50,"high":110,"pwyc":null,"costNotes":null,"description":"Grammy Award nominated vocalist Stacey Kent brings her luminous voice and elegant phrasing to a heartfelt tribute to legendary Brazilian songwriter Antônio Carlos Jobim. \n\nKent is an American jazz singer in the mould of the greats, with a legion of fans, a host of honours and awards including a Grammy nomination, with over two million albums sold, more than one billion streams and several chart-topping albums. Her unique multi-lingual repertoire includes standards, chanson, bossa nova, and originals written by her husband, Jim Tomlinson, with the Nobel Prize-winning author, Kazuo Ishiguro, with whom they have worked since 2006. She has also recorded with Brazilian legends Marcos Valle, Roberto Menescal, Danilo Caymmi, and the celebrated French string quartet, the Quatuor Ébène.\n\nAfter the concert, enjoy a beverage and more music at the Postlude Performance in the Leslie and Anna Dan Galleria.\n","categories":["Live Performances","Music"],"presenter":null,"image":"TszDdFMdjPwlFXUHLem5SQ","website":"https://www.rcmusic.com/concert/stacey-kent-a-tribute-to-tom-jobim-427802","tickets":"https://www.rcmusic.com/tickets/seats/427802"},{"id":"4c37a021-5350-471c-a81a-06b4a0636741","name":"Toronto Sauna Festival 2026","dates":[1790978400000,1791050400000,1791122400000],"start":"2026-10-02T18:00:00-04:00","end":"2026-10-04T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Evergreen Brick Works","address":"550 Bayview Ave, East York, ON, M4W 3X8","lat":43.683783348,"lng":-79.365627973},"free":false,"low":89.99,"high":233.99,"pwyc":null,"costNotes":null,"description":"Join us for three days of social wellness!\n\nEnjoy over 20 saunas, guided and free-flow cold plunges, international sauna rituals, movement, music, recovery experiences, food and community.","categories":["Seminars/Workshops","Other"],"presenter":null,"image":"RNl6kf35RbKeLqeTDr70_g","website":"https://www.torontosaunafestival.com/","tickets":"https://torontosaunafestival.tickit.ca/events/36425?goto=t-178beccf4"},{"id":"9f8b04ea-a1a1-438a-aab8-0a91a83acf8c","name":"International Architectural Design Competition 2026-2027: Persian Garden Suite","dates":[1789444800000,178953120