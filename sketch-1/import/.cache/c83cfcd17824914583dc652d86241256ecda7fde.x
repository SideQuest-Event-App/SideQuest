000,1791259200000,1791345600000,1791432000000,1791518400000,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000,1792123200000,1792209600000,1792296000000,1792382400000,1792468800000,1792555200000,1792641600000,1792728000000,1792814400000,1792900800000,1792987200000,1793073600000,1793160000000,1793246400000,1793332800000,1793419200000,1793505600000,1793595600000,1793682000000,1793768400000,1793854800000,1793941200000,1794027600000,1794114000000,1794200400000,1794286800000,1794373200000,1794459600000,1794546000000,1794632400000,1794718800000,1794805200000,1794891600000,1794978000000,1795064400000,1795150800000,1795237200000,1795323600000,1795410000000,1795496400000,1795582800000,1795669200000,1795755600000,1795842000000,1795928400000,1796014800000,1796101200000,1796187600000,1796274000000,1796360400000,1796446800000,1796533200000,1796619600000,1796706000000,1796792400000,1796878800000,1796965200000,1797051600000,1797138000000,1797224400000,1797310800000,1797397200000,1797483600000,1797570000000,1797656400000,1797742800000],"start":"2026-09-15T00:00:00-04:00","end":"2026-12-20T00:00:00-05:00","allDay":"Day Event","venue":{"name":"Toronto (virtual)","address":"","lat":null,"lng":null},"free":false,"low":10,"high":30,"pwyc":null,"costNotes":null,"description":"This international architectural competition invites participants to design a Persian Garden Suite pavilion in Toronto. \n\nThe initiative explores cultural heritage, urban design, and innovative architecture. Detailed competition guidelines, submission criteria and timelines are available for participants.","categories":["Cultural","Other"],"presenter":"Iranian-Canadian Architects and Artists Forum ","image":null,"website":"https://www.icaaf.ca/competition","tickets":"https://www.icaaf.ca/competition"},{"id":"47e168a9-bd28-45ab-9517-7840fa994c6a","name":"A Haunting on the Hill? Halloween at Spadina","dates":[1792794600000,1792881000000,1793399400000],"start":"2026-10-23T18:30:00-04:00","end":"2026-10-30T18:30:00-04:00","allDay":"Night Event","venue":{"name":"Spadina Museum","address":"285 Spadina Rd, Toronto, ON, M5R 2V5","lat":43.679046946,"lng":-79.408181452},"free":false,"low":30,"high":null,"pwyc":null,"costNotes":null,"description":"Calling all brave detectives! The Austin family have fled their Spadina mansion in the dead of the night due to the unexplained and uncanny disturbances that have been taking place in their ancestral home after nightfall.  Investigate this bizarre case: are these the makings of a disgruntled staff? A scorned stranger? Innocent pranks of witty neighbours? Or perhaps, the very phenomenon we fear when things go bump in the night... Follow the clues, solve the riddles, and help to decipher this most curious case.\n\nDisclaimer: This event is designed around a fictional scenario of real-life people. Event includes a talk by Ann McDougall, author of A Ghost In the Room. Topics include paranormal, occult, and death. The activities will involve puzzle-solving, unscrambling, some strong scents, light effects. The museum will be in low-light conditions and require guests to navigate through narrow pathways. For ages 13+.","categories":["History","Museum","Talks","Halloween"],"presenter":null,"image":"gUDKLMZPNIIrnLM377mJuQ","website":"https://toronto.ca/spadina","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/44a643b9-ae16-4669-ba0f-1d54db9c62be"},{"id":"00372fbc-0a46-47e6-a48a-b54bbace1d25","name":"Wonderland Road by Carrianne Leung – By the Lake Book Club","dates":[1828224000000],"start":"2027-12-07T19:00:00-05:00","end":"2027-12-07T19:00:00-05:00","allDay":"Night Event","venue":{"name":"Assembly Hall","address":"1 Colonel Samuel Smith Park Dr, Etobicoke, ON, M8V 4B6","lat":43.597660441,"lng":-79.515824559},"free":false,"low":10,"high":21,"pwyc":null,"costNotes":null,"description":"Presented by: City of Toronto’s Assembly Hall, Humber Polytechnic’s Faculty of Media, Creative Arts and Design\n\nWonderland Road is a dystopian novel set in a near future shaped by uncertainty, where three lives intertwine in a neighbourhood struggling to endure loss, isolation and change. Through characters searching for safety and connection, Carrianne Leung explores survival, community, family and hope in an unpredictable world. In conversation, she'll speak about the ideas that sparked the novel and how resilience, compassion and human connection emerge throughout the story.\n\nBy the Lake Book Club offers six Tuesday-night events, between February and December featuring leading Canadian authors in conversation with Humber Polytechnics alumni. Each in-person event includes a reading, discussion, audience Q&A, book-signing and American sign language interpretation. Virtual events are subtitled live.\n","categories":["Literary","Talks"],"presenter":null,"image":"e8RR4B7wlgk8ioYlvAucQQ","website":"https://toronto.ca/BookClub","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/084a6d2b-8730-4643-90e0-9a2be6b977ec"},{"id":"6f5d2569-b40e-44ee-ae87-8ca2e8edbb20","name":"Seven Heavens Away by Ashraf Zaghal – By the Lake Book Club","dates":[1807657200000],"start":"2027-04-13T19:00:00-04:00","end":"2027-04-13T19:00:00-04:00","allDay":"Night Event","venue":{"name":"Assembly Hall","address":"1 Colonel Samuel Smith Park Dr, Etobicoke, ON, M8V 4B6","lat":43.597660441,"lng":-79.515824559},"free":false,"low":10,"high":28,"pwyc":null,"costNotes":null,"description":"Presented by: City of Toronto’s Assembly Hall, Humber Polytechnic’s Faculty of Media, Creative Arts and Design\n\nSeven Heavens Away is a coming-of-age novel set in Jerusalem, following a Palestinian teenager grappling with grief, identity and belonging after a close friend's death amid escalating violence. Navigating family, friendship and a complicated bond with a Jewish girl, he confronts hard questions about loss, hope and the future. Ashraf Zaghal will reflect on the novel's creative process, writing about memory and displacement, and how his characters illuminate identity, community and resilience.\n\nBy the Lake Book Club offers six Tuesday-night events, between February and December featuring leading Canadian authors in conversation with Humber Polytechnics alumni. Each in-person event includes a reading, discussion, audience Q&A, book-signing and American sign language interpretation. Virtual events are subtitled live.","categories":["Literary","Talks"],"presenter":null,"image":"ejg68c81vEna8sUvd0oLXw","website":"https://toronto.ca/BookClub","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/1f02cd39-1e2b-420f-b5e9-ec0bb3f0bab4"},{"id":"6ec34be6-79f7-4394-be7d-e980d83ba6d4","name":"Always In Fashion","dates":[1789574400000,1789660800000,1789747200000,1789833600000,1789920000000,1790179200000,1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000],"start":"2026-09-16T12:00:00-04:00","end":"2027-01-03T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Curated by Amber-Dawn Bear Robe, enjoy an immersive exploration of Indigenous design languages and their transformative impact on the fashion landscape of the lands we call Canada and the United States. \n\nThis exhibition emerges from the urgent need to recognize and celebrate Indigenous designers who are reshaping the industry by reclaiming cultural narratives, innovating with ancestral techniques, and challenging colonial frameworks within fashion. \n\nThrough research on Indigenous fashion history, cultural sustainability, and decolonial design practices, the exhibition highlights how contemporary Indigenous couturiers blend ancestral knowledge with cutting-edge innovation to redefine fashion on their own terms.\n\n","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"azAuMTKhii0Yt5PF3WwMYg","website":"https://textilemuseum.ca/event/always-in-fashion/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"aecd1a46-2d19-48bb-bb99-840c2c3da607","name":"Sala-Manca Group: Like a Bird’s Nest","dates":[1790204400000,1790269200000,1790352000000,1790438400000,1790524800000,1790787600000,1790874000000,1790956800000,1791043200000,1791129600000,1791392400000,1791478800000,1791561600000,1791648000000,1791734400000,1791997200000,1792083600000,1792166400000,1792252800000,1792339200000,1792602000000,1792688400000,1792771200000,1792857600000,1792944000000,1793206800000,1793293200000,1793376000000,1793462400000,1793552400000,1793815200000,1793901600000,1793984400000,1794070800000,1794157200000,1794420000000,1794506400000,1794589200000,1794675600000,1794762000000,1795024800000,1795111200000,1795194000000,1795280400000,1795366800000,1795629600000,1795716000000,1795798800000,1795885200000,1795971600000],"start":"2026-09-23T19:00:00-04:00","end":"2026-11-29T12:00:00-05:00","allDay":"Day Event","venue":{"name":"PIX FILM Gallery","address":"1411 Dufferin St, Toronto, ON, M6H 4C7","lat":43.670941,"lng":-79.439848},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy a landmark retrospective from the international artist collective, the Sala-Manca Group.\n\nInstallation, video and photography are exhibited together for the first time, all connected to the ritual object of the sukkah, a temporary hut traditionally erected during the Jewish festival of Sukkot.\n\nOver the last twenty years, Sala-Manca has explored the symbolism and function of the sukkah and related themes of shelter, impermanence, displacement, and liberation. In their hands, the sukkah is interchangeably a ritual structure, an ethnographic object, a work of art, an ephemeral monument, a site of protest, and a performative arena. \n\nThis exhibition traverses unlikely geographies, travelling through time and place, from a small town in Germany where no Jews remain to a Jahalin Bedouin community in Khan al-Ahmar; from the contested streets of Jerusalem to the fraught landscapes of Ontario. ","categories":["Arts/Exhibits","Cultural","Talks"],"presenter":"Fentster Gallery","image":"T7PtQvwfAsgTqCPeW8LzYw","website":"https://fentster.org/birds-nest","tickets":null},{"id":"7641e799-03c8-4ff8-98bd-68e534742177","name":"Sala-Manca Group: Like a Bird’s Nest","dates":[1790204400000,1790269200000,1790352000000,1790438400000,1790524800000,1790787600000,1790874000000,1790956800000,1791043200000,1791129600000,1791392400000,1791478800000,1791561600000,1791648000000,1791734400000,1791997200000,1792083600000,1792166400000,1792252800000,1792339200000,1792602000000,1792688400000,1792771200000,1792857600000,1792944000000,1793206800000,1793293200000,1793376000000,1793462400000,1793552400000,1793815200000,1793901600000,1793984400000,1794070800000,1794157200000,1794420000000,1794506400000,1794589200000,1794675600000,1794762000000,1795024800000,1795111200000,1795194000000,1795280400000,1795366800000,1795629600000,1795716000000,1795798800000,1795885200000,1795971600000],"start":"2026-09-23T19:00:00-04:00","end":"2026-11-29T12:00:00-05:00","allDay":"Day Event","venue":{"name":"PIX FILM Gallery","address":"1411 Dufferin St, Toronto, ON, M6H 4C7","lat":43.670941,"lng":-79.439848},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy a landmark retrospective from the international artist collective, the Sala-Manca Group.\n\nInstallation, video and photography are exhibited together for the first time, all connected to the ritual object of the sukkah, a temporary hut traditionally erected during the Jewish festival of Sukkot.\n\nOver the last twenty years, Sala-Manca has explored the symbolism and function of the sukkah and related themes of shelter, impermanence, displacement, and liberation. In their hands, the sukkah is interchangeably a ritual structure, an ethnographic object, a work of art, an ephemeral monument, a site of protest, and a performative arena. \n\nThis exhibition traverses unlikely geographies, travelling through time and place, from a small town in Germany where no Jews remain to a Jahalin Bedouin community in Khan al-Ahmar; from the contested streets of Jerusalem to the fraught landscapes of Ontario. ","categories":["Arts/Exhibits","Cultural","Talks"],"presenter":"Fentster Gallery","image":"T7PtQvwfAsgTqCPeW8LzYw","website":"https://fentster.org/birds-nest","tickets":null},{"id":"f0122904-e6ab-4c32-a7c4-f32176ed1821","name":"Tales of the Damned: Immersive Theatre Experience","dates":[1792020600000,1792193400000,1792279200000,1792366200000,1792539000000,1792625400000,1792798200000,1792884600000,1792971000000,1793143800000,1793230200000,1793403000000,1793498400000,1793579400000],"start":"2026-10-14T19:30:00-04:00","end":"2026-11-01T19:30:00-05:00","allDay":"Night Event","venue":{"name":"Campbell House Museum","address":"160 Queen St W, Toronto, ON, M5H 3H3","lat":43.651058,"lng":-79.387322},"free":false,"low":42.15,"high":54.99,"pwyc":null,"costNotes":null,"description":"Experience a bone-chilling Halloween tradition!\n\nFrom the creators of the immersive sensations “Tales of the Grotesque” (2023, 2024) and the landmark production of “Tales of the Damned” (2025) comes the revival of Toronto’s favourite gothic horror anthology. \n\nWith fresh characters, familiar tales, and its twisted brand of terror, this site-specific theatrical experience brings literature’s most depraved characters to life and death. \n\nAfter a lady of the night is murdered, a mad doctor strikes a pact with the Devil to raise her from the dead. But all hell breaks loose when he comes face-to-face with her killer at a masquerade. Descend into madness with Victor Frankenstein, Henry Jekyll, and Dorian Gray to discover the results of playing God, and the monstrous repercussions when the Devil comes to collect. \n\nStep into the story as you move through the candlelit Campbell House mansion to confront history's most iconic villains. Ages 14 and up, minors must be accompanied by an adult.","categories":["Live Performances","Museum","Theatre","Halloween"],"presenter":"Campbell House Museum","image":"vywbbYFbH0ca7m8NLmLaow","website":"https://www.whitemillstheatreco.com/upcoming-events-1","tickets":"https://www.whitemillstheatreco.com/upcoming-events-1"},{"id":"5801ed7f-26dc-403a-9179-778d2176560f","name":"Tales of the Damned: Immersive Theatre Experience","dates":[1792020600000,1792193400000,1792279200000,1792366200000,1792539000000,1792625400000,1792798200000,1792884600000,1792971000000,1793143800000,1793230200000,1793403000000,1793498400000,1793579400000],"start":"2026-10-14T19:30:00-04:00","end":"2026-11-01T19:30:00-05:00","allDay":"Night Event","venue":{"name":"Campbell House Museum","address":"160 Queen St W, Toronto, ON, M5H 3H3","lat":43.651058,"lng":-79.387322},"free":false,"low":42.15,"high":54.99,"pwyc":null,"costNotes":null,"description":"Experience a bone-chilling Halloween tradition!\n\nFrom the creators of the immersive sensations “Tales of the Grotesque” (2023, 2024) and the landmark production of “Tales of the Damned” (2025) comes the revival of Toronto’s favourite gothic horror anthology. \n\nWith fresh characters, familiar tales, and its twisted brand of terror, this site-specific theatrical experience brings literature’s most depraved characters to life and death. \n\nAfter a lady of the night is murdered, a mad doctor strikes a pact with the Devil to raise her from the dead. But all hell breaks loose when he comes face-to-face with her killer at a masquerade. Descend into madness with Victor Frankenstein, Henry Jekyll, and Dorian Gray to discover the results of playing God, and the monstrous repercussions when the Devil comes to collect. \n\nStep into the story as you move through the candlelit Campbell House mansion to confront history's most iconic villains. Ages 14 and up, minors must be accompanied by an adult.","categories":["Live Performances","Museum","Theatre","Halloween"],"presenter":"Campbell House Museum","image":"vywbbYFbH0ca7m8NLmLaow","website":"https://www.whitemillstheatreco.com/upcoming-events-1","tickets":"https://www.whitemillstheatreco.com/upcoming-events-1"},{"id":"e0dd97e4-725e-4580-ad02-ed1b501e1b7b","name":"Tales of the Damned: Immersive Theatre Experience","dates":[1792020600000,1792193400000,1792279200000,1792366200000,1792539000000,1792625400000,1792798200000,1792884600000,1792971000000,1793143800000,1793230200000,1793403000000,1793498400000,1793579400000],"start":"2026-10-14T19:30:00-04:00","end":"2026-11-01T19:30:00-05:00","allDay":"Night Event","venue":{"name":"Campbell House Museum","address":"160 Queen St W, Toronto, ON, M5H 3H3","lat":43.651058,"lng":-79.387322},"free":false,"low":42.15,"high":54.99,"pwyc":null,"costNotes":null,"description":"Experience a bone-chilling Halloween tradition!\n\nFrom the creators of the immersive sensations “Tales of the Grotesque” (2023, 2024) and the landmark production of “Tales of the Damned” (2025) comes the revival of Toronto’s favourite gothic horror anthology. \n\nWith fresh characters, familiar tales, and its twisted brand of terror, this site-specific theatrical experience brings literature’s most depraved characters to life and death. \n\nAfter a lady of the night is murdered, a mad doctor strikes a pact with the Devil to raise her from the dead. But all hell breaks loose when he comes face-to-face with her killer at a masquerade. Descend into madness with Victor Frankenstein, Henry Jekyll, and Dorian Gray to discover the results of playing God, and the monstrous repercussions when the Devil comes to collect. \n\nStep into the story as you move through the candlelit Campbell House mansion to confront history's most iconic villains. Ages 14 and up, minors must be accompanied by an adult.","categories":["Live Performances","Museum","Theatre","Halloween"],"presenter":"Campbell House Museum","image":"vywbbYFbH0ca7m8NLmLaow","website":"https://www.whitemillstheatreco.com/upcoming-events-1","tickets":"https://www.whitemillstheatreco.com/upcoming-events-1"},{"id":"58c04be4-874f-40e7-96d6-a2561c1d839a","name":"Tales of the Damned: Immersive Theatre Experience","dates":[1792020600000,1792193400000,1792279200000,1792366200000,1792539000000,1792625400000,1792798200000,1792884600000,1792971000000,1793143800000,1793230200000,1793403000000,1793498400000,1793579400000],"start":"2026-10-14T19:30:00-04:00","end":"2026-11-01T19:30:00-05:00","allDay":"Night Event","venue":{"name":"Campbell House Museum","address":"160 Queen St W, Toronto, ON, M5H 3H3","lat":43.651058,"lng":-79.387322},"free":false,"low":42.15,"high":54.99,"pwyc":null,"costNotes":null,"description":"Experience a bone-chilling Halloween tradition!\n\nFrom the creators of the immersive sensations “Tales of the Grotesque” (2023, 2024) and the landmark production of “Tales of the Damned” (2025) comes the revival of Toronto’s favourite gothic horror anthology. \n\nWith fresh characters, familiar tales, and its twisted brand of terror, this site-specific theatrical experience brings literature’s most depraved characters to life and death. \n\nAfter a lady of the night is murdered, a mad doctor strikes a pact with the Devil to raise her from the dead. But all hell breaks loose when he comes face-to-face with her killer at a masquerade. Descend into madness with Victor Frankenstein, Henry Jekyll, and Dorian Gray to discover the results of playing God, and the monstrous repercussions when the Devil comes to collect. \n\nStep into the story as you move through the candlelit Campbell House mansion to confront history's most iconic villains. Ages 14 and up, minors must be accompanied by an adult.","categories":["Live Performances","Museum","Theatre","Halloween"],"presenter":"Campbell House Museum","image":"vywbbYFbH0ca7m8NLmLaow","website":"https://www.whitemillstheatreco.com/upcoming-events-1","tickets":"https://www.whitemillstheatreco.com/upcoming-events-1"},{"id":"cb69df8e-3c74-41a3-8766-d9d02c9bb406","name":"Tales of the Damned: Immersive Theatre Experience","dates":[1792020600000,1792193400000,1792279200000,1792366200000,1792539000000,1792625400000,1792798200000,1792884600000,1792971000000,1793143800000,1793230200000,1793403000000,1793498400000,1793579400000],"start":"2026-10-14T19:30:00-04:00","end":"2026-11-01T19:30:00-05:00","allDay":"Night Event","venue":{"name":"Campbell House Museum","address":"160 Queen St W, Toronto, ON, M5H 3H3","lat":43.651058,"lng":-79.387322},"free":false,"low":42.15,"high":54.99,"pwyc":null,"costNotes":null,"description":"Experience a bone-chilling Halloween tradition!\n\nFrom the creators of the immersive sensations “Tales of the Grotesque” (2023, 2024) and the landmark production of “Tales of the Damned” (2025) comes the revival of Toronto’s favourite gothic horror anthology. \n\nWith fresh characters, familiar tales, and its twisted brand of terror, this site-specific theatrical experience brings literature’s most depraved characters to life and death. \n\nAfter a lady of the night is murdered, a mad doctor strikes a pact with the Devil to raise her from the dead. But all hell breaks loose when he comes face-to-face with her killer at a masquerade. Descend into madness with Victor Frankenstein, Henry Jekyll, and Dorian Gray to discover the results of playing God, and the monstrous repercussions when the Devil comes to collect. \n\nStep into the story as you move through the candlelit Campbell House mansion to confront history's most iconic villains. Ages 14 and up, minors must be accompanied by an adult.","categories":["Live Performances","Museum","Theatre","Halloween"],"presenter":"Campbell House Museum","image":"vywbbYFbH0ca7m8NLmLaow","website":"https://www.whitemillstheatreco.com/upcoming-events-1","tickets":"https://www.whitemillstheatreco.com/upcoming-events-1"},{"id":"1dccfca5-0569-45cd-8c74-247ccb040dbe","name":"Mônica Freire","dates":[1792281600000],"start":"2026-10-17T20:00:00-04:00","end":"2026-10-17T20:00:00-04:00","allDay":"Night Event","venue":{"name":"Spadina Theatre","address":"24 Spadina Rd, Toronto, ON, M5R 2S7","lat":43.668766739,"lng":-79.405189671},"free":false,"low":14.33,"high":20.75,"pwyc":null,"costNotes":null,"description":"Join us at Spadina Theatre for a vibrant world music concert with Mônica Freire, winner of the 2024 Félix Award, Quebec's most prestigious music prize.\n\nMônica Freire brings together her native Brazil and her Middle Eastern roots in her concert Ilhada. Weaving together Brazilian guitar, oriental percussion and strings, she delivers a joyful and powerful blend of music and poetry. Enjoy a celebration of encounters, sung in Portuguese and French.\n\nFeaturing Mônica Freire (voice, guitar), Nizar Tabcharani (qanun) and Joseph Khoury (percussion).","categories":["Live Performances","Music"],"presenter":null,"image":"7Oo4D5y1jDjpy8rTu4dcTw","website":"https://www.alliance-francaise.ca/en/