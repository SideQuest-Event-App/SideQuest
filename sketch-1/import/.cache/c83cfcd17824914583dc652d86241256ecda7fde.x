200000,1792245600000,1792332000000],"start":"2026-09-19T10:00:00-04:00","end":"2026-10-18T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Wychwood Theatre","address":"76 Wychwood Ave studio 176, Toronto, ON","lat":43.680031,"lng":-79.423389},"free":false,"low":30.49,"high":35.49,"pwyc":null,"costNotes":"\nReseller tickets will not be accepted.\n\nPhoto-op with the cast after the show included with every purchase. ","description":"When Rainbow Fish refuses to share their vibrant, shimmering scales, the whole ocean seems to turn against the vain creature. Unhappy that no one adores them anymore, the Rainbow Fish seeks out the wise Octopus, who helps the fish learn that it's far better to be admired for being kind than for being beautiful. \n\nJoin us for this kids-friendly musical performance and immerse yourself in the ocean!\n\n","categories":["Family/Children","Live Performances","Theatre"],"presenter":null,"image":null,"website":"https://tickets.ticketwise.com/event/rainbow-fish-musical-2026","tickets":"https://tickets.ticketwise.com/event/rainbow-fish-musical-2026"},{"id":"e76fda71-74ca-4da7-a7b2-5db05860bb3e","name":"The Rainbow Fish Musical","dates":[1789826400000,1789912800000,1790431200000,1790517600000,1791036000000,1791122400000,1791640800000,1791727200000,1792245600000,1792332000000],"start":"2026-09-19T10:00:00-04:00","end":"2026-10-18T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Wychwood Theatre","address":"76 Wychwood Ave studio 176, Toronto, ON","lat":43.680031,"lng":-79.423389},"free":false,"low":30.49,"high":35.49,"pwyc":null,"costNotes":"\nReseller tickets will not be accepted.\n\nPhoto-op with the cast after the show included with every purchase. ","description":"When Rainbow Fish refuses to share their vibrant, shimmering scales, the whole ocean seems to turn against the vain creature. Unhappy that no one adores them anymore, the Rainbow Fish seeks out the wise Octopus, who helps the fish learn that it's far better to be admired for being kind than for being beautiful. \n\nJoin us for this kids-friendly musical performance and immerse yourself in the ocean!\n\n","categories":["Family/Children","Live Performances","Theatre"],"presenter":null,"image":null,"website":"https://tickets.ticketwise.com/event/rainbow-fish-musical-2026","tickets":"https://tickets.ticketwise.com/event/rainbow-fish-musical-2026"},{"id":"0d0f3a1c-385f-45d8-92f0-ae5f7d798d35","name":"Hallowmas Market","dates":[1791644400000],"start":"2026-10-10T11:00:00-04:00","end":"2026-10-10T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Ground Control","address":"1279 Queen Street West","lat":43.641106,"lng":-79.4336},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":"\nATM on-site.","description":"Trick… or Treat?\n\nWe have the treats, with over 35 vendors selling the coolest, spookiest, weirdest creations, just in time for the best day of the year!\n\nDog-friendly and children-friendly. Also enjoy a beverage while you shop!\n","categories":["Arts/Exhibits","Artisan","Cultural","Halloween"],"presenter":null,"image":"yjecCboIiAZUpDXFYk90cg","website":"https://www.torontodarkartsmarket.com/","tickets":null},{"id":"7dc6dd06-f201-401d-a853-ccc61c344a2c","name":"New Music Concerts: Blackout In Vain","dates":[1800835200000,1800842400000],"start":"2027-01-24T19:00:00-05:00","end":"2027-01-24T21:00:00-05:00","allDay":"Night Event","venue":{"name":"Temerty Theatre","address":"273 Bloor St W, Toronto, ON, M5S 1W2","lat":43.667856304,"lng":-79.396058814},"free":false,"low":21,"high":40,"pwyc":null,"costNotes":null,"description":"For 55 years, New Music Concerts has been one of Canada’s leading forces in contemporary music. \n\nWidely hailed as the first masterpiece of the 21st century, Georg Friedrich Haas’s in vain is one of the most admired works of our time. \n\nPerformed by a group of Toronto’s top professional musicians, this extraordinary piece transforms sound into a living, shifting landscape of microtonal colour. At its centre is a breathtaking 20-minute passage where the audience is plunged into total blackout.\n\n","categories":["Live Performances","Music"],"presenter":null,"image":"hreRCrJgiTEInNDqpM7W3w","website":"https://www.rcmusic.com/concert/new-music-concerts-blackout-in-vain-454001","tickets":"https://www.rcmusic.com/tickets/"},{"id":"307746ad-9e71-4ce2-b2dc-c4fdf5e55a82","name":"SHADE by Jordan Shaw at Budapest Park","dates":[1787716800000,1787803200000,1787889600000,1787976000000,1788062400000,1788148800000,1788235200000,1788321600000,1788408000000,1788494400000,1788580800000,1788667200000,1788753600000,1788840000000,1788926400000,1789012800000,1789099200000,1789185600000,1789272000000,1789358400000,1789444800000,1789531200000,1789617600000,1789704000000,1789790400000,1789876800000,1789963200000,1790049600000,1790136000000,1790222400000,1790308800000,1790395200000,1790481600000,1790568000000,1790654400000,1790740800000,1790827200000,1790913600000,1791000000000,1791086400000,1791172800000,1791259200000,1791345600000,1791432000000,1791518400000,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000],"start":"2026-08-26T00:00:00-04:00","end":"2026-10-15T00:00:00-04:00","allDay":"Day Event","venue":{"name":"Budapest Park","address":"1575 Lake Shore Blvd W, Toronto, ON, M6R 1B5","lat":43.636828816,"lng":-79.446436254},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"At first, Shade appears as a series of aluminum lattice structures: geometric, quiet, casting patterns across the grass. Spend a few minutes observing and something shifts — the shadows have moved. As you move around the structures, perspectives change. What becomes clear is that the work has two authors — you and the sun. The sun continues its arc regardless, changing the work's shadows and presence throughout the day. Shade is analog interactivity in its most elemental form — a reminder that we move through a world that is constantly changing, independent of us. We bring our presence, our attention, our memory and the world brings everything else.\n\nJordan Shaw is a Toronto-based artist and creative technologist whose practice explores data as material, he works across sculpture, installation, light and textile. His public artworks have been installed at Ontario Place, the City of Pickering and municipalities across Canada. ","categories":["Arts/Exhibits"],"presenter":null,"image":"B4ojJZhax41imauSMd6vvg","website":null,"tickets":null},{"id":"709a7e09-e813-4561-963f-6267af30634d","name":"SHADE by Jordan Shaw at Budapest Park","dates":[1787716800000,1787803200000,1787889600000,1787976000000,1788062400000,1788148800000,1788235200000,1788321600000,1788408000000,1788494400000,1788580800000,1788667200000,1788753600000,1788840000000,1788926400000,1789012800000,1789099200000,1789185600000,1789272000000,1789358400000,1789444800000,1789531200000,1789617600000,1789704000000,1789790400000,1789876800000,1789963200000,1790049600000,1790136000000,1790222400000,1790308800000,1790395200000,1790481600000,1790568000000,1790654400000,1790740800000,1790827200000,1790913600000,1791000000000,1791086400000,1791172800000,1791259200000,1791345600000,1791432000000,1791518400000,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000],"start":"2026-08-26T00:00:00-04:00","end":"2026-10-15T00:00:00-04:00","allDay":"Day Event","venue":{"name":"Budapest Park","address":"1575 Lake Shore Blvd W, Toronto, ON, M6R 1B5","lat":43.636828816,"lng":-79.446436254},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"At first, Shade appears as a series of aluminum lattice structures: geometric, quiet, casting patterns across the grass. Spend a few minutes observing and something shifts — the shadows have moved. As you move around the structures, perspectives change. What becomes clear is that the work has two authors — you and the sun. The sun continues its arc regardless, changing the work's shadows and presence throughout the day. Shade is analog interactivity in its most elemental form — a reminder that we move through a world that is constantly changing, independent of us. We bring our presence, our attention, our memory and the world brings everything else.\n\nJordan Shaw is a Toronto-based artist and creative technologist whose practice explores data as material, he works across sculpture, installation, light and textile. His public artworks have been installed at Ontario Place, the City of Pickering and municipalities across Canada. ","categories":["Arts/Exhibits"],"presenter":null,"image":"B4ojJZhax41imauSMd6vvg","website":null,"tickets":null},{"id":"a55d90a8-bafb-401a-82fd-f2a41c90a409","name":"SHADE by Jordan Shaw at Budapest Park","dates":[1787716800000,1787803200000,1787889600000,1787976000000,1788062400000,1788148800000,1788235200000,1788321600000,1788408000000,1788494400000,1788580800000,1788667200000,1788753600000,1788840000000,1788926400000,1789012800000,1789099200000,1789185600000,1789272000000,1789358400000,1789444800000,1789531200000,1789617600000,1789704000000,1789790400000,1789876800000,1789963200000,1790049600000,1790136000000,1790222400000,1790308800000,1790395200000,1790481600000,1790568000000,1790654400000,1790740800000,1790827200000,1790913600000,1791000000000,1791086400000,1791172800000,1791259200000,1791345600000,1791432000000,1791518400000,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000],"start":"2026-08-26T00:00:00-04:00","end":"2026-10-15T00:00:00-04:00","allDay":"Day Event","venue":{"name":"Budapest Park","address":"1575 Lake Shore Blvd W, Toronto, ON, M6R 1B5","lat":43.636828816,"lng":-79.446436254},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"At first, Shade appears as a series of aluminum lattice structures: geometric, quiet, casting patterns across the grass. Spend a few minutes observing and something shifts — the shadows have moved. As you move around the structures, perspectives change. What becomes clear is that the work has two authors — you and the sun. The sun continues its arc regardless, changing the work's shadows and presence throughout the day. Shade is analog interactivity in its most elemental form — a reminder that we move through a world that is constantly changing, independent of us. We bring our presence, our attention, our memory and the world brings everything else.\n\nJordan Shaw is a Toronto-based artist and creative technologist whose practice explores data as material, he works across sculpture, installation, light and textile. His public artworks have been installed at Ontario Place, the City of Pickering and municipalities across Canada. ","categories":["Arts/Exhibits"],"presenter":null,"image":"B4ojJZhax41imauSMd6vvg","website":null,"tickets":null},{"id":"e6d4c2f2-2e92-401b-986e-0448d465a396","name":"Exhibition: \"Returning to Ourselves and Michael Massie: now and then\"","dates":[1788987600000,1789056000000,1789142400000,1789228800000,1789574400000,1789660800000,1789747200000,1789833600000,1790179200000,1790265600000,1790352000000,1790438400000,1790784000000,1790870400000,1790956800000,1791043200000,1791388800000,1791475200000,1791561600000,1791648000000,1791993600000,1792080000000,1792166400000,1792252800000,1792598400000,1792684800000,1792771200000,1792857600000,1793203200000,1793289600000,1793376000000,1793462400000,1793811600000,1793898000000,1793984400000,1794070800000,1794416400000,1794502800000,1794589200000,1794675600000,1795021200000,1795107600000,1795194000000,1795280400000,1795626000000,1795712400000,1795798800000,1795885200000,1796230800000,1796317200000,1796403600000,1796490000000,1796835600000,1796922000000,1797008400000,1797094800000,1797440400000,1797526800000,1797613200000,1797699600000,1798045200000,1798131600000,1798218000000,1798304400000,1798650000000,1798736400000,1798822800000,1798909200000,1799254800000,1799341200000,1799427600000,1799514000000,1799859600000,1799946000000,1800032400000,1800118800000,1800464400000,1800550800000,1800637200000,1800723600000,1801069200000,1801155600000,1801242000000,1801328400000],"start":"2026-09-09T17:00:00-04:00","end":"2027-01-30T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Onsite Gallery","address":"199 Richmond St W, Toronto, ON, M5V 0H4","lat":43.649477,"lng":-79.388341},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Please join us at the 'Returning to Ourselves - Rebecca Baird and Kenny Alvin Baird: A Retrospective of Art and Design by Cree Métis Siblings'. Curated by Lisa Deanne Smith.\n\nThis exhibit presents over 40 years of transformative work by Rebecca Baird and Kenny Alvin Baird. The exhibition spans sculpture, painting and traditional material practices, alongside interior design and more.\n\n'Michael Massie: now and then' brings together works from across his career, including a large collection of teapots, previously unexhibited pieces and a new body of large-scale sculptural installations, to celebrate the enduring importance of joy, experimentation and humour in his work. Guest-curated by Alysa Procida and enjoy our Special Projects Gallery.","categories":["Arts/Exhibits","Artisan","Cultural"],"presenter":null,"image":null,"website":"https://www.ocadu.ca/events-and-exhibitions/michael-massie-now-and-then","tickets":"https://www.eventbrite.ca/e/opening-reception-returning-to-ourselves-michael-massie-now-and-then-tickets-1997059101532?aff=ebdsoporgprofile"},{"id":"a68c4425-1004-4f0e-bf49-24aaaa24ac18","name":"Exhibition: \"Returning to Ourselves and Michael Massie: now and then\"","dates":[1788987600000,1789056000000,1789142400000,1789228800000,1789574400000,1789660800000,1789747200000,1789833600000,1790179200000,1790265600000,1790352000000,1790438400000,1790784000000,1790870400000,1790956800000,1791043200000,1791388800000,1791475200000,1791561600000,1791648000000,1791993600000,1792080000000,1792166400000,1792252800000,1792598400000,1792684