1789738200000,1790170200000,1790343000000,1790775000000,1790947800000,1791379800000,1791552600000,1791984600000,1792157400000],"start":"2026-09-16T09:30:00-04:00","end":"2026-10-16T09:30:00-04:00","allDay":"Day Event","venue":{"name":"Cedar Ridge Creative Centre","address":"225 Confederation Dr, Scarborough, ON, M1G 1B2","lat":43.75743,"lng":-79.207132},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join Mural Routes for a free multi-session mosaic art workshop series for older adults. Led by mosaic mural artist Cristina Delago, participants will learn mosaic-making techniques, create a personalized artwork to take home, and contribute to a larger community mosaic installation. A final culminating event held on October 23 will take place after workshops are complete to celebrate all participants and what they have accomplished.\n\nThe project is delivered through two separate cohorts running concurrently at different locations. Please ensure you select your intended workshop series (cohort), as each cohort has its own location and schedule. All materials are provided and advance registration is required.\n\nA City of Toronto Cultural Hotspot Signature Project.","categories":["Arts/Exhibits","Seminars/Workshops"],"presenter":"Mural Routes","image":"i2SMsQnvkRtaYNfLbdOTrw","website":"https://muralroutes.ca/mosaics-for-seniors-2026-cedarridge/","tickets":"https://muralroutes.ca/mosaics-for-seniors-2026-cedarridge/"},{"id":"978d7179-97f0-4061-addc-160392efe81c","name":"Piece by Piece: Mosaics for Seniors at Cedar Ridge Creative Centre","dates":[1789565400000,1789738200000,1790170200000,1790343000000,1790775000000,1790947800000,1791379800000,1791552600000,1791984600000,1792157400000],"start":"2026-09-16T09:30:00-04:00","end":"2026-10-16T09:30:00-04:00","allDay":"Day Event","venue":{"name":"Cedar Ridge Creative Centre","address":"225 Confederation Dr, Scarborough, ON, M1G 1B2","lat":43.75743,"lng":-79.207132},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join Mural Routes for a free multi-session mosaic art workshop series for older adults. Led by mosaic mural artist Cristina Delago, participants will learn mosaic-making techniques, create a personalized artwork to take home, and contribute to a larger community mosaic installation. A final culminating event held on October 23 will take place after workshops are complete to celebrate all participants and what they have accomplished.\n\nThe project is delivered through two separate cohorts running concurrently at different locations. Please ensure you select your intended workshop series (cohort), as each cohort has its own location and schedule. All materials are provided and advance registration is required.\n\nA City of Toronto Cultural Hotspot Signature Project.","categories":["Arts/Exhibits","Seminars/Workshops"],"presenter":"Mural Routes","image":"i2SMsQnvkRtaYNfLbdOTrw","website":"https://muralroutes.ca/mosaics-for-seniors-2026-cedarridge/","tickets":"https://muralroutes.ca/mosaics-for-seniors-2026-cedarridge/"},{"id":"d9a14409-e4dd-4639-a9e6-1f9518b1e1e9","name":"Paddleboarding at Biidaasige Park","dates":[1789223400000,1789828200000,1790433000000,1791037800000],"start":"2026-09-12T10:30:00-04:00","end":"2026-10-03T10:30:00-04:00","allDay":"Day Event","venue":{"name":"Biidaasige Park ","address":"51 Commissioners St, Toronto, ON, M5A 1A6","lat":43.646495807,"lng":-79.348925214},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":"Please register using the correct link below:\nSat September 12 Paddleboarding\n10:30 am, 12:30 pm - https://www.eventbrite.ca/e/1999636049252\nSat September 19 Paddleboarding\n10:30 am, 12:30 pm - https://www.eventbrite.ca/e/1999638061270\nSat September 26 Paddleboarding\n10:30 am, 12:30 pm - https://www.eventbrite.ca/e/1999638111420\n\n","description":"Get out on the water and experience Biidaasige Park from a whole new perspective! Join Don’t Mess with the Don for a fun and refreshing paddleboarding adventure along Toronto’s stunning new waterfront park. Whether you’re a first-timer or an experienced paddler, this is a great way to connect with nature, enjoy the river, and take in the park’s unique landscapes from the water. All equipment is provided, including a paddleboard, paddle, and personal flotation device (PFD). \n\nParticipants will have up to 1.5 hours to explore at their own pace. Please wear weather-appropriate clothing and water shoes, and bring water to stay hydrated. Recommended for ages 12+. \n\nCome discover the beauty of Biidaasige Park, build confidence on the water, and enjoy an unforgettable summer morning outdoors!","categories":["Environmental","Sports","Tour"],"presenter":null,"image":"L4b1C942bMoMQdF9ic2Ofw","website":"https://www.dontmesswiththedon.ca/","tickets":"https://www.eventbrite.ca/e/1998641932823"},{"id":"2292e5cf-9935-4284-9344-546d15b87831","name":"Retracing Tatreez: Palestinian Thobes through the Twentieth Century","dates":[1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000,1799254800000,1799341200000,1799427600000,1799514000000,1799600400000,1799859600000,1799946000000,1800032400000,1800118800000,1800205200000,1800464400000,1800550800000,1800637200000,1800723600000,1800810000000,1801069200000,1801155600000,1801242000000,1801328400000,1801414800000,1801674000000,1801760400000,1801846800000,1801933200000,1802019600000],"start":"2026-09-24T12:00:00-04:00","end":"2027-02-07T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":"\nChildren 5 and under visit for free.","description":"Featuring several examples of Palestinian tatreez (embroidery) from the Textile Museum’s collection, most of which will be exhibited for the first time! \n\nRetracing Tatreez highlights what these belongings can tell us about the relationship between Palestinians and their homelands in the twentieth century and beyond.\n\nIn this exhibition, curator Nina Rafique showcases these pieces with restored historical context and invites visitors to re-engage with their ways of storytelling. \n\nIn doing so, Retracing Tatreez highlights what these embroideries can tell us about the unique regional connections between Palestinians and their homelands, as well as the journeys of these objects from the hands of their original creators to today.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"j37-eBOZLJMeQ8B7zUJpJg","website":"https://textilemuseum.ca/event/retracing-tatreez-palestinian-thobes-through-the-20th-century/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"29d2bb12-2246-448b-909d-ba91025e559d","name":"Always In Fashion","dates":[1789574400000,1789660800000,1789747200000,1789833600000,1789920000000,1790179200000,1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000],"start":"2026-09-16T12:00:00-04:00","end":"2027-01-03T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Curated by Amber-Dawn Bear Robe, enjoy an immersive exploration of Indigenous design languages and their transformative impact on the fashion landscape of the lands we call Canada and the United States. \n\nThis exhibition emerges from the urgent need to recognize and celebrate Indigenous designers who are reshaping the industry by reclaiming cultural narratives, innovating with ancestral techniques, and challenging colonial frameworks within fashion. \n\nThrough research on Indigenous fashion history, cultural sustainability, and decolonial design practices, the exhibition highlights how contemporary Indigenous couturiers blend ancestral knowledge with cutting-edge innovation to redefine fashion on their own terms.\n\n","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"azAuMTKhii0Yt5PF3WwMYg","website":"https://textilemuseum.ca/event/always-in-fashion/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"7b1b634b-d396-4d6e-b9ae-f1d754d839e1","name":"Taste of Downtown Yonge Beverage Tour","dates":[1789320600000,1789925400000,1790530200000,1791135000000,1791739800000,1792344600000,1792949400000,1793557800000,1794162600000,1794767400000,1795372200000,1795977000000,1796581800000,1797186600000,1797791400000],"start":"2026-09-13T13:30:00-04:00","end":"2026-12-20T13:30:00-05:00","allDay":"Day Event","venue":{"name":"Meeting Point: Daon Cafe","address":"475 Yonge Street, Toronto, ON M4Y 1X7","lat":43.662291,"lng":-79.383096},"free":false,"low":15,"high":null,"pwyc":null,"costNotes":null,"description":"Six drinks. Local cafés, tea shops, bakeries and neighbourhood hot spots. 90 minutes of discovery.\n\nExplore Downtown Yonge in a whole new way with a special beverage focus.\n\nYou’ll visit a selection of 6 local cafés, tea shops, bakeries and neighbourhood hot spots, sampling six different beverages along the way. Discover hidden gems, hear some of the stories behind the neighbourhood, and find places you may never have thought to try.\n\nIt’s a fun, easy way to explore more of Downtown Yonge and you might just discover your next favourite spot!\n","categories":["Food/Culinary","History","Tour"],"presenter":"Downtown Yonge BIA","image":null,"website":"http://www.downtown.com/foodtours","tickets":"http://www.downtownyonge.com/foodtours"},{"id":"44eecf75-dc08-4127-a99d-1367ab8a7132","name":"Davis plays Davis and Toronto Tenor Madness","dates":[1804381200000],"start":"2027-03-06T20:00:00-05:00","end":"2027-03-06T20:00:00-05:00","allDay":"Night Event","venue":{"name":"Koerner Hall","address":"273 Bloor St W, Toronto, ON, M5S 1W2","lat":43.667856304,"lng":-79.396058814},"free":false,"low":50,"high":110,"pwyc":null,"costNotes":null,"description":"Chicago trumpet great Orbert Davis brings his acclaimed septet for a high-energy, deeply expressive tribute to Miles. Opening the evening is Toronto Tenor Madness, a powerhouse saxophone ensemble led by John Johnson.\n\nAfter the concert, enjoy a beverage and more music at the Postlude Performance in the Leslie and Anna Dan Galleria.","categories":["Live Performances","Music"],"presenter":null,"image":"SyP5Swq4JHrFfuKfM-3GlQ","website":"https://www.rcmusic.com/concert/orbert-davis-sextet-430801","tickets":"https://www.rcmusic.com/tickets/seats/430801"},{"id":"128f1173-709f-4ccb-b103-73ef3f86a2b2","name":"International Architectural Design Competition 2026-2027: Persian Garden Suite","dates":[1789444800000,1789531200000,1789617600000,1789704000000,1789790400000,1789876800000,1789963200000,1790049600000,1790136000000,1790222400000,1790308800000,1790395200000,1790481600000,1790568000000,1790654400000,1790740800000,1790827200000,1790913600000,1791000000000,1791086400000,1791172800000,1791259200000,1791345600000,1791432000000,1791518400000,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000,1792123200000,1792209600000,1792296000000,1792382400000,1792468800000,1792555200000,1792641600000,1792728000000,1792814400000,1792900800000,1792987200000,1793073600000,1793160000000,1793246400000,1793332800000,1793419200000,1793505600000,1793595600000,1793682000000,1793768400000,1793854800000,1793941200000,1794027600000,1794114000000,1794200400000,1794286800000,1794373200000,1794459600000,1794546000000,1794632400000,1794718800000,1794805200000,1794891600000,1794978000000,1795064400000,1795150800000,1795237200000,1795323600000,1795410000000,1795496400000,1795582800000,1795669200000,1795755600000,1795842000000,1795928400000,1796014800000,1796101200000,1796187600000,1796274000000,1796360400000,1796446800000,1796533200000,1796619600000,1796706000000,1796792400000,1796878800000,1796965200000,1797051600000,1797138000000,1797224400000,1797310800000,1797397200000,1797483600000,1797570000000,1797656400000,1797742800000],"start":"2026-09-15T00:00:00-04:00","end":"2026-12-20T00:00:00-05:00","allDay":"Day Event","venue":{"name":"Toronto (virtual)","address":"","lat":null,"lng":null},"free":false,"low":10,"high":30,"pwyc":null,"costNotes":null,"description":"This international architectural competition invites participants to design a Persian Garden Suite pavilion in Toronto. \n\nThe initiative explores cultural heritage, urban design, and innovative architecture. Detailed competition guidelines, submission criteria and timelines are available for participants.","categories":["Cultural","Other"],"presenter":"Iranian-Canadian Architects and Artists Forum ","image":null,"website":"https://www.icaaf.ca/competition","tickets":"https://www.icaaf.ca/competition"},{"id":"f0921cbe-733f-482b-9b31-2c9c6900ce6a","name":"Fur Ball 2026","dates":[1792339200000],"start":"2026-10-18T12:00:00-04:00","end":"2026-10-18T12:00:00-04:00","allDay":"Day Event","venue":{"name":"St. James Park","address":"120 King St E, Toronto","lat":43.65056791,"lng":-79.372573871},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join us for the Fur Ball, a Halloween dog costume contest and fashion show, and your dog is invited to strut their stuff on the stage.\n\nDress up your dog in their spookiest, silliest, or most stylish costume. Our judges will be on the lookout for the best of the best, with awesome prize packs up for grabs.\n\nPlus, some of our favourite vendors will be there selling all things dog, so bring your wallet along with your walking shoes.\n\nMark your calendars, grab your dog’s costume, and come out for a day of fun, treats, and tail wags!\n\nAwards include Best Costume, Best Pari and Most Creative Costume. \n\nCome out and have some fun!\n","categories":["Other","Halloween"],"presenter":"Old Town Toronto BIA","image":null,"website":"https://oldtowntoronto.ca/event/fur-ball-2026/","tickets":"https://docs.google.com/forms/d/e/1FAIpQLSet1A2xW_a1dakyfTyf5c3_lpUlzcs3YkQ6hhMam0MEXiaEng/viewform"},{"id":"497dd8f2-423f-4776-b4b4-34d01e82933e","name":"Tales of the Damned: Immersive Theatre Experience","dates":[1792020600000,1792193400000,1792279200000,1792366200000,1792539000000,1792625400000,1792798200000,1792884600000,1792971000000,1793143800000,1793230200000,1793403000000,1793498400000,1793579400000],"start":"2026-10-14T19:30:00-04:00","end":"2026-11-01T19:30:00-05:00","allDay":"Night Event","venue":{"name":"Campbell House Museum","address":"160 Queen St W, Toronto, ON, M5H 3H3","lat":43.651058,"lng":-79.387322},"free":false,"low":42.15,"high":54.99,"pwyc":null,"costNotes":null,"description":"Experience a bone-chilling Halloween tradition!\n\nFrom the creators of the immersive sensations “Tales of the Grotesque” (2023, 2024) and the landmark production of “Tales of the Damned” (2025) comes the revival of Toronto’s favourite gothic horror anthology. \n\nWith fresh characters, familiar tales, and its twisted brand of terror, this site-specific theatrical experience brings literature’s most depraved characters to life and death. \n\nAfter a lady of the night is murdered, a mad doctor strikes a pact with the Devil to raise her from the dead. But all hell breaks loose when he comes face-to-face with her killer at a masquerade. Descend into madness with Victor Frankenstein, Henry Jekyll, and Dorian Gray to discover the results of playing God, and the monstrous repercussions when the Devil comes to collect. \n\nStep into the story as you move through the candlelit Campbell House mansion to confront history's most iconic villains. Ages 14 and up, minors must be accompanied by an adult.","categories":["Live Performances","Museum","Theatre","Halloween"],"presenter":"Campbell House Museum","image":"vywbbYFbH0ca7m8NLmLaow","website":"https://www.whitemillstheatreco.com/upcoming-events-1","tickets":"https://www.whitemillstheatreco.com/upcoming-events-1"},{"id":"e0076229-1295-4cb9-9e73-a93c7166c7f2","name":"Historic Holiday Gingerbread Workshop at Fort York","dates":[1797696000000,1797706800000,1797782400000,1797793200000,1798041600000,1798052400000,1798128000000,1798138800000,1798387200000,1798398000000,1798646400000,1798657200000,1798732800000,1798743600000,1798905600000,1798916400000,1798992000000,1799002800000],"start":"2026-12-19T11:00:00-05:00","end":"2027-01-03T14:00:00-05:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site ","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864,"lng":-79.406315},"free":false,"low":20,"high":null,"pwyc":null,"costNotes":null,"description":"Experience the warmth of the holiday season through a hands-on baking workshop in the historic Officers' Mess Kitchen.  Children and teens aged 8 to 14 can prepare an historic recipe using traditional methods including creaming butter, pounding sugar, grating spices, sifting flour, rolling and cutting dough.  \n\nWhile the gingerbread bakes, participants can enjoy a festive scavenger hunt in the Fort and return back to the kitchen to sample their freshly baked gingerbread biscuits and take home the historic recipe to recreate in their own kitchens.  ","categories":["Food/Culinary","History","Museum","Winter Holidays"],"presenter":null,"image":"OOkRdDMZf1TJSEdlmkqvKg","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/f778e3cc-f1b6-403a-baa6-4c8276e34a34"},{"id":"3a118b3e-0741-465a-8865-484d9eee256a","name":"Rebellion Talks: Rebel Blacksmiths & Radical Farmers","dates":[1805565600000],"start":"2027-03-20T14:00:00-04:00","end":"2027-03-20T14:00:00-04:00","allDay":"Day Event","venue":{"name":"Scarborough Museum","address":"1007 Brimley Rd, Scarborough, ON, M1P 3E8","lat":43.757624474,"lng":-79.254809969},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Consider the role of rebel blacksmiths and radical farmers in the Rebellion of 1837. As the rebellion approached, the countryside around Toronto was alive with farmers running military drills and blacksmiths forging weapons. Mackenzie's rebel army would include many ordinary people from the surrounding area who found themselves swept up in the cause. Head to Scarborough Museum to learn about the role civilians played in the uprising—and how two of them found themselves at the end of a hangman's noose.\n\nFrom October 2026 to April 2027, historian Adam Bunch brings Toronto’s history to life in a series of talks exploring the Upper Canada Rebellion and its lasting impact on the city. From spies and taverns to political reform, rural rebels and the Patriot War, each talk reveals a different story connected to the museum where it takes place.","categories":["History","Museum","Talks"],"presenter":"Toronto History Museums","image":"T39P28HhN7oLepSQRlFfaw","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/scarborough-museum/","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/a2d0547e-debc-4b6a-88eb-b38f35c7249c"},{"id":"1c41d9d5-0166-4fae-9a5e-e2f4d647e89f","name":"Youth Voices Creative Workshop Series","dates":[1790200800000,1790805600000,1791410400000,1792015200000,1792620000000],"start":"2026-09-23T18:00:00-04:00","end":"2026-10-21T18:00:00-04:00","allDay":"Night Event","venue":{"name":"East Scarborough Storefront","address":"4040 Lawrence Ave E, Scarborough, ON, M1E 2R2","lat":43.766004,"lng":-79.199012},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Join a free arts-based program where youth can explore different forms of creative expression while developing original work for a community showcase. Through weekly workshops, participants will experiment with a range of artistic disciplines, build creative skills, and collaborate with peers and facilitators in a supportive environment. Through the program, youth will explore and express their experiences, identities, and perspectives through the arts. The program culminates in the Youth Voices Community Showcase, held on October 22 at Tropicana Community Services 1385 Huntingwood Dr., Scarborough, ON, M1S 3J1, where participants will share their work and celebrate the creativity of local youth.\n\nA City of Toronto Cultural Hotspot Signature Project.","categories":["Arts/Exhibits","Seminars/Workshops","Other"],"presenter":"East Scarborough Storefront","image":"P5CxD-jd5C-8DdRxgpxBRA","website":null,"tickets":null},{"id":"815ae5b9-24f8-430e-9a20-e1fd6e5423fc","name":"ConnectHER Film Festival Toronto Showcase","dates":[1793311200000],"start":"2026-10-29T18:00:00-04:00","end":"2026-10-29T18:00:00-04:00","allDay":"Night Event","venue":{"name":"TIFF Lightbox","address":"350 King St W, Toronto, ON, M5V 3X5","lat":43.646646277,"lng":-79.390400897},"free":false,"low":18,"high":null,"pwyc":null,"costNotes":null,"description":"An international short film festival that amplifies the voices of young filmmakers telling powerful stories about issues affecting women and girls around the world. \n\nNow in its fourteenth year, we have received more than 2,250 film submissions from 96 countries, celebrating authentic storytelling and its power to inspire action.\n\nFor the first time in the festival's history, ConnectHER is bringing its acclaimed program beyond Austin, Texas, with Toronto becoming the inaugural Canadian city to host!\n\nThe evening will feature a curated selection of award-winning and audience favorite short films by emerging filmmakers from Palestine, Tibet, Iran, Canada, and beyond, along with a filmmaker QnA, special guest speakers, and live performances, including writer and comedian, Nour Hadidi!\n\nJoin us for an inspiring evening of film, conversation, and music that celebrates the next generation of global storytellers.","categories":["Cultural","Film","Live Performances"],"presenter":"ConnectHER and Eloise DeJoria","image":"DiOn3xWynrersicj47dknA","website":"https://am.ticketmaster.com/tiff/buy/ConnectHER","tickets":"https://am.ticketmaster.com/tiff/buy/ConnectHER"},{"id":"10b2b4d1-264b-472c-ab5b-8fb82500132c","name":"Rebellion Talks: The Burning of the Rebel's Home","dates":[1792267200000],"start":"2026-10-17T16:00:00-04:00","end":"2026-10-17T16:00:00-04:00","allDay":"Day Event","venue":{"name":"Gibson House","address":"5172 Yonge St, North York, ON, M2N 5P6","lat":43.769686148,"lng":-79.414666941},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Dive into the history of the Rebellion of 1837 through the story of David Gibson, a surveyor who found himself playing a leading role in Mackenzie's army. From the rebel meetings held at his home to the dramatic day the government burned his house down in vengeance, learn about the failed revolution. Gather inside the famed surveyor's house for this rare opportunity to revisit the site of chaos that engulfed the city back in 1837.\n\nFrom October 2026 to April 2027, historian Adam Bunch brings Toronto’s history to life in a series of talks exploring the Upper Canada Rebellion and its lasting impact on the city. From spies and taverns to political reform, rural rebels and the Patriot War, each talk reveals a different story connected to the museum where it takes place.","categories":["History","Museum","Talks"],"presenter":"Toronto History Museums","image":"1pJicQ67_jKKT6Me4ke7Yw","website":"https://toronto.ca/gibsonhouse","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/7f14d351-4efd-47cf-bd65-0add40dbd5ef"},{"id":"3cb1eeab-a43b-4603-b9e0-c2b1686f3c37","name":"Places That Stayed: Youth Photography Exhibit","dates":[1792123200000,1792209600000,1792296000000,1792382400000,1792468800000,1792555200000,1792641600000,1792728000000,1792814400000,1792900800000,1792987200000,1793073600000,1793160000000,1793246400000,1793332800000,1793419200000,1793505600000,1793595600000,1793682000000,1793768400000,1793854800000,1793941200000,1794027600000,1794114000000,1794200400000,1794286800000,1794373200000,1794459600000,1794546000000,1794632400000,1794718800000,1794805200000,1794891600000,1794978000000,1795064400000,1795150800000,1795237200000,1795323600000,1795410000000,1795496400000,1795582800000,1795669200000,1795755600000,1795842000000,1795928400000,1796014800000],"start":"2026-10-16T00:00:00-04:00","end":"2026-11-30T00:00:00-05:00","allDay":"Day Event","venue":{"name":"East Scarborough Storefront","address":"4040 Lawrence Ave E, Scarborough, ON, M1E 2R2","lat":43.766003524,"lng":-79.199011833},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover Kingston-Galloway-Orton Park (KGO) through the eyes of local youth in this outdoor photography exhibit. Created as part of a youth placemaking and photography project, the exhibit features photographs documenting the places and spaces that make the neighbourhood unique, from familiar gathering spots and busy streets to quiet corners, overlooked landscapes, parks, and community spaces. Installed along the community garden fence at East Scarborough Storefront, the exhibit invites visitors to explore the neighbourhood through the perspectives of local youth and reflect on the places that shape community life.\n\nA City of Toronto Cultural Hotspot SPARK Project.\n","categories":["Arts/Exhibits","Cultural","Family/Children"],"presenter":"itsneerby","image":"6qUPh0-04BnPvAhTFhcOaA","website":"https://www.itsneerby.ca/","tickets":null},{"id":"2342f842-8b9b-4e19-9f93-9cd59a0b91da","name":"Trick or Tease: A Halloween-Themed Burlesque Show","dates":[1791592200000],"start":"2026-10-09T20:30:00-04:00","end":"2026-10-09T20:30:00-04:00","allDay":"Night Event","venue":{"name":"The Great Hall","address":"1087 Queen St W, Toronto, ON, M6J 1H3","lat":43.643349301,"lng":-79.422058241},"free":false,"low":25,"high":50,"pwyc":null,"costNotes":"Individual Tickets Pricing:\n$25.00 Early Bird (Only available until September 9, 2026)\n$35.00 General Admission Advance (Seating available on a first come, first served basis)\n$50.00 VIP Seating (Includes reserved seat and exclusive swag bag!)\n$45.00 at the Door (Cash only for door tickets and merch)\n\nAll tickets are non-refundable.","description":"Boo! \n\nDon't be frightened, peep in as all your favourite characters are summoned for an evening of parody burlesque inspired by classic Horror and Halloween icons of TV and Film. \n\nYou are invited to witness this ghastly cast of beloved on-screen witches, devils, monsters and more in a burlesque romp wild enough to raise spirits! So join us, we know you will SCREAM with delight and become OBSESSED! You may even leave thinking, how did they do that, it was PRACTICALLY MAGIC?! \n\nPerformances by: Forca, Honeysuckle Pussywillow, Ivory, Kage Wolfe, Majestic Maehem, Peach Blossom, Rita Ann'tique, Sonya Lex, Sweets, Tha True Original Gata, Tanya Cheex, Zilly Lilly and \nZyra Lee Vanity.\n\nHosted by Ajay Fry and Betty Quirk\n\nPlease use hashtag #peepshowto when mentioning this show on social media!\n","categories":["Live Performances","Nightlife","Theatre","Halloween"],"presenter":"PeepshowTO","image":"koSCG0qD06zpUQLCNMH1jw","website":"https://www.tickettailor.com/events/peepshowto/2353070","tickets":"https://www.tickettailor.com/events/peepshowto/2353070"},{"id":"2e0bf251-3360-461f-ba25-066ff219b0f1","name":"Taste of Downtown Yonge Beverage Tour","dates":[1789320600000,1789925400000,1790530200000,1791135000000,1791739800000,1792344600000,1792949400000,1793557800000,1794162600000,1794767400000,1795372200000,1795977000000,1796581800000,1797186600000,1797791400000],"start":"2026-09-13T13:30:00-04:00","end":"2026-12-20T13:30:00-05:00","allDay":"Day Event","venue":{"name":"Meeting Point: Daon Cafe","address":"475 Yonge Street, Toronto, ON M4Y 1X7","lat":43.662291,"lng":-79.383096},"free":false,"low":15,"high":null,"pwyc":null,"costNotes":null,"description":"Six drinks. Local cafés, tea shops, bakeries and neighbourhood hot spots. 90 minutes of discovery.\n\nExplore Downtown Yonge in a whole new way with a special beverage focus.\n\nYou’ll visit a selection of 6 local cafés, tea shops, bakeries and neighbourhood hot spots, sampling six different beverages along the way. Discover hidden gems, hear some of the stories behind the neighbourhood, and find places you may never have thought to try.\n\nIt’s a fun, easy way to explore more of Downtown Yonge and you might just discover your next favourite spot!\n","categories":["Food/Culinary","History","Tour"],"presenter":"Downtown Yonge BIA","image":null,"website":"http://www.downtown.com/foodtours","tickets":"http://www.downtownyonge.com/foodtours"},{"id":"304218a7-3469-450b-b444-67a61bf9cdc5","name":"Taste of Downtown Yonge Beverage Tour","dates":[1789320600000,1789925400000,1790530200000,1791135000000,1791739800000,1792344600000,1792949400000,1793557800000,1794162600000,1794767400000,1795372200000,1795977000000,1796581800000,1797186600000,1797791400000],"start":"2026-09-13T13:30:00-04:00","end":"2026-12-20T13:30:00-05:00","allDay":"Day Event","venue":{"name":"Meeting Point: Daon Cafe","address":"475 Yonge Street, Toronto, ON M4Y 1X7","lat":43.662291,"lng":-79.383096},"free":false,"low":15,"high":null,"pwyc":null,"costNotes":null,"description":"Six drinks. Local cafés, tea shops, bakeries and neighbourhood hot spots. 90 minutes of discovery.\n\nExplore Downtown Yonge in a whole new way with a special beverage focus.\n\nYou’ll visit a selection of 6 local cafés, tea shops, bakeries and neighbourhood hot spots, sampling six different beverages along the way. Discover hidden gems, hear some of the stories behind the neighbourhood, and find places you may never have thought to try.\n\nIt’s a fun, easy way to explore more of Downtown Yonge and you might just discover your next favourite spot!\n","categories":["Food/Culinary","History","Tour"],"presenter":"Downtown Yonge BIA","image":null,"website":"http://www.downtown.com/foodtours","tickets":"http://www.downtownyonge.com/foodtours"},{"id":"ad97767f-26ea-4897-b80c-2301e5a6f43f","name":"“Dakiimi / To have land“ by Amber Quail","dates":[1790445600000,1790690400000,1790776800000,1790863200000,1790949600000,1791036000000,1791295200000],"start":"2026-09-26T14:00:00-04:00","end":"2026-10-06T10:00:00-04:00","allDay":"Day Event","venue":{"name":"Riverdale Hub","address":"1326 Gerrard St E, Toronto, ON, M4L 1Z1","lat":43.671781866,"lng":-79.32550473},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Iconography in Western culture has been a central theme in Amber’s visual arts practice. Familiar household archetypes, reimagined through an Indigenous lens, invite viewers to consider alternate truths beyond those presented by the dominant culture.\n\nAn off-reserve member of Alderville First Nation, Amber’s practice is based in Tkaronto and South Algonquin. In Dakiimi / To Have Land, the iconic board game Monopoly serves as both an anchor and a catalyst for reflection on land theft and greed. Through vibrant beadwork, mixed-media works, and paintings, Amber explores land, ownership, power and the enduring impacts of colonialism.","categories":["Arts/Exhibits","Indigenous"],"presenter":"Riverdale Hub Gallery","image":null,"website":"https://riverdalehub.ca/dakiimi-to-have-land-an-exhibition-by-amber-smith-quail/","tickets":"https://riverdalehub.ca/gallery-event-registration/"},{"id":"de54b151-56b6-4282-825b-94c3812f7342","name":"Places That Stayed: Youth Photography Exhibit","dates":[1792123200000,1792209600000,1792296000000,1792382400000,1792468800000,1792555200000,1792641600000,1792728000000,1792814400000,1792900800000,1792987200000,1793073600000,1793160000000,1793246400000,1793332800000,1793419200000,1793505600000,1793595600000,1793682000000,1793768400000,1793854800000,1793941200000,1794027600000,1794114000000,1794200400000,1794286800000,1794373200000,1794459600000,1794546000000,1794632400000,1794718800000,1794805200000,1794891600000,1794978000000,1795064400000,1795150800000,1795237200000,1795323600000,1795410000000,1795496400000,1795582800000,1795669200000,1795755600000,1795842000000,1795928400000,1796014800000],"start":"2026-10-16T00:00:00-04:00","end":"2026-11-30T00:00:00-05:00","allDay":"Day Event","venue":{"name":"East Scarborough Storefront","address":"4040 Lawrence Ave E, Scarborough, ON, M1E 2R2","lat":43.766003524,"lng":-79.199011833},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover Kingston-Galloway-Orton Park (KGO) through the eyes of local youth in this outdoor photography exhibit. Created as part of a youth placemaking and photography project, the exhibit features photographs documenting the places and spaces that make the neighbourhood unique, from familiar gathering spots and busy streets to quiet corners, overlooked landscapes, parks, and community spaces. Installed along the community garden fence at East Scarborough Storefront, the exhibit invites visitors to explore the neighbourhood through the perspectives of local youth and reflect on the places that shape community life.\n\nA City of Toronto Cultural Hotspot SPARK Project.\n","categories":["Arts/Exhibits","Cultural","Family/Children"],"presenter":"itsneerby","image":"6qUPh0-04BnPvAhTFhcOaA","website":"https://www.itsneerby.ca/","tickets":null},{"id":"cc30724e-ed2c-40b3-8b49-e49ad0821106","name":"MULTIfest Interactive Art festival","dates":[1790888400000,1790974800000,1791061200000,1791147600000,1791234000000,1791320400000,1791406800000,1791493200000],"start":"2026-10-01T17:00:00-04:00","end":"2026-10-08T17:00:00-04:00","allDay":"Day Event","venue":{"name":"Stackt Market","address":"28 Bathurst St, Toronto, ON, M5V 0R4","lat":43.640948,"lng":-79.402169},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Toronto’s new festival of interactive and digital art, returns to STACKT Market!\n\nWe're bringing together interactive art installations, audiovisual performances and beginner-friendly workshops, alongside artist talks, family programming and community events.\n\nExplore immersive digital artworks, interact with responsive installations, experience live audiovisual performances, and get hands-on with creative technology through workshops in electronic music making, projection mapping and more.\n\nTogether with Nuit Blanche, enjoy an afternoon Show and Tell and immersive round table, followed by an Immersive Happy Hour with DJs, live visuals and interactive art.\n","categories":["Arts/Exhibits","Live Performances","Music"],"presenter":null,"image":"KoSi1GfJkywyaekelu014A","website":"https://multi-fest.ca/","tickets":null},{"id":"ba8a0c8b-cd05-4461-adbf-d8ddb7833eca","name":"Highland Creek/Morningside Park/Botany Hill Park","dates":[1792244700000],"start":"2026-10-17T09:45:00-04:00","end":"2026-10-17T09:45:00-04:00","allDay":"Day Event","venue":{"name":"Meeting outside the Curran Hall Community Centre ","address":"277 Orton Park Rd., Scarborough, ON M1G 3T4","lat":43.777299,"lng":-79.210858},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Community Clean-up of the riparian areas of Highland Creek just south of the Ellesmere Bridge, organized by the Curran Hall Community Association in collaboration with Don't Mess With The Don, Toronto Nature Stewards, Scarborough Zero Waste, and University of Toronto One Health. \n\nMeet outside of the Curran Hall Community Centre at 277 Orton Park Rd. in Scarborough. \nClean up running from 10 AM to 12:30 PM.\n\nCoffee/tea available at 9:30 AM. Bring your own mug, and reusable water bottle. \nGloves, trash bags and tools provided. \n\nBe tick aware (long pants and tops with long sleeves; light colour clothing are best).\nRubber boots are best suited for this clean up, as we will be on the creek banks.\nSome sections will be reached through steep paths. ","categories":["Environmental"],"presenter":null,"image":"zpElCyn9FxJW00Kmj6wtqw","website":"https://www.dontmesswiththedon.ca/upcoming-events","tickets":null},{"id":"8416f115-75d0-4fad-a570-de6e8f12bfda","name":"Storytime At The Park","dates":[1792245600000,1794668400000,1797087600000],"start":"2026-10-17T10:00:00-04:00","end":"2026-12-12T10:00:00-05:00","allDay":"Day Event","venue":{"name":"Downsview Park ","address":"70 Canuck Ave, North York, ON, M3K 2C5","lat":43.744269913,"lng":-79.48436452},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Perfect for families and children ages 3 to 9! \n\nEnjoy interactive read-alouds of beloved books in English and French, themed activities, nature exploration and a light snack. \n \nWe can't wait to see you soon at Downsview Park! ","categories":["Cultural","Live Performances","Other"],"presenter":null,"image":null,"website":"https://downsviewpark.ca/events/storytime-park","tickets":"https://downsviewpark.ca/events/storytime-park"},{"id":"b0be8300-4c99-41fe-9aac-5bde7e49a9f0","name":"Toronto Botanical Gardens Fall Ravine Festival","dates":[1791043200000],"start":"2026-10-03T12:00:00-04:00","end":"2026-10-03T12:00:00-04:00","allDay":"Day Event","venue":{"name":"Toronto Botanical Garden","address":"777 Lawrence Ave E, North York, ON, M3C 1P2","lat":43.734346145,"lng":-79.358667018},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrate the beauty of autumn in the heart of the city. \n\nEvery year, the garden comes alive with seasonal experiences for all ages including a site-wide scavenger hunt, live music, hands-on nature activities, eco-stewards, and delicious fall flavours. \n\nRooted in community and inspired by the changing landscape, this annual festival invites you to explore, connect, and embrace the vibrant colours and textures of the season in one of Toronto’s most beloved green spaces. \n\nThis is a fantastic opportunity for families to get hands-on with nature and environmental stewardship.\n","categories":["Environmental","Live Performances","Street Festival"],"presenter":null,"image":"8JENmCf9GUWQ2iPBHO0Qmg","website":"https://torontobotanicalgarden.ca/event/tbg-fall-ravine-festival/","tickets":null},{"id":"eb96acd6-3f4b-484d-9f04-453ebea341ae","name":"Downsview Library Tree Tour","dates":[1791568800000],"start":"2026-10-09T14:00:00-04:00","end":"2026-10-09T14:00:00-04:00","allDay":"Day Event","venue":{"name":"Downsview Library","address":"2793 Keele St, North York, ON, M3M 2G3","lat":43.728933011,"lng":-79.48205972},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"The Downsview branch and its neighbourhood are home to a variety of trees. Join the City of Toronto to explore the natural world on a local neighbourhood tour. Learn how to recognize different species and fun facts about their cultural and ecological importance. \n\nThe tour will start and end at the Downsview branch and will be guided by City of Toronto staff. There may be uneven, unpaved surfaces along the route. Please dress and prepare accordingly for this outdoor program (e.g. gloves/mittens, hats, sunscreen, water, comfortable shoes). This program takes place rain or shine. In the event of severe inclement weather, registrants will be notified of an alternative date. Children under 12 must be accompanied by a parent/caregiver.\n\nThis free program requires registration.","categories":["Environmental","Tour"],"presenter":null,"image":"GhrR-HvM1zCiEkUq6kajpg","website":"https://tpl.bibliocommons.com/v2/events/6a96e0a34cb69d003e24df9c","tickets":"https://tpl.bibliocommons.com/v2/events/6a96e0a34cb69d003e24df9c"},{"id":"2cf909ea-6aa3-45b3-9f8b-379881065546","name":"Maple Leaf Park - 2:30 to 4:30 p.m.","dates":[1791657000000],"start":"2026-10-10T14:30:00-04:00","end":"2026-10-10T14:30:00-04:00","allDay":"Day Event","venue":{"name":"Maple Leaf Park","address":"320 Culford Rd, North York","lat":43.716305452,"lng":-79.491470192},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Try something new, get moving and connect through sport, Play Mobile is a free touring sports program for all ages and skill levels.\n\nWith a variety of sports equipment on board, vibrant vans tour neighbourhoods, transforming parks and outdoor spaces into pop-up sport hubs, bringing energy and excitement directly to communities around the city. Proudly powered in partnership with Nike, Play Mobile is committed to the future of youth sport, creating more equitable and inclusive access to play – with a focus on encouraging girls to participate and stay involved in sport.","categories":["Sports"],"presenter":null,"image":"JY5NZWRAS6Lt1TXJKw_GWw","website":"https://www.toronto.ca/explore-enjoy/parks-recreation/places-spaces/parks-and-recreation-facilities/parks-and-community-recreation-centres-map/#location=875%20Dufferin%20St&lat=43.65634&lng=-79.432439&zoom=11","tickets":null},{"id":"abf2510f-70ba-4d88-b39a-46afb2fa2dfb","name":"Lantern Tours at Fort York: After Dark","dates":[1792711800000,1792798200000,1792884600000,1793316600000,1793403000000],"start":"2026-10-22T19:30:00-04:00","end":"2026-10-30T19:30:00-04:00","allDay":"Night Event","venue":{"name":"Fort York National Historic Site","address":"100 Garrison Rd, Toronto, ON, M5V 3K9","lat":43.638491,"lng":-79.40518},"free":false,"low":20,"high":null,"pwyc":null,"costNotes":null,"description":"Hear chilling and eerie tales on a lantern tour of Fort York and its historic surroundings. Learn about a haunted lighthouse and the bloody Battle of York. Explore the military burial ground. Tour the creepy shadows and 200-year-old buildings of Fort York at night and learn of the fort’s history and its many paranormal mysteries.","categories":["History","Museum","Tour","Halloween"],"presenter":null,"image":"G-eno19UG31sj5aKkgxxQg","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/09cc8903-6509-4ac3-9964-74a070bbb946"},{"id":"83fd7b6c-f199-43b7-9b33-2da604808cf7","name":"Lantern Tours at Fort York: After Dark","dates":[1792711800000,1792798200000,1792884600000,1793316600000,1793403000000],"start":"2026-10-22T19:30:00-04:00","end":"2026-10-30T19:30:00-04:00","allDay":"Night Event","venue":{"name":"Fort York National Historic Site","address":"100 Garrison Rd, Toronto, ON, M5V 3K9","lat":43.638491,"lng":-79.40518},"free":false,"low":20,"high":null,"pwyc":null,"costNotes":null,"description":"Hear chilling and eerie tales on a lantern tour of Fort York and its historic surroundings. Learn about a haunted lighthouse and the bloody Battle of York. Explore the military burial ground. Tour the creepy shadows and 200-year-old buildings of Fort York at night and learn of the fort’s history and its many paranormal mysteries.","categories":["History","Museum","Tour","Halloween"],"presenter":null,"image":"G-eno19UG31sj5aKkgxxQg","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/fort-york-national-historic-site/","tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/09cc8903-6509-4ac3-9964-74a070bbb946"},{"id":"e018ce3d-438d-47f9-9a2b-febca23167ce","name":"Tomorrow’s Memories: Gibson House 175 (Nuit Blanche Toronto)","dates":[1791068400000,1791154800000],"start":"2026-10-03T19:00:00-04:00","end":"2026-10-04T19:00:00-04:00","allDay":"Night Event","venue":{"name":"Gibson House","address":"5172 Yonge St, North York, ON, M2N 5P6","lat":43.769686148,"lng":-79.414666941},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Experience an immersive outdoor nighttime installation celebrating 175 years of Gibson House Museum. See a transformed historic landscape featuring youth-created crocheted flora and fauna, archival photographs, embroidery-inspired artwork, light, sound and storytelling. \n\nCreated by the City in partnership with Toronto History Museums Youth Volunteers, the installation reflects on themes of memory, land and community, inviting visitors to discover how 175 years of history continue to shape the future of North York.","categories":["Arts/Exhibits","Museum"],"presenter":null,"image":"ixatwmGnJ-6w6teIRf1QlQ","website":"https://www.toronto.ca/explore-enjoy/history-art-culture/museums/gibson-house-museum/","tickets":null},{"id":"507db560-4d5d-44cd-b0a0-bcdb6dbd07d9","name":"Halloween Pumpkin Hunt at Fort York","dates":[1792864800000],"start":"2026-10-24T14:00:00-04:00","end":"2026-10-24T14:00:00-04:00","allDay":"Day Event","venue":{"name":"Fort York National Historic Site","address":"250 Fort York Blvd, Toronto, ON, M5V 3K9","lat":43.637864096,"lng":-79.406314887},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":"Siblings or family members who wish to attend without decorating a pumpkin are welcome to come at no extra cost. ","description":"Search the grounds of Fort York for pumpkins that have been hidden by the soldiers of the War of 1812. After you've recovered your pumpkin, bring it to the Blue Barracks for decorating! Paint it, draw on it, even clothe it to look like a Fort York soldier. Take your pumpkin home with you where it can guard your door all throughout the spooky season. \n\nThis event is open for children aged 3 - 12. All children must be accompanied by an adult guardian at all times. ","categories":["Family/Children","History","Museum","Halloween"],"presenter":null,"image":"onLvMt-nvW0zJXK2se3DHw","website":null,"tickets":"https://secure.toronto.ca/webapps/feps_edc-ticketing/#events/96f4fd64-af50-43be-bc0b-7284b074a2b8"},{"id":"eca93fac-fa73-4415-8915-25b4beef6e8f","name":"Youth Voices Community Showcase","dates":[1792706400000],"start":"2026-10-22T18:00:00-04:00","end":"2026-10-22T18:00:00-04:00","allDay":"Night Event","venue":{"name":"Tropicana Community Services","address":"1385 Huntingwood Dr, Scarborough, ON, M1S 3J1","lat":43.797839,"lng":-79.26437},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Celebrate the creativity, talent, and perspectives of youth from the Kingston-Galloway-Orton Park community. This community celebration is the culmination of a youth mentorship program that engages participating KGO youth in the co-creation and facilitation of art workshops for community members. Through the program, youth develop creative skills, share their stories, and collaborate on artistic works that reflect their experiences, ideas, and visions for the community. \n\nAttendees can enjoy an evening featuring youth-led programming including visual art, fashion, music, food, and more. The event offers an opportunity to connect with neighbours, support emerging young artists, and experience the creativity and authenticity that make Scarborough unique. All are welcome.\n\nA City of Toronto Cultural Hotspot Signature Project.","categories":["Arts/Exhibits","Live Performances","Other"],"presenter":"East Scarborough Storefront","image":"6TmX6GQ6ld_2wGS2NugMEA","website":"https://www.thestorefront.org/","tickets":null},{"id":"42afd671-4457-45ab-b7b9-101b73b02b84","name":"The Descent of Orpheus","dates":[1792711800000,1792798200000,1792884600000,1792953000000],"start":"2026-10-22T19:30:00-04:00","end":"2026-10-25T14:30:00-04:00","allDay":"Night Event","venue":{"name":"TELUS Centre for Performance and Learning at Koerner Hall","address":"273 Bloor St W, Toronto, ON, M5S 1W2","lat":43.667856304,"lng":-79.396058814},"free":false,"low":85,"high":250,"pwyc":null,"costNotes":null,"description":"Enjoy our season premiere with Canada’s first fully-staged production of M.A. Charpentier’s The Descent of Orpheus. \n\nFounding Co-Artistic Directors Marshall Pynkoski, C.M. and Jeannette Lajeunesse Zingg, C.M. direct and choreograph this fresh, contemporary, and emotionally-driven staging of Charpentier’s masterpiece, grounded in the concept of period performance. \n\nThe production is the earliest known French operatic take on the Orpheus myth from Ovid's Metamorphoses. Celebrated American tenor Daniel McGrew is making his Canadian debut with Opera Atelier as Orpheus opposite French-Canadian soprano Mireille Asselin as Eurydice. ","categories":["Dance","Live Performances","Music"],"presenter":"Opera Atelier","image":"5Kjgp2yeVCQPw_sKJnSawg","website":"https://www.operaatelier.com/shows/the-descent-of-orpheus/","tickets":"https://www.rcmusic.com/concerts?tps_activeFacetTab=Concerts%20Presented%20By%20Others&fq=eventpresenter%7C%7COpera+Atelier"},{"id":"680c2e49-5c19-4d94-a3e7-b0bd1958cbf2","name":"Dog Days: Canadian Opera Premiere","dates":[1795048200000,1795134600000,1795294800000,1795374000000],"start":"2026-11-18T19:30:00-05:00","end":"2026-11-22T14:00:00-05:00","allDay":"Night Event","venue":{"name":"Nancy and Ed Jackman Performance Centre","address":"877 Yonge St, Toronto, ON, M4W 3M2","lat":43.674249,"lng":-79.387973},"free":false,"low":70,"high":105,"pwyc":null,"costNotes":null,"description":"A contemporary opera that combines classical vocals with dark ambient noise and amplified electric guitars. \n\nSet during a fictional wartime blackout, the story follows a rural working-class family attempting to survive amidst military collapse and severe food shortages. The psychological drama explores human resilience, desperation, and moral breakdown when social structures disintegrate.\n\nCritically acclaimed by The New York Times, this breakthrough work from the writing team of composer David T. Little (Soldier Songs, JFK) and Canadian librettist Royce Vavrek (Angel’s Bone, Listen, Quiet) put them on the map. They have since gone on, both together and in collaboration with others, to revolutionize opera in North America.","categories":["Live Performances","Music","Theatre"],"presenter":"Tapestry Opera and Against the Grain Theatre","image":"r3Bej54LjTXdeoVxlHVQ8g","website":"https://tapestryopera.com/performances/dog-days/","tickets":"https://tapestryopera.my.salesforce-sites.com/ticket/#/events/a0SOF000002p2Zh2AI"},{"id":"54c0447c-ac85-4e53-821d-4bcfc1fc9196","name":"International Architectural Design Competition 2026-2027: Persian Garden Suite","dates":[1789444800000,1789531200000,1789617600000,1789704000000,1789790400000,1789876800000,1789963200000,1790049600000,1790136000000,1790222400000,1790308800000,1790395200000,1790481600000,1790568000000,1790654400000,1790740800000,1790827200000,1790913600000,1791000000000,1791086400000,1791172800000,1791259200000,1791345600000,1791432000000,1791518400000,1791604800000,1791691200000,1791777600000,1791864000000,1791950400000,1792036800000,1792123200000,1792209600000,1792296000000,1792382400000,1792468800000,1792555200000,1792641600000,1792728000000,1792814400000,1792900800000,1792987200000,1793073600000,1793160000000,1793246400000,1793332800000,1793419200000,1793505600000,1793595600000,1793682000000,1793768400000,1793854800000,1793941200000,1794027600000,1794114000000,1794200400000,1794286800000,1794373200000,1794459600000,1794546000000,1794632400000,1794718800000,1794805200000,1794891600000,1794978000000,1795064400000,1795150800000,1795237200000,1795323600000,1795410000000,1795496400000,1795582800000,1795669200000,1795755600000,1795842000000,1795928400000,1796014800000,1796101200000,1796187600000,1796274000000,1796360400000,1796446800000,1796533200000,1796619600000,1796706000000,1796792400000,1796878800000,1796965200000,1797051600000,1797138000000,1797224400000,1797310800000,1797397200000,1797483600000,1797570000000,1797656400000,1797742800000],"start":"2026-09-15T00:00:00-04:00","end":"2026-12-20T00:00:00-05:00","allDay":"Day Event","venue":{"name":"Toronto (virtual)","address":"","lat":null,"lng":null},"free":false,"low":10,"high":30,"pwyc":null,"costNotes":null,"description":"This international architectural competition invites participants to design a Persian Garden Suite pavilion in Toronto. \n\nThe initiative explores cultural heritage, urban design, and innovative architecture. Detailed competition guidelines, submission criteria and timelines are available for participants.","categories":["Cultural","Other"],"presenter":"Iranian-Canadian Architects and Artists Forum ","image":null,"website":"https://www.icaaf.ca/competition","tickets":"https://www.icaaf.ca/competition"},{"id":"135a0ffe-de68-40d1-a737-e505faa25196","name":"Retracing Tatreez: Palestinian Thobes through the Twentieth Century","dates":[1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000,1799254800000,1799341200000,1799427600000,1799514000000,1799600400000,1799859600000,1799946000000,1800032400000,1800118800000,1800205200000,1800464400000,1800550800000,1800637200000,1800723600000,1800810000000,1801069200000,1801155600000,1801242000000,1801328400000,1801414800000,1801674000000,1801760400000,1801846800000,1801933200000,1802019600000],"start":"2026-09-24T12:00:00-04:00","end":"2027-02-07T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":"\nChildren 5 and under visit for free.","description":"Featuring several examples of Palestinian tatreez (embroidery) from the Textile Museum’s collection, most of which will be exhibited for the first time! \n\nRetracing Tatreez highlights what these belongings can tell us about the relationship between Palestinians and their homelands in the twentieth century and beyond.\n\nIn this exhibition, curator Nina Rafique showcases these pieces with restored historical context and invites visitors to re-engage with their ways of storytelling. \n\nIn doing so, Retracing Tatreez highlights what these embroideries can tell us about the unique regional connections between Palestinians and their homelands, as well as the journeys of these objects from the hands of their original creators to today.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"j37-eBOZLJMeQ8B7zUJpJg","website":"https://textilemuseum.ca/event/retracing-tatreez-palestinian-thobes-through-the-20th-century/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"591af237-4c43-471a-9d6c-2b54f0a7cb39","name":"Free Admission Weekend at Textile Museum of Canada","dates":[1791043200000,1791129600000],"start":"2026-10-03T12:00:00-04:00","end":"2026-10-04T12:00:00-04:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Enjoy free drop-in activities in the Learning Hub, restocked fabrics and supplies as part of the Reuse Program initiative and a chance to explore three exhibitions on view as part of Ontario Culture Days! \n\nExhibitions on view include Made by Many (50 Years of the Textile Museum of Canada), Always in Fashion (Curated by Amber-Dawn Bear Robe) and Retracing Tatreez: Palestinian Thobes through the 20th Century (Curated by Nina Rafique).\n\nThe Ontario Culture Days Festival is an annual celebration of arts, culture and heritage taking place each fall across the province. Organizers host programs throughout Ontario and invite the public to participate for free.","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":"Ontario Culture Days ","image":"X2wa_2oMCRTlxw1FxtFnPA","website":"https://textilemuseum.ca/event/ontario-culture-days-at-the-textile-museum/","tickets":"https://textilemuseum.ca/"},{"id":"35a3958c-a7c0-4db6-b095-20bfb49cfc92","name":"Always In Fashion","dates":[1789574400000,1789660800000,1789747200000,1789833600000,1789920000000,1790179200000,1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000],"start":"2026-09-16T12:00:00-04:00","end":"2027-01-03T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Curated by Amber-Dawn Bear Robe, enjoy an immersive exploration of Indigenous design languages and their transformative impact on the fashion landscape of the lands we call Canada and the United States. \n\nThis exhibition emerges from the urgent need to recognize and celebrate Indigenous designers who are reshaping the industry by reclaiming cultural narratives, innovating with ancestral techniques, and challenging colonial frameworks within fashion. \n\nThrough research on Indigenous fashion history, cultural sustainability, and decolonial design practices, the exhibition highlights how contemporary Indigenous couturiers blend ancestral knowledge with cutting-edge innovation to redefine fashion on their own terms.\n\n","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"azAuMTKhii0Yt5PF3WwMYg","website":"https://textilemuseum.ca/event/always-in-fashion/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"92f38345-bd0c-424d-86ac-628525cb2a5d","name":"Always In Fashion","dates":[1789574400000,1789660800000,1789747200000,1789833600000,1789920000000,1790179200000,1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,1793203200000,1793289600000,1793376000000,1793462400000,1793552400000,1793811600000,1793898000000,1793984400000,1794070800000,1794157200000,1794416400000,1794502800000,1794589200000,1794675600000,1794762000000,1795021200000,1795107600000,1795194000000,1795280400000,1795366800000,1795626000000,1795712400000,1795798800000,1795885200000,1795971600000,1796230800000,1796317200000,1796403600000,1796490000000,1796576400000,1796835600000,1796922000000,1797008400000,1797094800000,1797181200000,1797440400000,1797526800000,1797613200000,1797699600000,1797786000000,1798045200000,1798131600000,1798218000000,1798304400000,1798390800000,1798650000000,1798736400000,1798822800000,1798909200000,1798995600000],"start":"2026-09-16T12:00:00-04:00","end":"2027-01-03T12:00:00-05:00","allDay":"Day Event","venue":{"name":"Textile Museum of Canada","address":"55 Centre Ave, Toronto, ON, M5G 2H5","lat":43.654578756,"lng":-79.386652476},"free":false,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Curated by Amber-Dawn Bear Robe, enjoy an immersive exploration of Indigenous design languages and their transformative impact on the fashion landscape of the lands we call Canada and the United States. \n\nThis exhibition emerges from the urgent need to recognize and celebrate Indigenous designers who are reshaping the industry by reclaiming cultural narratives, innovating with ancestral techniques, and challenging colonial frameworks within fashion. \n\nThrough research on Indigenous fashion history, cultural sustainability, and decolonial design practices, the exhibition highlights how contemporary Indigenous couturiers blend ancestral knowledge with cutting-edge innovation to redefine fashion on their own terms.\n\n","categories":["Arts/Exhibits","Cultural","Museum"],"presenter":null,"image":"azAuMTKhii0Yt5PF3WwMYg","website":"https://textilemuseum.ca/event/always-in-fashion/","tickets":"https://textilemuseumcanada.ticketing.veevartapp.com/tickets/view/calendar"},{"id":"f0c6644d-0a0e-423d-b372-6e16b861276f","name":"Always In Fashion","dates":[1789574400000,1789660800000,1789747200000,1789833600000,1789920000000,1790179200000,1790265600000,1790352000000,1790438400000,1790524800000,1790784000000,1790870400000,1790956800000,1791043200000,1791129600000,1791388800000,1791475200000,1791561600000,1791648000000,1791734400000,1791993600000,1792080000000,1792166400000,1792252800000,1792339200000,1792598400000,1792684800000,1792771200000,1792857600000,1792944000000,179