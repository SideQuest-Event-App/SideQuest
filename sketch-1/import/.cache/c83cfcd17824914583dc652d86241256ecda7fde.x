0000,1787842800000,1787929200000,1788015600000,1788102000000,1788361200000,1788447600000,1788534000000,1788620400000,1788706800000,1788966000000,1789052400000,1789138800000,1789225200000,1789311600000,1789570800000,1789657200000,1789743600000,1789830000000,1789916400000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000,1791385200000,1791471600000,1791558000000,1791644400000,1791730800000,1791990000000,1792076400000,1792162800000,1792249200000,1792335600000],"start":"2026-08-26T11:00:00-04:00","end":"2026-10-18T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Spadina Museum","address":"285 Spadina Rd, Toronto, ON, M5R 2V5","lat":43.679046946,"lng":-79.408181452},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":"Visit the reception desk to register. Tickets are first-come first-serve and subject to capacity.","description":"See a contemporary art exhibition of five sculptural interventions located throughout the historic Spadina Museum, created by artist Ry Van Der Hout and curated by Adrien Sun Hall. Working with photography, stained glass, mirrors, and acts of rupture and repair, Van Der Hout reveals the emotional residue held within objects, architecture and stories. Cracks and fractures become apertures through which forgotten stories emerge, the artworks functioning as contemporary reliquaries for lives remembered and overlooked.\n\nMoving between deep histories, the present day and an imagined future, this exhibition traces connections across time, where fragments persist, reflections multiply, and the boundaries between past, present and future remain open.","categories":["Arts/Exhibits","History","Museum"],"presenter":null,"image":"caTKB0eJSOICT9G9ZdiXWw","website":"https://toronto.ca/spadina","tickets":null},{"id":"e9dc4c70-abc2-4b3c-9563-b970efe606d2","name":"The Second City Toronto: Mainstage Comedy 92nd Revue","dates":[1787097600000,1787184000000,1787270400000,1787356800000,1787443200000,1787529600000,1787616000000,1787702400000,1787788800000,1787875200000,1787961600000,1788048000000,1788134400000,1788220800000,1788307200000,1788393600000,1788480000000,1788566400000,1788652800000,1788739200000,1788825600000,1788912000000,1788998400000,1789084800000,1789171200000,1789257600000,1789344000000,1789430400000,1789516800000,1789603200000,1789689600000,1789776000000,1789862400000,1789948800000,1790035200000,1790121600000,1790208000000,1790294400000,1790380800000,1790467200000,1790553600000,1790640000000,1790726400000,1790812800000,1790899200000,1790985600000,1791072000000,1791158400000],"start":"2026-08-18T20:00:00-04:00","end":"2026-10-04T20:00:00-04:00","allDay":"Night Event","venue":{"name":"Second City Toronto","address":"110 Harbour St, Toronto, ON, M5J 0B7","lat":43.641557456,"lng":-79.379778422},"free":false,"low":39,"high":55,"pwyc":null,"costNotes":null,"description":"For over 65 years, Second City has delighted audiences around the world with brilliant songs, hilarious sketches, and iconic characters. \n\nIn our time-honoured tradition, you are invited to become part of our creative process…audiences have the chance to influence brand new material being developed in real time. Come be part of the laughter!","categories":["Arts/Exhibits","Comedy","Live Performances"],"presenter":null,"image":null,"website":"https://www.secondcity.com/shows/toronto/the-second-city-mainstage-92nd-revue-tor","tickets":"https://www.secondcity.com/shows/toronto/the-second-city-mainstage-92nd-revue-tor"},{"id":"ce6575f9-0325-4067-ade4-9a4b9488dcef","name":"In Broken Light Exhibition at Spadina Museum","dates":[1787756400000,1787842800000,1787929200000,1788015600000,1788102000000,1788361200000,1788447600000,1788534000000,1788620400000,1788706800000,1788966000000,1789052400000,1789138800000,1789225200000,1789311600000,1789570800000,1789657200000,1789743600000,1789830000000,1789916400000,1790175600000,1790262000000,1790348400000,1790434800000,1790521200000,1790780400000,1790866800000,1790953200000,1791039600000,1791126000000,1791385200000,1791471600000,1791558000000,1791644400000,1791730800000,1791990000000,1792076400000,1792162800000,1792249200000,1792335600000],"start":"2026-08-26T11:00:00-04:00","end":"2026-10-18T11:00:00-04:00","allDay":"Day Event","venue":{"name":"Spadina Museum","address":"285 Spadina Rd, Toronto, ON, M5R 2V5","lat":43.679046946,"lng":-79.408181452},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":"Visit the reception desk to register. Tickets are first-come first-serve and subject to capacity.","description":"See a contemporary art exhibition of five sculptural interventions located throughout the historic Spadina Museum, created by artist Ry Van Der Hout and curated by Adrien Sun Hall. Working with photography, stained glass, mirrors, and acts of rupture and repair, Van Der Hout reveals the emotional residue held within objects, architecture and stories. Cracks and fractures become apertures through which forgotten stories emerge, the artworks functioning as contemporary reliquaries for lives remembered and overlooked.\n\nMoving between deep histories, the present day and an imagined future, this exhibition traces connections across time, where fragments persist, reflections multiply, and the boundaries between past, present and future remain open.","categories":["Arts/Exhibits","History","Museum"],"presenter":null,"image":"caTKB0eJSOICT9G9ZdiXWw","website":"https://toronto.ca/spadina","tickets":null},{"id":"668918f3-6e0f-4471-9e0d-d21a3bdca4db","name":"Stephen Sondheim’s Sweeney Todd in Concert","dates":[1800061200000,1800147600000,1800216000000],"start":"2027-01-15T20:00:00-05:00","end":"2027-01-17T15:00:00-05:00","allDay":"Night Event","venue":{"name":"Koerner Hall","address":"273 Bloor St W, Toronto, ON M5S 1W2","lat":43.667913,"lng":-79.396195},"free":false,"low":75,"high":175,"pwyc":null,"costNotes":null,"description":"Broadway in concert returns! \n\nDirector Richard Ouzounian and Music Director Paul Sportelli reunite with the Royal Conservatory Orchestra for this in concert staging of Sondheim’s macabre masterpiece. Featuring a stellar cast of Canadian theatre, TV and opera talent, including Ben Carlson, Deborah Hay, Robert Markus, Thom Allison, Elena Howard Scott, Jason Howard, Jeigh Madjus and more to be announced soon!\n\nSweeney Todd has become a bloody, worldwide success since being awarded eight Tony Awards (including Best Musical) for its Broadway premiere. Stephen Sondheim's and Hugh Wheeler's (A Little Night Music, Pacific Overtures) tasty, thrilling, theatrical treat has simultaneously shocked, awed, and delighted audiences across the world.","categories":["Live Performances","Music"],"presenter":null,"image":null,"website":"https://www.rcmusic.com/concerts","tickets":"https://www.rcmusic.com/concerts"},{"id":"c7e85b61-42a0-4083-a961-a400bc1db0d9","name":"The Second City Toronto: Mainstage Comedy 92nd Revue","dates":[1787097600000,1787184000000,1787270400000,1787356800000,1787443200000,1787529600000,1787616000000,1787702400000,1787788800000,1787875200000,1787961600000,1788048000000,1788134400000,1788220800000,1788307200000,1788393600000,1788480000000,1788566400000,1788652800000,1788739200000,1788825600000,1788912000000,1788998400000,1789084800000,1789171200000,1789257600000,1789344000000,1789430400000,1789516800000,1789603200000,1789689600000,1789776000000,1789862400000,1789948800000,1790035200000,1790121600000,1790208000000,1790294400000,1790380800000,1790467200000,1790553600000,1790640000000,1790726400000,1790812800000,1790899200000,1790985600000,1791072000000,1791158400000],"start":"2026-08-18T20:00:00-04:00","end":"2026-10-04T20:00:00-04:00","allDay":"Night Event","venue":{"name":"Second City Toronto","address":"110 Harbour St, Toronto, ON, M5J 0B7","lat":43.641557456,"lng":-79.379778422},"free":false,"low":39,"high":55,"pwyc":null,"costNotes":null,"description":"For over 65 years, Second City has deligh