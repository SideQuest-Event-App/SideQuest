end experience in Toronto.","categories":["Farmers' Market","Food/Culinary","Other"],"presenter":null,"image":"HsINX9unS5aRBvcRR5D6QA","website":"https://www.dpmarket.com","tickets":null},{"id":"d9ca10a1-0ddd-4127-a1da-e421084bae3d","name":"Underpass Park Farmers' Market","dates":[1778788800000,1779393600000,1779998400000,1780603200000,1781208000000,1781812800000,1782417600000,1783022400000,1783627200000,1784232000000,1784836800000,1785441600000,1786046400000,1786651200000,1787256000000,1787860800000,1788465600000,1789070400000,1789675200000,1790280000000,1790884800000,1791489600000,1792094400000],"start":"2026-05-14T16:00:00-04:00","end":"2026-10-15T16:00:00-04:00","allDay":"Day Event","venue":{"name":"Underpass Park","address":"29 Lower River Street, Toronto, ON M5A 1M6","lat":43.65585,"lng":-79.354586},"free":true,"low":null,"high":null,"pwyc":null,"costNotes":null,"description":"Discover the magic of Underpass Park Farmers' Market—a vibrant gem in Toronto's Corktown and one of the city's most unique farmers market destinations! Surrounded by colorful murals from local artists, this lively outdoor market bursts with farm-fresh fruits and vegetables, mouthwatering baked goods, homemade preserves, and a tempting selection of artisanal treats.\n\nFrom May to October—rain or shine—this pet-friendly hotspot invites you to soak up live music, browse the stalls, and mingle with adorable pups for a truly unforgettable market experience.","categories":["Farmers' Market","Other"],"presenter":null,"image":"w3Jiy9MEVv3kfA1fQck79w","website":"https://underpassparkmarket.com/","tickets":null},{"id":"3ebbfd8b-90b7-45bd-b6de-3dd69db9ae73","name":"Underpass Park Farmers' Market","dates":[1778788800000,1779393600000,1779998400000,1780603200000,1781208000000,1781812800000,1782417600000,1783022400000,1783627200000,1784232000000,1784836800000,1785441600000,1786046400000,1786651200000,1787256000000,1787860800000,1788465600000,1789070400000,1789675200000,1790280000000,1790884800000,179