/secure.meetupstatic.com/photos/member/e/9/6/e/highres_322919758.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:161176342":{"__typename":"Member","id":"161176342","name":"MG","memberPhoto":{"__ref":"PhotoInfo:322919758"}},"PhotoInfo:304375995":{"__typename":"PhotoInfo","id":"304375995","highResUrl":"https://secure.meetupstatic.com/photos/member/d/a/b/b/highres_304375995.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:126313012":{"__typename":"Member","id":"126313012","name":"Sharky","memberPhoto":{"__ref":"PhotoInfo:304375995"}},"Member:234021075":{"__typename":"Member","id":"234021075","name":"Billy Sharks","memberPhoto":{"__ref":"PhotoInfo:326374674"}},"Event:316559353":{"__typename":"Event","id":"316559353","dateTime":"2026-10-04T16:59:00-04:00","isAttending":false,"group":{"__typename":"Group","urlname":"Internet-marketing-strategy-group"}},"Event:316656317":{"__typename":"Event","id":"316656317","dateTime":"2026-10-11T16:59:00-04:00","isAttending":false,"group":{"__typename":"Group","urlname":"Internet-marketing-strategy-group"}},"Event:316756568":{"__typename":"Event","id":"316756568","dateTime":"2026-10-18T16:59:00-04:00","isAttending":false,"group":{"__typename":"Group","urlname":"Internet-marketing-strategy-group","__ref":"Group:25917173"},"title":"🔥Toronto Founder Walk | Marketers, Entrepreneurs \u0026 Business Owners","description":"A lot of people in this group work with entrepreneurs every day — or are entrepreneurs themselves.\nAgency owners, marketers, consultants, freelancers, creators, startup founders and business owners often end up at the same conferences and seminars...\n…but don't necessarily get much time to actually know one another.\nSo instead of another marketing presentation, we're trying something simpler:\n\\# 🚶 Toronto Founder Walk\nA casual Sunday walk along Toronto's Harbourfront where entrepreneurs, marketers and business owners can meet through natural conversation.\nNo slides.\nNo speakers.\nNo sales presentation.\nNo forced networking exercises.\nJust:\n**Walk. Talk. Meet someone interesting.**\n\\#\\#\\# The idea\nI've been involved with entrepreneur and community events in Toronto since 2016, and this new series grew out of the **18,000-member Toronto Entrepreneurs \u0026 Start-ups Facebook community**.\nOne thing I've noticed over the years is that the best connections rarely come from exchanging as many business cards as possible.\nThey usually happen when you spend enough time talking to someone to discover:\n\\\u003e “Oh\\, this person actually thinks about things in an interesting way\\.”\nThat's what we're trying to create.\n\n**🚩Important: Meetup RSVP ≠ confirmed spot**\n**Keep your Meetup RSVP as Going so the event stays visible here. You will get link to a short application after you RSVP.**\n\n📍Meetup Location: Simcoe Wavedeck sign\n**📅Sunday schedule**\n**🕛4:45 PM — Arrive / check in**\n**🕛5:00 PM — Introductions**\nTell us who you are, what you're working on and one interesting way you're using—or want to use—AI.\n**🕛5:15 PM — Walk begins**\nWe'll rotate conversations and introduce a few AI discussion prompts along the route.\n**🕛Around 6:15 PM — Official finish**\nMany stay afterwards to network. Some people may grab food or a drink afterward.\n\n**🏃Running late?**\nDon't give up on coming.\nApproved guests can join our Sunday Walk WhatsApp group. Once we're moving, we'll share our live location so late arrivals can catch up.\n\nWe'll help make introductions at the start, but this is intentionally informal.\nPossible conversations might include:\n\n* What's actually working in marketing right now?\n* Growing an agency or service business\n* AI and automation\n* Customer acquisition\n* Entrepreneurship\n* Building a personal brand\n* Sales\n* Hiring\n* What you're currently working on\n* Or something completely unrelated to work\n\nYou don't have to talk marketing for 75 minutes.\nThe activity is simply there to make meeting people easier.\n\\#\\#\\# Who this is for\nEspecially relevant for:\n\n* Entrepreneurs\n* Agency owners\n* Digital marketers\n* Consultants\n* Freelancers\n* Creators\n* Startup founders\n* Business owners\n* Growth and marketing professionals\n\nYou don't need to sell marketing services.\nYou just need to be genuinely interested in meeting other people who build, market or operate businesses.\n\\#\\#\\# What this is NOT\nThis is not:\n\n* A lead-generation mixer\n* A seminar\n* A pitching session\n* A place to aggressively collect prospects\n\nIf your main objective is to distribute business cards to everyone, this probably isn't the right event.\nIf you'd enjoy meeting a few thoughtful people and seeing where the conversation goes, it probably is.\n\\#\\#\\# ☕ Optional afterward\nWe'll finish the formal walk around 6:15 PM.\nAnyone who wants can continue for coffee, food or a drink nearby.\n\\#\\#\\# 🎟 How to reserve your spot\n**Meetup RSVP does not confirm attendance.**\nPlease register through Luma:\n👉 [https://superr.ca/mmevents](https://superr.ca/mmevents)\nWe keep the walks relatively small, so please release your spot if your plans change.\n\\#\\#\\# 📱 Future events\nFor first notice of upcoming casual entrepreneur events, join **TES Social on WhatsApp**:\n👉 **[https://biz1.ca/wa](https://biz1.ca/wa)**\nUpcoming formats may include:\n\n* Founder walks\n* Small dinners\n* Breakfasts\n* Marketing/AI discussions\n* Sports\n* Wellness\n* Social activities\n\n\\#\\#\\# 🙌 Want to host or contribute?\nWe're looking for people interested in:\n\n* Hosting\n* Co-hosting\n* Photography\n* Video\n* Reels\n* Venue partnerships\n* Activities\n* Event support\n\n👉 **[https://superr.ca/host](https://biz1.ca/host)**\nCome curious.\nLeave the pitch at home.\nHopefully meet someone worth seeing again.\n#DigitalMarketingToronto #TorontoEntrepreneurs #FounderWalk #MarketingCommunity #TESSocial\n\n***📸Photo, Video \u0026 Audio Notice:*** *By registering for or attending this event, you acknowledge that photos, video and audio recordings may be captured during the event. You consent to Superr / TES Social using your image, likeness, voice and comments in event recaps, social media, promotional materials and other community content. If you prefer not to be photographed, filmed or recorded, please let the host know before the event and we’ll do our best to accommodate you.*","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/internet-marketing-strategy-group/events/316756568/","isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:535604603"},"displayPhoto":{"__ref":"PhotoInfo:535604603"},"feeSettings":null,"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":45,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326374674"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:270650847"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:265086208"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:261895435"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:270784537"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:267628136"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:313661770"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":10,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:301080506"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:91794142"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:161176342"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:126313012"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:234021075"}}}]},"series":{"__typename":"Series","description":"Every w