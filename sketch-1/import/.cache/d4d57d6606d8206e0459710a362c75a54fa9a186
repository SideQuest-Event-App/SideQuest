ontent.meetupstatic.com/images/classic-member/"},"Member:136038912":{"__typename":"Member","id":"136038912","name":"Aric","memberPhoto":{"__ref":"PhotoInfo:258682384"}},"PhotoInfo:325599243":{"__typename":"PhotoInfo","id":"325599243","highResUrl":"https://secure.meetupstatic.com/photos/member/9/9/4/b/highres_325599243.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:472714091":{"__typename":"Member","id":"472714091","name":"Karthy","memberPhoto":{"__ref":"PhotoInfo:325599243"}},"PhotoInfo:325864809":{"__typename":"PhotoInfo","id":"325864809","highResUrl":"https://secure.meetupstatic.com/photos/member/1/2/c/9/highres_325864809.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:56313242":{"__typename":"Member","id":"56313242","name":"Tim Bose","memberPhoto":{"__ref":"PhotoInfo:325864809"}},"PhotoInfo:280472740":{"__typename":"PhotoInfo","id":"280472740","highResUrl":"https://secure.meetupstatic.com/photos/member/7/f/e/4/highres_280472740.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:261445495":{"__typename":"Member","id":"261445495","name":"Michelle","memberPhoto":{"__ref":"PhotoInfo:280472740"}},"PhotoInfo:323145533":{"__typename":"PhotoInfo","id":"323145533","highResUrl":"https://secure.meetupstatic.com/photos/member/b/1/d/d/highres_323145533.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:379388580":{"__typename":"Member","id":"379388580","name":"Maria ","memberPhoto":{"__ref":"PhotoInfo:323145533"}},"Event:316495668":{"__typename":"Event","id":"316495668","title":"Morningside salmon run (11 km)","dateTime":"2026-10-04T14:30:00-04:00","description":"Salmon will be doing the running, not us. Late September to October is the season for watching salmon swimming upstream. There are four places in Toronto to see the salmon jump but Morningside is the only one that has a festival for it. In fact, this hike happens on that day!\n\nToronto Region Conservation Authority will be conducting guided walks. If interested, sign up at [TRCA](https://trca.ca/salmon-adventures/). We're not affiliated with them and this hike will start after the festival.\n\nFor our hike, we'll start at a clutch of restaurants near Colonel Danforth Park and follow Highland Creek upstream.\n\nIf there's anything more attractive than the salmon migration, it's food. We'll skip the main section of Morningside Park and visit restaurants around Morningside Ave and Lawrence Ave. Then, it's back to nature and ravines. We'll end at Toronto's only Czech restaurant in a lush hideaway, where you can try the different dumplings of Central Europe.\n\n**Highlights**\n\n1. Shamrock Burgers (depart 2:30pm)\n2. Mark's Pizzas\n3. Colonel Danforth Park\n4. Miller Lash House\n5. Morningside Park\n6. The Suya Spot / Amira's Hot Roti and Doubles / Spice Club / Homies Doughnuts (depart 4pm)\n7. St. Margaret in-the-Pines\n8. Lawrence Ave bridge overlooking Highland Creek\n9. Simi African Food Market / Upali Caters (depart 4:45pm)\n10. Highland Creek Park\n11. Cedar Ridge Creative Centre\n12. Prague Restaurant (arrive 5:40pm)\n\n**Neighbourhoods**\nHighland Creek \u003e West Hill \u003e Golfdale Gardens\n\n**Map**\n[https://www.google.com/maps/d/edit?mid=1g6tIwKCmtHbLqMdGmwgwWTawibbrD2A\u0026usp=sharing](https://www.google.com/maps/d/edit?mid=1g6tIwKCmtHbLqMdGmwgwWTawibbrD2A\u0026usp=sharing)\n\nMultiple moderate climbs: downhill to Colonel Danforth Park, uphill from Morningside Park, down- and uphill from Highland Creek Park.\n\nThe end point is 1 km from the nearest bus stop.\n\n**How it works**\nHike starts punctually. Late or can't do the whole route? Meet us at scheduled checkpoints.\n\nWe'll browse many food places but won't linger long. See the route in advance, organize takeout, then pickup along the way.\n\nNot sure what to try? Join our omakase for $5, which gives a tiny sample from different restaurants. Payment on the day of event by cash or e-transfer to globaltorontoeats@gmail.com. No refunds after orders are placed. Details of sampled food will be uploaded after the hike.\n\nLimited cutlery provided. Highly recommended to bring cutlery and containers for omakase and bringing back leftovers.\n\nSee our [home page](https://www.meetup.com/hike-to-eat/) for more info.","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/hike-to-eat/events/316495668/","isAttending":false,"isSaved":false,"maxTickets":100,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:507072837"},"displayPhoto":{"__ref":"PhotoInfo:507072837"},"feeSettings":null,"group":{"__ref":"Group:36449594"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":100,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:24916252"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:11897508"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:377351855"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:7938863"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:194321640"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:192882358"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:188484913"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:17602961"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:461387542"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:116607762"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:363746115"}}},{"__typename":"RsvpEdge","node":{"__typen