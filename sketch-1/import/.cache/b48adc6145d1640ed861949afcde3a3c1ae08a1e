24.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:264462704":{"__typename":"PhotoInfo","id":"264462704","highResUrl":"https://secure.meetupstatic.com/photos/member/a/6/d/0/highres_264462704.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:77576192":{"__typename":"PhotoInfo","id":"77576192","highResUrl":"https://secure.meetupstatic.com/photos/member/d/b/8/0/highres_77576192.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:1102060":{"__typename":"PhotoInfo","id":"1102060","highResUrl":"https://secure.meetupstatic.com/photos/member/5/6/2/c/highres_1102060.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:312069412":{"__typename":"PhotoInfo","id":"312069412","highResUrl":"https://secure.meetupstatic.com/photos/member/2/4/c/4/highres_312069412.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:9334356":{"__typename":"Member","id":"9334356","name":"Mathew","memberPhoto":{"__ref":"PhotoInfo:312069412"}},"Member:267447852":{"__typename":"Member","id":"267447852","name":"Joanna C","memberPhoto":{"__ref":"PhotoInfo:316235363"}},"Member:483486597":{"__typename":"Member","id":"483486597","name":"Mauricio","memberPhoto":null},"Member:343071743":{"__typename":"Member","id":"343071743","name":"L.G.","memberPhoto":{"__ref":"PhotoInfo:310015413"}},"Member:311902845":{"__typename":"Member","id":"311902845","name":"Bethlehem ","memberPhoto":null},"Member:482509780":{"__typename":"Member","id":"482509780","name":"mathieu.marilly","memberPhoto":null},"Event:316183314":{"__typename":"Event","id":"316183314","title":"🍂 Fall Walk: Rouge National Urban Park and  Picnic🌳","dateTime":"2026-10-24T09:45:00-04:00","description":"# 🍂🌳 Fall Walk: Rouge National Urban Park 🌳🍁\n\n### A Real Hike, Beautiful Fall Colours \u0026 a Picnic Together\n\nWant to get out of the city without actually leaving Toronto?\n\n**Rouge National Urban Park** is Canada's only urban national park — and one of the most popular hikes we do.\nOnce you get onto the trail, it can be hard to believe you're still in Toronto. Forest paths, rolling hills, changing leaves, and quiet stretches of wilderness make this feel much more like a trip outside the city than a walk through it.\nAnd fall is one of the best times to experience it.\n\nThis is **a real hike**, though. There are some hills and ups and downs, so it isn't the best choice if you're looking for an easy, flat walk.\nBut if you're up for the challenge, there's something satisfying about reaching the end knowing you did it together.\nAnd then we'll have a picnic. 🧺\n\n📱 Don't forget to join our **WhatsApp Group – [CLICK HERE](https://chat.whatsapp.com/H59mSCbsAi018gYANrKAnc)**\n\n***\n\n## 🥾 What We'll Do\n\nWe'll meet at **Don Mills Station** and take the 85C bus together toward Rouge National Urban Park.\nOnce we arrive, we'll begin our hike through the park.\nAlong the way we'll:\n\n* Hike through forest and open spaces 🌳\n* Enjoy the fall colours 🍂\n* Navigate the hills and changing terrain\n* Take in some beautiful views\n* Stop for a short break along the route\n* Finish at the Park's Welcome Centre\n* Have a **30–40 minute group picnic** afterward 🧺\n\nThe hike takes approximately **2½ hours**, plus a short break.\nAfterward, we'll take some time to relax, eat, and enjoy each other's company.\n\n***\n\n## 🍁 Fall Weather \u0026 Expectations\n\nThis is a **moderately challenging hike**, not a casual stroll.\nThere are hills, uneven sections, and some ups and downs, so good walking or hiking shoes are important.\nPlease come prepared for typical fall weather and bring enough water for the hike.\n\nIf you're comfortable walking for a couple of hours and handling some elevation changes, you'll be fine.\nIf you're looking for something completely flat and easy, **this probably isn't the walk for you.**\n\n***\n\n## 🚌 Meetup Details\n\n### 🚇 By TTC\n\n📍 **Meetup Location:** Don Mills Station — on the platform for the **85C bus**\n🫎 **Look for me in my Moose Hat!**\n⏰ **Meetup Time:** **9:45 AM**\n🚌 **Bus Leaves:** **10:06 AM sharp**\nI'll wait for the bus, but if you miss it, **you won't be able to join the group afterward.**\n**Early is on time. On time is late.**\n\n### 🚗 By Car\n\nParking is **not available at our TTC meeting point.**\n\nIf you're driving, please park at the **Toronto Zoo** and walk to the **Park's Welcome Centre (the house)**.\n🚗 **Car Meetup Time:** 11:00 AM\n\nWe may be a few minutes late arriving, depending on the bus and traffic.\n\n***\n\n## 🧺 The Picnic\n\nAfter the hike, we'll have a **30–40 minute group picnic** at the end.\nPlease bring something small to share — nothing too large or heavy. The goal is simply to have something to eat together after the hike.\n🥪 Sandwiches\n🍎 Fruit\n🍪 Snacks\n🥤 Drinks\nWhatever is easy to carry and share is perfect.\n\n***\n\n## 🧢 Meetup Details at a Glance\n\n🥾 **Hike:** Approximately 2½ hours + short break\n🧺 **Picnic:** 30–40 minutes\n🏁 **End Point:** Park's Welcome Centre\n💲 **Meetup Fee:** $5 cash or e-transfer\n📧 **mathewmaclean@hotmail.com**\n\n***\n\n## 🎒 What to Bring\n\n💧 Water\n🥾 Good walking shoes or hiking shoes\n🥪 A snack\n🧺 Something small to share for the picnic\n🧥 A fall jacket or layers\n\n***\n\n## 🌈 Who Is This For?\n\nThis hike is great for:\n\n* People who enjoy a little challenge\n* Anyone who wants to explore Rouge National Urban Park\n* People who love fall colours 🍂\n* Hikers looking for a social outing\n* Anyone comfortable walking hills and uneven terrain\n* People who want to meet others while getting outside\n\nThis isn't the easiest walk we do.\n**But sometimes the harder walks are the ones you remember.**\n\nYou're welcome to RSVP ahead of time or just show up on the day if you're unsure about your schedule.\nSometimes things happen and events may need to be cancelled or changed, so please keep an eye on the event page for updates.\n\n👤 **Organizer: Mathew**\n\nQuestions? Post on the event wall or email **torontomoviesandoutings@hotmail.com**\n\n**Come for the hike.**\n**Stay for the picnic.**\n**Leave with a new connection — and maybe a new friend.** 🍂💛","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/toronto-movies-and-social-group/events/316183314/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:504851599"},"displayPhoto":{"__ref":"PhotoInfo:504851599"},"feeSettings":{"__typename":"EventFeeSettings","accepts":"CASH","currency":"CAD","amount":5},"group":{"__ref":"Group:5774262"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":43,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:316235363"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:310015413"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:276945686"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:1700124"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:264462704"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:77576192"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:1102060"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":6,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:9334356"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:267447852"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:483486597"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:343071743"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:311902845"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member