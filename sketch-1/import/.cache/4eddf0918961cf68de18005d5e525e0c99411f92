res_536252324.jpeg","id":"536252324"},"PhotoInfo:532228117":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/6/d/d/5/highres_532228117.jpeg","id":"532228117"},"Group:38263259":{"__typename":"Group","id":"38263259","name":"Chi of Thee Meetup Group","urlname":"chi-of-thee-meetup-group","timezone":"America/Toronto","keyGroupPhoto":{"__ref":"PhotoInfo:532228117"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":0,"totalRatings":0}}},"PhotoInfo:325677893":{"__typename":"PhotoInfo","id":"325677893","highResUrl":"https://secure.meetupstatic.com/photos/member/e/2/2/5/highres_325677893.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:213901006":{"__typename":"Member","id":"213901006","name":"Pureland International Qi Gong","memberPhoto":{"__ref":"PhotoInfo:325677893"}},"Event:316651541":{"__typename":"Event","id":"316651541","title":"Qi Gong for 60+","dateTime":"2026-10-22T02:00:00-04:00","description":"### Inviting Adults 60+ to Start Your Healing Journey with Pureland Qi Gong — On the Danforth\n\n**with Generational Qi Gong Master Teresa Yeung**\nAfter a lifetime of caring for your family, friends, and others, **it's time to care for yourself.**\nAt 69, Master Teresa Yeung understands that staying active and taking care of our body, mind, and spirit becomes increasingly important as we grow older.\nThis is your time to **nurture yourself, keep moving, and thrive in the years ahead.**\nThrough the gentle practice of **Pureland Qi Gong**, you will learn simple movements, breathing, and relaxation practices designed to support your body's natural balance, circulation, flexibility, and vitality.\n\n### Keep Your Body Moving. Keep Your Spirit Thriving.\n\nQi Gong offers a gentle way to continue being active while giving yourself time to slow down, breathe, and reconnect.\nYou will explore practices that can help you:\n\n* **Keep the body gently moving**\n* Support flexibility, balance, and coordination\n* Encourage relaxation and mindful breathing\n* Cultivate and circulate Qi (energy)\n* Develop greater awareness of your body\n* Create a regular practice for your own well-being\n\n**And you can practice both standing and seated.** You don't have to be on your feet for the entire class.\n\n### Your Next Chapter Can Be About You\n\nYou have spent much of your life taking care of others.\nNow, take one hour for **yourself**.\nJoin Teresa Yeung and other adults 60+ for a welcoming introduction to **Pureland Qi Gong** and discover a gentle practice you can continue to enjoy as you move forward in life.\n**You are never too old to start something new.**\n\n## A Special Introductory Class\n\nThis 1-hour class is an opportunity to **experience Qi Gong with Teresa before deciding whether you would like to continue**.\nIf there is sufficient interest, a **4-week Qi Gong program for adults 60+** may be offered following these introductory sessions.\nThere is **no obligation to register for the 4-week program**. Come simply to experience the class and see if Qi Gong is right for you.\n\n## 📍 In-Person Class — Toronto\n\n**Room 212 Danforth Avenue**\n**2nd floor of Carrot Common**\n**Toronto, Ontario M4K 1P1**\n\n### 📍 **Choose your Class**\n\n**Wednesday, October 14, 2026**\n🕥 **10:30 AM – 11:30 AM**\n**OR**\n**Thursday, October 22, 2026**\n🕑 **2:00 PM – 3:00 PM**\n\nPlease register for the date and time that works best for you. **Each class is a separate event.**\n\n### 💰 **Introductory Class Fee**\n\n**$20 + 13% HST = $22.60 total**\nThe introductory class fee is **$22.60 per person, including HST**.\n\n## What to Bring\n\n* Comfortable clothing\n* Water\n* A willingness to relax, breathe and enjoy the experience\n\nPlease arrive **10–15 minutes early** so you have time to settle in before the class begins.\n\n## Meet Your Teacher — Teresa Yeung\n\n**Generational Qi Gong Master Teresa Yeung** is the founder of Pureland International Qi Gong in Canada and a successor in the lineage of Grandmaster Weizhao Wu.\nWith more than **30 years of experience teaching Qi Gong internationally**, Teresa has shared Qi Gong with people from many different backgrounds and age groups.\nShe is the creator of **Wu's Eye Qi Gong®, Heart Chi Gong™ and the Hidden Pearl Series for Women**, and is a **3-time #1 internationally bestselling author**.\n\nAt 69, Teresa is especially interested in sharing Qi Gong with people in her own generation — helping them discover simple ways to keep moving, breathing and cultivating greater balance in everyday life.\nPurelandQiGong.com\n\n#carrotcommon\n#torontoqigongtaichi\n#seniors","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/chi-of-thee-meetup-group/events/316651541/","isAttending":false,"isSaved":false,"maxTickets":10,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536252324"},"displayPhoto":{"__ref":"PhotoInfo:536252324"},"feeSettings":{"__typename":"EventFeeSettings","accepts":"PAYPAL","currency":"CAD","amount":22.6},"group":{"__ref":"Group:38263259"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:213901006"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Pureland International Qi Gong","address":"Room 212, 348 Danforth Avenue (2nd floor Carrrot Common Plaza)","city":"Toronto","state":"ON","country":"ca"}},"RecommendedEventsEdge:{\"node\":{\"id\":\"316651541\"}}":{"__typename":"RecommendedEventsEdge","node":{"__ref":"Event:316651541","id":"316651541"},"metadata":{"__typename":"SearchMetadata","recId":"9e737f55-fb42-4d30-bbc2-d13b16fd9af9","recSource":"ml-popular-events-nearby-offline"}},"Group:38688746":{"__typename":"Group","id":"38688746","name":"The Compost Circle Social Gathering Group","urlname":"the-compost-circle-