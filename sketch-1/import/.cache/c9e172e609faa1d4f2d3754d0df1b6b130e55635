d":"326143904","highResUrl":"https://secure.meetupstatic.com/photos/member/a/b/8/0/highres_326143904.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:274445427":{"__typename":"PhotoInfo","id":"274445427","highResUrl":"https://secure.meetupstatic.com/photos/member/1/5/3/3/highres_274445427.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:301409506":{"__typename":"PhotoInfo","id":"301409506","highResUrl":"https://secure.meetupstatic.com/photos/member/7/3/4/2/highres_301409506.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:139232652":{"__typename":"PhotoInfo","id":"139232652","highResUrl":"https://secure.meetupstatic.com/photos/member/7/f/8/c/highres_139232652.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:262876286":{"__typename":"PhotoInfo","id":"262876286","highResUrl":"https://secure.meetupstatic.com/photos/member/3/f/9/e/highres_262876286.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:312069412":{"__typename":"PhotoInfo","id":"312069412","highResUrl":"https://secure.meetupstatic.com/photos/member/2/4/c/4/highres_312069412.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:9334356":{"__typename":"Member","id":"9334356","name":"Mathew","memberPhoto":{"__ref":"PhotoInfo:312069412"}},"Member:154944002":{"__typename":"Member","id":"154944002","name":"Dana Lowi-Merri","memberPhoto":{"__ref":"PhotoInfo:326227357"}},"Member:483598268":{"__typename":"Member","id":"483598268","name":"SM","memberPhoto":{"__ref":"PhotoInfo:326316919"}},"Member:276219092":{"__typename":"Member","id":"276219092","name":"Naveen","memberPhoto":{"__ref":"PhotoInfo:326143904"}},"Event:316183922":{"__typename":"Event","id":"316183922","title":"🍂🌿 NEW FALL WALK: Discover Biidaasige Park 🌿🍂","dateTime":"2026-10-25T11:00:00-04:00","description":"# 🍂🌿 **NEW FALL WALK: Discover Biidaasige Park** 🌿🍂\n\n### A Brand-New Toronto Park, Fall Colours \u0026 Waterfront Trails\n\nWe're trying something **new**!\n\nJoin us for our first group walk to **Biidaasige Park**, one of the newest and most ambitious parks in Toronto. Opened as part of the massive transformation of the Port Lands, the park sits on **Ookwemin Minising**, Toronto's new island where the Don River meets Lake Ontario.\n\nThis isn't a walk we've done before, which makes it a little more exciting. We'll spend much of the afternoon actually **exploring the park rather than rushing through it** — following its trails, enjoying the waterfront, taking in the fall scenery, and stopping along the way to appreciate the new landscape.\nThe park is enormous, with more than **50 acres already open** and more sections being added as the Port Lands transformation continues.\n\nThere are curated trails and paths, viewpoints, natural areas, and places to get down closer to the new Don River.\nAnd because we're doing this in the fall, we'll get to experience the park at a completely different time of year — cooler air, changing leaves, open skies, and fewer summer crowds. 🍂\n\nWe'll meet at the **Young Centre in the Distillery District** simply because it's an easy and convenient meeting point before we head toward the park. We won't be spending the day touring the Distillery District — **the park is the destination.**\n\n📲 **Don't Forget to join our WhatsApp Group – [\\[CLICK HERE!\\]](http://xn--[click%20here!](%20join%20our%20whatsapp%20group-cu832c:%20Click%20here%20to%20join)/)**\n\n***\n\n## 🚶‍♂️ **What We'll Do**\n\nWe'll meet outside the **Young Centre for the Performing Arts** and make our way toward Biidaasige Park.\nOnce we reach the park, we'll slow things down and spend about **90 minutes exploring the trails and waterfront**.\nAlong the way we'll:\n\n* 🍂 Enjoy the fall colours\n* 🌿 Explore the park's trails and green spaces\n* 🌊 Walk along the new waterfront landscape\n* 📸 Stop for photos and scenic views\n* 🌳 Explore the natural areas around the new Don River\n* 🌆 Take in views toward the Toronto skyline and Toronto Islands\n* 🚶‍♂️ Enjoy plenty of time to walk and talk with the group\n\nThe walk itself will be approximately **2 hours**, but we're not trying to race through it.\n**This is about experiencing the park.**\nIt's our first time doing this walk, so we'll take our time and actually enjoy discovering what has been created here.\n\n***\n\n## 🌊 **Why Biidaasige Park?**\n\nBiidaasige Park is part of one of the biggest transformations Toronto has seen in decades.\nThe new Don River was created as part of the Port Lands Flood Protection project, transforming former industrial land into a new river valley, wetlands, parkland and public spaces.\n\nThe first phase of Biidaasige Park opened in July 2025.\nThe park includes **accessible trails, cycling paths, river access, wetlands, viewpoints and waterfront promenades**, with views toward the Toronto Islands, Inner Harbour and skyline.\n\nAnd there's something particularly fun about visiting a place that is still **brand new**.\nWe're not revisiting an old Toronto favourite.\n**We're discovering somewhere new together.**\n\n***\n\n## 🍺 **After the Walk: The Keating Channel Pub \u0026 Grill**\n\nAfter exploring the park, we'll head over to **The Keating Channel Pub \u0026 Grill** for lunch.\nThe pub sits right on the Keating Channel and has been a local fixture in the area for more than 20 years. After years of Port Lands construction made the neighbourhood difficult to reach, the transformation of the area has brought new life and new visitors back to the waterfront.\nIt's a nice way to finish the day: **a brand-new park followed by one of the neighbourhood's old survivors.**\nLunch is optional, but everyone is welcome to join us.\n\n***\n\n## 🍂 **Fall Weather \u0026 Expectations**\n\nThis is a **social urban walk**, not a difficult hike.\nWe'll be walking for approximately two hours, including our time exploring the park, so you should be comfortable being on your feet for that length of time.\nPlease dress for typical Toronto fall weather. The waterfront can be cooler and windier than other parts of the city, so a warm layer is a good idea.\n\n***\n\n## 🧢 **Meetup Details**\n\n📍 **Meetup Location:** Outside the **Young Centre for the Performing Arts**, 50 Tank House Lane, in the Distillery District. Young Centre for the Performing Arts\n🫎 **Look for me in my Moose Hat!**\n⏰ **Meetup Time: 11:00 AM sharp**\nI will only wait **5 minutes**.\n**Early is on time. On time is late.**\n🏁 **End Point:** The Keating Channel Pub \u0026 Grill\n\n***\n\n## 🎟️ **Meetup Fee**\n\n**$5 cash in person or e-transfer**\n📧 **mathewmaclean@hotmail.com**\nThis fee helps support the group and allows us to continue organizing walks and events throughout Toronto.\n\n***\n\n## 🎒 **What to Bring**\n\n💧 Water\n👟 Comfortable walking shoes\n🥪 A snack\n🧥 Weather-appropriate clothing\n📸 Your phone or camera for photos\n\n***\n\n## 🌈 **Who Is This For?**\n\nThis walk is great for:\n\n* People who enjoy discovering new places in Toronto\n* Anyone who likes parks and waterfront trails\n* People who want a relaxed social walk\n* Anyone interested in seeing Toronto's newest public spaces\n* People who enjoy exploring somewhere they've never been before\n* Anyone who wants to spend a fall day outside with good people\n\nThe park may be new.\n**The idea is the same: come out, walk with us, and meet some people along the way.**\n\n***\n\n📲 **You're welcome to RSVP ahead of time — or just show up on the day if you're unsure about your schedule.**\nSometimes things happen and events may need to be cancelled or changed, so please keep an eye on the event page for updates.\n\n👤 **Organizer: Mathew**\n\nQuestions? Post on the event wall or email:\n📧 **torontomoviesandoutings@hotmail.com**\n\n**Come discover a new park.**\n**Stay for the fall colours.**\n**Stay a little longer for lunch and friendship.** 🍂🌿🍺","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/no-such-thing-as-bad-weather/events/316183922/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:535740824"},"displayPhoto":{"__ref":"PhotoInfo:535740824"},"feeSettings":{"__typename":"EventFeeSettings","accepts":"CASH","currency":"CAD","amount":5},"group":{"__ref":"Group:35508019"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":31,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326227357"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326316919"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326143904"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:274445427"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:301409506"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:139232652"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:262876286"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":4,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:9334356"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:154944002"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:483598268"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:276219092"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Young Centre for the Performing Arts","address":"Distillery District, 50 Tank House Lane","city":"Toronto","state":"ON","country":"ca"}},"RecommendedEventsEdge:{\"node\":{\"id\":\"316183922\"}}":{"__typename":"RecommendedEventsEdge","node":{"__ref":"Event:316183922","id":"316183922"},"metadata":{"__typename":"SearchMetadata","recId":"0c1f0b89-b8c8-4282-b008-80adcdd01c90",