er/1/2/c/9/highres_325864809.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:56313242":{"__typename":"Member","id":"56313242","name":"Tim Bose","memberPhoto":{"__ref":"PhotoInfo:325864809"}},"PhotoInfo:326341652":{"__typename":"PhotoInfo","id":"326341652","highResUrl":"https://secure.meetupstatic.com/photos/member/6/7/4/highres_326341652.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:483364798":{"__typename":"Member","id":"483364798","name":"Julie","memberPhoto":{"__ref":"PhotoInfo:326341652"}},"PhotoInfo:245053558":{"__typename":"PhotoInfo","id":"245053558","highResUrl":"https://secure.meetupstatic.com/photos/member/3/4/f/6/highres_245053558.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:3379885":{"__typename":"Member","id":"3379885","name":"Talal","memberPhoto":{"__ref":"PhotoInfo:245053558"}},"PhotoInfo:317762689":{"__typename":"PhotoInfo","id":"317762689","highResUrl":"https://secure.meetupstatic.com/photos/member/a/8/1/highres_317762689.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:345996664":{"__typename":"Member","id":"345996664","name":"Sahana Chakravarty","memberPhoto":{"__ref":"PhotoInfo:317762689"}},"PhotoInfo:294537943":{"__typename":"PhotoInfo","id":"294537943","highResUrl":"https://secure.meetupstatic.com/photos/member/e/2/5/7/highres_294537943.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:296218784":{"__typename":"Member","id":"296218784","name":"Sarah lynn","memberPhoto":{"__ref":"PhotoInfo:294537943"}},"Member:481717333":{"__typename":"Member","id":"481717333","name":"bhuvangrewal055","memberPhoto":null},"Event:316562323":{"__typename":"Event","id":"316562323","title":"Fall Colours Canoe trip to Kawartha Highlands Provincial Park","dateTime":"2026-10-17T07:00:00-04:00","description":"This is a trip to view the back country Ontario during prime fall colours.\n\nThis is a one-night trip. We will paddle into the interior and camp for the night.\nThere are 2 small portage.\n\nCamp sites and canoes will be reserved. Food will be provided and carpooling arranged. You do not need to bring any food.\n\nWe will be asking for a $50 deposit via paypal or bank email transfer to keep your spot since I need to reserve the sites and canoes ahead of time. I will send out a note with further information to those who sign up. See paypal and bank email transfer info under \"COSTS\" below.\nRSVP REQUIREMENTS\n\nRSVP \"Going\" if you are sure you can attend, are able to meet the difficulty requirement, bring what is needed and have reviewed the costs associated with this event.\nEVENT DETAILS\nDifficulty: Easy to Moderate - You are able to paddle 3-4 hours per day and are reasonably fit.\n\nWhat to Bring:\nHat, Personal water bottle, 2 or 3 dry bags or garbage bags (to use for your clothes \u0026 sleeping bag) Put the garbage bag inside to line you backpack. Put another one inside your sleeping bag case to line that.\nWaterproof Coat.\nList of Clothing : Hat, swimsuit, sweaters or sweatshirts (it will get cold in the evenings), jeans or long pants, 1 towel, 2 pairs shoes - 1 for dry hiking and 1 for wet stuff. Wet shoes need to be secure, flip flops and loose sandals may get stuck in the mud.\nbowl, cup, spoon, fork, sun glasses, flashlight or strong headlamp,\nToiletries: Toilet paper, sunscreen, bug spray.\nWhen you pack your stuff, if you can pack everything in one pack, portaging will be much easier!\nOther camping items:\nBackpack, Sleeping bag (suitable for cold weather), sleeping pad or mattress\n\nGETTING THERE\nDrivers will be notified by the organizer where to meet and pick up passengers. Drivers will be sent complete directions as to where, when and who to meet and directions to the Park.\nPlease sign up for the carpool here:\n\nCOSTS\nOther: 50 deposit to remain on going list. Total cost between 180 and $220. This cost includes all gas, camp fees, food and canoe rentals. The balance is payable at the end of the trip when we calculate the costs owed by each member.\nHOW TO PAY: contact Pedro for paypal account and e-mail address\nINTRODUCTION TO CANOEING\nPlease review the following safety videos:\n(You don't need to kneel, sitting is fine for this type of trip. The other safety tips are good)\n[https://www.youtube.com/watch?v=PrjXT9bAB6c](https://www.youtube.com/watch?v=PrjXT9bAB6c)\n[https://www.youtube.com/watch?v=sTtFSpelQk4](https://www.youtube.com/watch?v=sTtFSpelQk4)\n[https://www.youtube.com/watch?v=_zHSfEhEqkU](https://www.youtube.com/watch?v=_zHSfEhEqkU)\nPlease ALWAYS check your email or the event post in the evening or in the morning prior to the event for cancellation, rescheduling or last minute changes.\nPlease Note: You are required to respond to Meetup messages in a timely manner. The messages may be on the comment board below, private message, or through the email address you have registered with [Meetup.com.](http://Meetup.com.)","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/gta-vibe-and-wander-com/events/316562323/","isAttending":false,"isSaved":false,"maxTickets":12,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536151685"},"displayPhoto":{"__ref":"PhotoInfo:536151685"},"feeSettings":null,"group":{"__ref":"Group:38018832"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":10,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:7575386"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:399170213"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:123395312"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:56313242"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"M