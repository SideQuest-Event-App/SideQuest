name":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":5,"totalRatings":13}}},"PhotoInfo:315640847":{"__typename":"PhotoInfo","id":"315640847","highResUrl":"https://secure.meetupstatic.com/photos/member/9/f/8/f/highres_315640847.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:339669683":{"__typename":"Member","id":"339669683","name":"Andrii Litvinov","memberPhoto":{"__ref":"PhotoInfo:315640847"}},"Event:316531870":{"__typename":"Event","id":"316531870","dateTime":"2026-10-02T17:00:00-04:00","isAttending":false,"group":{"__typename":"Group","urlname":"toronto-tantra-circle"}},"Event:316115760":{"__typename":"Event","id":"316115760","dateTime":"2026-10-03T17:00:00-04:00","isAttending":false,"group":{"__typename":"Group","urlname":"toronto-tantra-circle"}},"Event:316559576":{"__typename":"Event","id":"316559576","dateTime":"2026-10-04T17:00:00-04:00","isAttending":false,"group":{"__typename":"Group","urlname":"toronto-tantra-circle"}},"Event:316586675":{"__typename":"Event","id":"316586675","dateTime":"2026-10-06T17:00:00-04:00","isAttending":false,"group":{"__typename":"Group","urlname":"toronto-tantra-circle"}},"Event:316628956":{"__typename":"Event","id":"316628956","dateTime":"2026-10-09T17:00:00-04:00","isAttending":false,"group":{"__typename":"Group","urlname":"toronto-tantra-circle"}},"Event:316786142":{"__typename":"Event","id":"316786142","title":"MASSAGE CLUB \u0026 BODY PSYCHOTHERAPY","dateTime":"2026-10-20T17:00:00-04:00","description":"MASSAGE CLUB \u0026 BODY PSYCHOTHERAPY\nThis is the project overview only!\nDates might change.\n\nTo find the exact dates and register for the event, please join our Telegram group:\n\nT.me/TorontoTantra\nT.me/AndyTherapist\n\nMASSAGE \u0026 BODY PSYCHOTHERAPY CLUB\n\nHave you ever explored massage not only as relaxation, but also as a way to reconnect with your body, emotions, and nervous system?\n\nIn Toronto there are many massage services, but not many spaces where people can safely learn, practice and exchange conscious touch together.\n\nWe would like to create such a club.\n\nA warm, respectful space for people interested in massage, bodywork, somatic practices and body-oriented psychotherapy.\n\nYou don’t need professional massage experience. Beginners are welcome.\n\nJoin our group and leave a message if you would like to be added to the waiting list.\nt.me/TorontoTantra\n\nAbout this event\n\n• What is the Massage \u0026 Body Psychotherapy Club?\n\nIt is a practice evening where we explore conscious touch, relaxation, massage techniques and simple body-oriented therapeutic exercises.\n\nThe purpose is not only to relax muscles, but also to develop better contact with your body, reduce stress and learn how safe touch can support emotional regulation and connection.\n\n• What will we be doing?\n\nDepending on the evening, we may explore:\n\n- simple relaxation massage techniques\n- conscious touch and body awareness\n- grounding and nervous-system regulation\n- breathing and relaxation exercises\n- somatic and body-psychotherapy exercises\n- practicing giving and receiving\n- communication of boundaries and consent\n\nPractices can be done in pairs or small groups and will be guided step by step.\n\n• Massage exchange\n\nOne of the main parts of the club is a structured massage exchange.\n\nYou can experience both sides:\ngiving touch and receiving touch.\n\nThe goal is not to perform a “perfect massage,” but to become more sensitive to another person’s body, learn to listen through your hands, communicate clearly and discover what kind of touch feels supportive.\n\nImportant terms \u0026 agreements\n\nConsent first: every exercise and every touch is optional.\n\nRespect boundaries: you can say yes, no, stop, slower, softer or change the practice at any moment.\n\nKeep it therapeutic: this is a bodywork and personal-development space, not a sexual service or dating event.\n\nStay present: no alcohol or recreational drugs during the event.\n\nConfidentiality: personal experiences shared during the practice stay within the group.\n\nThe club may be interesting for people curious about:\n\nmassage • bodywork • somatic therapy • body-oriented psychotherapy • conscious touch • nervous-system regulation • relaxation • tantra-inspired body awareness\n\nDetails, dates and registration:\nt.me/TorontoTantra","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/toronto-tantra-circle/events/316786142/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:535655316"},"displayPhoto":{"__ref":"PhotoInfo:535655316"},"feeSettings":null,"group":{"__ref":"Group:37678460"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:339669683"}}}]},"series":{"__typename":"Series","description":"Every week on Tuesday, Friday, Saturday, Sunday","weeklyRecurrence":{"__typename":"WeeklyRecurrenceInfo","weeklyDaysOfWeek":["SATURDAY","TUESDAY","FRIDAY","SUNDAY"],"weeklyInterval":1},"monthlyRecurrence":null,"events({\"numberOfEvents\":5,\"startDate\":\"2026-10-02\"})":{"__typename":"SeriesEventConnection","edges":[{"__typename":"EventEdge","node":{"__ref":"Event:316531870"}},{"__typename":"EventEdge","node":{"__ref":"Event:316115760"}},{"__typename":"EventEdge","node":{"__ref":"Event:316559576"}},{"__typename":"EventEdge","node":{"__ref":"Event:316586675"}},{"__typename":"EventEdge","node":{"__ref":"Event:316628956"}}]}},"venue":null},"RecommendedEventsEdge:{\"node\":{\"id\":\"316786142\"}}":{"__typename":"RecommendedEventsEdge","node":{"__ref":"Event:316786142","id":"316786142"},"metadata":{"__typename":"SearchMetadata","recId":"0884a3fe-5c9e-4a9a-96d6-1a1d41e62e1d","recSource":"ml-popular-events-nearby-offline"}},"PhotoInfo:530489313":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.