ase inform your friends that they must also confirm.\n\n\\*In the event of repeated violations, the administrator reserves the right to make the final decision.\n\nThank you for your understanding and cooperation.\n\n* After reading the event details, members can contact the administrator via message.","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/ca-badminton-meetup-toronto-group-gta/events/316332798/","isSaved":false,"maxTickets":16,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:507254743"},"displayPhoto":{"__ref":"PhotoInfo:507254743"},"feeSettings":null,"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":16,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:370040241"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:112777102"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:483173609"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:482705831"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:483193417"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:340172248"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:241829628"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:298407400"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:479866524"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:384544588"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:474189366"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:475675550"}}},{"__typename":"RsvpE