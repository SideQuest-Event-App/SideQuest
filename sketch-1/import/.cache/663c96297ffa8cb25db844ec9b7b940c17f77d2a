typename":"Member","id":"209053418","name":"Chris Milan","memberPhoto":{"__ref":"PhotoInfo:258544991"}},"PhotoInfo:258100480":{"__typename":"PhotoInfo","id":"258100480","highResUrl":"https://secure.meetupstatic.com/photos/member/9/e/2/0/highres_258100480.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:208480462":{"__typename":"Member","id":"208480462","name":"Tamara Miller-Falls","memberPhoto":{"__ref":"PhotoInfo:258100480"}},"PhotoInfo:276506332":{"__typename":"PhotoInfo","id":"276506332","highResUrl":"https://secure.meetupstatic.com/photos/member/6/6/d/c/highres_276506332.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:252681749":{"__typename":"Member","id":"252681749","name":"Cerensu Urtekin","memberPhoto":{"__ref":"PhotoInfo:276506332"}},"PhotoInfo:241629547":{"__typename":"PhotoInfo","id":"241629547","highResUrl":"https://secure.meetupstatic.com/photos/member/2/5/4/b/highres_241629547.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:182610724":{"__typename":"Member","id":"182610724","name":"Juan Felipe Garzon","memberPhoto":{"__ref":"PhotoInfo:241629547"}},"PhotoInfo:258179699":{"__typename":"PhotoInfo","id":"258179699","highResUrl":"https://secure.meetupstatic.com/photos/member/e/9/3/3/highres_258179699.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:208644749":{"__typename":"Member","id":"208644749","name":"Michelle Feltwell Kostopoulos","memberPhoto":{"__ref":"PhotoInfo:258179699"}},"Event:316723632":{"__typename":"Event","id":"316723632","title":"🍂🌳 Fall Walk: Gus Harris Trail 🌳🍂","dateTime":"2026-10-11T11:00:00-04:00","description":"# 🍂🌳 Fall Walk: Gus Harris Trail 🌳🍂\n\n### A Hidden Ravine, Easy Walking \u0026 Great Conversation\n\nSometimes the best parts of Toronto are the ones most people drive right past.\n\nJoin us for a relaxed fall walk along the **Gus Harris Trail**, a quiet ravine trail that follows **Taylor-Massey Creek** through Scarborough and East York.\n\nThis isn't a challenging hike. It's an easy, mostly flat walk through one of Toronto's quieter green spaces, with plenty of time to enjoy the changing leaves, get some fresh air, and meet other people along the way.\n\nWe'll follow the creek, walk beneath the trees, and take our time enjoying the fall scenery.\nThe goal isn't to race to the end of the trail. **It's to get outside, have some good conversations, and enjoy the company.**\n\n✨ **Fun Fact:** Taylor-Massey Creek takes its name from two prominent Toronto families. The Taylor family was associated with the Don Valley Brick Works, now home to Evergreen Brick Works.\n\n📱 Don't forget to join our **WhatsApp Group – [CLICK HERE](https://chat.whatsapp.com/H59mSCbsAi018gYANrKAnc)**\n\n***\n\n## 🚶‍♂️ What We'll Do\n\nWe'll spend about **two hours** walking along the trail, taking our time, chatting, and getting to know one another.\nThis is a **social walk, not a race.**\n\nThe route has very few hills, making it a comfortable walk for most people with a reasonable level of fitness.\nWe'll finish back where we started.\n\n***\n\n## 🍁 Fall Weather \u0026 Expectations\n\nThis walk takes place outdoors in typical Toronto fall weather.\nPlease dress appropriately for the conditions and wear comfortable walking shoes. The trail may be damp or muddy depending on recent weather.\nBring water and a snack, and dress in layers if the temperature is changing throughout the day.\n\n***\n\n## 🧢 Meetup Details\n\n📍 **Meetup Location:** Outside Victoria Park Subway Station, by Victoria Park Road.\n🫎 **Look for me in my Moose Hat!**\n⏰ **Meetup Time: 11:00 AM sharp**\nI will only wait **5 minutes.**\n**Early is on time. On time is late.**\n🏁 **End Point:** Victoria Park Subway Station\n\n***\n\n## 🎟️ Meetup Fee\n\n**$5 cash in person or e-transfer**\n📧 **mathewmaclean@hotmail.com**\nThis fee helps support the group and allows us to continue organizing events throughout Toronto.\n\n***\n\n## 🎒 What to Bring\n\n💧 Water\n👟 Comfortable walking shoes\n🥪 A snack\n🧥 A fall jacket or sweater\n🦟 Bug spray if needed\n\n***\n\n## 🌈 Who Is This For?\n\nThis walk is great for:\n\n* Anyone who enjoys fall scenery 🍂\n* People looking for an easy trail\n* Anyone who wants to get outside and get moving\n* People who enjoy exploring Toronto's hidden green spaces\n* Anyone looking for a relaxed social outing\n* People who want to meet new people and make friends\n\nYou're welcome to RSVP ahead of time or just show up on the day if you're unsure about your schedule.\nSometimes things happen and events may need to be cancelled or changed, so please keep an eye on the event page for updates.\n\n👤 **Organizer: Mathew**\nQuestions? Post on the event wall or email **torontomoviesandoutings@hotmail.com**.\n\n**Come for the trail.**\n**Stay for the conversation.**\n**Leave with a new connection — and maybe a new friend.** 🍂💛","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/torontotnt/events/316723632/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536318117"},"displayPhoto":{"__ref":"PhotoInfo:536318117"},"feeSettings":{"__typename":"EventFeeSettings","accepts":"CASH","currency":"CAD","amount":5},"group":{"__ref":"Group:1822458"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":21,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:9334356"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:42205162"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:18367641"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:183723589"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:86488802"}}},{"__typename":"Rs