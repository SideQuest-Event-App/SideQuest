82114","highResUrl":"https://secure.meetupstatic.com/photos/member/a/4/8/2/highres_326382114.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:326099095":{"__typename":"PhotoInfo","id":"326099095","highResUrl":"https://secure.meetupstatic.com/photos/member/e/6/d/7/highres_326099095.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:349146718":{"__typename":"Member","id":"349146718","name":"Marko Starcevic","memberPhoto":{"__ref":"PhotoInfo:326099095"}},"Member:26338882":{"__typename":"Member","id":"26338882","name":"Andrej Ristic","memberPhoto":{"__ref":"PhotoInfo:262270594"}},"Member:285260643":{"__typename":"Member","id":"285260643","name":"Ritz","memberPhoto":{"__ref":"PhotoInfo:323561948"}},"Event:316064992":{"__typename":"Event","id":"316064992","title":"AI Clinic 02: Can AI actually do this? Bring the task and find out","dateTime":"2026-10-21T18:00:00-04:00","description":"Everybody has a task they have quietly wondered about. The one where you think *surely a computer could do this by now*, and then you never find out, because asking felt like it would turn into a sales call.\n\nThis is where you ask.\n\nSame format every month. Everyone names one job they keep doing by hand, all of it goes on a board, and it gets sorted in front of the room into **do it yourself this week**, **a weekend project**, or **needs help, or leave it alone**. Then three or four get taken apart properly: the approach, the tool, roughly the cost, what breaks.\n\nEvery bottleneck in the room gets sorted out loud and gets a first step. Some of these are a ten minute job, some are a real project, and some are not worth doing. You will be told which.\n\nYou get a straight answer, including when the answer is no. Some things are not worth automating and you deserve to hear that too.\n\n**The night**\n\n* 6:00 Doors, coffee, write your bottleneck on a card\n* 6:15 Round the table, sixty seconds each\n* 6:35 Th