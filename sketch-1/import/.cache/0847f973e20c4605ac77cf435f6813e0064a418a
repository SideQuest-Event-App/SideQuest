lay\n* Welcoming, inclusive environment\n\n\\*\\*\\*\nCome ready to rally, socialize, and have a great time on the court. We can’t wait to see you there!","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/downtown-miles-nadal-jcc-sports-and-recreation/events/316766959/","isSaved":false,"maxTickets":6,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:528093737"},"displayPhoto":{"__ref":"PhotoInfo:528093737"},"feeSettings":null,"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:200840137"}}}]},"series":{"__typename":"Series","description":"Every week on Monday until December 28, 2026","weeklyRecurrence":{"__typename":"WeeklyRecurrenceInfo","weeklyDaysOfWeek":["MONDAY"],"weeklyInterval":1},"monthlyRecurrence":null,"events({\"numberOfEvents\":5,\"startDate\":\"2026-10-02\"})":{"__typename":"SeriesEventConnection","edges":[{"__typename":"EventEdge","node":{"__ref":"Event:316569016"}},{"__typename":"EventEdge","node":{"__ref":"Event:316666332"}},{"__typename":"EventEdge","node":{"__ref":"Event:316766959"}},{"__typename":"EventEdge","node":{"__ref":"Event:snptztyjcnbjc"}},{"__typename":"EventEdge","node":{"__ref":"Event:snptztyjcpbdb"}}]}},"venue":{"__typename":"Venue","name":"Miles Nadal JCC","address":"750 Spadina Ave - M5S 2J2","city":"Toronto","state":"ON","country":"ca"}},"Event:snptztyjcnbjc":{"__typename":"Event","id":"snptztyjcnbjc","dateTime":"2026-10-26T13:15:00-04:00","isAttending":false,"group":{"__typename":"Group","urlname":"downtown-miles-nadal-jcc-sports-and-recreation"}},"Event:snptztyjcpbdb":{"__typename":"Event","id":"snptztyjcpbdb","dateTime":"2026-11-02T13:15:00-05:00","isAttending":false,"group":{"__typename":"Group","urlname":"downtown-miles-nadal-jcc-sports-and-recreation"}},"RecommendedEventsEdge:{\"node\":{\"id\":\"316766959\"}}":{"__typename":"RecommendedEventsEdge","node":{"__ref":"Event:31676