ts. Since we have limited seating, it is of the utmost importance that if you plan on attending you sign up for the event. Likewise, if you are unable to make it, kindly mark that you will not be coming so your spot becomes available for another per\n\nWe appreciate your understanding and cooperation. Hope to see you soon!","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/m-b-g-u/events/316762710/","isSaved":false,"maxTickets":25,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:497964091"},"displayPhoto":{"__ref":"PhotoInfo:497964091"},"feeSettings":{"__typename":"EventFeeSettings","accepts":"CASH","currency":"CAD","amount":9.04},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":49,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:9688196"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:263550323"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:88693742"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:167428352"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:190087232"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:241492031"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:251842830"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:143963262"}}}]},"series":{"__typename":"Series","description":"Every week on Monday","weeklyRecurrence":{"__typename":"WeeklyRecurrenceInfo","weeklyDaysOfWeek":["MONDAY"],"weeklyInterval":1},"monthlyRecurrence":null,"events({\"numberOfEvents\":5,\"startDate\":\"2026-10-02\"})":{"__typename":"SeriesEventConnection","edges":[{"__typename":"EventEdge","node":{"__ref":"Event:316762710"}},{"__typename":"EventEdge","node":{"__ref":"Event:ckklbvyjcnbjc"}},{"__typename":"EventEdge","node":{"__ref":"Event:ckklbvyjcpbdb"}},{"__typename":"EventEdge","node":{"__ref