to Cafeさんに会場をお借りしているので、ドリンクやおにぎりを注文していただけると本当に助かります（必須ではありません）。\n\nスケジュール\n11:50 開場\n12:05 ラウンド1（英語25分・日本語25分）\n12:55 グループチェンジ\n13:00 ラウンド2（英語25分・日本語25分）\n13:50 フリータイム。\n14:30 終了","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/tomodachitoronto/events/316726090/","isAttending":false,"isSaved":false,"maxTickets":1,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536321205"},"displayPhoto":{"__ref":"PhotoInfo:536321205"},"feeSettings":{"__typename":"EventFeeSettings","accepts":"CASH","currency":"CAD","amount":5},"group":{"__ref":"Group:37895830"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":22,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:312727854"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:484032052"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:476709438"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:83267832"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:138252902"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:269115686"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:482106557"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:455652871"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:484043726"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:471321505"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:193021474"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:481775016"}}},{"__typename":"RsvpEdge","node":{"__type