ANTHROPIC_API_KEY=paste-your-key-here
# Optional: change the model
# MODEL=claude-haiku-4-5-20251001

# Optional: store the database in Supabase instead of data/db.json (Project Settings → API).
# Use the secret key (service_role on older projects): only server.js talks to Supabase.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...

# ---------- The event import (import/run.js); in GitHub these are Actions secrets ----------
# TICKETMASTER_API_KEY=
# SeatGeek's Platform API client id (https://seatgeek.com/account/develop). Without it, SeatGeek is skipped.
# SEATGEEK_CLIENT_ID=
# Look up missing or lake coordinates on OpenStreetMap Nominatim (one request a second, cached in data/geocode.json,
# User-Agent "SideQuest-class-project"). The workflow sets GEOCODE=1.
# GEOCODE=1
# GEOCODE_MAX=300
